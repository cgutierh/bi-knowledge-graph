{"@context": {"@vocab": "urn:kg:vocab:", "xsd": "http://www.w3.org/2001/XMLSchema#", "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "BRAND_HAS_DOCUMENT": {"@type": "@id", "@container": "@set"}, "BRAND_HAS_TONE_RULE": {"@type": "@id", "@container": "@set"}, "BRAND_HAS_VISUAL_RULE": {"@type": "@id", "@container": "@set"}, "BRAND_TARGETS_MARKET": {"@type": "@id", "@container": "@set"}, "CLAIM_DERIVED_FROM_DOCUMENT": {"@type": "@id", "@container": "@set"}, "CLAIM_SUPPORTED_BY_REFERENCE": {"@type": "@id", "@container": "@set"}, "CONTENT_MODULE_CONTAINS_CLAIM": {"@type": "@id", "@container": "@set"}, "DERIVED_FROM_DOCUMENT": {"@type": "@id", "@container": "@set"}, "DERIVED_FROM_SECTION": {"@type": "@id", "@container": "@set"}, "DERIVED_FROM_TABLE": {"@type": "@id", "@container": "@set"}, "DOCUMENT_HAS_SECTION": {"@type": "@id", "@container": "@set"}, "DOCUMENT_HAS_TABLE": {"@type": "@id", "@container": "@set"}, "MARKET_PART_OF_REGION": {"@type": "@id", "@container": "@set"}, "OUTCOME_FROM_TRIAL": {"@type": "@id", "@container": "@set"}, "PI_SECTION_CONTAINS_SAFETY": {"@type": "@id", "@container": "@set"}, "RENAL_OUTCOME_FROM_TRIAL": {"@type": "@id", "@container": "@set"}, "SECTION_HAS_CHUNK": {"@type": "@id", "@container": "@set"}, "chunk_index": {"@type": "xsd:integer"}, "page_number": {"@type": "xsd:integer"}, "row_number": {"@type": "xsd:integer"}, "source_page": {"@type": "xsd:integer"}, "table_index": {"@type": "xsd:integer"}, "token_count": {"@type": "xsd:integer"}}, "@id": "urn:kg:jardiance:graph", "rdfs:label": "Jardiance", "generatedAt": {"@value": "2026-09-29T20:24:37.626415+00:00", "@type": "xsd:dateTime"}, "@graph": [{"@id": "urn:kg:jardiance:brand:jardiance", "@type": "Brand", "graphScope": "brand", "name": "jardiance", "brand_id": "jardiance", "BRAND_HAS_DOCUMENT": [{"@id": "urn:kg:jardiance:document:e77ccb64-a3a2-41c2-9027-fb5e54716ebc"}, {"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}, {"@id": "urn:kg:jardiance:document:c66d5608-