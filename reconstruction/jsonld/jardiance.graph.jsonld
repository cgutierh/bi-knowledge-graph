------------------------------------------|------------------------------------------------|\n|                                                              | Placebo                                        | Jardiance                                      | Jardiance                                      |\n|                                                              |                                                | 10 mg                                          | 25 mg                                          |\n| N                                                            | 165                                            | 165                                            | 168                                            |\n| HbA1c (%)                                                    |                                                |"}, {"@id": "urn:kg:jardiance:chunk:55338f77-3c07-46cb-9e8a-2df6ff6bcf15", "@type": "Chunk", "graphScope": "brand", "chunk_index": 102, "token_count": 294, "page_number": 16, "source_document_type": "product_information", "section_id": "066c1912-9215-4686-89aa-8e6364478f6a", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "2886d829f52559281dae4bac76253063d87c1477a38e3e786bb6cfea87dfaa4a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "55338f77-3c07-46cb-9e8a-2df6ff6bcf15", "text": "|\n| HbA1c (%)                                                    |                                                |                                                |                                                |\n| Baseline (mean)                                              | 8.16                                           | 8.07                                           | 8.06                                           |\n| Change from baseline 1                                       | -0.11                                          | -0.59                                          | -0.72                                          |\n| Difference from placebo 1 (97.5% CI)                         |                                                | -0.48* (-0.69, -0.27)                          | -0.61* (-0.82, -0.40)                          |\n| N                                                            | 155                                            | 151                                            | 160                                            |\n| Patients (%) achieving HbA1c < 7% with baseline HbA1c ≥ 7% 2 | 7.7                                            | 24"}, {"@id": "urn:kg:jardiance:chunk:522e79aa-894b-4761-a0e2-112bf035227e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 103, "token_count": 296, "page_number": 16, "source_document_type": "product_information", "section_id": "066c1912-9215-4686-89aa-8e6364478f6a", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ce104e7034c2443a77c217436434304f99a6e187fb3c2e086437c82068a8a18f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "522e79aa-894b-4761-a0e2-112bf035227e", "text": "|\n| Patients (%) achieving HbA1c < 7% with baseline HbA1c ≥ 7% 2 | 7.7                                            | 24                                             | 30                                             |\n| N                                                            | 165                                            | 165                                            | 168                                            |\n| Body Weight (kg)                                             |                                                |                                                |                                                |\n| Baseline (mean)                                              | 78.1                                           | 77.97                                          | 78.93                                          |\n| Change from baseline 1                                       | 0.34                                           | -1.62                                          | -1.47                                          |\n| Difference from placebo 1 (97.5% CI)                         |                                                | -1.95*"}, {"@id": "urn:kg:jardiance:chunk:82b6d6d4-10a4-453c-8947-f7d5de47cf44", "@type": "Chunk", "graphScope": "brand", "chunk_index": 104, "token_count": 282, "page_number": 16, "source_document_type": "product_information", "section_id": "066c1912-9215-4686-89aa-8e6364478f6a", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "3b1257b2dec8edec13349a2ffb6a87d1ceb1291275d6f38e28f6fa8a1a36442e", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "82b6d6d4-10a4-453c-8947-f7d5de47cf44", "text": "|\n| Difference from placebo 1 (97.5% CI)                         |                                                | -1.95* (-2.64, -1.27)                          | -1.81* (-2.49, -1.13)                          |\n| N                                                            | 165                                            | 165                                            | 168                                            |\n| SBP (mmHg) 3                                                 |                                                |                                                |                                                |\n| Baseline (mean)                                              | 125.7                                          | 126.5                                          | 126                                            |\n| Change from baseline 1                                       | 0.7                                            | -3.1                                           | -4.0                                           |\n| Difference from placebo 1 (95% CI)                           |"}, {"@id": "urn:kg:jardiance:chunk:034d036e-1a3e-4830-b5e7-09a210328729", "@type": "Chunk", "graphScope": "brand", "chunk_index": 105, "token_count": 136, "page_number": 16, "source_document_type": "product_information", "section_id": "066c1912-9215-4686-89aa-8e6364478f6a", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ab827d6e4301ce0d72adcacb9cd436f715b84254c521a4982f8514459cc85908", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "034d036e-1a3e-4830-b5e7-09a210328729", "text": "|\n| Difference from placebo 1 (95% CI)                           |                                                | -3.9 (-6.23, -1.50)                            | -4.7 (-7.08, -2.37)                            |\n\na\n\nFull analysis set (FAS) using last observation carried forward (LOCF) prior to glycaemic rescue therapy\n\n1 Mean adjusted for baseline value\n\n2 Not evaluated for statistical significance as a result of the sequential confirmatory testing procedure\n\n3 LOCF, values after antihypertensive rescue censored\n\n* p-value &lt; 0.0001"}, {"@id": "urn:kg:jardiance:chunk:0d034784-7595-4a49-a8a5-0f9649a8aa5a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 106, "token_count": 145, "page_number": 16, "source_document_type": "product_information", "section_id": "faf9c26b-2408-42f4-b4d4-71bdb0bd4a39", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "27446e47e16c37e2e9e18a0763f0576bb4e24e6dd59a00d0b470e51f6ca8201a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0d034784-7595-4a49-a8a5-0f9649a8aa5a", "text": "A factorial design study of 24 weeks duration was conducted to evaluate the efficacy and safety of empagliflozin in drug-naïve patients. Treatment with empagliflozin in combination with metformin (5 mg and 500 mg; 5 mg and 1 000 mg; 12.5 mg and 500 mg, and 12.5 mg and 1 000 mg given twice daily) provided statistically significant improvements in HbA1c (Table 4) and led to greater reductions in FPG (compared to the individual components) and body weight (compared to metformin).\n\nTable 4: Efficacy results at 24 week comparing empagliflozin in combination with metformin to the"}, {"@id": "urn:kg:jardiance:chunk:d23d6391-796b-4874-b675-65ddfaac61b9", "@type": "Chunk", "graphScope": "brand", "chunk_index": 107, "token_count": 296, "page_number": 17, "source_document_type": "product_information", "section_id": "c605dd04-eea9-4d75-84ac-2089ef8e7cb5", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "83f987d39050057be6836dade8fd80ad930d78e93e103914f4165490f366b6fb", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "d23d6391-796b-4874-b675-65ddfaac61b9", "text": "|                                 | Empagliflozin 10 mg b   | Empagliflozin 10 mg b   | Empagliflozin 10 mg b   | Empagliflozin 25 mg b   | Empagliflozin 25 mg b   | Empagliflozin 25 mg b   | Metformin c   | Metformin c   |\n|---------------------------------|-------------------------|-------------------------|-------------------------|-------------------------|-------------------------|-------------------------|---------------|---------------|\n|                                 | + Met 1 000 mg c        | + Met 2 000 mg c        | No Met                  | + Met 1 000 mg c        | + Met 2 000 mg c        | No Met                  | 1 000 m g     | 2 000 m g     |\n| N                               | 161                     | 167                     | 169                     | 165                     | 169                     | 163                     | 167           | 162           |\n| HbA1c (%)                       |                         |                         |                         |                         |                         |                         |               |               |\n| Baseline (mean)                 | 8.68                    | 8.65"}, {"@id": "urn:kg:jardiance:chunk:6ad965ef-4fdb-4d2c-843d-4253114db198", "@type": "Chunk", "graphScope": "brand", "chunk_index": 108, "token_count": 298, "page_number": 17, "source_document_type": "product_information", "section_id": "c605dd04-eea9-4d75-84ac-2089ef8e7cb5", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "dde0f0546022d622021660d0463459b316d9a91c999f7a07f352f6ddf105e45b", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6ad965ef-4fdb-4d2c-843d-4253114db198", "text": "|                         |               |               |\n| Baseline (mean)                 | 8.68                    | 8.65                    | 8.62                    | 8.84                    | 8.66                    | 8.86                    | 8.69          | 8.55          |\n| Change from baseline 1          | -1.98                   | -2.07                   | -1.3 5                  | -1.93                   | -2.08                   | -1.3 6                  | -1.18         | -1.75         |\n| Compariso n vs. empa (95% CI) 1 | -0.63* (-0.86, -0.40)   | -0.72* (-0.96, -0.49)   |                         | -0.57* (-0.81, -0.34)   | -0.72* (-0.95, -0.48)   |                         |               |               |\n| Compariso n vs. met (95% CI) 1  | -0.79* (-1.03, -0.56)   | -0.33* (-0.56, -0.09)   |                         | -0.75* (-0.98 -0.51)    | -0.33* (-0.56, -0.10)   |                         |               |               |\n\nMet = metformin; empa = empagliflozin\n\n- 1 mean adjusted for baseline value\n- a Analyses were performed on the full analysis set (FAS) using an observed cases (OC) approach\n- b Given in two equally divided doses per day when given to"}, {"@id": "urn:kg:jardiance:chunk:6756e47d-8341-461c-9954-16ffc1b25015", "@type": "Chunk", "graphScope": "brand", "chunk_index": 109, "token_count": 60, "page_number": 17, "source_document_type": "product_information", "section_id": "c605dd04-eea9-4d75-84ac-2089ef8e7cb5", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "c57266e769b41670f54f7e6e7b167d89d569c1c6c597f6d9e1bd25219b3348fc", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6756e47d-8341-461c-9954-16ffc1b25015", "text": "lyses were performed on the full analysis set (FAS) using an observed cases (OC) approach\n- b Given in two equally divided doses per day when given together with metformin\n- c Given in two equally divided doses per day\n* p ≤ 0.0062 for HbA1c"}, {"@id": "urn:kg:jardiance:chunk:98d27480-9f52-4e3d-a88f-e6a82d1f5b04", "@type": "Chunk", "graphScope": "brand", "chunk_index": 110, "token_count": 118, "page_number": 17, "source_document_type": "product_information", "section_id": "6a79446a-a696-4ec4-a11f-5dee0e4e5120", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e01fc16047b0945d50468d5d8ed556e2829f87c412258afd66bc153ab8ba932e", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "98d27480-9f52-4e3d-a88f-e6a82d1f5b04", "text": "In patients inadequately controlled with metformin and linagliptin 5 mg, treatment with both empagliflozin 10 mg or 25 mg resulted in statistically significant (p &lt; 0.0001) reductions in HbA1c and body weight compared to placebo (Table 5). In addition it resulted in clinically meaningful reductions in FPG, systolic and diastolic blood pressure compared to placebo.\n\nTable 5: Efficacy results of a 24 week placebo-controlled study in patients inadequately controlled"}, {"@id": "urn:kg:jardiance:chunk:832ec4e5-c48b-43a7-a0fc-65b25b474d82", "@type": "Chunk", "graphScope": "brand", "chunk_index": 111, "token_count": 298, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "707542f65599fb212184f7c8d3fee9a58bac3564a83bf02dec4e644e3354350d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "832ec4e5-c48b-43a7-a0fc-65b25b474d82", "text": "with metformin and linagliptin 5 mg\n\n| Add-on to metformin and linagliptin 5 mg                     | Add-on to metformin and linagliptin 5 mg   | Add-on to metformin and linagliptin 5 mg   | Add-on to metformin and linagliptin 5 mg   |\n|--------------------------------------------------------------|--------------------------------------------|--------------------------------------------|--------------------------------------------|\n|                                                              | Placebo 5                                  | Empagliflozin 6                            | Empagliflozin 6                            |\n|                                                              |                                            | 10 mg                                      | 25 mg                                      |\n| N                                                            | 106                                        | 109                                        | 110                                        |\n| HbA1c (%) 3                                                  |                                            |                                            |"}, {"@id": "urn:kg:jardiance:chunk:fb83a441-54fc-47dc-ae06-93ddf7b60371", "@type": "Chunk", "graphScope": "brand", "chunk_index": 112, "token_count": 285, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "6a54721093217530a9e05819a4c1442c519525dd62aeb0f00bf281b72848dc47", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "fb83a441-54fc-47dc-ae06-93ddf7b60371", "text": "|                                            |                                            |                                            |\n| Baseline (mean)                                              | 7.96                                       | 7.97                                       | 7.97                                       |\n| Change from baseline 1                                       | 0.14                                       | -0.65                                      | -0.56                                      |\n| Difference from placebo (95% CI)                             |                                            | -0.79* (-1.02, -0.55)                      | -0.70* (-0.93, -0.46)                      |\n| N                                                            | 100                                        | 100                                        | 107                                        |\n| Patients (%) achieving HbA1c < 7% with baseline HbA1c ≥ 7% 2 | 17.0                                       | 37.0                                       | 32.7                                       |\n| N"}, {"@id": "urn:kg:jardiance:chunk:a76387ac-62ce-4e63-9534-51c69822883f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 113, "token_count": 285, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "a7f12e2926be7d81ab9785b5f270eea8c2105297c3dc78c33bb885e4d2168e9a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a76387ac-62ce-4e63-9534-51c69822883f", "text": "| 17.0                                       | 37.0                                       | 32.7                                       |\n| N                                                            | 106                                        | 109                                        | 110                                        |\n| Body Weight (kg) 3                                           |                                            |                                            |                                            |\n| Baseline (mean)                                              | 82.3                                       | 88.4                                       | 84.4                                       |\n| Change from baseline 1                                       | -0.3                                       | -3.1                                       | -2.5                                       |\n| Difference from placebo (95% CI)                             |                                            | -2.8* (-3.5, -2.1)                         | -2.2* (-2.9, -1.5)                         |\n| N"}, {"@id": "urn:kg:jardiance:chunk:84156d59-5039-480d-a46a-2cca5d5fea81", "@type": "Chunk", "graphScope": "brand", "chunk_index": 114, "token_count": 300, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "af579c9e327731b2cbfbf3a00633738ee54e0736fc08ab957159a3f31f5744f3", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "84156d59-5039-480d-a46a-2cca5d5fea81", "text": "8* (-3.5, -2.1)                         | -2.2* (-2.9, -1.5)                         |\n| N                                                            | 106                                        | 109                                        | 110                                        |\n| SBP (mmHg) 4                                                 |                                            |                                            |                                            |\n| Baseline (mean)                                              | 130.1                                      | 130.4                                      | 131.0                                      |\n| Change from baseline 1                                       | -1.7                                       | -3.0                                       | -4.3                                       |\n| Difference from placebo (95% CI)                             |                                            | -1.3 (-4.2, 1.7)                           | -2.6 (-5.5, 0.4)                           |\n\n1 Mean adjusted for baseline value\n\n2 Not evaluated for statistical significance; not part of sequential testing"}, {"@id": "urn:kg:jardiance:chunk:3cdf6d2e-d72c-4ae7-ab7d-9db34605c560", "@type": "Chunk", "graphScope": "brand", "chunk_index": 115, "token_count": 271, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "233c7cf8d7f2358b859a116bf458e9e841e201bfcee07456920698138683ed0b", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "3cdf6d2e-d72c-4ae7-ab7d-9db34605c560", "text": ".5, 0.4)                           |\n\n1 Mean adjusted for baseline value\n\n2 Not evaluated for statistical significance; not part of sequential testing procedure for the secondary endpoints\n\n3 MMRM model on FAS (OC) included baseline HbA1c, baseline eGFR (MDRD), geographical region, visit, treatment, and treatment by visit interaction. For weight, baseline weight was included.\n\n4 MMRM model included baseline SBP and baseline HbA1c as linear covariate(s), and baseline eGFR, geographical region, treatment, visit, and visit by treatment interaction as fixed effects.\n\n5 Patients randomised to the placebo group were receiving the placebo plus linagliptin 5 mg with background metformin\n\n6 Patients randomised to the empagliflozin 10 mg or 25 mg groups were receiving empagliflozin 10 mg or 25 mg and linagliptin 5 mg with background metformin\n\n* p-value &lt; 0.0001\n\nIn a pre-specified subgroup of patients with baseline HbA1c greater or equal than 8.5% the reduction from baseline in HbA1c was -1.3% with empagliflozin 10 mg or 25 mg at 24 weeks (p &lt; 0.0001) compared to placebo."}, {"@id": "urn:kg:jardiance:chunk:bb3969cd-32d2-4521-9363-f784e3f666d4", "@type": "Chunk", "graphScope": "brand", "chunk_index": 116, "token_count": 9, "page_number": 18, "source_document_type": "product_information", "section_id": "19bfcd03-f8cf-4a6d-9744-6e1a3dd2640e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "4abf4da76a02fe39ce500b49292b3381fb9ca608e9750846c4cfab3a465a1f26", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "bb3969cd-32d2-4521-9363-f784e3f666d4", "text": "p &lt; 0.0001) compared to placebo."}, {"@id": "urn:kg:jardiance:chunk:efd36e35-0290-4334-92f9-fc023b60e19c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 117, "token_count": 269, "page_number": 18, "source_document_type": "product_information", "section_id": "c55430de-1e20-44cf-9ccf-8d0da12e8f81", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e5aff3efb1a17c68213442ce1cdd1c7b59e302ceeef1169a4cec59bff10cc8e7", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "efd36e35-0290-4334-92f9-fc023b60e19c", "text": "In a study comparing the efficacy and safety of empagliflozin 25 mg versus glimepiride (up to 4 mg per day) in patients with inadequate glycaemic control on metformin alone, treatment with empagliflozin daily resulted in superior reduction in HbA1c (Table 6), and a clinically meaningful reduction in FPG, compared to glimepiride. Empagliflozin daily resulted in a statistically significant reduction in body weight, systolic and diastolic blood pressure and a statistically significantly lower proportion of patients with hypoglycaemic events compared to glimepiride (2.5% for empagliflozin, 24.2% for glimepiride, p &lt; 0.0001).\n\nTable 6: Efficacy results at 104 week in an active controlled study comparing empagliflozin to glimepiride as add-on to metformin a\n\n|                 |   Empagliflozin 25 mg |   Glimepiride b |\n|-----------------|-----------------------|-----------------|\n| N               |                   765 |             780 |\n| HbA1c (%)       |                       |                 |\n| Baseline (mean) |                  7.92 |            7.92 |"}, {"@id": "urn:kg:jardiance:chunk:29dcac77-b0ff-4518-8183-8ba1e1fe87fb", "@type": "Chunk", "graphScope": "brand", "chunk_index": 118, "token_count": 6, "page_number": 18, "source_document_type": "product_information", "section_id": "c55430de-1e20-44cf-9ccf-8d0da12e8f81", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "4d461bb8e79c00cc5459a5d0088a6dc1547650fe098e3813054f9a80a4272b42", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "29dcac77-b0ff-4518-8183-8ba1e1fe87fb", "text": "7.92 |            7.92 |"}, {"@id": "urn:kg:jardiance:chunk:c41b690a-8c59-4b0c-ab72-b5fc4cc5f3de", "@type": "Chunk", "graphScope": "brand", "chunk_index": 119, "token_count": 300, "page_number": 19, "source_document_type": "product_information", "section_id": "f617bfd5-03d9-4f69-9b6a-0028902d6b2e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ca72667303c9d7bbb6c9ec8fe1e02977d53aaaf9b38673051a361adaf2f9138f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c41b690a-8c59-4b0c-ab72-b5fc4cc5f3de", "text": "| Change from baseline 1                                       | -0.66                  |   -0.55 |\n|--------------------------------------------------------------|------------------------|---------|\n| Difference from glimepiride 1 (97.5% CI)                     | -0.11* (-0.20, -0.01)  |         |\n| N                                                            | 690                    |     715 |\n| Patients (%) achieving HbA1c < 7% with baseline HbA1c ≥ 7% 2 | 33.6                   |    30.9 |\n| N                                                            | 765                    |     780 |\n| Body Weight (kg)                                             |                        |         |\n| Baseline (mean)                                              | 82.52                  |   83.03 |\n| Change from baseline 1                                       | -3.12                  |    1.34 |\n| Difference from glimepiride 1 (97.5% CI)                     | -4.46** (-4.87, -4.05) |         |\n| N                                                            | 765                    |     780 |\n| SBP (mmHg) 2                                                 |                        |         |"}, {"@id": "urn:kg:jardiance:chunk:1bddc4c3-99ec-4236-a97d-42b0d648f8d8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 120, "token_count": 191, "page_number": 19, "source_document_type": "product_information", "section_id": "f617bfd5-03d9-4f69-9b6a-0028902d6b2e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "c091ad09330ac89788c95e32321fc2b15aba6366372047222b04ea8ae4d2fc2c", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "1bddc4c3-99ec-4236-a97d-42b0d648f8d8", "text": "| 765                    |     780 |\n| SBP (mmHg) 2                                                 |                        |         |\n| Baseline (mean)                                              | 133.4                  |   133.5 |\n| Change from baseline 1                                       | -3.1                   |     2.5 |\n| Difference from glimepiride 1 (97.5% CI)                     | -5.6** (-7.0,-4.2)     |         |\n\na Full analysis set (FAS) using last observation carried forward (LOCF) prior to glycaemic rescue therapy\n\nb Up to 4 mg glimepiride\n\n1 Mean adjusted for baseline value\n\n2 LOCF, values after antihypertensive rescue censored\n\n* p-value &lt; 0.0001 for non-inferiority, and p-value = 0.0153 for superiority\n\n** p-value &lt; 0.0001"}, {"@id": "urn:kg:jardiance:chunk:5ccd846a-db0e-4023-b157-f0614479d964", "@type": "Chunk", "graphScope": "brand", "chunk_index": 121, "token_count": 298, "page_number": 19, "source_document_type": "product_information", "section_id": "886f13df-ee06-43b9-bae5-e84b5c965530", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "44b5c0df77fc8be23db485b1f174d8c9e9a499f19c31182e9c7ce5869351daa7", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "5ccd846a-db0e-4023-b157-f0614479d964", "text": "The efficacy and safety of empagliflozin as add-on to multiple daily insulin with or without concomitant metformin therapy was evaluated in a double-blind, placebo-controlled trial of 52 weeks duration. During the initial 18 weeks and the last 12 weeks, the insulin dose was kept stable, but was adjusted to achieve pre-prandial glucose levels &lt; 100 mg/dL [5.5 mmol/L], and post-prandial glucose levels &lt; 140 mg/dL [7.8 mmol/L] between Weeks 19 and 40.\n\nAt Week 18, empagliflozin provided statistically significant improvement in HbA1c compared with placebo (Table 7).\n\nAt Week 52, treatment with empagliflozin resulted in a statistically significant decrease in HbA1c and insulin sparing compared with placebo and a reduction in FPG and body weight.\n\nTable 7: Efficacy results at 18 and 52 weeks in a placebo-controlled study of empagliflozin as add on to multiple daily doses of insulin with or without metformin\n\n|                                        |   Placebo | Jardiance               | Jardiance             |\n|----------------------------------------|-----------|-------------------------|-----------------------|\n|                                        |           | 10 mg"}, {"@id": "urn:kg:jardiance:chunk:6f365817-2443-4160-8f96-09196370b903", "@type": "Chunk", "graphScope": "brand", "chunk_index": 122, "token_count": 300, "page_number": 19, "source_document_type": "product_information", "section_id": "886f13df-ee06-43b9-bae5-e84b5c965530", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f0bc3fa26ecd9de5b2cb48dd5d49eabdfafe712e8efda23ad75f5837865b7d18", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6f365817-2443-4160-8f96-09196370b903", "text": "------------------|-----------|-------------------------|-----------------------|\n|                                        |           | 10 mg                   | 25 mg                 |\n| N                                      |       188 | 186                     | 189                   |\n| HbA1c (%) at week 18                   |           |                         |                       |\n| Baseline (mean)                        |      8.33 | 8.39                    | 8.29                  |\n| Change from baseline 1                 |     -0.50 | -0.94                   | -1.02                 |\n| Difference from placebo 1 (97.5% CI)   |           | -0.44* (-0.61, -0.27)   | -0.52* (-0.69, -0.35) |\n| N                                      |       115 | 119                     | 118                   |\n| HbA1c (%) at week 52 2                 |           |                         |                       |\n| Baseline (mean)                        |      8.25 | 8.40                    | 8.37                  |\n| Change from baseline 1                 |     -0.81 | -1.18                   | -1.27                 |\n| Difference from placebo 1 (97.5% CI)   |           | -0.38*** (-0."}, {"@id": "urn:kg:jardiance:chunk:a4ae7dfa-1c9f-4ba5-9494-01fa2c19ae58", "@type": "Chunk", "graphScope": "brand", "chunk_index": 123, "token_count": 99, "page_number": 19, "source_document_type": "product_information", "section_id": "886f13df-ee06-43b9-bae5-e84b5c965530", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "41ae6a334aa1ee727ceb2c39e1b94cc89363d23080a73a3ce85f0f717b05e0cf", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a4ae7dfa-1c9f-4ba5-9494-01fa2c19ae58", "text": "1                 |     -0.81 | -1.18                   | -1.27                 |\n| Difference from placebo 1 (97.5% CI)   |           | -0.38*** (-0.62, -0.13) | -0.46* (-0.70, -0.22) |\n| N                                      |       113 | 118                     | 118                   |\n| Patients (%) achieving HbA1c < 7% with |      26.5 | 39.8                    | 45.8                  |"}, {"@id": "urn:kg:jardiance:chunk:b76b16c6-cd76-4130-b340-40bcb59b6a10", "@type": "Chunk", "graphScope": "brand", "chunk_index": 124, "token_count": 300, "page_number": 20, "source_document_type": "product_information", "section_id": "1db051fd-fc84-4beb-8cf1-ff10291dc80d", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "729223d6593cd7bebb96ea651adf9b6d9aa151e23c8d3b03e7ca4d5156c6715d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "b76b16c6-cd76-4130-b340-40bcb59b6a10", "text": "| baseline HbA1c ≥ 7% at week 52       |       |                         |                          |\n|--------------------------------------|-------|-------------------------|--------------------------|\n| N                                    |   115 | 118                     | 117                      |\n| Insulin dose (IU/day) at week 52 2   |       |                         |                          |\n| Baseline (mean)                      | 89.94 | 88.57                   | 90.38                    |\n| Change from baseline 1               | 10.16 | 1.33                    | -1.06                    |\n| Difference from placebo 1 (97.5% CI) |       | -8.83 # (-15.69, -1.97) | -11.22** (-18.09, -4.36) |\n| N                                    |   115 | 119                     | 118                      |\n| Body Weight (kg) at week 52 2        |       |                         |                          |\n| Baseline (mean)                      | 96.34 | 96.47                   | 95.37                    |\n| Change from baseline 1               |  0.44 | -1.95                   | -2.04                    |\n| Difference from placebo 1 (97.5% CI) |       | -2.39* (-3.54, -1.24)   | -2."}, {"@id": "urn:kg:jardiance:chunk:01703593-2afd-4026-937c-6ba773e3d733", "@type": "Chunk", "graphScope": "brand", "chunk_index": 125, "token_count": 116, "page_number": 20, "source_document_type": "product_information", "section_id": "1db051fd-fc84-4beb-8cf1-ff10291dc80d", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "4b478a932e32040863922454db9b202db9a5295f3d578f7f3392ffac51ed0ec4", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "01703593-2afd-4026-937c-6ba773e3d733", "text": "|  0.44 | -1.95                   | -2.04                    |\n| Difference from placebo 1 (97.5% CI) |       | -2.39* (-3.54, -1.24)   | -2.48* (-3.63, -1.33)    |\n\n1 Mean adjusted for baseline value\n\n2 Week 19-40: treat-to-target regimen for insulin dose adjustment to achieve predefined glucose target levels (pre-prandial &lt; 100 mg/dL (5.5 mmol/L), post-prandial &lt; 140 mg/dL (7.8 mmol/L)\n\n* p-value &lt; 0.0001\n\n** p-value = 0.0003\n\n*** p-value = 0.0005"}, {"@id": "urn:kg:jardiance:chunk:1b0efb95-92e1-4ddb-b6f8-0f2901c78ea8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 126, "token_count": 215, "page_number": 20, "source_document_type": "product_information", "section_id": "bcaf7b4a-091c-4635-92c0-e01e9f82edf6", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "22548f9da70f1e90d752f45f98824a57619e419d994d21434775a8665d19f896", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "1b0efb95-92e1-4ddb-b6f8-0f2901c78ea8", "text": "The efficacy and safety of empagliflozin as add-on to basal insulin with or without metformin and/or a sulphonylurea was evaluated in a double-blind, placebo-controlled trial of 78 weeks duration. During the initial 18 weeks the insulin dose was kept stable, but was adjusted to achieve a FPG &lt; 110 mg/dL in the following 60 weeks.\n\nAt week 18, empagliflozin provided statistically significant improvement in HbA1c (Table 8). At 78 weeks, empagliflozin resulted in a statistically significant decrease in HbA1c and insulin sparing compared to placebo. Furthermore, empagliflozin resulted in a reduction in FPG, body weight, and blood pressure.\n\nTable 8: Efficacy results at 18 and 78 weeks in a placebo-controlled study of empagliflozin as a Full analysis set (FAS) - Completers using last observation carried forward (LOCF) prior to glycaemic rescue therapy"}, {"@id": "urn:kg:jardiance:chunk:2d6e3476-8a56-4d9d-be48-713bcde7392b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 127, "token_count": 300, "page_number": 21, "source_document_type": "product_information", "section_id": "ca594031-d251-4160-bd03-33d70357e2c9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "aa7b2b8e1cf8cbafcded8b857b0b0ca8420296ca0a1d06931022554690ec4c8d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "2d6e3476-8a56-4d9d-be48-713bcde7392b", "text": "add-on to basal insulin with or without metformin or a sulphonylurea a\n\n|                                        |   Placebo | Empagliflozin 10 mg     | Empagliflozin 25 mg     |\n|----------------------------------------|-----------|-------------------------|-------------------------|\n| N                                      |       125 | 132                     | 117                     |\n| HbA1c (%) at week 18                   |           |                         |                         |\n| Baseline (mean)                        |      8.10 | 8.26                    | 8.34                    |\n| Change from baseline 1                 |     -0.01 | -0.57                   | -0.71                   |\n| Difference from placebo 1 (97.5% CI)   |           | -0.56* (-0.78, -0.33)   | -0.70* (-0.93, -0.47)   |\n| N                                      |       112 | 127                     | 110                     |\n| HbA1c (%) at week 78                   |           |                         |                         |\n| Baseline (mean)                        |      8.09 | 8.27                    | 8.29                    |\n| Change from baseline 1                 |     -0.02 | -0."}, {"@id": "urn:kg:jardiance:chunk:e3ac155f-6999-42f9-802e-ce0cf5c19a1f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 128, "token_count": 231, "page_number": 21, "source_document_type": "product_information", "section_id": "ca594031-d251-4160-bd03-33d70357e2c9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e2ee9c1f76ad9c2b1591d4e1f34925288c069c19f341a93c80753bdac1446fc6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "e3ac155f-6999-42f9-802e-ce0cf5c19a1f", "text": "n)                        |      8.09 | 8.27                    | 8.29                    |\n| Change from baseline 1                 |     -0.02 | -0.48                   | -0.64                   |\n| Difference from placebo 1 (97.5% CI)   |           | -0.46* (-0.73, -0.19)   | -0.62* (-0.90, -0.34)   |\n| N                                      |       112 | 127                     | 110                     |\n| Basal insulin dose (IU/day) at week 78 |           |                         |                         |\n| Baseline (mean)                        |     47.84 | 45.13                   | 48.43                   |\n| Change from baseline 1                 |      5.45 | -1.21                   | -0.47                   |\n| Difference from placebo 1 (97.5% CI)   |           | -6.66** (-11.56, -1.77) | -5.92** (-11.00, -0.85) |\n\n1 mean adjusted for baseline value\n\n* p-value &lt; 0.0001\n\n**  p-value &lt; 0.025"}, {"@id": "urn:kg:jardiance:chunk:795e2c66-8fdd-47c4-b353-27a5c7b443e7", "@type": "Chunk", "graphScope": "brand", "chunk_index": 129, "token_count": 300, "page_number": 21, "source_document_type": "product_information", "section_id": "fca286a4-fcdc-4f43-9c70-5e9274d3a3bf", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "0260f34b5602aef1978eab55f2dc2de72b0858cb5ef4b5c8d084168d06d59114", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "795e2c66-8fdd-47c4-b353-27a5c7b443e7", "text": "The efficacy and safety of empagliflozin as add-on to antidiabetic therapy was evaluated in patients with renal impairment in a double-blind, placebo-controlled study for 52 weeks. Treatment with empagliflozin led to a statistically significant reduction of HbA1c (Table 9) and clinically meaningful improvement in FPG compared to placebo at Week 24. The improvement in HbA1c, body weight, and blood pressure was sustained up to 52 weeks.\n\nTable 9: Results at 24 week in a placebo-controlled study of empagliflozin in renally impaired type 2 diabetes patients a\n\n|                                                              | Placebo                           | Empagliflozin 10 mg               | Empagliflozin 25 mg               | Placebo                           | Empagliflozin 25 mg               |\n|--------------------------------------------------------------|-----------------------------------|-----------------------------------|-----------------------------------|-----------------------------------|-----------------------------------|\n|                                                              | eGFR ≥ 60 to < 90 mL/min/1.73 m 2 | eGFR ≥ 60 to < 90 mL/min/1.73 m 2 | eGFR ≥ 60"}, {"@id": "urn:kg:jardiance:chunk:3b8bf27a-1c1d-427e-8eb2-77cc3cd25637", "@type": "Chunk", "graphScope": "brand", "chunk_index": 130, "token_count": 299, "page_number": 21, "source_document_type": "product_information", "section_id": "fca286a4-fcdc-4f43-9c70-5e9274d3a3bf", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "2560407c26f681e1f1b5e3c15fd65ef04229e8d739889501280bb72dfcef7e58", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "3b8bf27a-1c1d-427e-8eb2-77cc3cd25637", "text": "-|\n|                                                              | eGFR ≥ 60 to < 90 mL/min/1.73 m 2 | eGFR ≥ 60 to < 90 mL/min/1.73 m 2 | eGFR ≥ 60 to < 90 mL/min/1.73 m 2 | eGFR ≥ 30 to < 60 mL/min/1.73 m 2 | eGFR ≥ 30 to < 60 mL/min/1.73 m 2 |\n| N                                                            | 95                                | 98                                | 97                                | 187                               | 187                               |\n| HbA1c (%)                                                    |                                   |                                   |                                   |                                   |                                   |\n| Baseline (mean)                                              | 8.09                              | 8.02                              | 7.96                              | 8.04                              | 8.03                              |\n| Change from baseline 1                                       | 0.06                              | -0.46                             | -0.63                             | 0.05                              | -0.37"}, {"@id": "urn:kg:jardiance:chunk:0edf0a19-04e8-4cbf-a99b-0c2237046002", "@type": "Chunk", "graphScope": "brand", "chunk_index": 131, "token_count": 294, "page_number": 21, "source_document_type": "product_information", "section_id": "fca286a4-fcdc-4f43-9c70-5e9274d3a3bf", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ca859dbbc5ed4e7d939e2b03b8749544f33e66784f2b4896ecfd2291e1da81f1", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0edf0a19-04e8-4cbf-a99b-0c2237046002", "text": "06                              | -0.46                             | -0.63                             | 0.05                              | -0.37                             |\n| Difference from placebo 1 (95% CI)                           |                                   | -0.52* (-0.72, -0.32)             | -0.68* (-0.88, -0.49)             |                                   | -0.42* (-0.56, -0.28)             |\n| N                                                            | 89                                | 94                                | 91                                | 178                               | 175                               |\n| Patients (%) achieving HbA1c < 7% with baseline HbA1c ≥ 7% 2 | 6.7                               | 17.0                              | 24.2                              | 7.9                               | 12.0                              |\n| N                                                            | 95                                | 98                                | 97                                | 187                               | 187                               |\n| Body Weight (kg) 2"}, {"@id": "urn:kg:jardiance:chunk:973ee3af-69c5-45a3-9902-2dc7bbe93f08", "@type": "Chunk", "graphScope": "brand", "chunk_index": 132, "token_count": 149, "page_number": 21, "source_document_type": "product_information", "section_id": "fca286a4-fcdc-4f43-9c70-5e9274d3a3bf", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "157b37cba0c0393f74e2fcd56fef338352ebfd8b5badc36ed2e501712bac00a6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "973ee3af-69c5-45a3-9902-2dc7bbe93f08", "text": "97                                | 187                               | 187                               |\n| Body Weight (kg) 2                                           |                                   |                                   |                                   |                                   |                                   |\n| Baseline (mean)                                              | 86.00                             | 92.05                             | 88.06                             | 82.49                             | 83.22                             |"}, {"@id": "urn:kg:jardiance:chunk:4c086307-49cb-425c-ad3f-4e978ce1b1c5", "@type": "Chunk", "graphScope": "brand", "chunk_index": 133, "token_count": 300, "page_number": 22, "source_document_type": "product_information", "section_id": "e5a0b90c-1c48-41d2-8f8c-df74b53679d6", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "70e04eb7dc34f4eed16350744b733102454729ef7346d3fd657b93bf5864939d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "4c086307-49cb-425c-ad3f-4e978ce1b1c5", "text": "| Change from baseline 1             | -0.33        | -1.76                | -2.33                | -0.08        | -0.98                |\n|------------------------------------|--------------|----------------------|----------------------|--------------|----------------------|\n| Difference from placebo 1 (95% CI) |              | -1.43 (-2.09, -0.77) | -2.00 (-2.66, -1.34) |              | -0.91 (-1.41, -0.41) |\n| N                                  | 95           | 98                   | 97                   | 187          | 187                  |\n| SBP (mmHg) 2                       | SBP (mmHg) 2 | SBP (mmHg) 2         | SBP (mmHg) 2         | SBP (mmHg) 2 | SBP (mmHg) 2         |\n| Baseline (mean)                    | 134.69       | 137.37               | 133.68               | 136.38       | 136.64               |\n| Change from baseline 1             | 0.65         | -2.92                | -4.47                | 0.40         | -3.88                |\n| Difference from placebo 1 (95% CI) |              | -3.57 (-6.86, -0.29) | -5.12 (-8.41, -1.82) |              | -4.28 (-6.88, -1.68) |\n\na Full analysis set (FAS) using last observation carried forward (LOCF) prior to glycaemic resc"}, {"@id": "urn:kg:jardiance:chunk:b7f74653-6f96-4cd7-be1e-6c04872a050c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 134, "token_count": 80, "page_number": 22, "source_document_type": "product_information", "section_id": "e5a0b90c-1c48-41d2-8f8c-df74b53679d6", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "60535b350175464e2c325ba5febc81b57f304f158f32ef31518d8f0fcc819d8b", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "b7f74653-6f96-4cd7-be1e-6c04872a050c", "text": "-8.41, -1.82) |              | -4.28 (-6.88, -1.68) |\n\na Full analysis set (FAS) using last observation carried forward (LOCF) prior to glycaemic rescue therapy\n\n1 Mean adjusted for baseline value\n\n2 Not evaluated for statistical significance as a result of the sequential confirmatory testing procedure * p &lt; 0.0001"}, {"@id": "urn:kg:jardiance:chunk:0ca225b2-877c-4485-9896-8b0b7aea17d3", "@type": "Chunk", "graphScope": "brand", "chunk_index": 135, "token_count": 300, "page_number": 22, "source_document_type": "product_information", "section_id": "2b51311f-5ebb-4614-be8f-e6b93f38da71", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "d3ba91e0df8b565a4b378f02b64c9d680bda3ef50c76527484d427af42260e4e", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0ca225b2-877c-4485-9896-8b0b7aea17d3", "text": "The double-blind, placebo-controlled EMPA-REG OUTCOME study compared pooled doses of empagliflozin 10 mg and 25 mg with placebo as adjunct to standard care therapy in patients with type 2 diabetes and established cardiovascular disease. A total of 7 020 patients were treated (empagliflozin 10 mg: 2 345, empagliflozin 25 mg: 2 342, placebo: 2 333) and followed for a median of 3.1 years. The mean age was 63 years, the mean HbA1c was 8.1%, and 71.5% were male. At baseline, 74% of patients were being treated with metformin, 48% with insulin, and 43% with a sulphonylurea. About half of the patients (52.2%) had an eGFR of 60-90 mL/min/1.73 m 2 , 17.8% of 45-60 mL/min/1.73 m 2  and 7.7% of 30-45 mL/min/1.73 m 2 .\n\nAt week 12, an adjusted mean (SE) improvement in HbA1c when compared to baseline of 0.11% (0.02) in the placebo group, 0.65% (0.02) and 0.71% (0.02) in the empagliflozin 10 and 25 mg groups was observed. After the first 12 weeks glycaemic control was optimized independent of investigative treatment. Therefore the effect was attenuated at week 94, with an adjusted mean (SE) improvement in HbA1c of 0.08% (0.02) in the placebo group, 0.50% (0.02) and 0.55% (0.02) in the empaglifloz"}, {"@id": "urn:kg:jardiance:chunk:6ff6eaad-6860-48f1-b249-b966dbc390eb", "@type": "Chunk", "graphScope": "brand", "chunk_index": 136, "token_count": 300, "page_number": 22, "source_document_type": "product_information", "section_id": "2b51311f-5ebb-4614-be8f-e6b93f38da71", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "fd92d7475df65e0590a437fb6abc82fe2740c4bf353c2e1150dc69884ef79e3d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6ff6eaad-6860-48f1-b249-b966dbc390eb", "text": "ted at week 94, with an adjusted mean (SE) improvement in HbA1c of 0.08% (0.02) in the placebo group, 0.50% (0.02) and 0.55% (0.02) in the empagliflozin 10 and 25 mg groups.\n\nEmpagliflozin was superior in preventing the primary combined endpoint of cardiovascular death, non-fatal myocardial infarction, or non-fatal stroke, as compared with placebo. The treatment effect was driven by a significant reduction in cardiovascular death with no significant change in non-fatal myocardial infarction, or non-fatal stroke. The reduction of cardiovascular death was comparable for empagliflozin 10 mg and 25 mg (Figure 1) and confirmed by an improved overall survival (Table 10). The effect of empagliflozin on the primary combined endpoint of CV death, non-fatal MI, or non-fatal stroke was largely independent of glycaemic control or renal function (eGFR) and generally consistent across eGFR categories down to an eGFR of 30 mL/min/1.73 m 2  in the EMPA-REG OUTCOME study.\n\nThe efficacy for preventing cardiovascular mortality has not been conclusively established in patients using empagliflozin concomitantly with DPP-4 inhibitors or in Black patients because the representation of these groups in the"}, {"@id": "urn:kg:jardiance:chunk:1480ec50-e26b-4292-a9bc-784ba57d5ffd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 137, "token_count": 46, "page_number": 22, "source_document_type": "product_information", "section_id": "2b51311f-5ebb-4614-be8f-e6b93f38da71", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e5b491614e66e8f54f34890be16d1b8202401638bf3cf497f46fc379cc3c34ee", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "1480ec50-e26b-4292-a9bc-784ba57d5ffd", "text": "established in patients using empagliflozin concomitantly with DPP-4 inhibitors or in Black patients because the representation of these groups in the EMPA-REG OUTCOME study was limited."}, {"@id": "urn:kg:jardiance:chunk:bc1fb96c-da9b-4eaa-b65a-c00223d67e22", "@type": "Chunk", "graphScope": "brand", "chunk_index": 138, "token_count": 300, "page_number": 23, "source_document_type": "product_information", "section_id": "9447f588-b6bf-46de-a6a1-ed998dd71e44", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "7e7edb8408d7687f0c7654c29423afba85b7a7e77cbd080ff460be09f857040f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "bc1fb96c-da9b-4eaa-b65a-c00223d67e22", "text": "Table 10: Treatment effect for the primary composite endpoint, its components and mortality a\n\n|                                                                          | Placebo    | Empagliflozin b   |\n|--------------------------------------------------------------------------|------------|-------------------|\n| N                                                                        | 2 333      | 4 687             |\n| Time to first event of CV death, non-fatal MI, or non-fatal stroke N (%) | 282 (12.1) | 490 (10.5)        |\n| Hazard ratio vs. placebo (95.02% CI) *                                   |            | 0.86 (0.74, 0.99) |\n| p-value for superiority                                                  |            | 0.0382            |\n| CV Death N (%)                                                           | 137 (5.9)  | 172 (3.7)         |\n| Hazard ratio vs. placebo (95% CI)                                        |            | 0.62 (0.49, 0.77) |\n| p-value                                                                  |            | < 0.0001          |\n| Non-fatal MI N (%)                                                       | 121 (5.2)  | 213 (4.5)         |\n| Haz"}, {"@id": "urn:kg:jardiance:chunk:883f99f2-3093-4c14-8e0e-f338eed9ebde", "@type": "Chunk", "graphScope": "brand", "chunk_index": 139, "token_count": 292, "page_number": 23, "source_document_type": "product_information", "section_id": "9447f588-b6bf-46de-a6a1-ed998dd71e44", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "efada5d30f6bdccfab8c9bf2ba6f66495ccfca28fcd683c9cf5a2e2fce4c51ba", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "883f99f2-3093-4c14-8e0e-f338eed9ebde", "text": "|            | < 0.0001          |\n| Non-fatal MI N (%)                                                       | 121 (5.2)  | 213 (4.5)         |\n| Hazard ratio vs. placebo (95% CI)                                        |            | 0.87 (0.70, 1.09) |\n| p-value                                                                  |            | 0.2189            |\n| Non-fatal stroke N (%)                                                   | 60 (2.6)   | 150 (3.2)         |\n| Hazard ratio vs. placebo (95% CI)                                        |            | 1.24 (0.92, 1.67) |\n| p-value                                                                  |            | 0.1638            |\n| All-cause mortality N (%)                                                | 194 (8.3)  | 269 (5.7)         |\n| Hazard ratio vs. placebo (95% CI)                                        |            | 0.68 (0.57, 0.82) |\n| p-value                                                                  |            | < 0.0001          |\n| Non-CV mortality N (%)                                                   | 57 (2.4)   | 97 (2.1)          |\n| Hazard ratio vs. placebo (95% CI)"}, {"@id": "urn:kg:jardiance:chunk:71fb8641-f21e-4ab8-9381-2b4c3aeb47b4", "@type": "Chunk", "graphScope": "brand", "chunk_index": 140, "token_count": 211, "page_number": 23, "source_document_type": "product_information", "section_id": "9447f588-b6bf-46de-a6a1-ed998dd71e44", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f345afb7bb847d375c53aa002fba5822df17c27c9eb322f3098c8a8c6416a831", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "71fb8641-f21e-4ab8-9381-2b4c3aeb47b4", "text": "| 57 (2.4)   | 97 (2.1)          |\n| Hazard ratio vs. placebo (95% CI)                                        |            | 0.84 (0.60, 1.16) |\n\nCV = cardiovascular, MI = myocardial infarction\n\n- a Treated set (TS), i.e. patients who had received at least one dose of study drug\n\nb Pooled doses of empagliflozin 10 mg and 25 mg\n\n* Since data from the trial were included in an interim analysis, a two-sided 95.02% confidence interval applied which corresponds to a p-value of less than 0.0498 for significance.\n\nFigure 1 Time to occurrence of cardiovascular death in the EMPA-REG OUTCOME study\n\n<!-- image -->\n\nHeart failure requiring hospitalisation\n\nIn the EMPA-REG OUTCOME study, empagliflozin reduced the risk of heart failure requiring hospitalisation compared with placebo (empagliflozin 2.7%; placebo 4.1%; HR 0.65, 95% CI 0.50, 0.85)."}, {"@id": "urn:kg:jardiance:chunk:7e874daf-bf3e-4798-b29b-44400f68bf8f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 141, "token_count": 89, "page_number": 24, "source_document_type": "product_information", "section_id": "0045af39-13a4-4ff2-8ad9-9208cd3dadab", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "1f7e90acd06d74c4d66c59be32df9ff88efb37535fab967845f29dba3f69df1a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "7e874daf-bf3e-4798-b29b-44400f68bf8f", "text": "In the EMPA-REG OUTCOME study, for time to first nephropathy event, the HR was 0.61 (95% CI 0.53, 0.70) for empagliflozin (12.7%) vs placebo (18.8%).\n\nIn addition, empagliflozin showed a higher (HR 1.82, 95% CI 1.40, 2.37) occurrence of sustained normo- or micro-albuminuria (49.7%) in patients with baseline macro-albuminuria compared with placebo (28.8%)."}, {"@id": "urn:kg:jardiance:chunk:6244bb07-3a2b-4173-9fdf-e228f651bf4e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 142, "token_count": 108, "page_number": 24, "source_document_type": "product_information", "section_id": "e156c391-41bc-4900-8f1d-243f070d56e1", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e54c785e10b2ec617726bbd2f823bd5e051096bfc86ba71f376417b9066bb6ed", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6244bb07-3a2b-4173-9fdf-e228f651bf4e", "text": "In four placebo-controlled studies, treatment with empagliflozin as monotherapy or add-on therapy to metformin, pioglitazone, or metformin plus a sulphonylurea resulted in mean changes from baseline in FPG of -20.5 mg/dL [-1.14 mmol/L] for empagliflozin 10 mg and -23.2 mg/dL [-1.29 mmol/L] for empagliflozin 25 mg compared to placebo (7.4 mg/dL [0.41 mmol/L]). This effect was observed after 24 weeks and maintained for 76 weeks."}, {"@id": "urn:kg:jardiance:chunk:c896a199-33b9-4b42-a16c-2df45a3b98fd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 143, "token_count": 109, "page_number": 24, "source_document_type": "product_information", "section_id": "409f26f4-13b1-45dd-908b-57094b2443c9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "0cc3d031722679e66a35d9e757242b9646d900a0b4ea408f7aa85c54f809a958", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c896a199-33b9-4b42-a16c-2df45a3b98fd", "text": "Treatment with empagliflozin as add-on to metformin or metformin and a sulphonylurea resulted in a clinically meaningful reduction of 2-hour post-prandial glucose (meal tolerance test) at 24 weeks (add-on to metformin: placebo +5.9 mg/dL, empagliflozin 10 mg: -46.0 mg/dL, empagliflozin 25 mg: -44.6 mg/dL, add-on to metformin and a sulphonylurea: placebo -2.3 mg/dL, empagliflozin 10 mg: -35.7 mg/dL, empagliflozin 25 mg: -36.6 mg/dL)."}, {"@id": "urn:kg:jardiance:chunk:f78d6f66-9d43-4cdd-8eb5-67be58ba371a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 144, "token_count": 86, "page_number": 24, "source_document_type": "product_information", "section_id": "594ff179-5923-4282-bfa1-03521fe6ed6f", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "95e52085e1404417f61677cea9d95f0bd7d54f60be344687f8229ab91d90f35a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "f78d6f66-9d43-4cdd-8eb5-67be58ba371a", "text": "In a pre-specified pooled analysis of three phase 3 studies, treatment with open-label empagliflozin 25 mg in patients with severe hyperglycaemia (N = 184, mean baseline HbA1c 11.15%) resulted in a clinically meaningful reduction in HbA1c from baseline of 3.27% at week 24; no placebo or empagliflozin 10 mg arms were included in these studies."}, {"@id": "urn:kg:jardiance:chunk:be4d16e5-34f2-4f77-8e7e-8d7fd5f609ef", "@type": "Chunk", "graphScope": "brand", "chunk_index": 145, "token_count": 91, "page_number": 24, "source_document_type": "product_information", "section_id": "a66a82f3-6ad2-413e-9df1-e8dfbd101294", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "52b42a792646be75e0b0a5d2b069e21d25290886c7c737d2d529cfd354441d65", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "be4d16e5-34f2-4f77-8e7e-8d7fd5f609ef", "text": "In a pre-specified pooled analysis of 4 placebo-controlled studies, treatment with empagliflozin resulted in body weight reduction (-0.24 kg for placebo, -2.04 kg for empagliflozin 10 mg and -2.26 kg for empagliflozin 25 mg) at week 24 that was maintained up to week 52 (-0.16 kg for placebo, -1.96 kg for empagliflozin 10 mg and -2.25 kg for empagliflozin 25 mg)."}, {"@id": "urn:kg:jardiance:chunk:77e89a3e-0aa9-465d-b29b-4985d0bfd2d1", "@type": "Chunk", "graphScope": "brand", "chunk_index": 146, "token_count": 160, "page_number": 24, "source_document_type": "product_information", "section_id": "01b29649-6dff-4afd-a299-0101ba8c6032", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "04e86d1c12969563606fe6f6583cc2cb1c1ff711c04ff16be15cb903fb489006", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "77e89a3e-0aa9-465d-b29b-4985d0bfd2d1", "text": "The efficacy and safety of empagliflozin was evaluated in a double-blind, placebo-controlled study of 12 weeks duration in patients with type 2 diabetes and high blood pressure on different antidiabetic and up to 2 antihypertensive therapies. Treatment with empagliflozin once daily resulted in statistically significant improvement in HbA1c, and 24 hour mean systolic and diastolic blood pressure as determined by ambulatory blood pressure monitoring (Table 11). Treatment with empagliflozin provided reductions in seated SBP and DBP.\n\nTable 11: Efficacy results at 12 week in a placebo-controlled study of empagliflozin in patients with"}, {"@id": "urn:kg:jardiance:chunk:25bff48c-92b9-403a-913b-80c68f224d7b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 147, "token_count": 297, "page_number": 25, "source_document_type": "product_information", "section_id": "038c8e97-eb7b-4267-bf03-527255b43db7", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "dd62f7f8240f3a391c13aa5673ce843671c0f5bdd23eeb8311c3c42c27224236", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "25bff48c-92b9-403a-913b-80c68f224d7b", "text": "type 2 diabetes and uncontrolled blood pressure a\n\n|                                    |   Placebo | Jardiance              | Jardiance             |\n|------------------------------------|-----------|------------------------|-----------------------|\n|                                    |           | 10 mg                  | 25 mg                 |\n| N                                  |       271 | 276                    | 276                   |\n| HbA1c (%) at week 12 1             |           |                        |                       |\n| Baseline (mean)                    |      7.90 | 7.87                   | 7.92                  |\n| Change from baseline 2             |      0.03 | -0.59                  | -0.62                 |\n| Difference from placebo 2 (95% CI) |           | -0.62* (-0.72, -0.52)  | -0.65* (-0.75, -0.55) |\n| 24 hour SBP at week 12 3           |           |                        |                       |\n| Baseline (mean)                    |    131.72 | 131.34                 | 131.18                |\n| Change from baseline 4             |      0.48 | -2.95                  | -3.68                 |\n| Difference from placebo 4 (95% CI) |"}, {"@id": "urn:kg:jardiance:chunk:8615eb88-f313-420b-bc14-409b95679ab3", "@type": "Chunk", "graphScope": "brand", "chunk_index": 148, "token_count": 300, "page_number": 25, "source_document_type": "product_information", "section_id": "038c8e97-eb7b-4267-bf03-527255b43db7", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "abde0471ac0bf59a95e6628d6b01b03528d00a86a13d415b6fe71744eb8afa2c", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "8615eb88-f313-420b-bc14-409b95679ab3", "text": "| Change from baseline 4             |      0.48 | -2.95                  | -3.68                 |\n| Difference from placebo 4 (95% CI) |           | -3.44* (-4.78, -2.09)  | -4.16* (-5.50, -2.83) |\n| 24 hour DBP at week 12 3           |           |                        |                       |\n| Baseline (mean)                    |     75.16 | 75.13                  | 74.64                 |\n| Change from baseline 5             |      0.32 | -1.04                  | -1.40                 |\n| Difference from placebo 5 (95% CI) |           | -1.36** (-2.15, -0.56) | -1.72* (-2.51, -0.93) |\n\n- a Full analysis set (FAS)\n- 1 LOCF, values after taking antidiabetic rescue therapy censored\n- 2 Mean adjusted for baseline HbA1c, baseline eGFR, geographical region and number of antihypertensive medicinal products\n- 3 LOCF, values after taking antidiabetic rescue therapy or changing antihypertensive rescue therapy censored\n- 4 Mean adjusted for baseline SBP, baseline HbA1c, baseline eGFR, geographical region and number of antihypertensive medicinal products\n- 5 Mean adjusted for baseline DBP, baseline HbA1c, baseline eGFR, geographical region and number of antihypertensive medicinal prod"}, {"@id": "urn:kg:jardiance:chunk:86a75095-6ca9-4274-b1f1-e26facc4102c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 149, "token_count": 156, "page_number": 25, "source_document_type": "product_information", "section_id": "038c8e97-eb7b-4267-bf03-527255b43db7", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "578f3a8b2f7fcd69792a786dae09c3c7310f64dc3ac00a04926157417affa674", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "86a75095-6ca9-4274-b1f1-e26facc4102c", "text": "edicinal products\n- 5 Mean adjusted for baseline DBP, baseline HbA1c, baseline eGFR, geographical region and number of antihypertensive medicinal products\n* p-value &lt; 0.0001\n- ** p-value &lt; 0.001\n\nIn a pre-specified pooled analysis of 4 placebo-controlled studies, treatment with empagliflozin resulted in a reduction in systolic blood pressure (empagliflozin 10 mg: -3.9 mmHg; empagliflozin 25 mg: -4.3 mmHg) compared with placebo (-0.5 mmHg) and in diastolic blood pressure (empagliflozin 10 mg: -1.8 mmHg; empagliflozin 25 mg: -2.0 mmHg) compared with placebo (-0.5 mmHg) at week 24 that were maintained up to week 52."}, {"@id": "urn:kg:jardiance:chunk:3e61ff50-afbc-4d27-b545-17a7fa4faaaa", "@type": "Chunk", "graphScope": "brand", "chunk_index": 150, "token_count": 300, "page_number": 25, "source_document_type": "product_information", "section_id": "fd3c3f72-35c2-4409-a929-4f77110a3724", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e085d3b0ccc0d92dc9728672cc912fe38a2ea0aa9c8f4640098927a6a0816c09", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "3e61ff50-afbc-4d27-b545-17a7fa4faaaa", "text": "A randomised, double-blind, placebo-controlled study (EMPEROR-Reduced) was conducted in 3 730 patients with chronic heart failure (New York Heart Association [NYHA] II-IV) and reduced ejection fraction (LVEF ≤ 40%) to evaluate the efficacy and safety of empagliflozin 10 mg once daily as adjunct to standard of care heart failure therapy. The primary endpoint was the time to adjudicated first event of either cardiovascular (CV) death or hospitalisation for heart failure (HHF). Occurrence of adjudicated HHF (first and recurrent) and eGFR (CKD-EPI)cr slope of change from baseline were included in the confirmatory testing. Heart Failure therapy at baseline included ACE inhibitors/angiotensin receptor blockers/angiotensin receptor-neprilysin inhibitor (88.3%), beta blockers (94.7%), mineralocorticoid receptor antagonists (71.3%) and diuretics (95.0%).\n\nA total of 1 863 patients were randomised to empagliflozin 10 mg (placebo: 1 867) and followed for a median of 15.7 months. The study population consisted of 76.1% men and 23.9% women with a mean age of 66.8 years (range: 25-94 years), 26.8% were 75 years of age or older. 70.5% of the study population were White, 18.0% Asian and 6.9% Black"}, {"@id": "urn:kg:jardiance:chunk:fbcde982-77fc-496a-bce3-10cd4f94090f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 151, "token_count": 117, "page_number": 25, "source_document_type": "product_information", "section_id": "fd3c3f72-35c2-4409-a929-4f77110a3724", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "c0855d96c6bae6caaa5e03689ffc6ecd317b1c0ebf1f453cfa8e5db6225f34f6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "fbcde982-77fc-496a-bce3-10cd4f94090f", "text": "mean age of 66.8 years (range: 25-94 years), 26.8% were 75 years of age or older. 70.5% of the study population were White, 18.0% Asian and 6.9% Black/African American. At randomisation, 75.1% of patients were NYHA class II, 24.4% were class III and 0.5% were class IV. The mean LVEF was 27.5%. At baseline, the mean eGFR was 62.0 mL/min/1.73 m 2  and the median urinary albumin to creatinine ratio (UACR) was 22 mg/g. About half of the patients (51.7%) had an eGFR of"}, {"@id": "urn:kg:jardiance:chunk:dab13f70-7dc7-4668-82a9-66fdd36cf37f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 152, "token_count": 300, "page_number": 26, "source_document_type": "product_information", "section_id": "5596e8bd-5561-42aa-bbf4-cc29cd5eaa1e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "fcf7391133bd7dca46f559ea777a6c22857d189708641d96977a6fa3218a8497", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "dab13f70-7dc7-4668-82a9-66fdd36cf37f", "text": "≥ 60 mL/min/1.73 m 2 , 24.1% of 45 to &lt; 60 mL/min/1.73 m 2 , 18.6% of 30 to &lt; 45 mL/min/1.73 m 2 and 5.3% 20 to &lt; 30 mL/min/1.73 m 2 .\n\nEmpagliflozin was superior in reducing the risk of the primary composite endpoint of cardiovascular death or hospitalisation for heart failure compared with placebo. Additionally, empagliflozin significantly reduced the risk of occurrence of HHF (first and recurrent), and significantly reduced the rate of eGFR decline (Table 12; Figure 2).\n\nTable 12: Treatment effect for the primary composite endpoint, its components and the two key secondary endpoints included in the pre-specified confirmatory testing\n\n|                                                                   | Placebo    | Empagliflozin 10 mg   |\n|-------------------------------------------------------------------|------------|-----------------------|\n| N                                                                 | 1 867      | 1 863                 |\n| Time to first event of CV death or HHF, N (%)                     | 462 (24.7) | 361 (19.4)            |\n| Hazard ratio vs. placebo (95% CI)*                                |            | 0.75 (0.65, 0.86)     |\n| p-value f"}, {"@id": "urn:kg:jardiance:chunk:b34de909-e0e8-4ea6-9fb6-d78e23c51f0f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 153, "token_count": 300, "page_number": 26, "source_document_type": "product_information", "section_id": "5596e8bd-5561-42aa-bbf4-cc29cd5eaa1e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "d56c308386e6e550089356cf0bcbba71674eef08fec7f62f8163d582bae55448", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "b34de909-e0e8-4ea6-9fb6-d78e23c51f0f", "text": "24.7) | 361 (19.4)            |\n| Hazard ratio vs. placebo (95% CI)*                                |            | 0.75 (0.65, 0.86)     |\n| p-value for superiority                                           |            | < 0.0001              |\n| CV Death, N (%)                                                   | 202 (10.8) | 187 (10.0)            |\n| Hazard ratio vs. placebo (95% CI)                                 |            | 0.92 (0.75, 1.12)     |\n| HHF (first occurrence), N (%)                                     | 342 (18.3) | 246 (13.2)            |\n| Hazard ratio vs. placebo (95% CI)                                 |            | 0.69 (0.59, 0.81)     |\n| HHF (first and recurrent), N of events                            | 553        | 388                   |\n| Hazard ratio vs. placebo (95% CI)*                                |            | 0.70 (0.58, 0.85)     |\n| p-value                                                           |            | 0.0003                |\n| eGFR (CKD-EPI)cr slope**, Rate of decline (mL/min/1.73 m 2 /year) | -2.28      | -0.55                 |\n| Treatment difference vs. placebo (95% CI)                         |            | 1.73 (1.10, 2.3"}, {"@id": "urn:kg:jardiance:chunk:6ee88139-3446-412a-8809-a5aec5696d84", "@type": "Chunk", "graphScope": "brand", "chunk_index": 154, "token_count": 204, "page_number": 26, "source_document_type": "product_information", "section_id": "5596e8bd-5561-42aa-bbf4-cc29cd5eaa1e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "fb7ba681c33c5cfc4b71948d133e171b879f2e8407b62d37cf46497420c652db", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6ee88139-3446-412a-8809-a5aec5696d84", "text": "3 m 2 /year) | -2.28      | -0.55                 |\n| Treatment difference vs. placebo (95% CI)                         |            | 1.73 (1.10, 2.37)     |\n| p-value                                                           |            | < 0.0001              |\n\nCV = cardiovascular, HHF = hospitalisation for heart failure, eGFR = Estimated glomerular filtration rate, CKD-EPI = Chronic kidney disease epidemiology collaboration equation\n\n* CV death and HHF events were adjudicated by an independent clinical event committee and analysed based on the randomised set.\n\n** eGFR slope was analysed based on the treated set. Intercept is -0.95 mL/min/1.73 m 2 for placebo and -3.02 mL/min/1.73 m 2  for empagliflozin. The intercept represents the acute effect on eGFR while the slope represents the long-term effect."}, {"@id": "urn:kg:jardiance:chunk:12bf84fc-a155-42b7-a29e-5355dc704db2", "@type": "Chunk", "graphScope": "brand", "chunk_index": 155, "token_count": 94, "page_number": 27, "source_document_type": "product_information", "section_id": "a842bbf8-aab1-4fec-8005-85ba8328784b", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ad3faf8f12ebe2062565edede77db95b10a293dfda1b146a7063c4e24a15cda6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "12bf84fc-a155-42b7-a29e-5355dc704db2", "text": "Figure 2 Time to first event of adjudicated CV death or HHF\n\n<!-- image -->\n\nThe results of the primary composite endpoint were generally consistent with a hazard ratio (HR) below 1 across the pre-specified subgroups, including patients with heart failure, with or without type 2 diabetes mellitus and with or without renal impairment (down to an eGFR of 20 mL/min/1.73 m 2 )."}, {"@id": "urn:kg:jardiance:chunk:c5000385-1a95-4c1d-a3e9-cf5e5cf0366a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 156, "token_count": 300, "page_number": 27, "source_document_type": "product_information", "section_id": "14a08e82-3383-4747-a1ab-49c57e4f3ac9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "688705be0f9b2e0c13edbf2a294f8708fac21e5491caf924c08cacd59e80c078", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c5000385-1a95-4c1d-a3e9-cf5e5cf0366a", "text": "A randomised, double-blind, placebo-controlled study (EMPEROR-Preserved) was conducted in 5 988 patients with chronic heart failure (NYHA II-IV) and preserved ejection fraction (LVEF &gt; 40%) to evaluate the efficacy and safety of empagliflozin 10 mg once daily as adjunct to standard of care therapy. The primary endpoint was the time to adjudicated first event of either cardiovascular (CV) death or hospitalisation for heart failure (HHF). Occurrence of adjudicated HHF (first and recurrent), and eGFR (CKD-EPI)cr slope of change from baseline were included in the confirmatory testing. Baseline therapy included ACE inhibitors/angiotensin receptor blockers/angiotensin receptorneprilysin inhibitor (80.7%), beta blockers (86.3%), mineralocorticoid receptor antagonists (37.5%) and diuretics (86.2%).\n\nA total of 2 997 patients were randomised to empagliflozin 10 mg (placebo: 2 991) and followed for a median of 26.2 months. The study population consisted of 55.3% men and 44.7% women with a mean age of 71.9 years (range: 22-100 years), 43.0% were 75 years of age or older. 75.9% of the study population were White, 13.8% Asian and 4.3% Black/African American. At randomisation, 81.5% of patien"}, {"@id": "urn:kg:jardiance:chunk:dce926e7-729d-4432-914b-5bee2addc6ba", "@type": "Chunk", "graphScope": "brand", "chunk_index": 157, "token_count": 171, "page_number": 27, "source_document_type": "product_information", "section_id": "14a08e82-3383-4747-a1ab-49c57e4f3ac9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f44ba55a7c37cc2bfbd365cc04b7cfd9e53abbe1d7a8be29fa575ce09b887274", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "dce926e7-729d-4432-914b-5bee2addc6ba", "text": "ere 75 years of age or older. 75.9% of the study population were White, 13.8% Asian and 4.3% Black/African American. At randomisation, 81.5% of patients were NYHA class II, 18.1% were class III and 0.3% were class IV. The EMPERORPreserved study population included patients with a LVEF &lt; 50% (33.1%), with a LVEF 50 to &lt; 60% (34.4%) and a LVEF ≥ 60% (32.5%). At baseline, the mean eGFR was 60.6 mL/min/1.73 m 2  and the median urinary albumin to creatinine ratio (UACR) was 21 mg/g. About half of the patients (50.1%) had an eGFR of ≥ 60 mL/min/1.73 m 2 , 26.1% of 45 to &lt; 60 mL/min/1.73 m 2 , 18.6% of 30 to &lt; 45 mL/min/1.73 m 2  and 4.9% 20 to &lt; 30 mL/min/1.73 m 2 ."}, {"@id": "urn:kg:jardiance:chunk:a336fedf-22c1-4bc1-a094-aca2cf86074b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 158, "token_count": 292, "page_number": 28, "source_document_type": "product_information", "section_id": "f4bbab15-a987-4bad-9e73-71f07a5b4422", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "0f911fa598fd4b62e06fb3bb406a5f4c4a1f377dbff31b8e65d9c06b277c7939", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a336fedf-22c1-4bc1-a094-aca2cf86074b", "text": "Empagliflozin was superior in reducing the risk of the primary composite endpoint of cardiovascular death or hospitalisation for heart failure compared with placebo. Additionally, empagliflozin significantly reduced the risk of occurrence of HHF (first and recurrent), and significantly reduced the rate of eGFR decline (Table 13; Figure 3).\n\nTable 13: Treatment effect for the primary composite endpoint, its components and the two key secondary endpoints included in the pre-specified confirmatory testing\n\n|                                                                   | Placebo    | Empagliflozin 10 mg   |\n|-------------------------------------------------------------------|------------|-----------------------|\n| N                                                                 | 2 991      | 2 997                 |\n| Time to first event of CV death or HHF, N (%)                     | 511 (17.1) | 415 (13.8)            |\n| Hazard ratio vs. placebo (95% CI)*                                |            | 0.79 (0.69, 0.90)     |\n| p-value for superiority                                           |            | 0.0003                |\n| CV Death, N (%)"}, {"@id": "urn:kg:jardiance:chunk:f2f26a21-86c6-40cd-8252-473a86216b5a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 159, "token_count": 300, "page_number": 28, "source_document_type": "product_information", "section_id": "f4bbab15-a987-4bad-9e73-71f07a5b4422", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "58b5638e5ca77f7c1fd4b463a9df8b4f1b5b3aa5a48465e99a16d83841fe3f34", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "f2f26a21-86c6-40cd-8252-473a86216b5a", "text": "lue for superiority                                           |            | 0.0003                |\n| CV Death, N (%)                                                   | 244 (8.2)  | 219 (7.3)             |\n| Hazard ratio vs. placebo (95% CI)                                 |            | 0.91 (0.76, 1.09)     |\n| HHF (first occurrence), N (%)                                     | 352 (11.8) | 259 (8.6)             |\n| Hazard ratio vs. placebo (95% CI)                                 |            | 0.71 (0.60, 0.83)     |\n| HHF (first and recurrent), N of events                            | 541        | 407                   |\n| Hazard ratio vs. placebo (95% CI)*                                |            | 0.73 (0.61, 0.88)     |\n| p-value                                                           |            | 0.0009                |\n| eGFR (CKD-EPI)cr slope**, Rate of decline (mL/min/1.73 m 2 /year) | -2.62      | -1.25                 |\n| Treatment difference vs. placebo (95% CI)                         |            | 1.36 (1.06, 1.66)     |\n| p-value                                                           |            | < 0.0001              |\n\nCV = cardiovascular, HHF = h"}, {"@id": "urn:kg:jardiance:chunk:926a40a0-7904-44e5-92b2-5aedf9dbb8fa", "@type": "Chunk", "graphScope": "brand", "chunk_index": 160, "token_count": 168, "page_number": 28, "source_document_type": "product_information", "section_id": "f4bbab15-a987-4bad-9e73-71f07a5b4422", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "76023b673a8060090a6d20a7d1eed06e89d370de39c42b31edde9171db9ef691", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "926a40a0-7904-44e5-92b2-5aedf9dbb8fa", "text": ", 1.66)     |\n| p-value                                                           |            | < 0.0001              |\n\nCV = cardiovascular, HHF = hospitalisation for heart failure, eGFR = Estimated glomerular filtration rate, CKD-EPI = Chronic kidney disease epidemiology collaboration equation\n\n* CV death and HHF events were adjudicated by an independent clinical event committee and analysed based on the randomised set.\n\n** eGFR slope was analysed based on the treated set. Intercept is -0.18 mL/min/1.73 m 2 for placebo and -3.02 mL/min/1.73 m 2  for empagliflozin. The intercept represents the acute effect on eGFR while the slope represents the long-term effect."}, {"@id": "urn:kg:jardiance:chunk:6d232415-c23f-4f0c-a375-6fc103286ed4", "@type": "Chunk", "graphScope": "brand", "chunk_index": 161, "token_count": 71, "page_number": 29, "source_document_type": "product_information", "section_id": "1052c108-3e9a-40f5-b851-3fc110539961", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "b50177e6cc603f1abea5b89ed02aa782d722891f0161d99fb764496344602b50", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6d232415-c23f-4f0c-a375-6fc103286ed4", "text": "Figure 3 Time to first event of adjudicated CV death or HHF\n\n<!-- image -->\n\nThe results of the primary composite endpoint were consistent across each of the pre-specified subgroups categorized by e.g., LVEF, diabetes status or renal function (down to an eGFR of 20 mL/min/1.73 m 2 )."}, {"@id": "urn:kg:jardiance:chunk:31e46dcd-b169-4d2f-aa16-589b5e59713e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 162, "token_count": 300, "page_number": 29, "source_document_type": "product_information", "section_id": "a6e06da5-1e39-4448-9557-3f27b3083187", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "12ec8a35dd42ecf769b345463b1a90d3e415857738f52b06f1a4e450e273af5f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "31e46dcd-b169-4d2f-aa16-589b5e59713e", "text": "A randomised, double-blind, placebo-controlled study of empagliflozin 10 mg once daily (EMPA-KIDNEY) was conducted in 6 609 patients with chronic kidney disease (eGFR ≥ 20 - &lt; 45 mL/min/1.73 m 2 ; or eGFR ≥ 45 - &lt; 90 mL/min/1.73 m 2 with urinary albumin to creatinine ratio (UACR) ≥ 200 mg/g) to assess cardio-renal outcomes as adjunct to standard of care therapy. The primary endpoint was the time to first occurrence of kidney disease progression (sustained ≥ 40% eGFR decline from randomisation, sustained eGFR &lt; 10 mL/min/1.73 m 2 , end-stage kidney disease, or renal death) or CV death. First occurrence of hospitalisation for heart failure or CV death, all-cause hospitalisation (first and recurrent), and all-cause mortality were included in the confirmatory testing. Baseline therapy included an appropriate use of a RAS-inhibitor (85.2% ACE inhibitor or angiotensin receptor blocker).\n\nA total of 3 304 patients were randomised to empagliflozin 10 mg (placebo: 3 305) and followed for a median of 24.3 months. The study population consisted of 66.8% men and 33.2% women with a mean age of 63.3 years (range: 18-94 years), 23.0% were 75 years of age or older. 58.4% of the study popu"}, {"@id": "urn:kg:jardiance:chunk:04bfca88-87c5-4984-8c4c-ba65558400c9", "@type": "Chunk", "graphScope": "brand", "chunk_index": 163, "token_count": 204, "page_number": 29, "source_document_type": "product_information", "section_id": "a6e06da5-1e39-4448-9557-3f27b3083187", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "4c369850a36efda94b764413bb39221400d9dc1df5d5b5d5a668f096b3b8556f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "04bfca88-87c5-4984-8c4c-ba65558400c9", "text": "onsisted of 66.8% men and 33.2% women with a mean age of 63.3 years (range: 18-94 years), 23.0% were 75 years of age or older. 58.4% of the study population were White, 36.2% Asian and 4.0% Black/African American.\n\nAt baseline, the mean eGFR was 37.3 mL/min/1.73 m 2 , 21.2% patients had an eGFR of ≥ 45 mL/min/1.73 m 2 , 44.3% of 30 to &lt; 45 mL/min/1.73 m 2 and 34.5% &lt; 30 mL/min/1.73 m 2 including 254 patients with an eGFR &lt; 20 mL/min /1.73 m 2 . The median UACR was 329 mg/g, 20.1% patients had an UACR &lt; 30 mg/g, 28.2% had an UACR 30 to ≤ 300 mg/g and 51.7% had an UACR &gt; 300 mg/g; 41.1% of patients had an UACR &lt; 200 mg/g. Primary causes of CKD were diabetic nephropathy/diabetic kidney disease (31%), glomerular disease (25%), hypertensive/renovascular disease (22%) and other/unknown (22%)."}, {"@id": "urn:kg:jardiance:chunk:c70a493e-8b04-42db-b5d6-33eb9de0d8e9", "@type": "Chunk", "graphScope": "brand", "chunk_index": 164, "token_count": 300, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "d1bcf167274a89b3d84a3a7a482e78c38dc58681a39ff889d55db4837d3bd451", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c70a493e-8b04-42db-b5d6-33eb9de0d8e9", "text": "Empagliflozin was superior in reducing the risk of the primary composite endpoint of kidney disease progression or CV death compared with placebo (see Table 14). Additionally, empagliflozin significantly reduced the risk of all-cause hospitalisation (first and recurrent).\n\nTable 14: Treatment effect for the primary composite and key secondary endpoints included in the pre-specified confirmatory testing and its components\n\n|                                                                                                                                                                                                                     | Placebo    | Empagliflozin 10 mg   |\n|---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|------------|-----------------------|\n| N                                                                                                                                                                                                                   | 3 305      | 3 304                 |\n| Time to first"}, {"@id": "urn:kg:jardiance:chunk:11faff6d-fce5-4f14-944f-84ed6ff0ae65", "@type": "Chunk", "graphScope": "brand", "chunk_index": 165, "token_count": 272, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "7a5de79b49535cf0f82800f03d98d201aece0031bc7f93a3bbf4beaddcdcd5e1", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "11faff6d-fce5-4f14-944f-84ed6ff0ae65", "text": "| 3 305      | 3 304                 |\n| Time to first occurrence of kidney disease progression (sustained ≥ 40% eGFR decline from randomisation, sustained eGFR < 10 mL/min/1.73 m 2 , end-stage kidney disease* (ESKD), or renal death) or CV death, N (%) | 558 (16.9) | 432 (13.1)            |\n| Hazard ratio vs. placebo (99.83% CI)                                                                                                                                                                                |            | 0.72 (0.59, 0.89)     |\n| p-value for superiority                                                                                                                                                                                             |            | < 0.0001              |\n| Sustained ≥ 40% eGFR decline from randomisation, N (%)                                                                                                                                                              | 474 (14.3) | 359 (10.9)            |\n| Hazard ratio vs. placebo (95% CI)"}, {"@id": "urn:kg:jardiance:chunk:6fcfb0ea-7b5d-46d5-82f0-e6a70db524dd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 166, "token_count": 265, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "07f6a06310535d8cdfc8a2dadbf3bff48da54e6377ed4cf7f401c5b4ac26adbd", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6fcfb0ea-7b5d-46d5-82f0-e6a70db524dd", "text": "| 474 (14.3) | 359 (10.9)            |\n| Hazard ratio vs. placebo (95% CI)                                                                                                                                                                                   |            | 0.70 (0.61, 0.81)     |\n| p-value                                                                                                                                                                                                             |            | < 0.0001              |\n| ESKD* or sustained eGFR < 10 mL/min/1.73 m 2 , N (%)                                                                                                                                                                | 221 (6.7)  | 157 (4.8)             |\n| Hazard ratio vs. placebo (95% CI)                                                                                                                                                                                   |            | 0.69 (0.56, 0.84)     |\n| p-value"}, {"@id": "urn:kg:jardiance:chunk:beb3cec5-8edc-4053-b953-2454df9de0e1", "@type": "Chunk", "graphScope": "brand", "chunk_index": 167, "token_count": 267, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "50548e345d72f5f689f09b197274a2960ce6b607fa488a4105efcb9ab34dd931", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "beb3cec5-8edc-4053-b953-2454df9de0e1", "text": "|            | 0.69 (0.56, 0.84)     |\n| p-value                                                                                                                                                                                                             |            | 0.0003                |\n| Renal death, N (%)**                                                                                                                                                                                                | 4 (0.1)    | 4 (0.1)               |\n| Hazard ratio vs. placebo (95% CI)                                                                                                                                                                                   |            |                       |\n| p-value                                                                                                                                                                                                             |            |                       |\n| CV Death, N (%)"}, {"@id": "urn:kg:jardiance:chunk:a6ea1e1c-9427-412f-b93a-4c0c165b0a42", "@type": "Chunk", "graphScope": "brand", "chunk_index": 168, "token_count": 262, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "60dbdafeb84ad65dab18feef890f490e06d451c684ea1eac3bfd744612a70633", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a6ea1e1c-9427-412f-b93a-4c0c165b0a42", "text": "|\n| CV Death, N (%)                                                                                                                                                                                                     | 69 (2.1)   | 59 (1.8)              |\n| Hazard ratio vs. placebo (95% CI)                                                                                                                                                                                   |            | 0.84 (0.60, 1.19)     |\n| p-value                                                                                                                                                                                                             |            | 0.3366                |\n| ESKD or CV Death, N (%) #                                                                                                                                                                                           | 217 (6.6)  | 163 (4.9)             |\n| Hazard ratio vs. placebo (95% CI)"}, {"@id": "urn:kg:jardiance:chunk:84cf9872-ca9a-4419-a526-60c371aaa1e6", "@type": "Chunk", "graphScope": "brand", "chunk_index": 169, "token_count": 251, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "a9402c636e8d86eb2cbf0595ddf465874ed8f0508b33187ef8e9809abfc89d53", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "84cf9872-ca9a-4419-a526-60c371aaa1e6", "text": ". placebo (95% CI)                                                                                                                                                                                   |            | 0.73 (0.59, 0.89)     |\n| p-value                                                                                                                                                                                                             |            | 0.0023                |\n| Occurrence of all-cause hospitalisation (first and recurrent), N of events                                                                                                                                          | 1 895      | 1 611                 |\n| Hazard ratio vs. placebo (99.03% CI)                                                                                                                                                                                |            | 0.86 (0.75, 0.98)     |\n| p-value"}, {"@id": "urn:kg:jardiance:chunk:61882349-6903-4b26-9caf-f624c767c4ac", "@type": "Chunk", "graphScope": "brand", "chunk_index": 170, "token_count": 77, "page_number": 30, "source_document_type": "product_information", "section_id": "5b026f6a-6faf-4a6e-a57c-e7e1de9516bb", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e8c0b446cd740512a00bafad792f266131585c71790f8ce4c893d3fffaf35ecf", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "61882349-6903-4b26-9caf-f624c767c4ac", "text": "|            | 0.0025                |\n\nCV = cardiovascular, eGFR = Estimated glomerular filtration rate\n\n* End-stage kidney disease (ESKD) is defined as the initiation of maintenance dialysis or receipt of a kidney transplant.\n\n** There were too few events of renal death to compute a reliable hazard ratio."}, {"@id": "urn:kg:jardiance:chunk:89416347-23bb-40dc-bb80-05aa142c9079", "@type": "Chunk", "graphScope": "brand", "chunk_index": 171, "token_count": 277, "page_number": 31, "source_document_type": "product_information", "section_id": "6c75e440-edc0-4030-8c77-926c3974943c", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "dc519e3e6247496fa14991bbedec686fe1c6292815b772f516cafc0dbea7caca", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "89416347-23bb-40dc-bb80-05aa142c9079", "text": "Figure 4 Time to first event of kidney disease progression or adjudicated CV death, estimated cumulative incidence function\n\n<!-- image -->\n\nThe results of the primary composite endpoint were generally consistent across the pre-specified subgroups, including eGFR categories, underlying cause of renal disease, diabetes status, or background use of RAS inhibitors. Treatment benefits were more clearly evident in patients with higher levels of albuminuria.\n\nDuring treatment, eGFR decline over time was slower in the empagliflozin group compared to the placebo group (Figure 5). Empagliflozin slowed the annual rate of eGFR decline compared to placebo by 1.37 mL/min/1.73 m 2 /year (95% CI 1.16, 1.59), based on a pre-specified analysis of all eGFR measurements taken from the 2-month visit to the final follow-up visit. Patients treated with empagliflozin experienced an initial drop in eGFR which returned towards baseline after treatment discontinuation as demonstrated in several of the empagliflozin studies, supporting that haemodynamic changes play a role in the acute effects of empagliflozin on eGFR."}, {"@id": "urn:kg:jardiance:chunk:3387628e-6a54-4390-b0d0-acede25a6fbc", "@type": "Chunk", "graphScope": "brand", "chunk_index": 172, "token_count": 14, "page_number": 31, "source_document_type": "product_information", "section_id": "6c75e440-edc0-4030-8c77-926c3974943c", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "d83c4edf7b71e0959f52b6167b7685eb707ef99642d32447e3136bae7a6fb203", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "3387628e-6a54-4390-b0d0-acede25a6fbc", "text": "play a role in the acute effects of empagliflozin on eGFR."}, {"@id": "urn:kg:jardiance:chunk:952e634a-9e11-41f5-9edc-ea7864515b20", "@type": "Chunk", "graphScope": "brand", "chunk_index": 173, "token_count": 32, "page_number": 32, "source_document_type": "product_information", "section_id": "df1791bd-a257-424f-ab12-a795dc9583fd", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "2fbc3c13a2c044118c75c7886a53aca8dc633c0a5ad44b1122c05c41dd98de81", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "952e634a-9e11-41f5-9edc-ea7864515b20", "text": "Figure 5 Change in eGFR over time*\n\n<!-- image -->\n\n* eGFR (CKD-EPI) (mL/min/1.73 m 2 ) MMRM results over time - randomised set."}, {"@id": "urn:kg:jardiance:chunk:8519dcec-2200-4cac-85ef-abc1806fa153", "@type": "Chunk", "graphScope": "brand", "chunk_index": 174, "token_count": 220, "page_number": 32, "source_document_type": "product_information", "section_id": "33d04905-d86a-4892-9446-48a9ce2727d9", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ecfcd71c774faa629c6e220b7fa60d484c9764e5c4118732052586d123c78ffb", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "8519dcec-2200-4cac-85ef-abc1806fa153", "text": "The clinical efficacy and safety of empagliflozin (10 mg with a possible dose-increase to 25 mg) and linagliptin (5 mg) once daily has been studied in children and adolescents from 10 to 17 years of age with type 2 diabetes mellitus in a placebo-controlled study (DINAMO) over 26 weeks, with a safety extension period up to 52 weeks. Background therapies as adjunct to diet and exercise included metformin (51%), a combination of metformin and insulin (40.1%), insulin (3.2%), or none (5.7%).\n\nThe adjusted mean change in HbA1c at week 26 between empagliflozin (N = 52) and placebo (N = 53) of -0.84% was clinically meaningful and statistically significant (95% CI -1.50, -0.19; p = 0.0116). In addition, treatment with empagliflozin versus placebo resulted in a clinically meaningful adjusted mean change in FPG of -35.2 mg/dL (95% CI -58.6, -11.7) [-1.95 mmol/L (-3.25, -0.65)]."}, {"@id": "urn:kg:jardiance:chunk:2dba8a8b-2e01-4a51-90b3-a447400441f6", "@type": "Chunk", "graphScope": "brand", "chunk_index": 175, "token_count": 66, "page_number": 32, "source_document_type": "product_information", "section_id": "7076ad58-2837-4a04-94c0-4aea1af45b39", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "14b94de1a18f6040b8502c82e79de63f6d57438348af558d8d3530df7183c0c5", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "2dba8a8b-2e01-4a51-90b3-a447400441f6", "text": "The European Medicines Agency has waived the obligation to submit the results of studies with Jardiance in all subsets of the paediatric population in heart failure and in the treatment of chronic kidney disease (see section 4.2 for information on paediatric use)."}, {"@id": "urn:kg:jardiance:chunk:5caf3170-f604-4dd1-b4a6-5a3bb00e0bdd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 176, "token_count": 237, "page_number": 32, "source_document_type": "product_information", "section_id": "5f306100-2c2a-4587-a141-554baecb9ce0", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "beaab438dae9e019a2567d3f5b2134b3f4467037437fd3ae683f9f0e33f39d8a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "5caf3170-f604-4dd1-b4a6-5a3bb00e0bdd", "text": "The pharmacokinetics of empagliflozin have been extensively characterised in healthy volunteers and patients with type 2 diabetes. After oral administration, empagliflozin was rapidly absorbed with peak plasma concentrations occurring at a median tmax of 1.5 hours post-dose. Thereafter, plasma concentrations declined in a biphasic manner with a rapid distribution phase and a relatively slow terminal phase. The steady state mean plasma AUC and Cmax were 1 870 nmol.h/L and 259 nmol/L with empagliflozin 10 mg and 4 740 nmol.h/L and 687 nmol/L with empagliflozin 25 mg once daily. Systemic exposure of empagliflozin increased in a dose-proportional manner. The single-dose and steady-state pharmacokinetic parameters of empagliflozin were similar suggesting linear pharmacokinetics with respect to time. There were no clinically relevant differences in empagliflozin pharmacokinetics between healthy volunteers and patients with type 2 diabetes."}, {"@id": "urn:kg:jardiance:chunk:abd701c7-75c5-4e1e-9735-64cf31e8589f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 177, "token_count": 95, "page_number": 33, "source_document_type": "product_information", "section_id": "344919ba-3170-4589-9e36-c012741a96b6", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f9fb7b7785ab9576af6f6718e0409467cbc2a1572921beb116f0254f8916495a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "abd701c7-75c5-4e1e-9735-64cf31e8589f", "text": "Administration of empagliflozin 25 mg after intake of a high-fat and high calorie meal resulted in slightly lower exposure; AUC decreased by approximately 16% and Cmax by approximately 37% compared to fasted condition. The observed effect of food on empagliflozin pharmacokinetics was not considered clinically relevant and empagliflozin may be administered with or without food."}, {"@id": "urn:kg:jardiance:chunk:5dc70c67-bf4c-4418-9f1c-d09ec724b15b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 178, "token_count": 76, "page_number": 33, "source_document_type": "product_information", "section_id": "0d2c4d7e-14bb-4a9b-a6f9-24fff3ca5d93", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "35464632170c7407876de1fa0ea2b802962ef5b0e2b3e39d5916bc7a83a5f6da", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "5dc70c67-bf4c-4418-9f1c-d09ec724b15b", "text": "The apparent steady-state volume of distribution was estimated to be 73.8 L based on the population pharmacokinetic analysis. Following administration of an oral [ 14 C]-empagliflozin solution to healthy volunteers, the red blood cell partitioning was approximately 37% and plasma protein binding was 86%."}, {"@id": "urn:kg:jardiance:chunk:57195047-b3f4-4705-b16e-1053f164e8b3", "@type": "Chunk", "graphScope": "brand", "chunk_index": 179, "token_count": 113, "page_number": 33, "source_document_type": "product_information", "section_id": "4d6b965d-2d20-4616-b515-911260df62d2", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "6ea81d5b5df86d7bc82b74ac4ac29901d4e918531d507a4372a03dcfc94cbbe5", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "57195047-b3f4-4705-b16e-1053f164e8b3", "text": "No major metabolites of empagliflozin were detected in human plasma and the most abundant metabolites were three glucuronide conjugates (2-, 3-, and 6-O glucuronide). Systemic exposure of each metabolite was less than 10% of total drug-related material. In vitro studies suggested that the primary route of metabolism of empagliflozin in humans is glucuronidation by the uridine 5'-diphospho-glucuronosyltransferases UGT2B7, UGT1A3, UGT1A8, and UGT1A9."}, {"@id": "urn:kg:jardiance:chunk:ff9c140d-5db8-46f3-b1fc-24451922193b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 180, "token_count": 224, "page_number": 33, "source_document_type": "product_information", "section_id": "9eb34d0f-b023-4316-be32-42df8dc40b5f", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "7c251afa2c761db80fff6005e12399f0dcb5f52cae0b16222e39564edf9f69ee", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "ff9c140d-5db8-46f3-b1fc-24451922193b", "text": "Based on the population pharmacokinetic analysis, the apparent terminal elimination half-life of empagliflozin was estimated to be 12.4 hours and apparent oral clearance was 10.6 L/hour. The inter-subject and residual variabilities for empagliflozin oral clearance were 39.1% and 35.8%, respectively. With once-daily dosing, steady-state plasma concentrations of empagliflozin were reached by the fifth dose. Consistent with the half-life, up to 22% accumulation, with respect to plasma AUC, was observed at steady-state. Following administration of an oral [ 14 C]-empagliflozin solution to healthy volunteers, approximately 96% of the drug-related radioactivity was eliminated in faeces (41%) or urine (54%). The majority of drug-related radioactivity recovered in faeces was unchanged parent drug and approximately half of drug related radioactivity excreted in urine was unchanged parent drug."}, {"@id": "urn:kg:jardiance:chunk:c762dec4-d2a1-44b8-98c7-bfa572cf4b18", "@type": "Chunk", "graphScope": "brand", "chunk_index": 181, "token_count": 200, "page_number": 33, "source_document_type": "product_information", "section_id": "1b8612bc-0866-4f1a-8054-6d94463c8a84", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "dc4bd2cac16098853198bcd3321c39630135f1a0a397de34ea1e45d8fe9dc9ee", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c762dec4-d2a1-44b8-98c7-bfa572cf4b18", "text": "In patients with mild, moderate or severe renal impairment (eGFR &lt; 30 - &lt; 90 mL/min/1.73 m 2 ) and patients with kidney failure/end stage kidney disease (ESKD), AUC of empagliflozin increased by approximately 18%, 20%, 66%, and 48%, respectively compared to subjects with normal renal function. Peak plasma levels of empagliflozin were similar in subjects with moderate renal impairment and kidney failure/ESKD compared to patients with normal renal function. Peak plasma levels of empagliflozin were roughly 20% higher in subjects with mild and severe renal impairment as compared to subjects with normal renal function. The population pharmacokinetic analysis showed that the apparent oral clearance of empagliflozin decreased with a decrease in eGFR leading to an increase in drug exposure."}, {"@id": "urn:kg:jardiance:chunk:67183249-a0c1-403e-b9e9-67450d820b39", "@type": "Chunk", "graphScope": "brand", "chunk_index": 182, "token_count": 70, "page_number": 33, "source_document_type": "product_information", "section_id": "c772b334-5918-4ce4-89a8-51b6ced1f797", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "cc961237e94c4fddb1645df37babfa56b25fce7b107a7bf1f02b9eb0471d7c97", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "67183249-a0c1-403e-b9e9-67450d820b39", "text": "In subjects with mild, moderate, and severe hepatic impairment according to the Child-Pugh classification, AUC of empagliflozin increased approximately by 23%, 47%, and 75% and Cmax by approximately 4%, 23%, and 48%, respectively, compared to subjects with normal hepatic function."}, {"@id": "urn:kg:jardiance:chunk:ec4821af-ddc4-4d23-9d0b-8c4f5e698369", "@type": "Chunk", "graphScope": "brand", "chunk_index": 183, "token_count": 83, "page_number": 34, "source_document_type": "product_information", "section_id": "fdf226ea-da77-4451-a61f-45b6e311dc25", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "21214b6b18eca314ab35f08c0b7c395f83bea8fbf8f8f66f5ec8432f506af883", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "ec4821af-ddc4-4d23-9d0b-8c4f5e698369", "text": "Body mass index had no clinically relevant effect on the pharmacokinetics of empagliflozin based on the population pharmacokinetic analysis. In this analysis, AUC was estimated to be 5.82%, 10.4%, and 17.3% lower in subjects with BMI of 30, 35, and 45 kg/m 2 , respectively, compared to subjects with a body mass index of 25 kg/m 2 ."}, {"@id": "urn:kg:jardiance:chunk:0018ef97-4f55-4302-8864-131383bedd77", "@type": "Chunk", "graphScope": "brand", "chunk_index": 184, "token_count": 33, "page_number": 34, "source_document_type": "product_information", "section_id": "f2e7340b-a8cc-43a5-b161-0e7c341c8b6e", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ffc6eefbc140aa704e749a65f43bb90b790eef66ebdfc7ff2d5d1dc98e4c78ca", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0018ef97-4f55-4302-8864-131383bedd77", "text": "Gender had no clinically relevant effect on the pharmacokinetics of empagliflozin based on the population pharmacokinetic analysis."}, {"@id": "urn:kg:jardiance:chunk:ba7fb2a1-0aec-439d-9840-71a26dad9749", "@type": "Chunk", "graphScope": "brand", "chunk_index": 185, "token_count": 47, "page_number": 34, "source_document_type": "product_information", "section_id": "90a42cdd-893d-443e-9547-881257f5b79f", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "89c2293c0f08de44b7c8ffb31d424dc6b1bf9a7bb9140063e4cb2b663704e124", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "ba7fb2a1-0aec-439d-9840-71a26dad9749", "text": "In the population pharmacokinetic analysis, AUC was estimated to be 13.5% higher in Asians with a body mass index of 25 kg/m 2 compared to non-Asians with a body mass index of 25 kg/m 2 ."}, {"@id": "urn:kg:jardiance:chunk:97cc29d2-be61-4d5d-b724-5f212f6b5af4", "@type": "Chunk", "graphScope": "brand", "chunk_index": 186, "token_count": 34, "page_number": 34, "source_document_type": "product_information", "section_id": "a13d3b4a-4fa5-486f-92ca-8e399085cf68", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "6f6aab70952332939494034725f4188e05f56f82c1b093597c11a8a32193e368", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "97cc29d2-be61-4d5d-b724-5f212f6b5af4", "text": "Age did not have a clinically meaningful impact on the pharmacokinetics of empagliflozin based on the population pharmacokinetic analysis."}, {"@id": "urn:kg:jardiance:chunk:6125c4b8-97fc-469b-ba58-1a1bf20204ea", "@type": "Chunk", "graphScope": "brand", "chunk_index": 187, "token_count": 263, "page_number": 34, "source_document_type": "product_information", "section_id": "0f0b8632-a0e0-4155-8fb5-a4a673ecf461", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "10f537618c557bd38acc54eacf5f84d2bf76a17e3ed3db32388a53dabd5d9c0b", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "6125c4b8-97fc-469b-ba58-1a1bf20204ea", "text": "A paediatric phase 1 study examined the pharmacokinetics and pharmacodynamics of empagliflozin (5 mg, 10 mg and 25 mg) in children and adolescents ≥ 10 to &lt; 18 years of age with type 2 diabetes mellitus. The observed pharmacokinetic and pharmacodynamic responses were consistent with those found in adult subjects.\n\nA paediatric phase 3 study examined the pharmacokinetics and pharmacodynamics (HbA1c change from baseline) of empagliflozin 10 mg with a possible dose-increase to 25 mg in children and adolescents 10 to 17 years of age with type 2 diabetes mellitus. The observed exposure-response relationship was overall comparable in adults and children and adolescents. Oral administration of empagliflozin resulted in an exposure within the range observed in adult patients.\n\nThe observed geometric mean trough concentrations and geometric mean concentrations at 1.5 hours post-administration at steady state were 26.6 nmol/L and 308 nmol/L with empagliflozin 10 mg once daily and 67.0 nmol/L and 525 nmol/L with empagliflozin 25 mg once daily."}, {"@id": "urn:kg:jardiance:chunk:c7fc60e6-2c81-4de0-b334-b4725279cc3e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 188, "token_count": 1, "page_number": 34, "source_document_type": "product_information", "section_id": "0f0b8632-a0e0-4155-8fb5-a4a673ecf461", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "cdb4ee2aea69cc6a83331bbe96dc2caa9a299d21329efb0336fc02a82e1839a8", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c7fc60e6-2c81-4de0-b334-b4725279cc3e", "text": "."}, {"@id": "urn:kg:jardiance:chunk:7f629eb8-e6b9-44c8-ab20-9cb7dbb1abe7", "@type": "Chunk", "graphScope": "brand", "chunk_index": 189, "token_count": 272, "page_number": 34, "source_document_type": "product_information", "section_id": "332646fb-fcb9-4b51-aa89-d76cc7212326", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "557398f4586028f379ca245c2547b7cf3cac507646a58d4fbc705bf589c641e2", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "7f629eb8-e6b9-44c8-ab20-9cb7dbb1abe7", "text": "Non-clinical data reveal no special hazard for humans based on conventional studies of safety pharmacology, genotoxicity, fertility and early embryonic development.\n\nIn long term toxicity studies in rodents and dogs, signs of toxicity were observed at exposures greater than or equal to 10-times the clinical dose of empagliflozin. Most toxicity was consistent with secondary pharmacology related to urinary glucose loss and electrolyte imbalances including decreased body weight and body fat, increased food consumption, diarrhoea, dehydration, decreased serum glucose and increases in other serum parameters reflective of increased protein metabolism and gluconeogenesis, urinary changes such as polyuria and glucosuria, and microscopic changes including mineralisation in kidney and some soft and vascular tissues. Microscopic evidence of the effects of exaggerated pharmacology on the kidney observed in some species included tubular dilatation, and tubular and pelvic mineralisation at approximately 4-times the clinical AUC exposure of empagliflozin associated with the 25 mg dose."}, {"@id": "urn:kg:jardiance:chunk:0dc2c253-dc5a-43ee-9268-2f5e9a8639c0", "@type": "Chunk", "graphScope": "brand", "chunk_index": 190, "token_count": 9, "page_number": 34, "source_document_type": "product_information", "section_id": "332646fb-fcb9-4b51-aa89-d76cc7212326", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f3e7b5e1466cdc5051bef99db4bc1ef0b6f70ed9470789c951e5112879d4bc44", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0dc2c253-dc5a-43ee-9268-2f5e9a8639c0", "text": "lozin associated with the 25 mg dose."}, {"@id": "urn:kg:jardiance:chunk:73e774e8-0e80-4b17-bc7e-eb82139d3499", "@type": "Chunk", "graphScope": "brand", "chunk_index": 191, "token_count": 204, "page_number": 34, "source_document_type": "product_information", "section_id": "cf6523fe-9a37-47c4-9b17-abdfeceffc64", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "0af407da0028c484e24eea8ad8dc6ff5becf746a6f5cd39a23a6ed19706f4fba", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "73e774e8-0e80-4b17-bc7e-eb82139d3499", "text": "In a 2 year carcinogenicity study, empagliflozin did not increase the incidence of tumours in female rats up to the highest dose of 700 mg/kg/day, which corresponds to approximately 72-times the maximal clinical AUC exposure to empagliflozin. In male rats, treatment-related benign vascular proliferative lesions (haemangiomas) of the mesenteric lymph node were observed at the highest dose, but not at 300 mg/kg/day, which corresponds to approximately 26-times the maximal clinical exposure to empagliflozin. Interstitial cell tumours in the testes were observed with a higher incidence in rats at 300 mg/kg/day and above, but not at 100 mg/kg/day which corresponds to approximately 18-times the maximal clinical exposure to empagliflozin. Both tumours are common in rats and are unlikely to be relevant to humans."}, {"@id": "urn:kg:jardiance:chunk:a46084cd-8935-4276-9367-132baa7832e8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 192, "token_count": 300, "page_number": 35, "source_document_type": "product_information", "section_id": "727fec54-82a7-4856-b04e-248889343501", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "8c0ec4e5629bcf7a710bf275f8568be62d47c8819c2c184d0f3cd54a5b63df45", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a46084cd-8935-4276-9367-132baa7832e8", "text": "Empagliflozin did not increase the incidence of tumours in female mice at doses up to 1 000 mg/kg/day, which corresponds to approximately 62-times the maximal clinical exposure to empagliflozin. Empagliflozin induced renal tumours in male mice at 1 000 mg/kg/day, but not at 300 mg/kg/day, which corresponds to approximately 11-times the maximal clinical exposure to empagliflozin. The mode of action for these tumours is dependent on the natural predisposition of the male mouse to renal pathology and a metabolic pathway not reflective of humans. The male mouse renal tumours are considered not relevant to humans.\n\nAt exposures sufficiently in excess of exposure in humans after therapeutic doses, empagliflozin had no adverse effects on fertility or early embryonic development. Empagliflozin administered during the period of organogenesis was not teratogenic. Only at maternally toxic doses, empagliflozin also caused bent limb bones in the rat and increased embryofetal loss in the rabbit.\n\nIn pre- and postnatal toxicity studies in rats, reduced weight gain of offspring was observed at maternal exposures approximately 4-times the maximal clinical exposure to empagliflozin. No such effect w"}, {"@id": "urn:kg:jardiance:chunk:64051869-2f2a-4b0b-bb25-fd9fad4c00cc", "@type": "Chunk", "graphScope": "brand", "chunk_index": 193, "token_count": 164, "page_number": 35, "source_document_type": "product_information", "section_id": "727fec54-82a7-4856-b04e-248889343501", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "abd8e09e0174ade0481eacaec43cd4603ac3d096c6a639fa873bb209a48d29b1", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "64051869-2f2a-4b0b-bb25-fd9fad4c00cc", "text": "ced weight gain of offspring was observed at maternal exposures approximately 4-times the maximal clinical exposure to empagliflozin. No such effect was seen at systemic exposure equal to the maximal clinical exposure to empagliflozin. The relevance of this finding to humans is unclear.\n\nIn a juvenile toxicity study in the rat, when empagliflozin was administered from postnatal day 21 until postnatal day 90, non-adverse, minimal to mild renal tubular and pelvic dilation in juvenile rats was seen only at 100 mg/kg/day, which approximates 11-times the maximum clinical dose of 25 mg. These findings were absent after a 13 weeks drug-free recovery period."}, {"@id": "urn:kg:jardiance:chunk:87716563-e963-4a50-a5b0-8a5466ee9a93", "@type": "Chunk", "graphScope": "brand", "chunk_index": 194, "token_count": 34, "page_number": 35, "source_document_type": "product_information", "section_id": "960dacf9-11e2-42e9-b8da-6bded3aff8b3", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "0965a6e65df5fcba789838356d823297721243b35d99781d826cec22604257d6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "87716563-e963-4a50-a5b0-8a5466ee9a93", "text": "Lactose monohydrate Microcrystalline cellulose Hydroxypropylcellulose Croscarmellose sodium Colloidal anhydrous silica Magnesium stearate"}, {"@id": "urn:kg:jardiance:chunk:bc89faea-3e8e-4500-b974-4f2dbb7a2c0a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 195, "token_count": 20, "page_number": 35, "source_document_type": "product_information", "section_id": "8b03e7bc-1e5a-49b9-91dd-e3ad13298106", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "c0e7af27d8fb3a8e339532e09803537ab13e9d5d63e2846f3594bf373a138a7d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "bc89faea-3e8e-4500-b974-4f2dbb7a2c0a", "text": "Hypromellose Titanium dioxide (E171) Talc Macrogol (400) Iron oxide yellow (E172)"}, {"@id": "urn:kg:jardiance:chunk:8b9703f8-e32d-44aa-8745-e47be8c9fb83", "@type": "Chunk", "graphScope": "brand", "chunk_index": 196, "token_count": 4, "page_number": 35, "source_document_type": "product_information", "section_id": "5db547af-497a-4ca8-83c9-db0251a8f3b4", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "a3014a36534d5612e7e04f74fc455b30bd0101d370991d349923efd6cc69ebc0", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "8b9703f8-e32d-44aa-8745-e47be8c9fb83", "text": "Not applicable."}, {"@id": "urn:kg:jardiance:chunk:3e6ccde9-459d-4d26-a100-24ac686245dd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 197, "token_count": 2, "page_number": 35, "source_document_type": "product_information", "section_id": "9b676687-0471-41e1-9980-be9029901eca", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "50a85bc5620bccce3bd18d3de2fd413e4711b0afff5d687d2e6c677135d04b4d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "3e6ccde9-459d-4d26-a100-24ac686245dd", "text": "3 years"}, {"@id": "urn:kg:jardiance:chunk:0bf04555-5087-42bc-a141-eade3594bc5c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 198, "token_count": 18, "page_number": 36, "source_document_type": "product_information", "section_id": "e56f7b44-18b6-4db2-afa3-8b69ed0c09bf", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "9f755eb247c336e8c571938e604667ab7bb761bdccb796f91611c6d78a37c997", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "0bf04555-5087-42bc-a141-eade3594bc5c", "text": "This medicinal product does not require any special storage conditions."}, {"@id": "urn:kg:jardiance:chunk:b3a55e58-e601-479c-a2c3-b669f0afe163", "@type": "Chunk", "graphScope": "brand", "chunk_index": 199, "token_count": 48, "page_number": 36, "source_document_type": "product_information", "section_id": "50f76789-d8ca-45bd-b0c6-28c3f5c4ccf7", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "6a7f10f505f52994a1782620f0b773374fed10c1025473481c92f48577bd614a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "b3a55e58-e601-479c-a2c3-b669f0afe163", "text": "PVC/aluminium perforated unit dose blisters.\n\nPack sizes of 7 × 1, 10 × 1, 14 × 1, 28 × 1, 30 × 1, 60 × 1, 70 × 1, 90 × 1, and 100 × 1 film-coated tablets.\n\nNot all pack sizes may be marketed."}, {"@id": "urn:kg:jardiance:chunk:1b5eb77d-47dd-4877-8c6a-e1d5b02903b9", "@type": "Chunk", "graphScope": "brand", "chunk_index": 200, "token_count": 27, "page_number": 36, "source_document_type": "product_information", "section_id": "55880ba3-c4f4-41d4-8672-c6cb88ab9d74", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "a8e95ea83119aa7534f9512b807ac73ff0d80e238082752115f9404813fb62fa", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "1b5eb77d-47dd-4877-8c6a-e1d5b02903b9", "text": "Any unused medicinal product or waste material should be disposed of in accordance with local requirements."}, {"@id": "urn:kg:jardiance:chunk:a0a9530a-9a03-4a3b-b398-6273659db505", "@type": "Chunk", "graphScope": "brand", "chunk_index": 201, "token_count": 23, "page_number": 36, "source_document_type": "product_information", "section_id": "4f86b55b-2ca9-4d33-af19-6a90a14da291", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "b27e7b16c25cd6673a895fd833bbb7a42f5e25da4621931e1a02641c60bb89f4", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a0a9530a-9a03-4a3b-b398-6273659db505", "text": "Boehringer Ingelheim International GmbH\n\nBinger Str. 173\n\n55216 Ingelheim am Rhein\n\nGermany"}, {"@id": "urn:kg:jardiance:chunk:45f183df-5bc5-43e7-8071-f8a4980bc311", "@type": "Chunk", "graphScope": "brand", "chunk_index": 202, "token_count": 94, "page_number": 36, "source_document_type": "product_information", "section_id": "28e6eb28-3dff-4bf4-bd8b-fe2b5b7919c1", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "02edf1ae1d025016ad3fdfac5deffc24f4666a3cbab17feec5f024e15584f8d7", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "45f183df-5bc5-43e7-8071-f8a4980bc311", "text": "```\nJardiance 10 mg film-coated tablets EU/1/14/930/010 EU/1/14/930/011 EU/1/14/930/012 EU/1/14/930/013 EU/1/14/930/014 EU/1/14/930/015 EU/1/14/930/016 EU/1/14/930/017 EU/1/14/930/018 Jardiance 25 mg film-coated tablets EU/1/14/930/001 EU/1/14/930/002 EU/1/14/930/003 EU/1/14/930/004 EU/1/14/930/005 EU/1/14/930/006 EU/1/14/930/007 EU/1/14/930/008\n```\n\n```\nEU/1/14/930/009\n```"}, {"@id": "urn:kg:jardiance:chunk:26293c3d-324e-4e5f-97c6-bf4b07f92c0b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 203, "token_count": 20, "page_number": 36, "source_document_type": "product_information", "section_id": "3528d035-7364-4ce5-a488-073dbb07f761", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "44eb729ffc17f21a724816302a1588feebd67225c17fff7ccdc2f430f6592e9e", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "26293c3d-324e-4e5f-97c6-bf4b07f92c0b", "text": "Date of first authorisation: 22 May 2014\n\nDate of latest renewal: 14 February 2019"}, {"@id": "urn:kg:jardiance:chunk:e0b7fb5f-f170-442d-a6c6-e6ffdee1d6aa", "@type": "Chunk", "graphScope": "brand", "chunk_index": 204, "token_count": 34, "page_number": 37, "source_document_type": "product_information", "section_id": "286b0b7a-7cbb-45e1-ad81-7fdf3b0d133d", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "9f2a855337f11701b0cd4191c51820fa5a70b201b2e0721ba6acd34544486f89", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "e0b7fb5f-f170-442d-a6c6-e6ffdee1d6aa", "text": "Detailed information on this medicinal product is available on the website of the European Medicines Agency https://www.ema.europa.eu."}, {"@id": "urn:kg:jardiance:chunk:8d714fab-8fa4-49b8-a671-9df251cfdc54", "@type": "Chunk", "graphScope": "brand", "chunk_index": 205, "token_count": 69, "page_number": 38, "source_document_type": "product_information", "section_id": "df6f2142-9924-46df-a8bb-df3cd0c7fbe5", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "b699405b31d85f540ca7a50a2a17499c8505fa49fd75234253a52b0f17e56b35", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "8d714fab-8fa4-49b8-a671-9df251cfdc54", "text": "- A. MANUFACTURER(S) RESPONSIBLE FOR BATCH RELEASE\n- B. CONDITIONS OR RESTRICTIONS REGARDING SUPPLY AND USE\n- C. OTHER CONDITIONS AND REQUIREMENTS OF THE MARKETING AUTHORISATION\n- D. CONDITIONS OR RESTRICTIONS WITH REGARD TO THE SAFE AND EFFECTIVE USE OF THE MEDICINAL PRODUCT"}, {"@id": "urn:kg:jardiance:chunk:9ca69f65-b09e-4aa0-9bd2-fe0f7ed28356", "@type": "Chunk", "graphScope": "brand", "chunk_index": 206, "token_count": 145, "page_number": 39, "source_document_type": "product_information", "section_id": "62f8438b-fb5e-4e34-a3a1-868af82f3ee3", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "81e0e17b69953eadfddd7268723f9bf2a7a87c8d2136d3276c8c23d73571daf7", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "9ca69f65-b09e-4aa0-9bd2-fe0f7ed28356", "text": "Name and address of the manufacturer(s) responsible for batch release\n\nBoehringer Ingelheim Pharma GmbH &amp; Co. KG Binger Strasse 173 55216 Ingelheim am Rhein Germany\n\nBoehringer Ingelheim Hellas Single Member S.A. 5th km Paiania - Markopoulo Koropi Attiki, 19441 Greece\n\nRottendorf Pharma GmbH Ostenfelder Strasse 51 - 61 59320 Ennigerloh Germany\n\nBoehringer Ingelheim France 100-104 Avenue de France 75013 Paris France\n\nThe printed package leaflet of the medicinal product must state the name and address of the manufacturer responsible for the release of the concerned batch."}, {"@id": "urn:kg:jardiance:chunk:638ad741-7c23-4c5e-9415-d8216ce25271", "@type": "Chunk", "graphScope": "brand", "chunk_index": 207, "token_count": 12, "page_number": 39, "source_document_type": "product_information", "section_id": "4071f045-4c7a-413c-968e-1bde4c50132f", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "f59e60a405cd29d8de0d0cfa2c4fd5c87e80574c3dbf7354e143c03cfe8789e6", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "638ad741-7c23-4c5e-9415-d8216ce25271", "text": "Medicinal product subject to medical prescription."}, {"@id": "urn:kg:jardiance:chunk:cfcdd50f-26b5-4db2-b369-1b521f303dc2", "@type": "Chunk", "graphScope": "brand", "chunk_index": 208, "token_count": 66, "page_number": 39, "source_document_type": "product_information", "section_id": "1b15bb11-7d4a-4d1e-bf0c-f47122f8d18c", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "08f301f55c524686da1304f9c27acddff5a56c56ea073b7267b5230914db8f30", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "cfcdd50f-26b5-4db2-b369-1b521f303dc2", "text": "The requirements for submission of PSURs for this medicinal product are set out in the list of Union reference dates (EURD list) provided for under Article 107c(7) of Directive 2001/83/EC and any subsequent updates published on the European medicines web-portal."}, {"@id": "urn:kg:jardiance:chunk:60747fa9-d1bb-4b59-8012-bb8c1cf15b6c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 209, "token_count": 152, "page_number": 39, "source_document_type": "product_information", "section_id": "cec16136-80c6-4780-9f89-a543b73be927", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "093256ce2211ff2a81de63c76402c0fb58b31a2d63b8800758c78c58082b578a", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "60747fa9-d1bb-4b59-8012-bb8c1cf15b6c", "text": "The marketing authorisation holder (MAH) shall perform the required pharmacovigilance activities and interventions detailed in the agreed RMP presented in Module 1.8.2 of the marketing authorisation and any agreed subsequent updates of the RMP.\n\nAn updated RMP should be submitted:\n\n- At the request of the European Medicines Agency;\n- Whenever the risk management system is modified, especially as the result of new information being received that may lead to a significant change to the benefit/risk profile or as the result of an important (pharmacovigilance or risk minimisation) milestone being reached."}, {"@id": "urn:kg:jardiance:chunk:7577cf98-2cb5-4333-9b88-7de04e43dfd2", "@type": "Chunk", "graphScope": "brand", "chunk_index": 210, "token_count": 3, "page_number": 42, "source_document_type": "product_information", "section_id": "013ad048-3444-4d9d-9b37-692f2a52b6e4", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "3319901cb8d8b3b8eadf909dd8e615d9f0cd0cbb676f6cbad6551e3947fdab8f", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "7577cf98-2cb5-4333-9b88-7de04e43dfd2", "text": "OUTER CARTON"}, {"@id": "urn:kg:jardiance:chunk:8e356063-5671-43ae-9755-232701089844", "@type": "Chunk", "graphScope": "brand", "chunk_index": 211, "token_count": 12, "page_number": 42, "source_document_type": "product_information", "section_id": "31fb74e2-4aa0-45a1-8f0b-28a5426269c7", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "832cf1f78778c4aa8579d388ce5098be1633c61fd212a1d33f9a7b1ecaf71241", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "8e356063-5671-43ae-9755-232701089844", "text": "Jardiance 10 mg film-coated tablets empagliflozin"}, {"@id": "urn:kg:jardiance:chunk:51227b37-def9-417d-9309-3f9bc09fcb17", "@type": "Chunk", "graphScope": "brand", "chunk_index": 212, "token_count": 11, "page_number": 42, "source_document_type": "product_information", "section_id": "c02968b8-ae8f-43b2-b6b5-23a61ff220ee", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "97ad9c533f1d6f86c349f6da42943be712bf33e319bd21ffc715208f960c87e7", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "51227b37-def9-417d-9309-3f9bc09fcb17", "text": "Each tablet contains 10 mg of empagliflozin."}, {"@id": "urn:kg:jardiance:chunk:a9a09ef3-4f86-46b8-9a28-ddc63e544475", "@type": "Chunk", "graphScope": "brand", "chunk_index": 213, "token_count": 14, "page_number": 42, "source_document_type": "product_information", "section_id": "aeb9cd16-33e4-4535-8437-8dacf916936f", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "e4b884c554ec1c7b57eb7d15204de2bd89864d49e59e422bbc3603099193eb1b", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "a9a09ef3-4f86-46b8-9a28-ddc63e544475", "text": "Contains lactose, see leaflet for further information."}, {"@id": "urn:kg:jardiance:chunk:066515df-05f4-4814-9a18-1bd7f91bdf86", "@type": "Chunk", "graphScope": "brand", "chunk_index": 214, "token_count": 65, "page_number": 42, "source_document_type": "product_information", "section_id": "f66fc56f-c895-4894-ad43-9e2c616f78ba", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "ef3352a0fafd78d0fff594f1a848f0d215e90aae640bdaeab2fa5e41af631ff8", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "066515df-05f4-4814-9a18-1bd7f91bdf86", "text": "- 7 × 1 film-coated tablets\n- 10 × 1 film-coated tablets\n- 14 × 1 film-coated tablets\n- 28 × 1 film-coated tablets\n- 30 × 1 film-coated tablets\n- 60 × 1 film-coated tablets\n- 70 × 1 film-coated tablets\n- 90 × 1 film-coated tablets\n- 100 × 1 film-coated tablets"}, {"@id": "urn:kg:jardiance:chunk:c6eef1dc-ddfc-4cbf-8419-6df7c9d41ef3", "@type": "Chunk", "graphScope": "brand", "chunk_index": 215, "token_count": 12, "page_number": 42, "source_document_type": "product_information", "section_id": "3e28ef44-851e-449b-b32d-dda7ba354384", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "8f62900682624caa5583eb1e914966ee7e236a84040d86cc28da8e03b89abd6d", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "c6eef1dc-ddfc-4cbf-8419-6df7c9d41ef3", "text": "Read the package leaflet before use.\n\nOral use"}, {"@id": "urn:kg:jardiance:chunk:4f8767a2-0f83-451e-a61b-20a9cd68b60c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 216, "token_count": 11, "page_number": 42, "source_document_type": "product_information", "section_id": "4683ac0e-319d-4251-983e-d5c27d68670d", "extraction_method": "docling", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_hash": "77d4932f12dcf39f8aadf34b35b6d27ac2c4d8ef32c24993dd4f241b38acbbee", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "chunk_id": "4f8767a2-0f83-451e-a61b-20a9cd68b60c", "text": "Keep out of the sight and reach of children."}, {"@id": "urn:kg:jardiance:chunk:039cda06-8526-4222-ac17-ec9af4fb16e6", "@type": "Chunk"