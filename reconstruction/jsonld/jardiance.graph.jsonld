": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:50"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:51", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Disease education / Unmet need", "claim_text": "EMPA-REG OUTCOME® trial: Early and sustained reductions in the risk of CV death5", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 51, "indication": "Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:51"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:52", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Disease education / Unmet need", "claim_text": "EMPA-REG OUTCOME® trial: Early and sustained reductions in the risk of CV death5 Reducing the risk of CV death can help your patients get more time with their loved ones5", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 52, "indication": "Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:52"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:53", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Disease education / Unmet need", "claim_text": "The 14% RRR in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p<0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77); there was no change in risk of nonfatal MI (HR=0.87; 95% CI: 0.70, 1.09) or nonfatal stroke (HR=1.24; 95% CI: 0.92, 1.67).1", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 53, "indication": "Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:53"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:54", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Disease education / Unmet need", "claim_text": "JARDIANCE is a guideline-recommended option that can help your patients by reducing their risk of CV death", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 54, "indication": "Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:54"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:55", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Disease education / Unmet need", "claim_text": "Contraindications and precautions \n• JARDIANCE should not be used for the treatment of patients with: \n– Type 1 diabetes \n– Severe hepatic impairment \n– Hypersensitivity to the active substance or to any of the excipients \n• In patients 75 years and older, an increased risk of volume depletion should be taken into account \n• Due to limited experience, it is not recommended to initiate treatment with empagliflozin in patients with an eGFR <20 mL/min/1.73 m2", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 55, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:55"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812