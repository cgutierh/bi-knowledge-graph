OCUMENT": [{"@id": "urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0"}]}, {"@id": "urn:kg:jardiance:safety:a464c0ff-2705-44be-9999-d15c29867182", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "a464c0ff-2705-44be-9999-d15c29867182", "statement_text": "The glucose lowering efficacy of JARDIANCE 25 mg decreased with decreasing level of renal function in the mild to moderate range. Least square mean HbA1c changes at 24 weeks were -0.6%, -0.5%, and -0.2% for those with a baseline eGFR of 60 to less than 90 mL/min/1.73 m 2 , 45 to ", "source_file_name": "Jardiance_PI.pdf", "source_document_id": "b2560bb2-851a-4e06-8246-07641712e8b0", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:jardiance:section:a464c0ff-2705-44be-9999-d15c29867182"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0"}]}, {"@id": "urn:kg:jardiance:safety:60a8f800-fc0a-48cf-9014-998161e169e6", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "60a8f800-fc0a-48cf-9014-998161e169e6", "statement_text": "14.3  Cardiovascular Outcomes in Adults with Type 2 Diabetes Mellitus and Atherosclerotic Cardiovascular Disease", "source_file_name": "Jardiance_PI.pdf", "source_document_id": "b2560bb2-851a-4e06-8246-07641712e8b0", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:jardiance:section:60a8f800-fc0a-48cf-9014-998161e169e6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0"}]}, {"@id": "urn:kg:jardiance:safety:aa122e32-acb0-4ed0-b8cb-402045f53ab7", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "aa122e32-acb0-4ed0-b8cb-402045f53ab7", "statement_text": "The primary endpoint in EMPA-REG OUTCOME was the time to first occurrence of a Major Adverse Cardiac Event