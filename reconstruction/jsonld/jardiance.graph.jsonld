rule:1453f2d8-d14c-41ba-9e4b-d2a5b281d7c7"}, {"@id": "urn:kg:jardiance:visualrule:b587c40e-9d06-46de-8c12-7cea918f32b4"}, {"@id": "urn:kg:jardiance:visualrule:8023779f-8c01-494d-86f7-4e699c6624ba"}, {"@id": "urn:kg:jardiance:visualrule:1a8c94ee-4dbc-4206-b52c-1c56e1d47347"}, {"@id": "urn:kg:jardiance:visualrule:54a88882-5bcc-4f06-808f-78cfebd0e570"}, {"@id": "urn:kg:jardiance:visualrule:4ddfa53e-30c6-4dfb-bb8b-d93a074d7849"}, {"@id": "urn:kg:jardiance:visualrule:269c534f-0432-42a5-98d3-8caf6b4d5358"}, {"@id": "urn:kg:jardiance:visualrule:5d13561c-2d12-4435-9bed-db3cf30b527f"}, {"@id": "urn:kg:jardiance:visualrule:28d9ff37-be73-4be8-aa07-7e5e0a8ca384"}, {"@id": "urn:kg:jardiance:visualrule:7753009f-ae98-4138-bbb0-d3cf83be2922"}, {"@id": "urn:kg:jardiance:visualrule:e75ada45-b98d-4c54-80a1-d4ca8b14c3bd"}, {"@id": "urn:kg:jardiance:visualrule:10d11004-9825-4c40-9ec3-755411d9a6fe"}, {"@id": "urn:kg:jardiance:visualrule:a4873424-0538-43c6-b404-d4168dcd8de5"}, {"@id": "urn:kg:jardiance:visualrule:23e5eccf-cb06-4ddf-8121-23a39c30be3d"}, {"@id": "urn:kg:jardiance:visualrule:66ad13f4-f620-4999-8bdd-31026196938b"}, {"@id": "urn:kg:jardiance:visualrule:2398bee7-e1c2-4077-9d41-be35bd678f41"}, {"@id": "urn:kg:jardiance:visualrule:0374e466-7e86-4b2c-8961-83cf257fbf37"}, {"@id": "urn:kg:jardiance:visualrule:6d3bb492-5b07-4826-b05f-8c84ee9c8716"}], "BRAND_TARGETS_MARKET": [{"@id": "urn:kg:enterprise:market:usa"}]}, {"@id": "urn:kg:jardiance:cardiovascularoutcome:5a32b221-9744-49f6-b5d1-701d7ca083e9", "@type": "CardiovascularOutcome", "graphScope": "brand", "source_page": 34, "source_document_type": "prescribing_information", "section_id": "5a32b221-9744-49f6-b5d1-701d7ca083e9", "outcome_text": "EMPEROR-Reduced (NCT03057977) was a double-blind trial conducted in adults with chronic heart failure (New York Heart Association [NYHA] functional class II-IV) with left ventricular ejection fraction (LVEF) ≤ 40% to evaluate the efficacy of JARDIANCE as adjunct to standard of care heart failure therapy.", "source_file_name": "Jardiance_PI.pdf", "source_document_id": "b2560bb2-851a-4e06-8246-07641712e8b0", "OUTCOME_FROM_TRIAL": [{"@id": "urn:kg:jardiance:clinicaltrial:jardiance:nct03057977"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:jardiance:section:5a32b221-9744-49f6-b5d1-701d7ca083e9"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0"}]}, {"@id": "urn:kg:jardiance:chunk:41453899-4ef0-4e77-aa51-48932c0e4699", "@type": "Chunk", "graphScope": "brand", "chunk_index": 0, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "3e66223d6e6e92734bae8ee7e3aee3b1917ae084ecd2a79ba0f3d83be99ae4cf", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "41453899-4ef0-4e77-aa51-48932c0e4699", "text": "# Sheet\nResource: Sunil | Name: CL-CRP-000958 | Match Text: In patients with CKD, JARDIANCE reduced the relative risk of CV death or kidney disease progression by 28% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPA-KIDNEY trial, a randomised, parallel-group, double-blind, placebo-controlled study of 6609 patients with CKD, the efficacy and safety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305). Patients were adults with an eGFR ≥ 20, < 45 mL/min/1.73 m2 ; or an eGFR ≥ 45, < 90 mL/min/1.73 m2 with a uACR ≥ 200 mg/g. The primary endpoint in the EMPA-KIDNEY trial was a composite of CV death or progression of kidney disease defined as end-stage kidney disease (the initiation of maintenance dialysis or receipt of a kidney transplant), a sustained decrease in the eGFR to <10 ml/min/1.73 m2, a sustained decrease in eGFR of ≥40% from baseline, or death from renal causes. Patients treated with JARDIANCE experienced a 28% RRR in this endpoint (HR=0.72; 95% CI: 0.64, 0.82; p<0.001).  CI=confidence interval; CKD=chronic kidney disease; eGFR=estimated glomeru"}, {"@id": "urn:kg:jardiance:chunk:6ee6e917-b1c3-407e-af51-68ce41fc626d", "@type": "Chunk", "graphScope": "brand", "chunk_index": 1, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "1cf2acba078c149bced44537a38b2c58ed6218dac3061ad8cd66315b2de4ce41", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "6ee6e917-b1c3-407e-af51-68ce41fc626d", "text": "rienced a 28% RRR in this endpoint (HR=0.72; 95% CI: 0.64, 0.82; p<0.001).  CI=confidence interval; CKD=chronic kidney disease; eGFR=estimated glomerular filtration;  HR=hazard ratio; RRR=relative risk reduction; T2D=type 2 diabetes; uACR=urinary albumin-to-creatinine ratio. | Reference: Herrington 2022 NEJM, Nov 4, 2022 | AMA Style Guide References: Herrington 2022 N Engl J Med, Nov 4, 2022. | Content Modules & Rule Sets: CPNT-CRP-100323 JARDIANCE (v3.0)\nResource: Sunil | Name: CL-CRP-000960 | Match Text: In patients with HF with LVEF >40%, JARDIANCE reduced the relative risk of CV death or HHF by 21% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or H"}, {"@id": "urn:kg:jardiance:chunk:f08f19c3-b908-4ef4-8357-4deaf5354f0e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 2, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "1875e7d53327806ee0b1b362953be779c68c047eb35d6a6738cdaa0875f213f0", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "f08f19c3-b908-4ef4-8357-4deaf5354f0e", "text": "ass II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  CI=confidence interval; CV=cardiovascular;  HFpEF=heart failure with preserved ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction. | Reference: RD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: CPNT-CRP-100331 JARDIANCE (v1.0)\nResource: Sunil | Name: CL-CRP-000964 | Match Text: In patients with CKD, JARDIANCE reduced the relative risk of first and recurrent all-cause hospitalisation by 14% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPA-KIDNEY trial, a randomised,"}, {"@id": "urn:kg:jardiance:chunk:886a0961-33b5-46f4-98ff-b0d2ac4d8a08", "@type": "Chunk", "graphScope": "brand", "chunk_index": 3, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "d4ec14c4fd78cdac41442fa91e89d4645b6d4121f08f0ca05b513c735a5f25e7", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "886a0961-33b5-46f4-98ff-b0d2ac4d8a08", "text": "| Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPA-KIDNEY trial, a randomised, parallel-group, double-blind, placebo-controlled study of 6609 patients with CKD, the efficacy and safety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305). Patients were adults with an eGFR ≥ 20, < 45 mL/min/1.73 m2 ; or an eGFR ≥ 45, < 90 mL/min/1.73 m2 with a uACR ≥ 200 mg/g. The primary endpoint in the EMPA-KIDNEY trial was a composite of CV death or progression of kidney disease defined as end-stage kidney disease (the initiation of maintenance dialysis or receipt of a kidney transplant), a sustained decrease in the eGFR to <10 ml/min/1.73 m2, a sustained decrease in eGFR of ≥40% from baseline, or death from renal causes. Patients treated with JARDIANCE experienced a 28% RRR in this endpoint (HR=0.72; 95% CI: 0.64, 0.82; p<0.001).  Hospitalisation for any cause was a key secondary outcome of the EMPA-KIDNEY trial. The analysis of hospitalisations for any cause included the first and all subsequent events (JARDIANCE, 1611 hospitalisations in 960 patients; placebo, 1895 hospitalisations in 1035 patients).  CI=confidenc"}, {"@id": "urn:kg:jardiance:chunk:6f2a8de0-27b4-4e84-a657-9967de936faf", "@type": "Chunk", "graphScope": "brand", "chunk_index": 4, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "3007974ef162e4fa4d610d0a185985a43cc8a97aef843e8ac992bda22576cfae", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "6f2a8de0-27b4-4e84-a657-9967de936faf", "text": "the first and all subsequent events (JARDIANCE, 1611 hospitalisations in 960 patients; placebo, 1895 hospitalisations in 1035 patients).  CI=confidence interval; CKD=chronic kidney disease; eGFR=estimated glomerular filtration;  HR=hazard ratio; RRR=relative risk reduction; uACR=urinary albumin-to-creatinine ratio. | Reference: Herrington 2022 NEJM, Nov 4, 2022 | AMA Style Guide References: Herrington 2022 N Engl J Med, Nov 4, 2022. | Content Modules & Rule Sets: \nCPNT-CRP-100326 JARDIANCE (v1.0)\nResource: Sunil | Name: CL-CRP-000966 | Match Text: In patients with LVEF ≤ 40%, JARDIANCE slowed the decline of renal function by 4 times | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a c"}, {"@id": "urn:kg:jardiance:chunk:7f455654-f146-48dc-a7c0-2c2dc37f1555", "@type": "Chunk", "graphScope": "brand", "chunk_index": 5, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "d3d8931b305e834b70b871b22b28a7b543efe328cc9a01e7dc75d89b8aacea32", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "7f455654-f146-48dc-a7c0-2c2dc37f1555", "text": "hronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).   The rate of decline in eGFR was a prespecified secondary outcome of the EMPEROR-Reduced trial.  CI=confidence interval; CV=cardiovascular; eGFR=estimated glomerular filtration rate; HFrEF=heart failure with reduced ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction | Reference: RD-157832 JARDIANCE M. Packer, S.D. Anker, J. Butler; Cardiovascular and Renal Outcomes with Empagli | AMA Style Guide References: Packer M, Anker SD, Butler J. Cardiovascular and Renal Outcomes with Empagli. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-000968 | Match Text: In patients with LVEF > 40%, JARDIANCE slowed the decline of renal function by 2 times | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism |"}, {"@id": "urn:kg:jardiance:chunk:dc07cf3d-c4f4-437b-b07f-632df4a83708", "@type": "Chunk", "graphScope": "brand", "chunk_index": 6, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "2557be4f31022f1dd99126c508108f46551e31cf9b9bc0049a8749b7a8b37800", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "dc07cf3d-c4f4-437b-b07f-632df4a83708", "text": "F > 40%, JARDIANCE slowed the decline of renal function by 2 times | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  The rate of decline in eGFR was a prespecified secondary outcome of the EMPEROR-Preserved trial.  CI=confidence interval; CV=cardiovascular; eGFR=estimated glomerular filtration rate; HFpEF=heart failure with preserved ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk red"}, {"@id": "urn:kg:jardiance:chunk:c71169ce-12c8-4a91-ab53-3cb781229c95", "@type": "Chunk", "graphScope": "brand", "chunk_index": 7, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "785c3cfcdc179aa0188e5fcc1b265ef0781fb90bbbf7e4f283be415b4cd76079", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "c71169ce-12c8-4a91-ab53-3cb781229c95", "text": "F=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction | Reference: RD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-000969 | Match Text: In patients with T2D and CVD, JARDIANCE reduced the relative risk of CV death by 38% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: The primary composite outcome in the EMPA-REG OUTCOME trial was 3-point MACE, composed of death from CV causes, nonfatal MI, or nonfatal stroke, as analyzed in the pooled JARDIANCE group vs the placebo group. Patients were adults with insufficiently controlled T2D and CAD, PAD, or a history of MI or stroke. The 14% RRR in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p<0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77) and"}, {"@id": "urn:kg:jardiance:chunk:74edee3a-cbfc-4c6e-be9b-dc47a6025cbd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 8, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "34e15dbdc1e1ce5bf427a537d79829739c465c7ca2eb3bd2daef5b4cff522964", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "74edee3a-cbfc-4c6e-be9b-dc47a6025cbd", "text": ": 0.74, 0.99; p<0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77) and 38% RRR in CV death was achieved in the overall EMPA-REG OUTCOME population for the duration of the trial.  Pooled data from 10-mg and 25-mg doses of JARDIANCE; both doses showed a comparable reduction in the risk of CV death.  In addition to reducing the risk of CV death when added to the standard of care, JARDIANCE also lowered HbA1c. In addition, JARDIANCE demonstrated reduction in weight and blood pressure. JARDIANCE is not indicated for weight loss or reduction of blood pressure.  CAD=coronary artery disease; CI=confidence interval; CV=cardiovascular; eCVD=established cardiovascular disease; HbA1c=haemoglobin A1c; HR=hazard ratio; MACE=major adverse cardiovascular events; MI=myocardial infarction; PAD=peripheral artery disease; RRR=relative risk reduction; SGLT2i=sodium-glucose cotransporter-2 inhibitor; T2D=type 2 diabetes. | Reference: \nRD-103048 Zinman B, Wanner C, Lachin JM, et al. New Eng J Med. 2016;373:2117-28. | AMA Style Guide References: Zinman B, Wanner C, Lachin JM, et al. N Engl J Med. 2016;373:2117-28. | Content Mod"}, {"@id": "urn:kg:jardiance:chunk:ca68fb46-b0ea-4474-a9ea-bbb2971ed77d", "@type": "Chunk", "graphScope": "brand", "chunk_index": 9, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "02e65aab374e490e6fc9a2688beddbea580c79a3bd84fc12d5cf3c094e704765", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "ca68fb46-b0ea-4474-a9ea-bbb2971ed77d", "text": "al. New Eng J Med. 2016;373:2117-28. | AMA Style Guide References: Zinman B, Wanner C, Lachin JM, et al. N Engl J Med. 2016;373:2117-28. | Content Modules & Rule Sets: \nCPNT-CRP-100327 JARDIANCE (v2.0)\nResource: Sunil | Name: CL-CRP-000959 | Match Text: In patients with HF with LVEF ≤40%, JARDIANCE reduced the relative risk of CV death or HHF by 25% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).  CI=confidence interval; CV=cardiovascular;  HFrEF=heart failure with reduced ejection fraction; HHF=hospitaliza"}, {"@id": "urn:kg:jardiance:chunk:a546cdc5-d830-4aca-9d19-a5f01cdbafff", "@type": "Chunk", "graphScope": "brand", "chunk_index": 10, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "7ff311ba4cdd9a08318013175aa45f8b823f4eb19c4d02e4f75ccd0929c57c93", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "a546cdc5-d830-4aca-9d19-a5f01cdbafff", "text": "R=0.75; 95% CI: 0.65, 0.86; p<0.001).  CI=confidence interval; CV=cardiovascular;  HFrEF=heart failure with reduced ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction | Reference: RD-157832 JARDIANCE M. Packer, S.D. Anker, J. Butler; Cardiovascular and Renal Outcomes with Empagli | AMA Style Guide References: Packer M, Anker SD, Butler J. Cardiovascular and Renal Outcomes with Empagli. | Content Modules & Rule Sets: CPNT-CRP-100329 JARDIANCE (v1.0)\nResource: Sunil | Name: CL-CRP-000965 | Match Text: In patients with LVEF ≤ 40%, JARDIANCE reduced the relative risk of first and recurrent HHF by 30% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced"}, {"@id": "urn:kg:jardiance:chunk:7b3a9568-442e-4f17-b3e2-24e10d4148fa", "@type": "Chunk", "graphScope": "brand", "chunk_index": 11, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "669c0b83ec4e6ab1954d931addf2b644450c71397dc9c5e3685b2dea90338d42", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "7b3a9568-442e-4f17-b3e2-24e10d4148fa", "text": "of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).   The occurrence of all HHF, including first and recurrent events, was a prespecified secondary outcome of the EMPEROR-Reduced trial.  In addition to the RRR of all HHF, including first and recurrent events, the risk of total hospitalisations for any reason was also significantly reduced (HR=0.85, 95% CI: 0.75, 0.95).  CI=confidence interval; CV=cardiovascular;  HFrEF=heart failure with reduced ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction | Reference: RD-157832 JARDIANCE M. Packer, S.D. Anker, J. Butler; Cardiovascular and Renal Outcomes with Empagli | AMA Style Guide References: Packer M, Anker SD, Butler J. Cardiovascular and Renal Outcomes"}, {"@id": "urn:kg:jardiance:chunk:e928522c-1e5c-40b3-9f7b-92d8b0055e35", "@type": "Chunk", "graphScope": "brand", "chunk_index": 12, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "4bf8db013a3eb6a7c0949c50cf3bf0bd9707269be5eb053487a283b30d308119", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "e928522c-1e5c-40b3-9f7b-92d8b0055e35", "text": ". Butler; Cardiovascular and Renal Outcomes with Empagli | AMA Style Guide References: Packer M, Anker SD, Butler J. Cardiovascular and Renal Outcomes with Empagli. | Content Modules & Rule Sets: CPNT-CRP-100330 JARDIANCE (v2.0)\nResource: Sunil | Name: CL-CRP-000967 | Match Text: In patients with LVEF > 40%, JARDIANCE reduced the relative risk of first and recurrent HHF by 27% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  The occurrence of all HHF, including first and recurrent events, was a prespe"}, {"@id": "urn:kg:jardiance:chunk:c142ad76-561a-4142-8233-f1dade68c09e", "@type": "Chunk", "graphScope": "brand", "chunk_index": 13, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "0d3bbe16955d190030f1f098be259c7374a1fc144af70ad56e8c56e704151422", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "c142ad76-561a-4142-8233-f1dade68c09e", "text": "nced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  The occurrence of all HHF, including first and recurrent events, was a prespecified secondary outcome of the EMPEROR-Preserved trial.  CI=confidence interval; CV=cardiovascular;  HFpEF=heart failure with preserved ejection fraction; HHF=hospitalization for heart failure; HR=hazard ratio; LVEF=left ventricular ejection fraction;  NYHA=New York Heart Association; RRR=relative risk reduction | Reference: RD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: CPNT-CRP-100332 JARDIANCE (v1.0)\nResource: Sunil | Name: CL-CRP-000971 | Match Text: The interconnected nature of cardio, renal and metabolic diseases ampliﬁes and accelerates risk. | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Reference: 2020 - Cardiorenal Syndrome in Type 2 Diabetes Mellitus - Rational Use f Sodium-glucose Cotransporte | AMA Style Guide References: Cardiorenal Syndrome i"}, {"@id": "urn:kg:jardiance:chunk:baa021f1-0f9b-42ad-97f5-c6047b1bef76", "@type": "Chunk", "graphScope": "brand", "chunk_index": 14, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "121f66848bd309f7605d941967bc56abb58a75b3cfc218ed3f82154725edd5a6", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "baa021f1-0f9b-42ad-97f5-c6047b1bef76", "text": "0 - Cardiorenal Syndrome in Type 2 Diabetes Mellitus - Rational Use f Sodium-glucose Cotransporte | AMA Style Guide References: Cardiorenal Syndrome in Type 2 Diabetes Mellitus - Rational Use f Sodium-glucose Cotransporte. 2020. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-000973 | Match Text: JARDIANCE has a proven safety and tolerability profile across multiple trials. | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Safety | Footnotes: Please see the SmPC for the full list of AEs and full list of special warnings and precautions for use, as well as dosing details.  AE=adverse event; SmPC=Summary of Product Characteristics | Reference: Jardiance - EU/SmPC  | AMA Style Guide References: - EU/SmPC. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-000978 | Match Text: Adopting guideline-recommended treatments improves patient outcomes. | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Guidelines | Reference: 2023 - Contemporary Use of Sodium-Glucose Cotransporter-2 Inhibitor"}, {"@id": "urn:kg:jardiance:chunk:2003ac13-a2e7-4eda-a71c-9f877409e8db", "@type": "Chunk", "graphScope": "brand", "chunk_index": 15, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "e5e917a356505dce5f92b012e106db392df1d13cc15b62dd709f13639a452b9e", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "2003ac13-a2e7-4eda-a71c-9f877409e8db", "text": "m | Lifecycle State: Approved for Use | Key Message Type: Guidelines | Reference: 2023 - Contemporary Use of Sodium-Glucose Cotransporter-2 Inhibitor Therapy Among Patients Hospitali  | AMA Style Guide References: Contemporary Use of Sodium-Glucose Cotransporter-2 Inhibitor Therapy Among Patients Hospitali. 2023. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-000979 | Match Text: Despite their proven potential, evidence-based recommendations are often underutilized | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Guidelines | Reference: 2023 - Contemporary Use of Sodium-Glucose Cotransporter-2 Inhibitor Therapy Among Patients Hospitali \n\n2019 - Reasons for Lack of Improvement in Treatment With Evidence-Based Therapies in Heart Failure | AMA Style Guide References: Contemporary Use of Sodium-Glucose Cotransporter-2 Inhibitor Therapy Among Patients Hospitali. 2023.\n\nReasons for Lack of Improvement in Treatment With Evidence-Based Therapies in Heart Failure. 2019. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001161 | Match Text: In patients with HF, JARDIANCE d"}, {"@id": "urn:kg:jardiance:chunk:a51da393-be00-494d-80ea-d00d0e15dd28", "@type": "Chunk", "graphScope": "brand", "chunk_index": 16, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "09ad0f17b46d650fea183affc736f7f802fe504ffea944b1598016f6d4a50cc6", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "a51da393-be00-494d-80ea-d00d0e15dd28", "text": "erapies in Heart Failure. 2019. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001161 | Match Text: In patients with HF, JARDIANCE delivered consistent efficacy regardless of T2D or CKD status | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).   Results of prespecified subgroup analyses in the EMPEROR-Reduced trial. Diabetes at baseline (HR=0.72; 95% CI: 0.60, 0.87); no diabetes at baseline (HR=0.78; 95% CI: 0.64, 0.97). eGFR (CKD-EPI) ≥ 60 mL/min/1.73 m2 at baseline (HR=0.67; 95% CI: 0.55, 0"}, {"@id": "urn:kg:jardiance:chunk:0141e280-d1a9-4e56-8b36-fcea76bbd7c8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 17, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "dcf808d18abe316ab39cd594c4c458db7e0bdd950bcac0732aac0cb927b29958", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "0141e280-d1a9-4e56-8b36-fcea76bbd7c8", "text": "; 95% CI: 0.60, 0.87); no diabetes at baseline (HR=0.78; 95% CI: 0.64, 0.97). eGFR (CKD-EPI) ≥ 60 mL/min/1.73 m2 at baseline (HR=0.67; 95% CI: 0.55, 0.83); eGFR (CKD-EPI) < 60 mL/min/1.73 m2 at baseline (HR=0.83; 95% CI: 0.69, 1.00).  In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  Results of prespecified subgroup analyses in the EMPEROR-Preserved trial. Diabetes at baseline (HR=0.79; 95% CI: 0.67, 0.94); no diabetes at baseline (HR=0.78; 95% CI: 0.64, 0.95). eGFR (CKD-EPI) ≥ 60 mL/min/1.73 m2 at baseline (HR=0.81; 95% CI: 0.65, 1.00); eGFR (CKD-EPI) < 60 mL/min/1.73 m2 at baseline (HR=0.78; 95% CI: 0.66, 0.91).  CI=confidence interval;  CV=cardiovascular;"}, {"@id": "urn:kg:jardiance:chunk:f909461b-b21c-4b51-8eea-101be1645da1", "@type": "Chunk", "graphScope": "brand", "chunk_index": 18, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "02bbd39bdd4244cc381776b602e193cd32dbc1b2f94943db83d443f6f3da319a", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "f909461b-b21c-4b51-8eea-101be1645da1", "text": "=0.81; 95% CI: 0.65, 1.00); eGFR (CKD-EPI) < 60 mL/min/1.73 m2 at baseline (HR=0.78; 95% CI: 0.66, 0.91).  CI=confidence interval;  CV=cardiovascular; eGFR=estimated glomerular filtration;  HFpEF=heart failure with preserved ejection fraction; HFrEF=heart failure with reduced ejection fraction; HHF=hospitalisation for heart failure;  HR=hazard ratio; LVEF=left ventricular ejection fraction; NYHA=New York Heart Association; RRR=relative risk reduction; T2D=type 2 diabetes.. | Reference: RD-142505 JARDIANCE Packer 2020_Cardiovascular and renal outcomes \n\nRD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Packer 2020 Cardiovascular and renal outcomes.\n\nAnker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001157 | Match Text: JARDIANCE protected patients with HF by reducing the risk of CV death or HHF | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group,"}, {"@id": "urn:kg:jardiance:chunk:4485cb6c-c8c2-430c-83f8-da19d886c04c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 19, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "2d835e3e5e0ba18db537871295f2a4137971e7dee624dbc4a4106119683a9e68", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "4485cb6c-c8c2-430c-83f8-da19d886c04c", "text": "Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).  In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR"}, {"@id": "urn:kg:jardiance:chunk:8c42b5bd-a0ea-4c31-9f30-6851ea500e6b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 20, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "e9284c72b94a08fab4614ba8220e55cbe9823ebbc2be85ff4e162c31536729ba", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "8c42b5bd-a0ea-4c31-9f30-6851ea500e6b", "text": "al was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  CI=confidence interval;  CV=cardiovascular; HF=heart failure; HHFpEF=heart failure with preserved ejection fraction; HFrEF=heart failure with reduced ejection fraction; HHF=hospitalisation for heart failure;  HR=hazard ratio; LVEF=left ventricular ejection fraction; NYHA=New York Heart Association; RRR=relative risk reduction. | Reference: RD-142505 JARDIANCE Packer 2020_Cardiovascular and renal outcomes\n\nRD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Packer 2020 Cardiovascular and renal outcomes.\n\nAnker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001158 | Match Text: In patients with HF, JARDIANCE protected the kidneys by slowing the decline of renal function | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Redu"}, {"@id": "urn:kg:jardiance:chunk:56459f4a-2e7c-4b08-986a-fa73a32e6a78", "@type": "Chunk", "graphScope": "brand", "chunk_index": 21, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "bd0099fd6b348eaa27878836e135bdeb8183f164255f6faff42ec549a85d30d9", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "56459f4a-2e7c-4b08-986a-fa73a32e6a78", "text": "te | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety profile of JARDIANCE 10 mg (n=1863) was evaluated vs placebo (n=1867). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤ 40%). The primary endpoint in the EMPEROR-Reduced trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p<0.001).  In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety profile of JARDIANCE 10 mg (n=2997) was evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF > 40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated wi"}, {"@id": "urn:kg:jardiance:chunk:cd5c4baa-dfc7-4499-9b26-f85dbe150a96", "@type": "Chunk", "graphScope": "brand", "chunk_index": 22, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "5edd78cb1258acf11645ae6e67a72d3a51bcd80bb61a3b601a56a4089ad7cde8", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "cd5c4baa-dfc7-4499-9b26-f85dbe150a96", "text": "40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p<0.001).  The rate of decline in eGFR was a prespecified secondary outcome of the EMPEROR-Preserved and EMPEROR-Reduced trials.  CI=confidence interval;  CV=cardiovascular; eGFR=estimated glomerular filtration; HF=heart failure; HFpEF=heart failure with preserved ejection fraction; HFrEF=heart failure with reduced ejection fraction; HHF=hospitalisation for heart failure;  HR=hazard ratio; LVEF=left ventricular ejection fraction; NYHA=New York Heart Association; RRR=relative risk reduction. | Reference: RD-142505 JARDIANCE Packer 2020_Cardiovascular and renal outcomes\n\nRD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Packer 2020 Cardiovascular and renal outcomes.\n\nAnker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001160 | Match Text: JARDIANCE demonstrated early benefits when initiated in the h"}, {"@id": "urn:kg:jardiance:chunk:6539bdc5-2e86-4ced-a771-32d0013c8e4c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 23, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "f2b25e612ecd5c7ebcf240815b097421467e75fa44dc6fe56c70e4dde6fbda4a", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "6539bdc5-2e86-4ced-a771-32d0013c8e4c", "text": "1. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001160 | Match Text: JARDIANCE demonstrated early benefits when initiated in the hospital | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Safety | Footnotes: In the EMPULSE trial, a randomised, double-blind, placebo-controlled study of 530 patients with chronic heart failure regardless of LVEF, the efficacy and safety of JARDIANCE 10 mg (n=265) were evaluated in the hospital setting vs placebo (n=265). The primary endpoint in the EMPULSE trial was clinical benefit, defined as a hierarchical composite of death from any cause, number of heart failure events and time to first heart failure event, or a 5-point or greater difference in change from baseline in the KCCQ-TSS at 90 days, as assessed using a win ratio. Patients treated with JARDIANCE were 36% more likely to experience clinical benefit compared with placebo (win ratio=1.36; 95% CI: 1.09, 1.68; p=0.0054).  In the EMPULSE trial, the initiation of empagliflozin for acute HF produced clinical benefit regardless of the degree of symptomatic impairment at baseline and improved"}, {"@id": "urn:kg:jardiance:chunk:4ae35387-09d6-483d-937a-3fe9ecaddf5c", "@type": "Chunk", "graphScope": "brand", "chunk_index": 24, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "a09503a35b91f97b0b913b525cb255837aeca588b2ef94c0e8ac523555e040c5", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "4ae35387-09d6-483d-937a-3fe9ecaddf5c", "text": "l, the initiation of empagliflozin for acute HF produced clinical benefit regardless of the degree of symptomatic impairment at baseline and improved symptoms, physical limitations, and quality of life, with benefits seen as early as 15 days and maintained through 90 days.  CI=confidence interval; KCCQ-TSS=Kansas City Cardiomyopathy Questionnaire Total Symptom Score; LVEF=left ventricular ejection fraction; NYHA=New York Heart Association. | Reference: \nRD-157613 JARDIANCE Voors Nature Medicines\n\n\n25. Kosiborod MN. Circulation. 2022;146(4):279-288.\n | AMA Style Guide References: Voors Nat Med.\n\nKosiborod MN. Circulation. 2022;146(4):279-288. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001172 | Match Text: In patients with T2D and eCVD, JARDIANCE reduced the relative risk of incident or worsening nephropathy by 39% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPA-REG OUTCOME trial, a randomised, double-blind, placebo-controlled study of 7720 patients with T2D at high cardiovascular risk, the efficacy and safety of JARDIANCE 10 mg or 25 mg (n="}, {"@id": "urn:kg:jardiance:chunk:5d28ea1a-778b-4a87-8f18-025b7d3ef96d", "@type": "Chunk", "graphScope": "brand", "chunk_index": 25, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "f05bfc0130fb295cc630c3b4576cb4a9b52616c7185e6b577f85643a06d8f560", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "5d28ea1a-778b-4a87-8f18-025b7d3ef96d", "text": "double-blind, placebo-controlled study of 7720 patients with T2D at high cardiovascular risk, the efficacy and safety of JARDIANCE 10 mg or 25 mg (n=4867) were evaluated vs placebo (n=2333). Patients were adults with insufficiently controlled T2D and CAD, PAD, or a history of MI or stroke. The primary composite outcome in the EMPA-REG OUTCOME trial was 3-point MACE, composed of death from CV causes, nonfatal MI, or nonfatal stroke, as analysed in the pooled JARDIANCE group vs the placebo group. The result was 14% RRR (1.6% ARR) in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p<0.001 for noninferiority; p=0.04 for superiority).   Incident or worsening nephropathy is defined as progression to macroalbuminuria, doubling of serum creatinine, eGFR of ≤ 45 mL/min/1.73 m2; initiation of renal replacement therapy; death from renal disease. Incident or worsening nephropathy was a prespecified component of the secondary microvascular outcome in the EMPA-REG OUTCOME trial.  CAD=coronary artery disease; CI=confidence interval; CV=cardiovascular;  eGFR=estimated glomerular filtration; HR=hazard ratio; MACE=major adverse cardiovascular events; MI=myocardial infarction; PAD=peripheral artery disea"}, {"@id": "urn:kg:jardiance:chunk:eb6bbf7f-d4b5-40e9-bea7-9ee9d337f254", "@type": "Chunk", "graphScope": "brand", "chunk_index": 26, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "d7703c8f009854878630fbe63fdde3b2cf67157d64ff38e4a956ee565cfad1c8", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "eb6bbf7f-d4b5-40e9-bea7-9ee9d337f254", "text": "eGFR=estimated glomerular filtration; HR=hazard ratio; MACE=major adverse cardiovascular events; MI=myocardial infarction; PAD=peripheral artery disease; RRR=relative risk reduction; T2D=type 2 diabetes. | Reference: 2015 - Empagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes\n\nRD-149832 JARDIANCE Christoph Wanner The New England Journal of Medicine | AMA Style Guide References: Empagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes. 2015.\n\nChristoph Wanner The New England Journal of Medicine. | Content Modules & Rule Sets: \nCPNT-CRP-100328 JARDIANCE (v1.0)\nResource: Sunil | Name: CL-CRP-001165 | Match Text: Prescribe JARDIANCE to reduce kidney disease progression or risk of CV death in patients with CKD | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: In the EMPA-KIDNEY trial, a randomised, parallel-group, double-blind, placebo-controlled study of 6609 patients with CKD, the efficacy and safety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305). Patients were adults with an eGFR ≥ 20, < 45 mL/min/1.73 m2 ; or an eGFR ≥ 45, <"}, {"@id": "urn:kg:jardiance:chunk:1cb00685-efcd-4518-86ee-c25a5d42123f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 27, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "5741d712f21c569d4e90322d923e05dfc3f0d2ddce95fc862ae4dddddd4c58a6", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "1cb00685-efcd-4518-86ee-c25a5d42123f", "text": "afety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305). Patients were adults with an eGFR ≥ 20, < 45 mL/min/1.73 m2 ; or an eGFR ≥ 45, < 90 mL/min/1.73 m2 with a uACR ≥ 200 mg/g. The primary endpoint in the EMPA-KIDNEY trial was a composite of CV death or progression of kidney disease defined as end-stage kidney disease (the initiation of maintenance dialysis or receipt of a kidney transplant), a sustained decrease in the eGFR to <10 ml/min/1.73 m2, a sustained decrease in eGFR of ≥40% from baseline, or death from renal causes. Patients treated with JARDIANCE experienced a 28% RRR in this endpoint (HR=0.72; 95% CI: 0.64, 0.82; p<0.001).2  CI=confidence interval; CKD=chronic kidney disease; CV=cardiovascular; eGFR=estimated glomerular filtration rate; HR=hazard ratio; RRR=relative risk reduction uACR=urine albumin-to-creatinine ratio. | Reference: Herrington 2022 NEJM, Nov 4, 2022 \n\nJardiance - SmPC | AMA Style Guide References: Herrington 2022 N Engl J Med, Nov 4, 2022.\n\n- SmPC. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001166 | Match Text: EMPA-KIDNEY was the largest and broadest SGLT2i trial of its kind | Country of Origin: Corporate | Brand:"}, {"@id": "urn:kg:jardiance:chunk:fa6c5e6d-0564-4f18-8da3-6deb64baf1d4", "@type": "Chunk", "graphScope": "brand", "chunk_index": 28, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "7d87f6747a69736e7c3b60698b3bfbc1021e02a4af654bf3047a47fff2f895d8", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "fa6c5e6d-0564-4f18-8da3-6deb64baf1d4", "text": ": Sunil | Name: CL-CRP-001166 | Match Text: EMPA-KIDNEY was the largest and broadest SGLT2i trial of its kind | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | End Audience: HCP (Health Care Personnel) | Footnotes: CKD=chronic kidney disease; SGLT2i=sodium glucose cotransporter 2 inhibitor | Reference: Herrington 2022 NEJM, Nov 4, 2022 \n\nEMPA-KIDNEY Collaborative Group Nephrol Dial Transplant 2022 | AMA Style Guide References: Herrington 2022 N Engl J Med, Nov 4, 2022.\n\nEMPA-KIDNEY Collaborative Group Nephrol Dial Transplant. 2022. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001171 | Match Text: In patients with T2D and CVD, JARDIANCE reduced the relative risk of HHF by 35% | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: The primary composite outcome in the EMPA-REG OUTCOME trial was 3-point MACE, composed of death from CV causes, nonfatal MI, or nonfatal stroke, as analyzed in the pooled JARDIANCE group vs the placebo group. Patients were adults with insu"}, {"@id": "urn:kg:jardiance:chunk:d110fab7-db4e-490a-95d8-a1f34f9e60d0", "@type": "Chunk", "graphScope": "brand", "chunk_index": 29, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "0e063e7daab521efe981a09d449b46b426e9f0f795fcb7d9e7564a96ba648e35", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "d110fab7-db4e-490a-95d8-a1f34f9e60d0", "text": "death from CV causes, nonfatal MI, or nonfatal stroke, as analyzed in the pooled JARDIANCE group vs the placebo group. Patients were adults with insufficiently controlled T2D and CAD, PAD, or a history of MI or stroke. The 14% RRR in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p<0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77).  Hospitalisation for heart failure was a secondary CV outcome in the EMPA-REG OUTCOME trial (HR=0.65; 95% CI: 0.50, 0.85).  CAD=coronary artery disease; CI=confidence interval; CV=cardiovascular; HHF=hospitalization for heart failure; HR=hazard ratio; MACE=major adverse cardiovascular events; MI=myocardial infarction; PAD=peripheral artery disease; RRR=relative risk reduction; T2D=type 2 diabetes. | Reference: 2015 - Empagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes | AMA Style Guide References: Empagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes. 2015. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001184 | Match Text: JARDIANCE offers triple protection for cardiovascular, renal, and metabolic conditions | Country of"}, {"@id": "urn:kg:jardiance:chunk:e4ff2a1d-e909-4250-b06d-56cc8ffb0b75", "@type": "Chunk", "graphScope": "brand", "chunk_index": 30, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "fa6e7f2ea255810f9204e3f88e5347ef074e1bb8c7be3140d9ee8e346df0a620", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "e4ff2a1d-e909-4250-b06d-56cc8ffb0b75", "text": "esource: Sunil | Name: CL-CRP-001184 | Match Text: JARDIANCE offers triple protection for cardiovascular, renal, and metabolic conditions | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | End Audience: HCP (Health Care Personnel) | Reference: Herrington 2022 NEJM, Nov 4, 2022\n\n2015 - Empagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes\n\nRD-142505 JARDIANCE Packer 2020_Cardiovascular and renal outcomes\n\nRD-157961 Anker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461 | AMA Style Guide References: Herrington 2022 N Engl J Med, Nov 4, 2022.\n\nEmpagliflozin, Cardiovascular Outcomes, and Mortality in Type 2 Diabetes. 2015.\n\nPacker 2020 Cardiovascular and renal outcomes.\n\nAnker SD, Butler J, Filippatos G, et al. N Engl J Med. 2021;385(16):1451-1461. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001188 | Match Text: JARDIANCE may provide the greatest kidney benefit and delay of dialysis when initiated early | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Mess"}, {"@id": "urn:kg:jardiance:chunk:d1cd95d7-5b63-4f37-b805-ae92e7641ea8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 31, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_method": "openpyxl", "source_file_name": "Jardiance_Claims_updated & Content Modules 1.xlsx", "source_hash": "8e399d70e10604f13c93b198d7ed9f8a0bcb80c8f3c377ed9c6480d9335c03e6", "source_document_id": "e77ccb64-a3a2-41c2-9027-fb5e54716ebc", "chunk_id": "d1cd95d7-5b63-4f37-b805-ae92e7641ea8", "text": "s when initiated early | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | End Audience: HCP (Health Care Personnel) | Footnotes: According to a calculation based on the hypothetical transformation of chronic eGFR slopes into time to kidney failure in an independent publication.  Estimated from each baseline eGFR value by applying the chronic eGFR slopes corresponding to participants on placebo vs JARDIANCE within the prespecified eGFR subgroups (eGFR cutoff points to define subgroups).  CKD=chronic kidney disease; eGFR=estimated glomerular filtration rate. | Reference: 2023 - EMPA-KIDNEY: expanding the range of kidney protection by SGLT2 inhibitors | AMA Style Guide References: EMPA-KIDNEY: expanding the range of kidney protection by SGLT2 inhibitors. 2023. | Content Modules & Rule Sets: NA\nResource: Sunil | Name: CL-CRP-001192 | Match Text: CKD is a silent, progressive disease often missed and untreated in early phases | Country of Origin: Corporate | Brand: JARDIANCE | Therapeutic Area: Metabolism | Lifecycle State: Approved for Use | Key Message Type: Efficacy | Footnotes: CKD=chroni"}, {"@id": "urn:kg:jardiance:chunk:728df923-1097-4752-8260-1e1d5fc2d087", "@type": "Chunk", "graphScope": "brand", "chunk_index": 32, "token_count": 300, "page_number": 1, "source_document_type": "claims_content_modules", "section_id": "f9f1c2ed-a62f-44e4-b02c-6fa39df42688", "extraction_