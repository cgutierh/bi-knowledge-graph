4-99d1-d1da70d2fc48:140"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:141", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Dosing / Administration", "claim_text": "Adjusted mean changes of -0.1% from baseline HbA1c 7.9% for placebo (n=207), -0.7% from baseline HbA1c 7.9% for JARDIANCE 10 mg (n=217), and -0.8% from baseline HbA1c 7.9% for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p<0.001 vs placebo for both doses.", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 141, "indication": "Type 2 diabetes", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:141"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:142", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Dosing / Administration", "claim_text": "In a subgroup analysis at 24 weeks of patients with baseline ≥8.5%, adjusted mean changes in HbA1c were -0.5% for placebo (n=50), -1.2% for JARDIANCE 10 mg (n=57), and -1.5% for JARDIANCE 25 mg (n=48). Difference from placebo (adjusted mean) was -0.73% for JARDIANCE 10 mg and -1.0% for JARDIANCE 25 mg.", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_doc