id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:158", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "International T2D, CKD, and HF guidelines recommend the use of an SGLT2i such as JARDIANCE as early as first line2-9", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 158, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:158"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:159", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "More than 100 nephrology, endocrinology, and cardiology guidelines \nworldwide endorse the foundational use of SGLT2is, such as JARDIANCE1", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 159, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:159"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:160", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "Used alone” is defined as giving JARDIANCE without insulin or sulphonylureas.2 \n\n|| The mechanism of action of JARDIANCE is dependent on blood glucose levels, meaning it only removes glucose when levels are elevated. The risk of hypoglycaemia only increases when it’s combined with other medications that can cause low blood sugar, such as insulin or sulphonylureas.2,3", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 160, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:160"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:161", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "Based on claims data sources of adult patients with HFrEF in Japan (Medical Data Vision claims registry), Sweden (nationwide administrative registries), and the United States (C212Optum de-identified Market Clarity Data). At study onset, dapagliflozin was the available SGLT2i approved for use in patients with HFrEF in the United States.2", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 161, "indication": "Heart failure", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:161"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:162", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFmrEF and HFpEF to reduce the risk of heart failure hospitalisation or cardiovascular death2", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 162, "indication": "Heart failure", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:162"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:163", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "In the 2022 AHA/ACC/HFSA Guideline for the Management