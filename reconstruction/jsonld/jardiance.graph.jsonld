atus": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:168"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:169", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "*Based on a consortium that was tasked with compiling and meta-analysing the best available data to provide a more comprehensive assessment of the independent and combined associations of eGFR and albuminuria with mortality and kidney outcomes. Results are from the findings from a collaborative meta-analysis of the 21 general population cohorts for all-cause and cardiovascular mortality, which included >100,000 individuals with uACR measurements and 1.1 million participants with dipstick measurements", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 169, "indication": "Type 2 diabetes; Chronic kidney disease; Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:169"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:170", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "Primary care guidelines recommend including SGLT2is, such as JARDIANCE, as part of initial therapy for patients with T2D at high or very high cardiovascular risk7 ESC guidelines include SGLT2is, such as JARDIANCE, as Class I, Level A-recommended therapy for patients with eCVD and T2D to reduce cardiovascular events, independent of baseline or target HbA1c6", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 170, "indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:170"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:171", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "SGLT2is, such as JARDIANCE, are Class I recommended for first-line use in patients with eCVD + T2D to reduce the risk of CV events8", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 171, "indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:171"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:172", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Mechanism of action", "claim_text": "SGLT2is reduced the risk of composite HHF or CV mortality by 22% In a meta-analysis examining 15 studies with SGLT2is in CVD, T2D, and CKD", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 172, "indication": "Type 2 diabetes; Heart failure; Chronic kidney disease", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:172"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:173", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Safety / Tolerability", "claim_text": "Very common AEs: hypoglycaemia (when used with sulphonylurea or insulin). JARDIANCE has a placebo-like incidence of hypoglycaemia when added to metformin; volume \ndepletion. Selected uncommon AE: diabetic ketoacidosis. Rare AE: necrotising fasciitis of the perineum (Fournier’s gangrene).", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 173, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:173"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:174", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Safety / Tolerability", "claim_text": "JARDIANCE is contraindicated in patients with hypersensitivity to the active substance or to any of the excipients of JARDIANCE. JARDIANCE should not be used in patients with type 1 diabetes or for the treatment of DKA. JARDIANCE should be used with caution in patients who may be at a higher risk of ketoacidosis while taking JARDIANCE. In patients where DKA is suspected or diagnosed, treatment with JARDIANCE should be discontinued immediately. For use in patients with renal impairment, please refer to the dosing page of this document and the SmPC.1", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 174, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:174"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:175", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Safety / Tolerability", "claim_text": "Rates of hypoglycaemia were similar between JARDIANCE and placebo1", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 175, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Confirmed complete", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:175"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:176", "@type": "Claim", "graphScope": "brand", "audience": "HCP/Internal", "claim_status": "candidate", "approval_status": "candidate", "key_message_type": "Safety / Tolerability", "claim_text": "Rates of hypoglycaemia‡ were similar between JARDIANCE \nand placebo in patients with or without T2D1", "table_id": "5812fcb9-1028-4304-99d1-d1da70d2fc48", "source_document_type": "claims_content_modules", "row_number": 176, "indication": "General", "source_file_name": "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx", "source_document_id": "13ae0354-6211-4820-b97a-7634167e0ed0", "source_status": "Corrected", "CLAIM_DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0"}], "CLAIM_SUPPORTED_BY_REFERENCE": [{"@id": "urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:176"}], "DERIVED_FROM_TABLE": [{"@id": "urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48"}]}, {"@id": "urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:177", "@type": "Claim", "graphScope": "brand", "audience":