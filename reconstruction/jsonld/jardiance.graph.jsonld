M_DOCUMENT": [{"@id": "urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40"}]}, {"@id": "urn:kg:jardiance:safety:727fec54-82a7-4856-b04e-248889343501", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 35, "source_document_type": "product_information", "section_id": "727fec54-82a7-4856-b04e-248889343501", "statement_text": "Empagliflozin did not increase the incidence of tumours in female mice at doses up to 1 000 mg/kg/day, which corresponds to approximately 62-times the maximal clinical exposure to empagliflozin. Empagliflozin induced renal tumours in male mice at 1 000 mg/kg/day, but not at 300 m", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:jardiance:section:727fec54-82a7-4856-b04e-248889343501"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40"}]}, {"@id": "urn:kg:jardiance:safety:e56f7b44-18b6-4db2-afa3-8b69ed0c09bf", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 36, "source_document_type": "product_information", "section_id": "e56f7b44-18b6-4db2-afa3-8b69ed0c09bf", "statement_text": "6.4 Special precautions for storage", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_document_id": "98de1eab-c096-475d-9a30-ff5319cefc40", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:jardiance:section:e56f7b44-18b6-4db2-afa3-8b69ed0c09bf"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40"}]}, {"@id": "urn:kg:jardiance:safety:55880ba3-c4f4-41d4-8672-c6cb88ab9d74", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 36, "source_document_type": "product_information", "section_id": "55880ba3-c4f4-41d4-8672-c6cb88ab9d74", "statement_text": "6.6 Special precautions for disposal", "source_file_name": "jardiance-epar-product-information_en.pdf", "source_document_id": "98de1eab-c096-4