8, "cells": {"Resource": "Moumita", "Name": "CL-CRP-001496", "Match Text": "Initiate JARDIANCE first line to reduce your patients’ risk of CV death and protect them right from the start", "Country of Origin": "Corporate", "Brand": "JARDIANCE", "Therapeutic Area": "Metabolism", "Lifecycle State": "Approved for Use", "Indication": null, "Key Message Type": "Efficacy", "End Audience": "HCP (Health Care Personnel)", "Contextual Information": null, "Footnotes": "JARDIANCE helps protect by reducing CV and kidney risk.   CV=cardiovascular", "Reference": "Jardiance - EU/SmPC", "AMA Style Guide References": "- EU/SmPC.", "Content Modules & Rule Sets": "NA"}}, {"row_number": 79, "cells": {"Resource": "Moumita", "Name": "CL-CRP-001482", "Match Text": "Initiate an SGLT2i early to slow kidney function decline", "Country of Origin": "Corporate", "Brand": "JARDIANCE", "Therapeutic Area": "Metabolism", "Lifecycle State": "Approved for Use", "Indication": null, "Key Message Type": "CRM/Cardio-Renal-Metabolic, Disease Awareness, Efficacy", "End Audience": null, "Contextual Information": null, "Footnotes": "SGLT2i=sodium-glucose cotransporter-2 inhibitor", "Reference": "2024 KDIGO Guidelines", "AMA Style Guide References": "2024 KDIGO Guidelines.", "Content Modules & Rule Sets": "NA"}}, {"row_number": 80, "cells": {"Resource": "Moumita", "Name": "CL-CRP-001490", "Match Text": "Irreversible vascular damage may be present by the time T2D or CKD are diagnosed", "Country of Origin": "Corporate", "Brand": "JARDIANCE", "Therapeutic Area": "Metabolism", "Lifecycle State": "Approved for Use", "Indication": null, "Key Message Type": "CRM/Cardio-Renal-Metabolic", "End Audience": "HCP (Health Care Personnel)", "Contextual Information": null, "Footnotes": "CKD=chronic kidney disease; T2D=type 2 diabetes", "Reference": "Palladino BMJ Open Diabetes Res Care 2020\n\nAlexander Cardiovasc Res 2021\n\nSun Front Pharmacol 2020\n\nHahad J Am Heart Assoc 2019\n\nRabelink Nat Rev Nephrol 2015\n\nDou Toxins