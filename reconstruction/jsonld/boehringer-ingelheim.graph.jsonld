ource_document_id": "ab59869e-f86f-48d4-8916-fb89334732d4", "text": "<!-- image -->\n\n2\n\n<!-- image -->\n\nPrioritize inclusion and diversity in our illustrations, without bias.\n\nIllustrations should authentically preserving a handcrafted aesthetic, represent their subjects while\n\nadequate contrast and readability in the Always combine colors that enable illustration.\n\nsteering clear of a 'comic' style.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:43c7d65c-eb43-4a22-9367-17943c1c1321"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:00e274a3-eead-4e83-af6b-afbb036a546e", "@type": "Section", "graphScope": "brand", "section_title": "Downloads", "section_type": "heading", "page_number": 28, "source_document_type": "guidance_document", "section_id": "00e274a3-eead-4e83-af6b-afbb036a546e", "extraction_method": "docling", "source_file_name": "BI Illustrations 4.pdf", "source_document_id": "ab59869e-f86f-48d4-8916-fb89334732d4", "text": "Downloadpackage", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:f11368d1-6792-48b8-873d-445f04a9b476"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:c8fe93f9-90de-47d3-bcf8-f492303de31c", "@type": "Section", "graphScope": "brand", "section_title": "Skin and hair color swatches", "section_type": "heading", "page_number": 28, "source_document_type": "guidance_document", "section_id": "c8fe93f9-90de-47d3-bcf8-f492303de31c", "extraction_method": "docling", "source_file_name": "BI Illustrations 4.pdf", "source_document_id": "ab59869e-f86f-48d4-8916-fb89334732d4", "text": "<!-- image -->\n\n1asset Ready to add a dash of creativity to your designs with some captivating illustrations?", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:fe937e16-4641-413f-a4f7-1068523a2583"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:0877bf9c-f3e8-4bd2-a30a-fe99c832162a", "@type": "Section", "graphScope": "brand", "section_title": "Go to illustration library", "section_type": "heading", "page_n