-37d6de7e8182", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:0a855a7c-b7c6-4ab3-8560-585170c249f6"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:bca86e52-d070-4a5d-8554-348b4072cb39", "@type": "Section", "graphScope": "brand", "section_title": "Style guidance", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "bca86e52-d070-4a5d-8554-348b4072cb39", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:7986a7c4-c3aa-480d-a64e-fa978897faf3", "@type": "Section", "graphScope": "brand", "section_title": "Art direction decisions for a consistent illustration style", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "7986a7c4-c3aa-480d-a64e-fa978897faf3", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:0366f742-91eb-4d98-b452-868507d7fd79", "@type": "Section", "graphScope": "brand", "section_title": "Style decision", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "0366f742-91eb-4d98-b452-868507d7fd79", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:bb6a53d3-0d60-49e8-9c5a-ccd7e86e1be4", "@type": "Section", "graphScope": "brand", "section_title": "Hair", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "bb6a53d3-0d60-49e8-9c5a-ccd7e86e1be4", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "1\n\nHair should be illustrated in a simplified way, avoiding brush-like strokes. Overall, hair details should be kept to a minimum to maintain a clean visual style.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:2c6b40ec-fad1-42c6-ae82-0bb4b82f3b4d"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:e5481313-a75e-4b29-abec-6109efc1c16a", "@type": "Section", "graphScope": "brand", "section_title": "Eye shape", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "e5481313-a75e-4b29-abec-6109efc1c16a", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Only one single eye shape should be used for all characters and  animals. This ensures visual coherence and prevents stylistic variation.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:1deb7e6b-d5a8-43c1-8e5e-ff9fbb512372"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:918b7f7f-832e-4484-9d9e-9b681c7ca08f", "@type": "Section", "graphScope": "brand", "section_title": "Expanded color palette", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "918b7f7f-832e-4484-9d9e-9b681c7ca08f", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "2\n\n3\n\nThe existing color palette is expanded with four additional gray tones and three new hair colors. This allows for greater flexibility.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:19cbb5cd-4973-4018-af0e-a2aab580f6b6"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:90feea84-ff9a-4621-89b2-c6bf012b9755", "@type": "Section", "graphScope": "brand", "section_title": "Illustration example", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "90feea84-ff9a-4621-89b2-c6bf012b9755", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:c1371c40-bbc9-4530-822c-24fc22529291"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:b1e13efb-3b6e-41af-9162-35ed1e1f825b", "@type": "Section", "graphScope": "brand", "section_title": "Style guidance", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "b1e13efb-3b6e-41af-9162-35ed1e1f825b", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:905179cd-90ea-4544-9916-faa3f2b73f0b", "@type": "Section", "graphScope": "brand", "section_title": "Art direction decisions for a consistent illustration style", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "905179cd-90ea-4544-9916-faa3f2b73f0b", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:c5e960be-9c1c-4153-9ea4-665d7d0f8cb9", "@type": "Section", "graphScope": "brand", "section_title": "Style decision", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "c5e960be-9c1c-4153-9ea4-665d7d0f8cb9", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:4290418e-1a05-44df-99b3-443a21cf4420", "@type": "Section", "graphScope": "brand", "section_title": "Fingernails", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "4290418e-1a05-44df-99b3-443a21cf4420", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "4\n\nFingernails may be included depending on the zoomlevel of the illustration. When the zoom-level is close, fingernails may be included.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:b3b0272c-7f52-4abc-a093-7211867e53b8"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:be23c449-f8c6-4eb8-b189-9f4af6b3e170", "@type": "Section", "graphScope": "brand", "section_title": "Mouth shape", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "be23c449-f8c6-4eb8-b189-9f4af6b3e170", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "5\n\nDifferent mouth shapes are allowed, including mouths with beards. A missing upper lip or simplified black areas within the mouth are acceptable.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:e6af90b2-7317-4a75-b715-939fbe068698"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:20758b18-758e-40f1-8ed3-134d970d95ab", "@type": "Section", "graphScope": "brand", "section_title": "Less shadows", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "20758b18-758e-40f1-8ed3-134d970d95ab", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "The use of shadows should be kept to a minimum. Avoid skin tone shading and the grayish shadowing which is mixed with black.\n\n<!-- image -->\n\n6", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:b7c9b9f6-2011-4ea1-b669-d121798c45ad"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:62500fba-c8f8-4782-a01f-8e77536695b9", "@type": "Section", "graphScope": "brand", "section_title": "Illustration example", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "62500fba-c8f8-4782-a01f-8e77536695b9", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:94ed0d46-01ed-499a-aea7-48de1173f50b"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:013a4c78-c7e0-4795-963d-0b860f98b897", "@type": "Section", "graphScope": "brand", "section_title": "Style guidance", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "013a4c78-c7e0-4795-963d-0b860f98b897", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:27b54790-a8bb-4a32-a3e5-863fd4b45e0c", "@type": "Section", "graphScope": "brand", "section_title": "Art direction decisions for a consistent illustration style", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "27b54790-a8bb-4a32-a3e5-863fd4b45e0c", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:fa59c176-b1ca-4d60-9df9-295b907cb75d", "@type": "Section", "graphScope": "brand", "section_title": "Style decision", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "fa59c176-b1ca-4d60-9df9-295b907cb75d", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:d998d454-2f9f-48ff-a46f-8100935bacd5", "@type": "Section", "graphScope": "brand", "section_title": "Ear shadow", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "d998d454-2f9f-48ff-a46f-8100935bacd5", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Ear shading is optional and can be omitted without impacting consistency.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:08655937-ab66-4a9f-a030-31032cc86a0a"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:bc0cd71a-008b-4f5b-a6b8-dc28b287e415", "@type": "Section", "graphScope": "brand", "section_title": "Nose outline", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "bc0cd71a-008b-4f5b-a6b8-dc28b287e415", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Nose outlines are allowed when required by perspective or pose. They should be used sparingly and only when they support clarity.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:fc134dcc-9ce8-4421-9639-a33fa2ff6155"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:3f791725-f6f0-4457-94f2-a09d5147472b", "@type": "Section", "graphScope": "brand", "section_title": "Illustration example", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "3f791725-f6f0-4457-94f2-a09d5147472b", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n7\n\n8\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:2fae6bf9-c28d-45b2-a1e9-80a56bc886f6"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:e927c7c6-8220-4066-bd82-a66ccbaa39dd", "@type": "Section", "graphScope": "brand", "section_title": "Style example", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "e927c7c6-8220-4066-bd82-a66ccbaa39dd", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:5a4d9362-668b-4e57-ba7d-0d22426f0d9a", "@type": "Section", "graphScope": "brand", "section_title": "New version contains less shadowing and no hair strokes", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "5a4d9362-668b-4e57-ba7d-0d22426f0d9a", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:9e62acc8-7ea7-4a3c-be1d-17f22579d765", "@type": "Section", "graphScope": "brand", "section_title": "Prior version", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "9e62acc8-7ea7-4a3c-be1d-17f22579d765", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\nExemplary new version\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:98cac488-6ec9-4a52-bf3f-f8f7431ab9fa"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:cb32d462-fad8-4bb7-9cd9-e32785df9c58", "@type": "Section", "graphScope": "brand", "section_title": "Introduction of new perspectives", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "cb32d462-fad8-4bb7-9cd9-e32785df9c58", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:22955dde-2728-4cef-b09a-2a5bf06b9add", "@type": "Section", "graphScope": "brand", "section_title": "Different zoom levels help create more dynamic &amp; expressive illustrations", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "22955dde-2728-4cef-b09a-2a5bf06b9add", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:a4bb3281-6720-40d6-9c64-9ca3b6868eb0", "@type": "Section", "graphScope": "brand", "section_title": "Perspectives", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "a4bb3281-6720-40d6-9c64-9ca3b6868eb0", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:eded8f55-b069-4287-a352-341da30aa816", "@type": "Section", "graphScope": "brand", "section_title": "Close-ups", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "eded8f55-b069-4287-a352-341da30aa816", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Close-up perspectives are used to highlight specific details.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:d48e8a40-47ba-4af7-979c-d080eef72009"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:c46a1147-d366-47dc-ac2a-0b35dd9e87ae", "@type": "Section", "graphScope": "brand", "section_title": "Middle", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "c46a1147-d366-47dc-ac2a-0b35dd9e87ae", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Middle-distance perspectives provide a balanced view.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a8b724b8-082c-411e-9f5e-87ff80b874a6"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:429daaf4-4c5a-40db-a375-a1a4fbfac878", "@type": "Section", "graphScope": "brand", "section_title": "Wide", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "429daaf4-4c5a-40db-a375-a1a4fbfac878", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Wide perspectives are used to depict full scenes and environments.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a87fe5ac-72c8-4b5c-b6fc-f9847befecc1"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:b8abef7b-963c-43e1-8766-ee4be30f4c81", "@type": "Section", "graphScope": "brand", "section_title": "Animals (frontal + in action)", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "b8abef7b-963c-43e1-8766-ee4be30f4c81", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "Animals can be illustrated front-facing or in motion.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8a04c22d-4384-4b88-8312-d41ced2d7060"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:5dafd2b3-4767-4821-8986-cb42dfd84620", "@type": "Section", "graphScope": "brand", "section_title": "Illustration example", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "5dafd2b3-4767-4821-8986-cb42dfd84620", "extraction_method": "docling", "source_file_name": "AI_Illustration_Generator_Art_Direction_Guidance_Indegene.pdf", "source_document_id": "933ab84f-f1c7-49b2-be03-8ff145d78dd9", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:ac92089f-dff4-4754-96cd-110816e42d3c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:4440fc92-7e76-4ce4-8ca6-0b282f573a