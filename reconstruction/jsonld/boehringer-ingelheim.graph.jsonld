69-a01f-4a12-8b0d-709ce00e7959", "@type": "Section", "graphScope": "brand", "section_title": "Introduction: Imagery", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "1dd69269-a01f-4a12-8b0d-709ce00e7959", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Our imagery is a key part of how we visualize the Unwavering Optimism of our brand story. By focusing on the resilience and energy of everyday living, we also zoom in on the profound and significant details that capture connections between people, animals and society.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:b0bde1c6-815f-4a38-b1d9-bd42f29348b0"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:201286cd-1eb5-4b36-bac4-f149095fa3cf", "@type": "Section", "graphScope": "brand", "section_title": "Topic overview", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "201286cd-1eb5-4b36-bac4-f149095fa3cf", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8f205c18-620e-4277-ae1b-bdfaa9746313"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:e149594e-eaf5-4625-b91f-7b8477073a02", "@type": "Section", "graphScope": "brand", "section_title": "Principles Principles", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "e149594e-eaf5-4625-b91f-7b8477073a02", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Ourimagery guidelinesarebuiltfrom the samefoundationsasourexperiencemetaphor:Seeing significance inthesmallestmoments.Weusethisasguidanceforallourimagechoices.Thestyleevokesapositivefeeling throughwarmtonesandnatural lighting.Weshowlifeatitsmostreal andvividwithsnapshotsthattell captivatingstories.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:637faa5b-aba9-48a7-95d1-2c98b2f83e07"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:ade094d0-38ae-430f-a9ba-49f7d90a03a7", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 2, "source_document_type": "guidance_document", "section_id": "ade094d0-38ae-430f-a9ba-49f7d90a03a7", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n- To learn more on how we combine images for storytelling, visit the Layout section.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:7703f8e0-dd71-4b6a-adda-021ab00be3ed"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:62d4c508-b273-4ca9-9b10-ef75b3e7974f", "@type": "Section", "graphScope": "brand", "section_title": "Our range of images", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "62d4c508-b273-4ca9-9b10-ef75b3e7974f", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Our range helps us focus on different aspects of our claim'Life forward'in our communication:\n\n- ·Life as it happens (left)\n- ·The forward-thinking nature of our business, anchored in science,technology and innovation, and all nuances in between (right)\n\nNaturally,wealso applyourlook andfeel through all ourimages.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:00bac17b-5b44-4211-a678-751d64d9ccdc"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:7cc04aa5-fce2-406f-8bbf-e340b4c557c9", "@type": "Section", "graphScope": "brand", "section_title": "Life forward", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "7cc04aa5-fce2-406f-8bbf-e340b4c557c9", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:2cb20ca1-c5f7-4959-9004-d2e0819514bf"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:f65e85f7-fbcc-4f86-9743-1d991a3e24a7", "@type": "Section", "graphScope": "brand", "section_title": "TheprincipleofScale", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "f65e85f7-fbcc-4f86-9743-1d991a3e24a7", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "OurdesignprincipleScalecomestolifethroughtherulefromfartoclose.WeuseScaleasourcoretool:we portrayscenesfromclosetofar,depicting gnuancesofoptimismthroughvaryingintensitiesandemotions.\n\nFocusonlife\n\nFocusonscienceandinnovation\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:950ede1a-a33c-4323-afee-d914d00f7041"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:3c4e273f-ccc9-4f0c-9bfa-c81ae48680df", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 3, "source_document_type": "guidance_document", "section_id": "3c4e273f-ccc9-4f0c-9bfa-c81ae48680df", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "itself.We aimto create tensionbetweentheimageswithinthe samemotif,throughcounterposing littledetails tothebiggerpicture.\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:215d8869-d525-471b-9209-b813ec139565"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:9e4fe188-5c80-4669-88f4-9f91ff98f1ce", "@type": "Section", "graphScope": "brand", "section_title": "How to use", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "9e4fe188-5c80-4669-88f4-9f91ff98f1ce", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:6077a9fe-6bff-4cbf-aff7-f3cdddc08121", "@type": "Section", "graphScope": "brand", "section_title": "Scale: Proximity", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "6077a9fe-6bff-4cbf-aff7-f3cdddc08121", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "To ensure a diverserange ofimages,we'vedeveloped aproximity scaletoguideus.We alwaysmakesure to explore the scene extensively:\n\n- ·we pay attention to the smallest details(Close up)\n- ·wecapturethemomentasithappens(Inthemoment)\n- ·wegivecontexttothestory(Environment)\n\nThe majority of our images fall under the In the moment category, which is approximately 7o% of the whole.\n\n<!-- image -->\n\nIn the moment (70%)\n\nShows the core moment taking\n\n- 1 ---.-±1- Close up (15%)\n\nEnvironment (15%)\n\nGivescontexttothestory,showing ptaceintneimage,wneretne subjectsandobjectsareeasily recognizable,andtheactionis clear.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8e870f6c-366b-4d12-bc24-2d807459a0dd"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:324c1ea0-3020-4973-b5ff-693a05a64eee", "@type": "Section", "graphScope": "brand", "section_title": "Scale: Intensity", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "324c1ea0-3020-4973-b5ff-693a05a64eee", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "In parallel, to portray life as it is, we represent a wide range of emotions within a scene, from the calmer to the more active.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:1020b820-83bc-427c-a148-64d33b9fe18c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:7d1c7324-d4d2-41eb-8260-ce730a6cb2a6", "@type": "Section", "graphScope": "brand", "section_title": "Calm", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "7d1c7324-d4d2-41eb-8260-ce730a6cb2a6", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Captures moments of tranquility, focus, comfort, wellbeing, fulfilment.Thiscanbeshownwith the subject in company of loved onesoralone.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:6407f48b-5e7d-4c5e-b951-ac2257c2694b"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:1bbcb16e-9a4e-4370-a7f7-f94de04722f7", "@type": "Section", "graphScope": "brand", "section_title": "Combining Ouri images", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "1bbcb16e-9a4e-4370-a7f7-f94de04722f7", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Inourlayoutsystem,we aimtocreatecontrastbyintentionallycombiningimagesfromthesamescene,with different proximity scales.Forinstance,we may pair a Close up with an Environment shot,or an In the moment narrative.\n\nTo learn more about how we combine the different brand elements and images, visit our Layout section.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:f7949d91-2de9-4788-bba9-49036dbe46a0"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:e7bca506-4370-43a9-81b5-8ce197374999", "@type": "Section", "graphScope": "brand", "section_title": "Our imagery style", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "e7bca506-4370-43a9-81b5-8ce197374999", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Thefollowing chapter gives a practical overview on ourimagery style toidentify on brand stock imagery,as wellascreatingnewcontent.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:69032dc1-aa3f-4ea2-873b-ae130708c320"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:3e6c99b1-a158-4803-ad90-e765eeb29b6b", "@type": "Section", "graphScope": "brand", "section_title": "Active", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "3e6c99b1-a158-4803-ad90-e765eeb29b6b", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Showsin-actionmomentsofbeing motivated,inspired,andenergetic. Thisincludesexercise,sportor other activities.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:907386f7-6e80-4019-b260-2362b3d8625e"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6dbcc31c-6a10-4e7c-848e-e9293b06622e", "@type": "Section", "graphScope": "brand", "section_title": "Excited", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "6dbcc31c-6a10-4e7c-848e-e9293b06622e", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Depicts short moments of excitementorenlightenment, amazement,orastonishment.It could beaneureka moment, laughing with friends, etc.\n\ntextureorsmalldetails(likeskin texture,objectmaterial,gestures, facialexpressions...).\n\nnotontytnesupjectsoropjects involved,butalsopartoftheir environment.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8b708416-7c99-4f98-b540-7909c4ea3c4c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:64db807c-1cbd-4258-b753-0092c50b7fa7", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 5, "source_document_type": "guidance_document", "section_id": "64db807c-1cbd-4258-b753-0092c50b7fa7", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Thekeystyle criteriafor ourimagery iswhat we call asnapshotstyle.Thefollowing aspects helpguideus:\n\nRealness We show humans and animals ina lively way,\n\n<!-- image -->\n\nintheirnaturalcontextandbehaviors. Photosshould neverbe staged.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:81742bbf-62fb-4927-bd73-df12781e6598"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:3865db89-18be-4f89-b00f-b3028acee091", "@type": "Section", "graphScope": "brand", "section_title": "Our style criteria", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "3865db89-18be-4f89-b00f-b3028acee091", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "To choose or create new imagery, we use the following criteria:\n\nFree composition\n\n<!-- image -->\n\nThisis aboutcapturinglivelyimages.Ourimagessharedynamic perspectives and asymmetricalcomposition.\n\nAvoid:symmetricalor centered static compositions.\n\n<!-- image -->\n\nWe create depth.Thishappens organically/randomlywhen we\n\nSpatial depth capturepeopleingroups.\n\nAvoid: any subjects being in a staged formation.\n\n<!-- image -->\n\n<!-- image -->\n\nNo eye contact\n\nWedocumentreallife,sotakepositionofanobserver.Wewant subject/stobeunawareofeachshot.Exception:wedon'texpect you to creatively direct an animal!So,it's ok if animals look into the camera naturally.\n\nAvoid:directeyecontactwiththe camera,asit willfeel staged.\n\n<!-- image -->\n\nWe choose dynamicimages.Oursubjects should bemoving naturally,spontaneously and engaging inrealactivities.Exception: people are allowed to stand and be still,as long as they are engaged\n\nPortraymovement in a task.\n\nAvoid:staged andstaticsubjects.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\nImmersion Wedocumentreality asif the audienceis fullyimmersedinthesceneandfeelspart of it.\n\n<!-- image -->\n\nChance\n\nWechoosesurpriseand chanceovera perfectcomposition-that'swhywe capturethespontaneousand unplanned moments.\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:44538969-69dc-461c-8394-e4d028ef0381"}, {"@id": "urn:kg:boehringer-ingelheim:chunk:497796c4-3a83-42f2-8feb-1e11915c4cf5"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:312cfe45-15ed-469f-84c8-5497334c9309", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 6, "source_document_type": "guidance_document", "section_id": "312cfe45-15ed-469f-84c8-5497334c9309", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:6daa2a57-f2df-4a14-b734-132e646b3a58"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:07e741a8-a373-4578-96d2-3e373c6daadd", "@type": "Section", "graphScope": "brand", "section_title": "Tellastory", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "07e741a8-a373-4578-96d2-3e373c6daadd", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "levels.\n\nAvoid:Representingascenethroughonlyonesinglepicture.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:68b5eee8-505b-4805-ae2e-9b906106d2d3"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:bb6d5ef0-c3f0-4ea3-80ac-56c819aa9b69", "@type": "Section", "graphScope": "brand", "section_title": "Our imageryl look&amp;feel", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "bb6d5ef0-c3f0-4ea3-80ac-56c819aa9b69", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "We want to capture life authentically,so ourimages should be relatable and natural.\n\n<!-- image -->\n\nBrightness\n\nSoftandnaturaldivergentlight for clarity Slightly desaturatedpalettefor arealisticanddocumentarystylelook\n\nTemperature Warmtonesforrelatability\n\n<!-- image -->\n\nContrast\n\n<!-- image -->\n\nContrastforimpact\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:be7a8aff-f78a-444c-841d-f6a3e14e0bed"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:108c30f8-6696-4415-bf60-6aa2f8d3f7f5", "@type": "Section", "graphScope": "brand", "section_title": "Brightness and contrast", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "108c30f8-6696-4415-bf60-6aa2f8d3f7f5", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "We want to capture Optimism through our lighting.\n\n- ·Use divergent lighting for clarity, but avoid 'perfectly lit' scenes\n- ·Try slightly higher contrast images for greater expression\n- Consider using specific moments of light, such as sunrises or sunsets.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:be750616-d252-4907-8664-9f3207fca6ac"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:56e7f440-2ed8-4098-b82f-f05def91f1e3", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 7, "source_document_type": "guidance_document", "section_id": "56e7f440-2ed8-4098-b82f-f05def91f1e3", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:9db6a594-7620-45b3-b6a2-eeb45c33499e"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:965b8fa2-c1a8-442b-a924-09d0f5cf7d3d", "@type": "Section", "graphScope": "brand", "section_title": "Temperatureandsaturation", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "965b8fa2-c1a8-442b-a924-09d0f5cf7d3d", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "We use color and tonality to emphasize the feeling of warmth and Proximity.\n\n- ·Ensureimageshaveanoverall warmtone\n- ·Make sure color balance is neither too bright nor too pale.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:cd56be36-4397-4211-9f12-f83122c22136"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:b39cd493-992f-422c-99e4-3af863526108", "@type": "Section", "graphScope": "brand", "section_title": "The people in our images", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "b39cd493-992f-422c-99e4-3af863526108", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Wewanttotell storiesthatfeel relatable and familiar.Forthisreason,we chooseour subjects with the aim to portray humankind in its natural facets. We don't force diversity, nor do we highlight physical or mental differences among oursubjects.\n\n- Visit the Imagery production chapter to learn more about the people in our imagery. In the Addressing. everyone section you can learn more about our stance throughout our brand identity at large.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:59b60cf7-3c83-4392-8f9a-879c3ee4f293"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6503d30c-ed73-41ba-a3f2-b9ec93c4e491", "@type": "Section", "graphScope": "brand", "section_title": "Best practice", "section_type": "heading", "page_number": 7, "source_document_type": "guidance_document", "section_id": "6503d30c-ed73-41ba-a3f2-b9ec93c4e491", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->\n\nWhen showing guest speakers like interview partners or other personalities, we recommend using natural, neutral backgroundswith awarm tone andsoft depth. Settings should feel calm and unobtrusive, avoiding any visual distraction.\n\nFlatsurfaceslikeplainwallscanalsobesuitable whenchosen withcare.Avoid overly stylized or artificial cutouts. Images with harsh outlines or unrealistic shadows can appear poorly retouched and inauthentic.Pleasemaintainasenseofrealismand quality.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:4ce2a7c3-23fe-4c54-b334-cf42c88ee72f"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:dd5e9670-2a9a-4342-9dcf-1a60fca2730e", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 8, "source_document_type": "guidance_document", "section_id": "dd5e9670-2a9a-4342-9dcf-1a60fca2730e", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8450cd3d-09ea-428f-b177-07b01795a5e7"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:9b0cb439-7f80-406b-bb82-9382c2ccf1b5", "@type": "Section", "graphScope": "brand", "section_title": "Don'ts", "section_type": "heading", "page_number": 8, "source_document_type": "guidance_document", "section_id": "9b0cb439-7f80-406b-bb82-9382c2ccf1b5", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Avoidsymmetricalorcenteredstatic compositions\n\n<!-- image -->\n\nAvoiddirecteyecontactwiththecamera Directeyecontactfeelsstaged,instead it\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\nAvoidanysubjectsbeinginastaged\n\nformation\n\n1-= =", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:b1890a4a-273b-4e25-a885-e64e6050786d"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:b78b47e1-133a-4c0d-acd4-ac578262750c", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 9, "source_document_type": "guidance_document", "section_id": "b78b47e1-133a-4c0d-acd4-ac578262750c", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "asymmetricalcompositions\n\nAvoidstagedandstaticsubjects Oursubjectsshouldbemovingnaturally andengaginginrealactivities\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:fc54288d-9909-425d-8e39-eec105a523ce"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:4b5443f9-8522-428b-95f7-ab5507c952a6", "@type": "Section", "graphScope": "brand", "section_title": "Related topics", "section_type": "heading", "page_number": 9, "source_document_type": "guidance_document", "section_id": "4b5443f9-8522-428b-95f7-ab5507c952a6", "extraction_method": "docling", "source_file_name": "Introduction - Imagery.pdf", "source_document_id": "ded4ae29-e5c0-417b-8c08-00855d252370", "text": "Imageryproduction→\n\nPeople photography→\n\nshouldfeellikethesubjectisunawareof thecamera\n\nAvoidrepresentingascenethroughonly onesinglepicture Insteadcreateasetofimagesthatvaryin\n\n<!-- image -->\n\nproximityandintensitylevels\n\nMotion→\n\nLAYOUTSYSTEM\n\nResources&amp;Downloads\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\nLastmodifiedon Tue, 25.Nov 202511:03\n\nBoehringerIngelheim2025\n\nboehringer-ingelheim.com settings Don'tusestylisticdistortionthroughcolor andinnaturalcolors IMAGERY\n\n<!-- image -->\n\nmanipulationandfilters Wewanttocapturelifeasitis-authentic\n\nImageryproduction\n\nTermsofuse Dataprivacy. Imprint\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:c2f88df1-eb33-4c0b-91ef-34067f97dea3"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:def0e2e6-785a-4e46-9da9-555b2dd93e19", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 1, "source_document_type": "guidance_document", "section_id": "def0e2e6-785a-4e46-9da9-555b2dd93e19", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:02ecd20e-f62b-4ee0-9686-41f8dfb45c98"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:edde0eb2-ef92-43c6-9163-c773876cfb7f", "@type": "Section", "graphScope": "brand", "section_title": "Imagery production", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "edde0eb2-ef92-43c6-9163-c773876cfb7f", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "The following is a more detailed chapter for professionals, to conceptualize, organize and supervise photoshoots or searching stock imagery that reflects our imagery style.\n\nPlease note that allimages produced for Boehringer Ingelheim must be shared with our Brand A Helpdesk for approval before use and upload to the image library. Please note that all images produced for Boehringer Ingelheim must be shared with our Brand Helpdeskfor approval beforeuseand upload to theimagelibrary.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:d70c0c33-4081-4c58-8676-0685b49e8c37"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:36c43f0e-53d5-40dd-9cd0-6e0447962da0", "@type": "Section", "graphScope": "brand", "section_title": "Scale Matrix", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "36c43f0e-53d5-40dd-9cd0-6e0447962da0", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Using the scale matrix, we can create a wide range of images that fit our brand. Using the proximity levels, we explore different perspectives of the same scene. Through the intensity lens, we can display the full range of human emotions.\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:3605922c-9198-4bd5-b43d-aeba3b372089"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:31caf10c-9f41-464c-8c4e-0a8decd34956", "@type": "Section", "graphScope": "brand", "section_title": "Tips on using the proximity and intensity scale matrix", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "31caf10c-9f41-464c-8c4e-0a8decd34956", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a6a61ba6-2359-4486-970c-a7f79e446814"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:1f50455e-dd19-46cb-8a01-e3a70eb62630", "@type": "Section", "graphScope": "brand", "section_title": "Avoid forced and staged scenes.", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "1f50455e-dd19-46cb-8a01-e3a70eb62630", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Explore emotions that feel authentic.\n\n- Check out the Imagery. chapter to read more about the proximity and intensity scales.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:55b34e7c-1d08-425e-81cb-d2d433ac020e"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:d9c712f7-9012-4e42-99fe-e8d47eb0656c", "@type": "Section", "graphScope": "brand", "section_title": "How to use", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "d9c712f7-9012-4e42-99fe-e8d47eb0656c", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:ba1d129d-c967-4f06-b01d-3a7257261e56", "@type": "Section", "graphScope": "brand", "section_title": "People in our images", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "ba1d129d-c967-4f06-b01d-3a7257261e56", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Overall, our goal is to accurately document people's lives, without adhering to conventional beauty or social standards/stereotypes. Our primary aim is to capture humanity in all its unique variations without making those differences the central focal point of our imagery. We make sure to represent people in a safe and real environment. We use the correct equipment, and display safe behaviours.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:ce968eac-277b-436f-bc38-a5c744a5b1b2"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:1adc7c1d-1d50-4cf0-95d3-d7829cf5f498", "@type": "Section", "graphScope": "brand", "section_title": "Diversity", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "1adc7c1d-1d50-4cf0-95d3-d7829cf5f498", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We represent all ages, races, genders, ethnicities, religions, sexual orientationsandbodytypes.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:1860e99b-1cb5-42ff-8d95-4f8f3d3028ae"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:f12f6d28-3086-4fde-b421-40badddeae6f", "@type": "Section", "graphScope": "brand", "section_title": "Equity", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "f12f6d28-3086-4fde-b421-40badddeae6f", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:6f235fb2-23fd-4d6a-a3a1-c141afa443d2", "@type": "Section", "graphScope": "brand", "section_title": "Inclusion", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "6f235fb2-23fd-4d6a-a3a1-c141afa443d2", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We include people who live with disabilitiesorimpairments(e.g. glasses, a prothesis,hearing aids ..)\n\nWe don't define a person living with a disease by their illness. Thereforeweshowindividuals living a healthy and active life within the range of their capabilities.\n\nVisit the Addressingeveryone section to learn more about our stance throughout our brand identity at large.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:4c05cf5a-f530-4204-9667-5914bfd0311e"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:84e83cea-95b5-47ae-a438-c64911ecd781", "@type": "Section", "graphScope": "brand", "section_title": "Animals in our images", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "84e83cea-95b5-47ae-a438-c64911ecd781", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We portray animals' real lives and interactions with their owners, keeping the mood positive.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:10a54bc3-f42a-4bf4-bbae-d0a17a09f28b"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:01eb8427-aec5-47e2-bdd4-fef8892c81f1", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 3, "source_document_type": "guidance_document", "section_id": "01eb8427-aec5-47e2-bdd4-fef8892c81f1", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Reality\n\n<!-- image -->\n\nWe depict animals in their everyday surroundings and activities, in calm or lively states.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:356f4612-ea62-49d5-b270-09acb26e4b6c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:b08c7ab0-4690-4662-befa-9eebdd93206a", "@type": "Section", "graphScope": "brand", "section_title": "Diversity", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "b08c7ab0-4690-4662-befa-9eebdd93206a", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We showcase animals of different ages and colors, also featuring both pure and mixed breeds.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:23733bc5-da67-4a8c-a2c6-a99421d50964"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:dc3c2acf-d082-427b-8cdc-e018cfa1df22", "@type": "Section", "graphScope": "brand", "section_title": "Safety", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "dc3c2acf-d082-427b-8cdc-e018cfa1df22", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We always portray animals in safe, healthy and controlled environments that adhere to guidelines and restrictions of the respective business areas.\n\nWe follow the British Veterinarian Association's guidelines on showing pets in advertising and brand imagery-learnmoreabouttheguidelines sbydownloadingthedocumentontheResources &amp; Downloadspage.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:2b87ffe3-6dc3-43b1-a32c-6dbc20e64efd"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:96f1fcdb-accf-4378-88b0-60eee978f187", "@type": "Section", "graphScope": "brand", "section_title": "Styling", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "96f1fcdb-accf-4378-88b0-60eee978f187", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We choose timeless and minimal styling for our images to ensure the images last a long time. Our styling helps create authentic scenes.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:c503607b-9993-4b32-99d9-4a671bfb54c1"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:10f03feb-cc23-43de-a7fd-292e6e04442c", "@type": "Section", "graphScope": "brand", "section_title": "Lived in clothes", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "10f03feb-cc23-43de-a7fd-292e6e04442c", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Clothes shouldn't look like they're brand new, they should be comfortably worn. Try clothesfrom the models' ownwardrobesorfrom fashion archives.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:31331fdc-79c0-41a3-9287-e876ced311fb"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:cc299b0f-d509-4d32-8d45-99ef6cab8439", "@type": "Section", "graphScope": "brand", "section_title": "Appropriate and relatable", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "cc299b0f-d509-4d32-8d45-99ef6cab8439", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We choose appropriate yet seasonal'evergreen' attireineach scene (naturallythisislocation dependent). We always opt for comfort.and", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:79ee1074-e886-4c3b-8e6d-71293f7f7417"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:70e9b93d-b009-4625-93ea-f1831b0bb519", "@type": "Section", "graphScope": "brand", "section_title": "Muted palette with accents", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "70e9b93d-b009-4625-93ea-f1831b0bb519", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Clothing can be almost any color(seePeople Photography: Don'tsfor exceptions) as long as it offers enough contrast withthebackaround for Safety-compliant attire We always adhere to safety measure for working environments (safetygoogles,helmets, gloves, etc.).\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:ddb54bb4-8efa-4e15-9c65-e45aafd54f1d"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6227ab56-c57f-42cf-830e-c9c511d916cf", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 4, "source_document_type": "guidance_document", "section_id": "6227ab56-c57f-42cf-830e-c9c511d916cf", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:301c70b0-5ab7-4a7f-b540-b14086a4497c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:ce8ba61b-1d3c-4d21-ac16-86fe1bdad4f7", "@type": "Section", "graphScope": "brand", "section_title": "Avoid thefollowing in styling:", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "ce8ba61b-1d3c-4d21-ac16-86fe1bdad4f7", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "- Temporary trends (e.g. crop tops etc.)\n- Culturalcliche\n- Wearing incorrectequipment\n- Overusinggreeninthestyling\n- Monotone group styling\n- Prominent use of bright colors and patterns", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:254d3ceb-a8cb-43d9-b2c2-be17ef3b07fe"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:51282bfa-55d9-4117-ab66-a240e49afc5a", "@type": "Section", "graphScope": "brand", "section_title": "Locations", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "51282bfa-55d9-4117-ab66-a240e49afc5a", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We use diverse environments and backdrops, ensuring a mix of different settings making the scenes feel relatable.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:582d1625-fb90-45a3-b764-a6015e49f444"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:ca268adb-2135-4bf5-a0e0-5214419a7f60", "@type": "Section", "graphScope": "brand", "section_title": "Nature and urbanmix", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "ca268adb-2135-4bf5-a0e0-5214419a7f60", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We always have a good mixture of nature and urban settings as well asindoorandoutdoorlocationsfor our images.\n\nDown toearthand lived spaces Wechooseenvironmentsthatfeel easilyrelatabletothewiderpublic. Spaces and props need to feel like they're used in an everyday situation, not staged.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:92e7dfbe-0cc3-4fde-95eb-d1824563037a"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:32294aa8-a89b-4f7c-b8c1-29db79b26555", "@type": "Section", "graphScope": "brand", "section_title": "Internationalenvironments", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "32294aa8-a89b-4f7c-b8c1-29db79b26555", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "We don't show strong localized featuresineveryinstance,however recognizable backgrounds can be used if needed, e.g., when depicting a special breed only present in one region.\n\n- When depicting a scene, we make sure to portray the spaces from a mixed range of perspectives.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a16c95ce-048b-4b3f-9239-98e5e99989c4"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:8c22259e-d19a-457d-9b0d-dc00a6885730", "@type": "Section", "graphScope": "brand", "section_title": "ApplicationFormats", "section_type": "heading", "page_number": 4, "source_document_type": "guidance_document", "section_id": "8c22259e-d19a-457d-9b0d-dc00a6885730", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Weshouldbeabletouseanyimageyoutakeondifferentplatforms and indifferentsizes.Alwaysthinkabout thefollowing:\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:d1029fb9-f210-4f2f-9a45-b6586e95c085"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:c819175f-246c-437d-b59c-d7d7b8a0e3e2", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 5, "source_document_type": "guidance_document", "section_id": "c819175f-246c-437d-b59c-d7d7b8a0e3e2", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:c8c0aa6b-6c22-4aae-8877-84626f7b57d5"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:db8a2010-8fe2-4aa1-a35d-0d5fc4b749e0", "@type": "Section", "graphScope": "brand", "section_title": "Squareformats(1:1)", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "db8a2010-8fe2-4aa1-a35d-0d5fc4b749e0", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Use this fore.g.social media posts", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a21ba69d-0e31-4e03-a993-0ff73035de44"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:4093ca27-5d8f-4d7e-a7ce-e9da57c97666", "@type": "Section", "graphScope": "brand", "section_title": "Advice:", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "4093ca27-5d8f-4d7e-a7ce-e9da57c97666", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "- ·Apply rule of thirds when cropping to size\n- ·Leave empty space around the subject\n- ·Aimforsymmetry\n\nPortrait (9:16) Use this fore.g.social media (e.g.Instagram stories)\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:436da178-b63c-406a-adcb-a674ac9ca0a1"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:c639ccad-4924-4ab4-997c-dc469ad448bc", "@type": "Section", "graphScope": "brand", "section_title": "Advice:", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "c639ccad-4924-4ab4-997c-dc469ad448bc", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "- ·Applyruleof thirdswhencroppingtoformat\n- ·If the shot hasa strong horizon,considermoving it above or belowthemiddleof theframe\n\nLandscape(16:9)\n\n<!-- image -->\n\nUse thisfore.g.TVscreens,billboards", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:9e0fdffb-c18c-4777-b97c-b12cc93a240f"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:8d703424-9a62-430f-a0cf-9ea232864849", "@type": "Section", "graphScope": "brand", "section_title": "Advice:", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "8d703424-9a62-430f-a0cf-9ea232864849", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "- ·Apply rule of thirds when cropping to format\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:0be3790d-b364-4ec0-b916-4c968953f7fb"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:ac0a0ba7-0abb-414d-9a1a-1499e068d673", "@type": "Section", "graphScope": "brand", "section_title": "Narrowformats", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "ac0a0ba7-0abb-414d-9a1a-1499e068d673", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Use thisforwebsitebanners,advertisements", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:824b8703-b2e5-4026-8aec-9ab3aa42183f"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:fa161922-5c68-4983-b9de-0ad34c81ba12", "@type": "Section", "graphScope": "brand", "section_title": "Advice:", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "fa161922-5c68-4983-b9de-0ad34c81ba12", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "- ·Keepextraemptyspacetodrawtheviewer'sattentiontothe information", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:5f5ac468-cecf-48d0-be76-50f7a1664a73"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:1287b0e6-7f16-4cb0-a77f-daca0aed484f", "@type": "Section", "graphScope": "brand", "section_title": "Stock Imagery", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "1287b0e6-7f16-4cb0-a77f-daca0aed484f", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->\n\nFinding the right stock image can bea time-consuming and challenging task. Beyond ensuring that the image aligns with brand guidelines,it'salsoessentialthat the content fits and the quality is high.But how do we find stock photos that truly meet these criteria?\n\nPleasesee themanualon the Resources &amp; Downloads page to assist your stock image search.\n\nAs a Boehringer employee, you can request access to Adobe Stock in MyServices - Service Now. ① Please visit INSITE and search for /lmagepool, here you will find the Guidelines for using Adobe Stock\n\n- assetspurchasedbyBoehringer.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:d2b7aa6c-f2d4-40af-b93e-623229ba423f"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6edd7318-608d-48af-9625-dd362f80e70a", "@type": "Section", "graphScope": "brand", "section_title": "Don'ts", "section_type": "heading", "page_number": 5, "source_document_type": "guidance_document", "section_id": "6edd7318-608d-48af-9625-dd362f80e70a", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "<!-- image -->\n\nDon'tusestagedpictures\n\n<!-- image -->\n\nDon'tfeaturecruelbreeding\n\n<!-- image -->\n\nDon'tusedramaticeffectstoromantice animalcare\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:69e0fcb3-6ae8-4808-b8e2-dd9060db38e5"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:a5c4d15a-a6df-430f-8a7d-6735d08e7cba", "@type": "Section", "graphScope": "brand", "section_title": "Related topics", "section_type": "heading", "page_number": 6, "source_document_type": "guidance_document", "section_id": "a5c4d15a-a6df-430f-8a7d-6735d08e7cba", "extraction_method": "docling", "source_file_name": "Imagery Production.pdf", "source_document_id": "0f55abc8-b39d-49f3-a7b4-22747fd324cd", "text": "Imagery principles →\n\nPeople photography→\n\nMotion →\n\nIMAGERY\n\nIntroduction:lmagery\n\nLast modified on  Mon, 17.Nov 2025 16:09\n\nBoehringerIngelheim2025\n\n? Boehringerl Ingelheim2024\n\nboehringer-ingelheim.com IMAGERY\n\nPeople photography\n\nTerms of use Data privacy. Imprint\n\nwww.boehringer-ingelheim.com TermsofUse DataPrivacy Imprint", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:2a3c7c0a-91c8-45ae-887b-c15622cc3cdd"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6861ebe4-d0b1-4c99-9fda-9cc9f0fc0252", "@type": "Section", "graphScope": "brand", "section_title": "Welcome to the Ai illustration toolkit", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "6861ebe4-d0b1-4c99-9fda-9cc9f0fc0252", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "The Ai illustration toolkit contains open Adobe Illustrator (.ai) files. The containing illustrations have been created with the help of Ai. The following provides an overview of how to work with the supplied files.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:3ca97a00-75a8-4583-9c0f-aa77191f56d0"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:92d0bb6b-0958-412a-a303-ddf0ea28f124", "@type": "Section", "graphScope": "brand", "section_title": "Overview", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "92d0bb6b-0958-412a-a303-ddf0ea28f124", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:aa3e329e-8511-49d2-84a6-3f337c1de793", "@type": "Section", "graphScope": "brand", "section_title": "Details and audience", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "aa3e329e-8511-49d2-84a6-3f337c1de793", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:6c573ed5-87ab-4209-bc77-25b1bbbc95f2", "@type": "Section", "graphScope": "brand", "section_title": "What's included?", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "6c573ed5-87ab-4209-bc77-25b1bbbc95f2", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "- Adobe illustrator files (ai.)\n- 2000+ scene illustrations\n- 7 categories (minimum of one .ai file per category)\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8c97e4bd-6423-4961-a9fc-f311c7b48f22"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:9cbd91f9-99d0-4066-b0c8-2298a9544429", "@type": "Section", "graphScope": "brand", "section_title": "Who is it for?", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "9cbd91f9-99d0-4066-b0c8-2298a9544429", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "- Creatives with Adobe Illustrator experience\n- External agencies and production partners", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:06869afb-9dae-4a69-ba31-d4303157d6b0"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:7f774ea8-841c-45c3-a37f-4f8ad6de49dc", "@type": "Section", "graphScope": "brand", "section_title": "File structure", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "7f774ea8-841c-45c3-a37f-4f8ad6de49dc", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "- Categories 1\n\nIllustrations are structures within 7 categories\n\n<!-- image -->\n\n- Adobe illustrator files 2\n\nEach category contains at least one .ai file\n\n<!-- image -->\n\n<!-- image -->\n\n- PDF preview Offers an overview of the inclued illustrations 3\n\nTake a look at the Overview PDF files to determine which illustrations are located within each .ai file.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:e4a343f5-cbe3-4637-91f9-dd3a3247cc1f"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:38652a22-9bad-4c8e-8980-36c2185f51e9", "@type": "Section", "graphScope": "brand", "section_title": "Setup &amp; Basics", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "38652a22-9bad-4c8e-8980-36c2185f51e9", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:560a7b46-ae76-4224-be9e-2546db019344", "@type": "Section", "graphScope": "brand", "section_title": "How to use the .ai files", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "560a7b46-ae76-4224-be9e-2546db019344", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "<!-- image -->\n\nEach Scene illustration follows a layers structure:\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:bdc8e69d-94b6-47de-9bfb-7bec83e4eda2"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:2c83bd89-f3f7-47e7-b777-3b8ccf859bad", "@type": "Section", "graphScope": "brand", "section_title": "Stroke layer", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "2c83bd89-f3f7-47e7-b777-3b8ccf859bad", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "A layer that contains all strokes is at the topmost level\n\nA single illustration\n\nAn illustration is split into a background and shaopes layer", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:1553276a-65e9-4248-b271-cb0cf07fe563"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:78c1d5d3-94d1-4413-8ab5-069e0d9b1a2a", "@type": "Section", "graphScope": "brand", "section_title": "Color variants", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "78c1d5d3-94d1-4413-8ab5-069e0d9b1a2a", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Each illustration includes 5 predefined color variantes structured into layers for quick switching and consistent usage\n\nUse predefined elements and color variants when possible. Duplicate and adapt existing Scene illustrations instead of rebuilding from scratch.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:63346174-16d9-4eff-ac85-ba01488139cb"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:fe298a24-736c-4e36-a0c8-d2a86a65b022", "@type": "Section", "graphScope": "brand", "section_title": "Checklist", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "fe298a24-736c-4e36-a0c8-d2a86a65b022", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:ea32ddb9-f2fa-4278-9c80-d6ad0d92a85a", "@type": "Section", "graphScope": "brand", "section_title": "How to create Scene illustrations", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "ea32ddb9-f2fa-4278-9c80-d6ad0d92a85a", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:8e29e3c4-44ef-4931-ab97-68f07a66ad3e"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:6ed906f1-d91b-41f7-8824-bdb7fa2ee4dc", "@type": "Section", "graphScope": "brand", "section_title": "Checklist", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "6ed906f1-d91b-41f7-8824-bdb7fa2ee4dc", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:d6128408-ab53-40d1-96da-c76dfeb273bd", "@type": "Section", "graphScope": "brand", "section_title": "Don'ts (Creation)", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "d6128408-ab53-40d1-96da-c76dfeb273bd", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "<!-- image -->\n\nDon't use Dark Green or Accent Green as a background color for Scene illustrations.\n\n<!-- image -->\n\n- between selected colors. Don't X\n\nEnsure there's clear contrast use clashing shades.\n\n<!-- image -->\n\nFor more information regarding Diversity, Equity &amp; Inclusion in illustrations, read into the Brand Hub: brand.boehringer-ingelheim.com", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:da6df899-b73f-424e-a44c-104ed5f9ab4d"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:0213a9ca-9783-4267-b7ae-5b562fcc9232", "@type": "Section", "graphScope": "brand", "section_title": "Preparation", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "0213a9ca-9783-4267-b7ae-5b562fcc9232", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:dcfdb7c7-4d19-4841-a30a-e86f1776bf67", "@type": "Section", "graphScope": "brand", "section_title": "How the files are prepared", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "dcfdb7c7-4d19-4841-a30a-e86f1776bf67", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Each Scene illustration must be prepared in the specified formats.\n\n| File type    | Color mode    | File format   | Resolution     | Color versions: background                                                |\n|--------------|---------------|---------------|----------------|---------------------------------------------------------------------------|\n| Screen files | RGB           | SVG, PNG      | 1920 x 1920 px | Depending on the layout: Warm gray, secondary colors from light to medium |\n| Print files  | CMYK, Pantone | EPS           |                | shades (Yellow, Blue, Red and Violet)                                     |\n\nAccent Green is used as a Pantone color in the print version.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a0f0e94a-a662-46fd-a8e0-f7ddb0099f90"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:87042e14-6758-4406-9ca1-6245e6495b82", "@type": "Section", "graphScope": "brand", "section_title": "Naming", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "87042e14-6758-4406-9ca1-6245e6495b82", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:f7a49a92-1ab3-4ae8-a820-06b345480e9e", "@type": "Section", "graphScope": "brand", "section_title": "How to name files consistently", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "f7a49a92-1ab3-4ae8-a820-06b345480e9e", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Boehringer\\_Scene\\_ Description\\_Color-mode\n\n<!-- image -->\n\n<!-- image -->\n\ne.g. Boehringer\\_Scene\\_dog-playing\\_CMYK\\_Violet", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:9f4c7265-27b3-43f3-a6db-8a9421be1782"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:c19b9f54-ff7a-4e9e-a100-80a7062748bb", "@type": "Section", "graphScope": "brand", "section_title": "Upload", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "c19b9f54-ff7a-4e9e-a100-80a7062748bb", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": ""}, {"@id": "urn:kg:boehringer-ingelheim:section:39056749-1de6-4cd8-8421-9c9f5e8a0347", "@type": "Section", "graphScope": "brand", "section_title": "How to get Illustrations approved for the Brand Hub Library", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "39056749-1de6-4cd8-8421-9c9f5e8a0347", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Getting your Scene illustrations into the Brand Hub is easy! Just follow these three steps:\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:a74539cd-c679-4d51-817e-e540134fb4c5"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:db0ef3c0-fd90-4a1a-96cf-c47ca4969ed0", "@type": "Section", "graphScope": "brand", "section_title": "Design Review", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "db0ef3c0-fd90-4a1a-96cf-c47ca4969ed0", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Send your illustrations to brand@boehringer-ingelheim.com with the subject 'Approval Scene Illustration'. Our team will review and approve them to ensure they are in line with our illustration style. Please note that the inclusion in the library is checked in advance, only illustrations that are relevant for a large part of the organisation and are not duplicated will be included in our library.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:0e4f20f5-d209-4eae-8e92-c521d14fc15c"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:4a4779db-7c4d-455d-90d0-eb0f802fca24", "@type": "Section", "graphScope": "brand", "section_title": "File Preparation", "section_type": "heading", "page_number": 3, "source_document_type": "guidance_document", "section_id": "4a4779db-7c4d-455d-90d0-eb0f802fca24", "extraction_method": "docling", "source_file_name": "Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf", "source_document_id": "19fd2b5c-5248-47a5-852e-2b1b1976cae9", "text": "Once approved, prepare your files according to the documented specifications and send them back to the same email address.\n\n- Upload to Brand Hub 3\n\nWe'll take care of uploading your approved illustrations to the Brand Hub, ensuring they're ready to be used by employees and service providers across the organization.\n\n<!-- image -->\n\n<!-- image -->\n\n- 1 Description A brief description of the scene in three words or fewer\n- 2 Color mode Color format like CMYK as well as the\n\n<!-- image -->\n\naddition of background color version\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:761e69f0-222b-40f2-a016-4daebb760db7"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:8c60328f-9345-42eb-bc60-68148dfe1ddd", "@type": "Section", "graphScope": "brand", "section_title": "Illustrations Illustrations", "section_type": "heading", "page_number": 1, "source_document_type": "guidance_document", "section_id": "8c60328f-9345-42eb-bc60-68148dfe1ddd", "extraction_method": "docling", "source_file_name": "BI Illustrations 4.pdf", "source_document_id": "ab59869e-f86f-48d4-8916-fb89334732d4", "text": "Boehringer Ingelheim #\n\nQSearch\n\n'uoisap ano ot uoowa pue Aondwss yrwim sppe as uonesn n including complex It allows us to visualize a wide range of subjects technical or medical topics Our illustration style ad It allows us to visualize technical or medical to\n\n&lt;Brand elements Guideline overview Logo &amp; Claim Typography Layout system Graphics &amp; Illustrations lllustrations\n\n<!-- image -->\n\n02:\n\nImagery lcons Key visuals Infographics\n\n3Drenderings Motion punos Accessibility / Values Tone of voice", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:76a246a8-eccb-45e2-a570-3c62701f0345"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:fc3d5ba4-a18a-40ea-8d81-df98c144ccfa", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 2, "source_document_type": "guidance_document", "section_id": "fc3d5ba4-a18a-40ea-8d81-df98c144ccfa", "extraction_method": "docling", "source_file_name": "BI Illustrations 4.pdf", "source_document_id": "ab59869e-f86f-48d4-8916-fb89334732d4", "text": "-Lifeforward\n\nBrand Hub | Boehringer Ingelheim\n\nBrand elements\n\nlustrations", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:boehringer-ingelheim:chunk:670b4266-7457-4374-bfab-0239329f3813"}]}, {"@id": "urn:kg:boehringer-ingelheim:section:5ec49c25-1fcd-46bc-ae41-f66a53f759ef", "@type": "Section", "graphScope": "brand", "section_title": "Our illustrationstyle", "section_type": "heading", "page_number": 2, "source_document_type": "guidance_document", "section_id": "5ec49c25-1fcd-46bc-ae41-f66a53f759ef