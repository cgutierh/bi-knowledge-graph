pread                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |                                                                              |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                           |                                                                                                                                                                                                                                                                                                                                                   