             |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |     |\n| Summary                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |                                                                              |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |     |\n|                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |                                                                              |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           | 3.8 |\n|                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               | System                                                                       |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |     |", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:045e95f4-71cc-48bf-a2b5-38c3379d8f14"}, {"@id": "urn:kg:ofev:chunk:5ce2e9b3-9453-4c22-a2c7-a0a40a6de99c"}, {"@id": "urn:kg:ofev:chunk:ec5b37cb-a333-4c82-b978-904e0c64c5ab"}, {"@id": "urn:kg:ofev:chunk:76b9ca18-cec3-40ef-80ac-a91d40bc1266"}, {"@id": "urn:kg:ofev:chunk:9b615a0d-80cd-4ae5-8e46-0b1c9620d7c2"}, {"@id": "urn:kg:ofev:chunk:ea647822-eb48-4b5a-9e70-dbfd6cf95a93"}, {"@id": "urn:kg:ofev:chunk:93ae0143-a60d-44db-9f3e-861c2695f080"}, {"@id": "urn:kg:ofev:chunk:e338926e-b5a2-4a46-8fde-9d27eefa6c91"}, {"@id": "urn:kg:ofev:chunk:abc3feb9-99ab-4d2a-a6cf-8e32fe0b7920"}, {"@id": "urn:kg:ofev:chunk:2fced54e-e5d0-42a4-bd27-73fe3cf12073"}, {"@id": "urn:kg:ofev:chunk:0aabfbea-012c-4e59-9206-8d3ad8ac6abe"}, {"@id": "urn:kg:ofev:chunk:fca2cf6c-9135-43eb-9cff-b1ed457c7f67"}, {"@id": "urn:kg:ofev:chunk:cf5a2d5e-963b-4ad1-9328-de6e519279ef"}, {"@id": "urn:kg:ofev:chunk:6d488d38-5fef-45a6-8624-f36910634f90"}, {"@id": "urn:kg:ofev:chunk:4471a183-5fb3-4904-bb2d-6ae75abc10d8"}, {"@id": "urn:kg:ofev:chunk:9e62f319-6839-4444-8074-7d9eb603ce01"}, {"@id": "urn:kg:ofev:chunk:a1d9c119-2c5c-4ebf-877c-50828dfceb95"}, {"@id": "urn:kg:ofev:chunk:cccf19d6-1e9f-4f6d-afd0-4e9d563fa0d5"}, {"@id": "urn:kg:ofev:chunk:df991c66-4599-432e-940e-9be9b276f0c1"}, {"@id": "urn:kg:ofev:chunk:a54ed2c7-5da2-442b-8f31-3430974f7d17"}, {"@id": "urn:kg:ofev:chunk:74add275-b9f2-494b-9792-5cf151b41cc8"}, {"@id": "urn:kg:ofev:chunk:e54660ed-d061-4d32-aae8-ccdc54869109"}, {"@id": "urn:kg:ofev:chunk:3b14de52-4c77-41eb-b3ff-30f516d90317"}, {"@id": "urn:kg:ofev:chunk:b3428fc5-970e-476c-b900-4fb3298c07f0"}, {"@id": "urn:kg:ofev:chunk:3ea3d1b7-e414-46e5-99ff-a130c216b4fb"}, {"@id": "urn:kg:ofev:chunk:4caf6677-6ae1-4576-b811-b054c1e35dca"}, {"@id": "urn:kg:ofev:chunk:6e5d3c7f-cca6-4af7-94f5-6fdd0c543aca"}, {"@id": "urn:kg:ofev:chunk:b49bce00-d3f6-4a8d-ae75-8043c6ac697a"}, {"@id": "urn:kg:ofev:chunk:fb30c19f-dcd9-4520-aa78-3aff7e612e92"}, {"@id": "urn:kg:ofev:chunk:667d0f82-3cac-44ed-89d2-5a29dbcbcda0"}, {"@id": "urn:kg:ofev:chunk:310b525d-050c-46d6-a095-2352139d6e5d"}, {"@id": "urn:kg:ofev:chunk:2ef8f3ca-b534-493a-a900-4eebb38178a3"}, {"@id": "urn:kg:ofev:chunk:15bbfe16-aac6-406f-a83a-49cf598ef089"}, {"@id": "urn:kg:ofev:chunk:a6fbfa34-a86c-4401-a6c8-63933aa5e2ab"}, {"@id": "urn:kg:ofev:chunk:6e0fec77-1de8-4aaf-8b9d-f4752ba4d63c"}, {"@id": "urn:kg:ofev:chunk:dee85c45-d433-4c56-b855-6a1fecd422ee"}, {"@id": "urn:kg:ofev:chunk:cc943c18-381a-4bfc-91e1-07a56563b703"}, {"@id": "urn:kg:ofev:chunk:b26cd5ec-8a45-4a8e-8318-c1682570c033"}, {"@id": "urn:kg:ofev:chunk:39c4121d-1bc0-4e97-9ec0-562c9bb69dd6"}, {"@id": "urn:kg:ofev:chunk:cd4aa77d-0d3d-487b-b554-1f5246d59b5b"}, {"@id": "urn:kg:ofev:chunk:e3b0b0f0-33fa-4cc1-a8b0-b4b16083325f"}, {"@id": "urn:kg:ofev:chunk:0c514c88-feff-448b-880f-3286f8bf4727"}, {"@id": "urn:kg:ofev:chunk:47998278-16ec-4d5d-a508-5c5f8f909307"}, {"@id": "urn:kg:ofev:chunk:5cadefc8-b864-4a56-87bd-a06ce81ca3f6"}, {"@id": "urn:kg:ofev:chunk:526242ad-f293-4924-8dda-cea4299555e2"}, {"@id": "urn:kg:ofev:chunk:29c70d94-0fed-48ca-87b3-008266123f84"}]}, {"@id": "urn:kg:ofev:section:d9661045-25ca-4487-a872-14134686ea50", "@type": "Section", "graphScope": "brand", "section_title": "Brand Strategy 1.0", "section_type": "heading", "page_number": 4, "source_document_type": "brand_book", "section_id": "d9661045-25ca-4487-a872-14134686ea50", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "This section presents the brand's unique position in the market, the distinctive promise the brand makes its audiences, and the personality and behavior that define the brand experience.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4ad177ec-92b0-4b0c-99ab-23fe537a54f0"}]}, {"@id": "urn:kg:ofev:section:24b93411-2855-48bc-804a-d92942a12c4b", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 5, "source_document_type": "brand_book", "section_id": "24b93411-2855-48bc-804a-d92942a12c4b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "1.1", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:33378074-7632-434f-a65b-57476f2c8b00"}]}, {"@id": "urn:kg:ofev:section:d98ea450-71ce-499d-b637-423fe513a69a", "@type": "Section", "graphScope": "brand", "section_title": "Product Profile", "section_type": "heading", "page_number": 5, "source_document_type": "brand_book", "section_id": "d98ea450-71ce-499d-b637-423fe513a69a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Nintedanib is a tyrosine kinase inhibitor that targets pathways involved in fibrosis.\n\nOFEV ® slows IPF disease progression so that the physician's role is restored and patients can live tomorrow like they did yesterday.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:716e2347-b0fb-4e2d-bc11-b4dbeb20a608"}]}, {"@id": "urn:kg:ofev:section:b5c9dab8-6614-42cb-ae99-8081ddbf6965", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 6, "source_document_type": "brand_book", "section_id": "b5c9dab8-6614-42cb-ae99-8081ddbf6965", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "1.2", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:107ef703-aff0-4c3e-a151-9bd27986977b"}]}, {"@id": "urn:kg:ofev:section:456e0f85-2637-47da-9144-582b50c2628b", "@type": "Section", "graphScope": "brand", "section_title": "Brand Insights", "section_type": "heading", "page_number": 6, "source_document_type": "brand_book", "section_id": "456e0f85-2637-47da-9144-582b50c2628b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "OFEV ® slows disease progression in a broad range of IPF patient types with a 50% reduction in the decline of lung function OFEV ® reduces adjudicated acute exacerbations by 68%\n\nSide effects can be effectively managed in most patients Only 1 capsule twice a day ensures ease of dosing", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6f340619-ed8b-423b-8cc1-afe8bf76a7a8"}]}, {"@id": "urn:kg:ofev:section:a48e4f3c-bdb6-4324-a28d-4a59a63478f8", "@type": "Section", "graphScope": "brand", "section_title": "1.3", "section_type": "heading", "page_number": 7, "source_document_type": "brand_book", "section_id": "a48e4f3c-bdb6-4324-a28d-4a59a63478f8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:5662eb42-d69c-4afe-a7e4-0d9a371ccb41", "@type": "Section", "graphScope": "brand", "section_title": "Brand Positioning", "section_type": "heading", "page_number": 7, "source_document_type": "brand_book", "section_id": "5662eb42-d69c-4afe-a7e4-0d9a371ccb41", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Our brand positioning, an internal strategic statement, is the foundation of all branded communications. It shows how we want OFEV ®  to be perceived in the minds of customers, and it is essential that brand positioning be reflected in all our branded marketing efforts.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8650f2e1-6dce-4550-9768-7ac8a8bbfe12"}]}, {"@id": "urn:kg:ofev:section:3e128188-269d-498c-a537-2a7ef88f114d", "@type": "Section", "graphScope": "brand", "section_title": "PrEMiSE", "section_type": "heading", "page_number": 7, "source_document_type": "brand_book", "section_id": "3e128188-269d-498c-a537-2a7ef88f114d", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "iPF is devastating and unpredictable. Physicians are powerless, and patients live in fear.\n\nthe progressive loss of lung function erodes life and results in death by suffocation within 2-3 years of diagnosis.\n\nWhile most patients experience gradually declining lung function, some also experience precipitous, commonly fatal drops known as acute exacerbations. these come without warning or known cause, and have a direct effect on accelerating disease progression.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9124e088-3eec-4b99-9ca6-fcac4a8e926f"}]}, {"@id": "urn:kg:ofev:section:483a5465-a6a0-488a-a324-ea05be19c8f7", "@type": "Section", "graphScope": "brand", "section_title": "PoSitioninG", "section_type": "heading", "page_number": 7, "source_document_type": "brand_book", "section_id": "483a5465-a6a0-488a-a324-ea05be19c8f7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "| For those feeling helpless when facing the devastating diagnosis and unpredictable progression of iPF                                          |\n|------------------------------------------------------------------------------------------------------------------------------------------------|\n| oFEV ®                                                                                                                                         |\n| is a breakthrough therapy that delivers what it promises                                                                                       |\n| that slows disease progression in all iPF patient types by reliably reducing FVc decline and exacerbations with a convenient dosing regimen    |\n| unlike the complexity and uncertainties of pirfenidone and other therapies                                                                     |\n| So that physicians are confident to initiate treatment immediately after diagnosis, enabling patients to live tomorrow like they did yesterday |", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5c99cedd-14cc-4f27-812d-465cddb1b161"}]}, {"@id": "urn:kg:ofev:section:9d64d82e-2616-4045-ab10-c197ddaffcc8", "@type": "Section", "graphScope": "brand", "section_title": "1.4", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "9d64d82e-2616-4045-ab10-c197ddaffcc8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:25116737-9f83-4ca0-b1b7-1e0ad434dbe4", "@type": "Section", "graphScope": "brand", "section_title": "Brand Personality", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "25116737-9f83-4ca0-b1b7-1e0ad434dbe4", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Our brand personality encompasses the memorable persona our brand presents to the world and how we are perceived by our audiences. It includes how our brand looks, acts, and sounds, in human terms.\n\nTogether, the following traits define the brand personality of OFEV ® .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b77ef460-eacb-4ba6-8915-3f073e3b1c99"}]}, {"@id": "urn:kg:ofev:section:ee69b436-8a02-483a-9019-ad1801339b74", "@type": "Section", "graphScope": "brand", "section_title": "ProtectIve", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "ee69b436-8a02-483a-9019-ad1801339b74", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Even when the others turn in or give up, i remain vigilant and proactively guard against potential pitfalls. Knowing that i stay on watch gives others strength through security and comfort.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:49937b56-88fc-40e9-b683-a6242e253768"}]}, {"@id": "urn:kg:ofev:section:e5cadae2-cd95-46af-b348-57c0370a76b2", "@type": "Section", "graphScope": "brand", "section_title": "relIaBle", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "e5cadae2-cd95-46af-b348-57c0370a76b2", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "+\n\ni believe the best partnerships are those that are sustainable. to foster these long-term relationships, i build trust by remaining transparent and behaving with unwavering consistency.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:98839e2d-54ba-4ae9-aeca-9cf7d355dbc0"}]}, {"@id": "urn:kg:ofev:section:2111349c-59d3-4c26-ad62-972f50ad18c1", "@type": "Section", "graphScope": "brand", "section_title": "hIgh-Performance", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "2111349c-59d3-4c26-ad62-972f50ad18c1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "+\n\nMy intelligence, confidence, and the pride i take in my work allow me to regularly achieve success. By becoming the gold standard, i inevitably raise the bar higher for all.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7f9fcc2a-56f4-4b36-a7c6-f0b9dbb4f7f6"}]}, {"@id": "urn:kg:ofev:section:831bc60a-71f8-4171-94fb-890256a055fa", "@type": "Section", "graphScope": "brand", "section_title": "encouragIng", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "831bc60a-71f8-4171-94fb-890256a055fa", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "+\n\ni do more than deliver hope; i give others a real reason to believe in me. By inspiring them to take action in a way they didn't believe they could, i permanently shift the paradigm.\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f14dffeb-f09c-48e4-b328-f2e9c8add6f2"}]}, {"@id": "urn:kg:ofev:section:fee7a829-3d89-4e8e-bb41-bbbef50260d8", "@type": "Section", "graphScope": "brand", "section_title": "IndISPenSaBle", "section_type": "heading", "page_number": 8, "source_document_type": "brand_book", "section_id": "fee7a829-3d89-4e8e-bb41-bbbef50260d8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "=\n\ni am an essential and stabilizing force for everyone i touch. By always being protective, reliable, high-performing, and encouraging, i provide the vital foundation others need to achieve their best.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:058015bb-74f6-441c-a1fc-1b05ad58677a"}]}, {"@id": "urn:kg:ofev:section:235a46e9-9ff0-4617-af28-670c8536daaa", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 9, "source_document_type": "brand_book", "section_id": "235a46e9-9ff0-4617-af28-670c8536daaa", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "1.5 Color Palette", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:fbb64338-3a7f-4127-8f7e-568826261c69"}]}, {"@id": "urn:kg:ofev:section:8eb562d9-f82d-43d0-a542-f1c21a964c62", "@type": "Section", "graphScope": "brand", "section_title": "Overview", "section_type": "heading", "page_number": 9, "source_document_type": "brand_book", "section_id": "8eb562d9-f82d-43d0-a542-f1c21a964c62", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "coLor PALEttE oVErViEW\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:53908489-1341-4005-b1d0-88ff9da9c2db"}]}, {"@id": "urn:kg:ofev:section:3dbd4263-7db7-437f-a6c4-412c6c8916d0", "@type": "Section", "graphScope": "brand", "section_title": "2.0 hcP Branded Identity assets", "section_type": "heading", "page_number": 10, "source_document_type": "brand_book", "section_id": "3dbd4263-7db7-437f-a6c4-412c6c8916d0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Brand identity assets are the tools that we use to define and communicate a brand's unique characteristics. They include visual elements such as a logo, color, and type, as well as verbal and behavioral elements such as tone of voice, style, and manner. The OFEV ® brand identity assets have been carefully developed to work together to create a bold, charismatic, and memorable visual impression.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7e9163a3-1bf1-411f-af8f-c549695f92dd"}]}, {"@id": "urn:kg:ofev:section:c470d51b-2176-4cd0-a03d-9926c5be6c29", "@type": "Section", "graphScope": "brand", "section_title": "2.1", "section_type": "heading", "page_number": 11, "source_document_type": "brand_book", "section_id": "c470d51b-2176-4cd0-a03d-9926c5be6c29", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:74ba7b62-d92b-4327-9ba4-7052c1b100ec", "@type": "Section", "graphScope": "brand", "section_title": "Logo", "section_type": "heading", "page_number": 11, "source_document_type": "brand_book", "section_id": "74ba7b62-d92b-4327-9ba4-7052c1b100ec", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The OFEV ®  logo consists of 3 elements: the logotype, the symbol, and the generic name. The symbol depicts wings in motion that dependably guard patients. The symbol is inspiring and representational of high performance because of its forward motion. The use of dark blue and all caps in the logotype communicate reliability and vigilance.\n\nThe logo should never be changed in any way to keep the personality consistent worldwide.\n\nuS LoGo\n\n<!-- image -->\n\nSome markets have regulations about the size relationship between the brand and generic names. the united States, for which the oFEV ®  logo is illustrated here, has very speciffc rules regarding that relationship. Please use the assets that have been provided and approved for your region.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e0f6aea7-130d-4083-9fe3-50223fa0d459"}]}, {"@id": "urn:kg:ofev:section:ee7b7a67-c75b-45d1-8754-9b4a854b82ee", "@type": "Section", "graphScope": "brand", "section_title": "2.2", "section_type": "heading", "page_number": 12, "source_document_type": "brand_book", "section_id": "ee7b7a67-c75b-45d1-8754-9b4a854b82ee", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:38b8e81a-af41-4c3a-9e9d-3ca01edcf351", "@type": "Section", "graphScope": "brand", "section_title": "VARGATEF ®  Logo", "section_type": "heading", "page_number": 12, "source_document_type": "brand_book", "section_id": "38b8e81a-af41-4c3a-9e9d-3ca01edcf351", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The VARGATEF ®  logo is provided for countries that will launch nintedanib under the brand name VARGATEF ®  for both the IPF and lung cancer indications. These countries are required to use the same brand name for both indications; therefore, use of the brand name OFEV ® is not permitted.\n\nGLoBAL LoGo\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7dbf2957-c600-41fa-b0d3-1718a868a054"}]}, {"@id": "urn:kg:ofev:section:ef34b48e-0e5e-4882-9a79-6dfb41444647", "@type": "Section", "graphScope": "brand", "section_title": "2.3", "section_type": "heading", "page_number": 13, "source_document_type": "brand_book", "section_id": "ef34b48e-0e5e-4882-9a79-6dfb41444647", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:65d2c824-63a6-469e-be0b-db9f6a41096c", "@type": "Section", "graphScope": "brand", "section_title": "Clear Space and Minimum Size", "section_type": "heading", "page_number": 13, "source_document_type": "brand_book", "section_id": "65d2c824-63a6-469e-be0b-db9f6a41096c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Clear space is the specified area of empty space surrounding our brandmark. Its use allows us to maintain our brandmark's visual integrity and impact. The 'O' height in 'OFEV ® ' scaled down to 75% of its original size represents 1x. A minimum clear space of 1x should be maintained around the entire mark at all times.\n\nThe minimum size of the OFEV ® brandmark is 7/8' (22 mm, 125 pixels) in width. To maintain legibility, the brandmark should never be smaller than this.\n\n<!-- image -->\n\ncLEAr SPAcE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->\n\nPrint: 7/8' (22 mm) diGitAL: 125 PixELS", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:43f8e335-4704-402b-a2e9-db53003e4474"}]}, {"@id": "urn:kg:ofev:section:e3615558-bafd-4acd-8ff6-5126857e819b", "@type": "Section", "graphScope": "brand", "section_title": "2.4", "section_type": "heading", "page_number": 14, "source_document_type": "brand_book", "section_id": "e3615558-bafd-4acd-8ff6-5126857e819b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:801dcd86-712c-48fb-acf7-fb7260c09039", "@type": "Section", "graphScope": "brand", "section_title": "Logo With Tagline", "section_type": "heading", "page_number": 14, "source_document_type": "brand_book", "section_id": "801dcd86-712c-48fb-acf7-fb7260c09039", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A version of our logo with our tagline, [TAGLINE TO COME], is also available for use. This version of our logo should be used in campaign and promotional materials.\n\nuS LoGo WitH tAGLinE\n\n<!-- image -->\n\nGLoBAL LoGo WitH tAGLinE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:22ae2e6b-2a62-4ce9-a8b6-41363b400154"}]}, {"@id": "urn:kg:ofev:section:27fc09db-234e-4c56-b413-f2d09375ddf1", "@type": "Section", "graphScope": "brand", "section_title": "cLEAr SPAcE", "section_type": "heading", "page_number": 14, "source_document_type": "brand_book", "section_id": "27fc09db-234e-4c56-b413-f2d09375ddf1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\n<!-- image -->\n\n= 1Y", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8fcbc796-54f1-404c-bebb-9cd56a4dda89"}]}, {"@id": "urn:kg:ofev:section:8c3fb4dd-f869-4916-8107-a8c5fb3744c0", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 15, "source_document_type": "brand_book", "section_id": "8c3fb4dd-f869-4916-8107-a8c5fb3744c0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "2.5", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d239ce1e-c463-41aa-8342-7bfa99613f58"}]}, {"@id": "urn:kg:ofev:section:1c400ae5-86da-4278-91b8-f9361af515bb", "@type": "Section", "graphScope": "brand", "section_title": "VARGATEF ®  Logo With Tagline", "section_type": "heading", "page_number": 15, "source_document_type": "brand_book", "section_id": "1c400ae5-86da-4278-91b8-f9361af515bb", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A version of the VARGATEF ®  logo with the tagline, [TAGLINE TO COME], is also available. This version should be used in countries that must launch with the same brand name for both the IPF and lung cancer indications and, therefore, cannot use the brand name OFEV ® .\n\nGLoBAL LoGo WitH tAGLinE\n\n<!-- image -->\n\n[taglIne to come]", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f8e7a59e-0afa-48b3-b790-0ac66d58e4dc"}]}, {"@id": "urn:kg:ofev:section:03eb814d-b01a-4c18-9d64-0678e2e079db", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 16, "source_document_type": "brand_book", "section_id": "03eb814d-b01a-4c18-9d64-0678e2e079db", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "2.6", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8268c91f-206e-4241-87ff-62ed2b16ffc5"}]}, {"@id": "urn:kg:ofev:section:eb34159f-a331-4242-be7d-f06e60c9aec5", "@type": "Section", "graphScope": "brand", "section_title": "Logo Color Versions", "section_type": "heading", "page_number": 16, "source_document_type": "brand_book", "section_id": "eb34159f-a331-4242-be7d-f06e60c9aec5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The preferred use of the OFEV ® logo is the CMYK version on a white background.\n\nThe CMYK and PMS logos are used when printing communication pieces. When printing in black and white, use the grayscale version of the logo. The RGB version of the logo should be used in digital applications, such as interfaces, websites, and PowerPoint presentations.\n\ncMYK\n\n(PrEFErrEd For ALL PrintEd coMMunicAtionS)\n\n<!-- image -->\n\n3 PMS (uSEd WHEn SPot coLor PrintinG iS tHE onLY oPtion AVAiLABLE)\n\n<!-- image -->\n\nrGB\n\n(uSEd For diGitAL APPLicAtionS)\n\n<!-- image -->\n\nGrAYScALE (uSEd WHEn FuLL-coLor PrintinG iS not AVAiLABLE)\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2cbdaba4-2e9b-4a28-873e-426accb5aad5"}]}, {"@id": "urn:kg:ofev:section:b4f82aad-4e21-401a-8889-67fa24902d7c", "@type": "Section", "graphScope": "brand", "section_title": "2.7", "section_type": "heading", "page_number": 17, "source_document_type": "brand_book", "section_id": "b4f82aad-4e21-401a-8889-67fa24902d7c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:7817974b-70c2-4470-84fe-2c20a81af5b7", "@type": "Section", "graphScope": "brand", "section_title": "Incorrect Usage of Logo", "section_type": "heading", "page_number": 17, "source_document_type": "brand_book", "section_id": "7817974b-70c2-4470-84fe-2c20a81af5b7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "It can be easy to misuse our logo when implementing across marketing materials.\n\nFor your reference, here are some ways our logo should not be used.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\ndo not rotAtE tHE LoGo\n\n<!-- image -->\n\ndo not iLLuStrAtE tHE LoGo\n\n<!-- image -->\n\n<!-- image -->\n\ndo not Add droP SHAdoWS to tHE LoGo\n\n<!-- image -->\n\ndo not uSE tHE LoGo in coPY\n\ndo not ModiFY or rEcrEAtE tHE LoGotYPE\n\n<!-- image -->\n\n<!-- image -->\n\ndo not PLAcE tHE LoGo on BAcKGroundS tHAt do not ProVidE SuFFiciEnt contrASt\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c5c970c5-d1dc-430b-aa43-f8f1d3dcb5bf"}]}, {"@id": "urn:kg:ofev:section:637f2ab6-00bf-479d-9266-b7d939745837", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 18, "source_document_type": "brand_book", "section_id": "637f2ab6-00bf-479d-9266-b7d939745837", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "8\n\n.\n\n2", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6ad8cafd-656e-48ff-b1bd-e58a74fe5500"}]}, {"@id": "urn:kg:ofev:section:566084cf-6fd5-494b-87b2-c5bd95e93cef", "@type": "Section", "graphScope": "brand", "section_title": "Typography", "section_type": "heading", "page_number": 18, "source_document_type": "brand_book", "section_id": "566084cf-6fd5-494b-87b2-c5bd95e93cef", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Typography is another important element of our brand identity and a way to express our personality. The OFEV ®  primary fonts are Co Text Bold and Co Text Light. Co Text complements the visual elements seen in the OFEV ®  symbol and is also the font that the OFEV ®  logotype is based on. The OFEV ®  secondary font, used for body copy, is the Gotham Family, including Gotham Book, Gotham Bold, and Gotham Italic.\n\n<!-- image -->\n\naa", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:223ed3a9-302c-4e86-ae1a-94e67801baad"}]}, {"@id": "urn:kg:ofev:section:837d4615-55af-4d94-aceb-fd491a13808d", "@type": "Section", "graphScope": "brand", "section_title": "Headlines should be Co Text Bold sentence case", "section_type": "heading", "page_number": 18, "source_document_type": "brand_book", "section_id": "837d4615-55af-4d94-aceb-fd491a13808d", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:a92bc9ec-5a1e-4db5-ac8c-cf0c815f43a7", "@type": "Section", "graphScope": "brand", "section_title": "SUBHEADS SHOULD BE CO TEXT BOLD ALL CAPS", "section_type": "heading", "page_number": 18, "source_document_type": "brand_book", "section_id": "a92bc9ec-5a1e-4db5-ac8c-cf0c815f43a7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Body copy should be Gotham Book sentence case in 80%K. Body call-outs should be in Gotham Bold.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ba94355c-92e1-4c5c-9493-b7496e521d65"}]}, {"@id": "urn:kg:ofev:section:8881096c-85d1-4667-a8ee-057bd34941e5", "@type": "Section", "graphScope": "brand", "section_title": "Call-outs should be Co Text Light sentence case", "section_type": "heading", "page_number": 18, "source_document_type": "brand_book", "section_id": "8881096c-85d1-4667-a8ee-057bd34941e5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:5d753302-7929-478a-be97-4b2e04df5836", "@type": "Section", "graphScope": "brand", "section_title": "2.9", "section_type": "heading", "page_number": 19, "source_document_type": "brand_book", "section_id": "5d753302-7929-478a-be97-4b2e04df5836", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:5d73ab60-4648-4da2-9902-581f07f9629f", "@type": "Section", "graphScope": "brand", "section_title": "Color Palette", "section_type": "heading", "page_number": 19, "source_document_type": "brand_book", "section_id": "5d73ab60-4648-4da2-9902-581f07f9629f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The OFEV ®  colors were selected to reinforce our brand identity and to differentiate our brand from competitors. They should be used to help maintain brand recognition and impact. The OFEV ®  core brand color is Guardian Blue, and it should be the most prominent color in the palette. In addition, Guardian Blue is the only color that should be used with the line pattern.\n\nThe three secondary colors, Inspiring Yellow, Brilliant Gold, and Premium Orange, reflect the colors used in the OFEV ®  gradient. Premium Orange may be used for highlights in applications as well as in typographical call-outs and subheads.\n\nComfort Gray is included as a neutral tertiary color that helps balance the palette. Comfort Gray can be used in clinical and scientific situations, such as in charts or to represent placebo.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e6a7b8d0-68e9-4af2-82d2-5efcf95e99b0"}]}, {"@id": "urn:kg:ofev:section:b56615fb-ea88-4be1-b049-104d7fe47534", "@type": "Section", "graphScope": "brand", "section_title": "2.10", "section_type": "heading", "page_number": 20, "source_document_type": "brand_book", "section_id": "b56615fb-ea88-4be1-b049-104d7fe47534", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:b6c67302-a0f0-4c66-aa02-059141f00da2", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics", "section_type": "heading", "page_number": 20, "source_document_type": "brand_book", "section_id": "b6c67302-a0f0-4c66-aa02-059141f00da2", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A secondary graphic is a brand element that symbolizes our personality and unifies our brand across all communications. Our secondary graphic is a combination of two geometric shapes: the Guardian Blue shape that appears on the bottom of the page, and the golden gradient shape that appears on the top of the page. Together, these two shapes create a space that represents the change OFEV ®  is creating in the path of IPF.\n\nThe two shapes that make up our secondary graphic should appear together on every communication piece. The Guardian Blue shape should never appear on a page without the golden gradient shape and vice versa.\n\nOur secondary graphic has been provided in both a vertical and a horizontal format for flexibility of use (see next page).\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c9970eeb-0fa3-4ca6-82f8-15f9ff4f9b86"}]}, {"@id": "urn:kg:ofev:section:70a9ffe8-bf36-4b7d-bb8b-cbccd27959a0", "@type": "Section", "graphScope": "brand", "section_title": "2.11", "section_type": "heading", "page_number": 21, "source_document_type": "brand_book", "section_id": "70a9ffe8-bf36-4b7d-bb8b-cbccd27959a0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:e3f4c465-5528-4fc3-b8f6-39435ba74bce", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics Flexibility", "section_type": "heading", "page_number": 21, "source_document_type": "brand_book", "section_id": "e3f4c465-5528-4fc3-b8f6-39435ba74bce", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Our secondary graphic has been designed to accommodate a variety of layouts and content. The shapes can be scaled up and down, adding flexibility to the system and allowing for different configurations of the shapes to provide a variety of layout options with a consistent look.\n\nThe Guardian Blue shape should always be dominant and the golden gradient shape should be used as an accent. The golden gradient shape should not take up more than 15% of the page.\n\n<!-- image -->\n\noFEV\\_HorizontAL\\_cMYK.Ai", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d9c7ad31-7c80-42c2-a1f2-6479152cbe29"}]}, {"@id": "urn:kg:ofev:section:15a37819-56b0-4631-9f09-a8b180c3adb9", "@type": "Section", "graphScope": "brand", "section_title": "2.12", "section_type": "heading", "page_number": 22, "source_document_type": "brand_book", "section_id": "15a37819-56b0-4631-9f09-a8b180c3adb9", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:04476e36-8a43-4bb4-aada-998924622c29", "@type": "Section", "graphScope": "brand", "section_title": "Line Pattern", "section_type": "heading", "page_number": 22, "source_document_type": "brand_book", "section_id": "04476e36-8a43-4bb4-aada-998924622c29", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A line pattern inspired by the core campaign has been incorporated into the Guardian Blue shape in our secondary graphic. The change of the angle in the line pattern reinforces the idea that OFEV ®  is changing the path of IPF.\n\nThis line pattern should only appear within the Guardian Blue shape in our secondary graphic.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:27c0e2df-cb36-4308-b8c5-df676e3ebeab"}]}, {"@id": "urn:kg:ofev:section:1a2fbddf-d90e-411c-972a-a3c1725d0026", "@type": "Section", "graphScope": "brand", "section_title": "2.13", "section_type": "heading", "page_number": 23, "source_document_type": "brand_book", "section_id": "1a2fbddf-d90e-411c-972a-a3c1725d0026", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:5a8ba6f3-cc81-411f-a127-d9ec2f3e648f", "@type": "Section", "graphScope": "brand", "section_title": "Holding Shape", "section_type": "heading", "page_number": 23, "source_document_type": "brand_book", "section_id": "5a8ba6f3-cc81-411f-a127-d9ec2f3e648f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The OFEV ®  holding shape provides yet another distinctive element to the brand's marketing materials. Available in horizontal and vertical formats, the holding shape can be easily scaled to fit any piece. It is designed to be consistent yet flexible for various types of content. When adjusting the size of the holding shape, be sure to scale all the pieces proportionally.\n\n<!-- image -->\n\nBAcKGround: 20% PMS 5425\n\n45\n\n°", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:72edc69b-77b9-4331-b0fb-00d9fd220d99"}]}, {"@id": "urn:kg:ofev:section:aa2386cc-9571-40fc-8fee-1b7b76b10490", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 24, "source_document_type": "brand_book", "section_id": "aa2386cc-9571-40fc-8fee-1b7b76b10490", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "e\n\nr\n\ns\n\ni\n\no\n\nn\n\n3\n\n1\n\n5\n\ny\n\n2\n\n0\n\nu\n\ne\n\nd\n\nM\n\na\n\nV\n\nI\n\ns", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:93af8b04-99f9-461c-b135-d5aabdaf6ad3"}]}, {"@id": "urn:kg:ofev:section:9a28edf9-a657-4740-91fa-e6b40ec46164", "@type": "Section", "graphScope": "brand", "section_title": "2.14", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "9a28edf9-a657-4740-91fa-e6b40ec46164", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:fdd01979-367a-4b85-a234-228dbc776c83", "@type": "Section", "graphScope": "brand", "section_title": "Chart Style", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "fdd01979-367a-4b85-a234-228dbc776c83", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "l\n\nu\n\ns\n\nt\n\nr\n\na\n\ne\n\nd\n\no\n\nn\n\nh\n\ni\n\np\n\ng\n\ne\n\ns\n\nt\n\nh\n\nu\n\nn\n\ni\n\nq\n\ne\n\nt\n\ny\n\nl\n\nf\n\nc\n\ne\n\no\n\nh\n\na\n\nr\n\nt\n\nh\n\ns\n\na\n\nb\n\ne\n\nn\n\nc\n\nr\n\na\n\nt\n\nd\n\nI\n\ns\n\nf\n\no\n\nr\n\nO\n\nF\n\nE\n\nV\n\n®\n\n.\n\nS\n\nH\n\nC\n\nP\n\nB\n\nR\n\nA\n\nN\n\nD\n\nE\n\nI\n\nT\n\nY\n\nO\n\nF\n\nE\n\nV\n\nA\n\nB\n\n)\n\nR\n\nY\n\nG\n\nU\n\nL\n\nS\n\n(\n\nN\n\nI\n\nT\n\nE\n\nD", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5e1a5fd9-699e-44be-b35a-315453b2beb6"}]}, {"@id": "urn:kg:ofev:section:a8cb9f90-4df3-4dd1-bcf8-3abd5f68564a", "@type": "Section", "graphScope": "brand", "section_title": "INPULSIS ® -1", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "a8cb9f90-4df3-4dd1-bcf8-3abd5f68564a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:32df6210-8b14-49e7-8b15-257e4f917871"}]}, {"@id": "urn:kg:ofev:section:e6fd98e1-bb7c-4d55-b4b5-5b9639a797d0", "@type": "Section", "graphScope": "brand", "section_title": "POOLED ANALYSIS", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "e6fd98e1-bb7c-4d55-b4b5-5b9639a797d0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4e271a1b-7a47-43fd-83c2-ebada6cd3d32"}]}, {"@id": "urn:kg:ofev:section:4f1d10a3-4ff3-4dce-aff2-5e32bed510c0", "@type": "Section", "graphScope": "brand", "section_title": "INPULSIS ® -1", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "4f1d10a3-4ff3-4dce-aff2-5e32bed510c0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:19458101-c6b7-4998-b3c0-3694e338ca3b"}]}, {"@id": "urn:kg:ofev:section:1bdda281-cba2-476e-a04d-135925331c8a", "@type": "Section", "graphScope": "brand", "section_title": "INPULSIS ® -2", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "1bdda281-cba2-476e-a04d-135925331c8a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:599bee68-cb70-4185-a556-a753258ddeca"}]}, {"@id": "urn:kg:ofev:section:8c2b3c20-0941-4396-9776-a0d4cf64a4b3", "@type": "Section", "graphScope": "brand", "section_title": "INPULSIS ® -2", "section_type": "heading", "page_number": 24, "source_document_type": "brand_book", "section_id": "8c2b3c20-0941-4396-9776-a0d4cf64a4b3", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\n.\n\nY\n\nR\n\nU\n\nS\n\nO\n\nN\n\nF\n\nI\n\nD\n\nE\n\nT\n\nA\n\nL\n\n.\n\nC\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9f02cddb-c8e5-49d1-9ce3-81ae62bf20d7"}]}, {"@id": "urn:kg:ofev:section:64b9c98e-60cb-4336-9bed-d4106491f857", "@type": "Section", "graphScope": "brand", "section_title": "2.15", "section_type": "heading", "page_number": 25, "source_document_type": "brand_book", "section_id": "64b9c98e-60cb-4336-9bed-d4106491f857", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:3337f9c8-fb07-47d0-b7ef-51734089cd34", "@type": "Section", "graphScope": "brand", "section_title": "Grid System", "section_type": "heading", "page_number": 25, "source_document_type": "brand_book", "section_id": "3337f9c8-fb07-47d0-b7ef-51734089cd34", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A grid provides the underlying structure for the page layout, in addition to maximum flexibility for text, color, and image placement. To ensure consistency throughout all OFEV ®  communications, we have developed a vertical grid and a horizontal grid.\n\nThe vertical grid has 8 columns and the horizontal grid has 8 columns. For doublepage spreads, the grid on the left page mirrors that of the right, allowing the inner and outer margins to be maintained while providing flexibility in choice of binding.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:869facea-ccd7-4db7-915f-025d4c66830f"}]}, {"@id": "urn:kg:ofev:section:0fb43b56-4f71-46c3-a724-734bcfd4b0e0", "@type": "Section", "graphScope": "brand", "section_title": "2.16", "section_type": "heading", "page_number": 26, "source_document_type": "brand_book", "section_id": "0fb43b56-4f71-46c3-a724-734bcfd4b0e0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:e0db6756-7ed7-4ae1-a3c8-8e4785d86090", "@type": "Section", "graphScope": "brand", "section_title": "Corporate Signature", "section_type": "heading", "page_number": 26, "source_document_type": "brand_book", "section_id": "e0db6756-7ed7-4ae1-a3c8-8e4785d86090", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A clear space should be maintained around the Boehringer Ingelheim logo with dimensions equal to the diameter of the Boehringer Ingelheim symbol.\n\nThe logo lockup has a standard height of 12 mm and should be no less than 6 mm.\n\n<!-- image -->\n\ncLEAr SPAcE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->\n\nStAndArd SizE\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:775be542-d4d8-42df-bc61-06fac07820fe"}]}, {"@id": "urn:kg:ofev:section:c334743b-e470-4cf9-8333-8d445b9d3086", "@type": "Section", "graphScope": "brand", "section_title": "2.17", "section_type": "heading", "page_number": 27, "source_document_type": "brand_book", "section_id": "c334743b-e470-4cf9-8333-8d445b9d3086", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:33bddce0-5909-45df-88d8-ab9481faca47", "@type": "Section", "graphScope": "brand", "section_title": "Branded Identity Assets Sumary", "section_type": "heading", "page_number": 27, "source_document_type": "brand_book", "section_id": "33bddce0-5909-45df-88d8-ab9481faca47", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Please use all of these assets consistently in all countries.\n\nLoGo\n\n<!-- image -->\n\nSEcondArY GrAPHicS\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2b3014a6-4c79-4f9d-af60-4e95ce063685"}]}, {"@id": "urn:kg:ofev:section:e649f197-b30a-4b7e-a5ea-8e6c642c2b31", "@type": "Section", "graphScope": "brand", "section_title": "tYPoGrAPHY", "section_type": "heading", "page_number": 27, "source_document_type": "brand_book", "section_id": "e649f197-b30a-4b7e-a5ea-8e6c642c2b31", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Headlines should be Co Text Bold sentence case\n\nSUBHEADS SHOULD BE CO TEXT BOLD ALL CAPS\n\nBody copy should be Gotham Book sentence case in 80%K. Body call-outs should be in Gotham Bold.\n\nCall-outs should be Co Text Light sentence case\n\n<!-- image -->\n\ncoLorS\n\n<!-- image -->\n\nPAttErn\n\n<!-- image -->\n\nHoLdinG SHAPE\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f80373c9-79f4-45dd-85f7-8c79a8443d39"}]}, {"@id": "urn:kg:ofev:section:c32f82a0-7397-487b-b65d-1cbb6df7becd", "@type": "Section", "graphScope": "brand", "section_title": "hcP Branded Identity System 3.0", "section_type": "heading", "page_number": 28, "source_document_type": "brand_book", "section_id": "c32f82a0-7397-487b-b65d-1cbb6df7becd", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The brand identity system is the recognizable way in which all of our brand identity assets are designed, managed, and used in all of our communication materials.\n\nOur brand identity system unifies our brand in a consistent, flexible, and ownable way across all channels, allowing us to communicate consistently to all audiences.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f00cf2eb-6bfe-4899-a964-900913611667"}]}, {"@id": "urn:kg:ofev:section:ee824406-4af4-4c66-8571-0bc8f8133c15", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 29, "source_document_type": "brand_book", "section_id": "ee824406-4af4-4c66-8571-0bc8f8133c15", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "1\n\n.\n\n3", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:1a993163-41f5-4bd3-b3d5-f58026197cd4"}]}, {"@id": "urn:kg:ofev:section:9e9613d9-071e-4a35-b725-506556d9b181", "@type": "Section", "graphScope": "brand", "section_title": "how our Brand Identity assets Work t ogether", "section_type": "heading", "page_number": 29, "source_document_type": "brand_book", "section_id": "9e9613d9-071e-4a35-b725-506556d9b181", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Assets such as typeface, color, and graphics together form our brand identity system, through which we achieve our unique look and feel. All of these elements were created to work together harmoniously and reffect the oFEV ®  brand personality.\n\nHcP ExAMPLE\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2614ea68-8bb3-4aeb-aef9-c58810c04f0b"}]}, {"@id": "urn:kg:ofev:section:24e61833-ef15-4152-b7b4-5f51b16b8e70", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 30, "source_document_type": "brand_book", "section_id": "24e61833-ef15-4152-b7b4-5f51b16b8e70", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "3.2", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5e3ea434-85bc-4d00-8fc3-e7c8e6039b7f"}]}, {"@id": "urn:kg:ofev:section:c1591e70-0ded-4407-8650-122f449bad23", "@type": "Section", "graphScope": "brand", "section_title": "Banners", "section_type": "heading", "page_number": 30, "source_document_type": "brand_book", "section_id": "c1591e70-0ded-4407-8650-122f449bad23", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "these banners were designed to establish a brand presence at conferences and trade shows.\n\n<!-- image -->\n\nOFEV ®  (NINTEDANIB) BRAND IDENTITY GUIDELINES HcP BrAndEd idEntitY SYStEM\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:847f2dc4-11cf-4317-a42d-bfa2772ad4b7"}]}, {"@id": "urn:kg:ofev:section:c0dbb8e3-9d0f-4362-a898-c28975672610", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 31, "source_document_type": "brand_book", "section_id": "c0dbb8e3-9d0f-4362-a898-c28975672610", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "3.3", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d9f8dcbd-5138-4538-8e15-7408a83cc660"}]}, {"@id": "urn:kg:ofev:section:b8266e38-807c-4da8-89a9-8d5ede055472", "@type": "Section", "graphScope": "brand", "section_title": "folder", "section_type": "heading", "page_number": 31, "source_document_type": "brand_book", "section_id": "b8266e38-807c-4da8-89a9-8d5ede055472", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "illustrated to the right is an example of our branded folder.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c1e09efb-ea49-4386-8b18-c84b5f1b71ec"}]}, {"@id": "urn:kg:ofev:section:47451d9b-c8d5-4193-a2e0-be7673f3570e", "@type": "Section", "graphScope": "brand", "section_title": "3.4", "section_type": "heading", "page_number": 32, "source_document_type": "brand_book", "section_id": "47451d9b-c8d5-4193-a2e0-be7673f3570e", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:c1c36d21-c7a0-47f8-a4f0-f41071e30991", "@type": "Section", "graphScope": "brand", "section_title": "PowerPoint templates", "section_type": "heading", "page_number": 32, "source_document_type": "brand_book", "section_id": "c1c36d21-c7a0-47f8-a4f0-f41071e30991", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "PowerPoint templates enable us to present information with clarity, credibility, and consistency.\n\nProMotionAL\n\n<!-- image -->\n\ncLinicAL\n\n<!-- image -->\n\nO\n\nF\n\nE\n\nV\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9c87ec3e-2aa1-4c24-ae7c-0bafb470ff9f"}]}, {"@id": "urn:kg:ofev:section:821ace64-8b21-45aa-bab9-d481cc5b0ca7", "@type": "Section", "graphScope": "brand", "section_title": "3.5 Interactive", "section_type": "heading", "page_number": 33, "source_document_type": "brand_book", "section_id": "821ace64-8b21-45aa-bab9-d481cc5b0ca7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:50fc1146-6eab-4ccb-b9aa-57c2c3597691", "@type": "Section", "graphScope": "brand", "section_title": "visual aid", "section_type": "heading", "page_number": 33, "source_document_type": "brand_book", "section_id": "50fc1146-6eab-4ccb-b9aa-57c2c3597691", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "the oFEV ®  interactive visual aid showcases the branding in a digital platform. it allows Sales representatives and HcPs to quickly access information and helps facilitate the dialogue.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:794739b2-d86c-4afe-8fd8-d32a3050dc78"}]}, {"@id": "urn:kg:ofev:section:7810f3bd-9b5c-4f08-8aea-90e191ea25fe", "@type": "Section", "graphScope": "brand", "section_title": "3.0 Logo Rationale 3.6 monograph cover", "section_type": "heading", "page_number": 34, "source_document_type": "brand_book", "section_id": "7810f3bd-9b5c-4f08-8aea-90e191ea25fe", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "and Construction\n\nThe OFEV® brandmark consists of 3 this example demonstrates how the brand identity assets create a dynamic layout.\n\nelements: the logotype, the symbol,\n\nand the generic name. The brandmark\n\nis a depiction of wings in motion that\n\ndependably guards over patients.\n\nBecause the symbol is moving forward,\n\nit embodies high performance while also\n\nbeing inspiring. The dark blue and all\n\ncaps typeface communicate reliability\n\nand vigilance. Personality traits that\n\ncome through   in this brandmark: High\n\nperforming, Protective\n\nLorem ipsum dolor sit amet, consectetur\n\nadipiscing elit. Maecenas molestie lacinia\n\norci. Nunc mi turpis, vulputate et pharetra\n\nsed, convallis ut sapien. Proin auctor\n\nmauris in egestas rutrum. Aenean arcu\n\nmetus, blandit in risus a, feugiat mattis mi.\n\nPhasellus ultricies est in massa posuere,\n\nin imperdiet orci auctor. Nullam tincidunt\n\nurna quis lorem lacinia, sed euismod diam\n\nconsequat. Donec quis fringilla magna.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:95744a4c-8e3d-469c-ad31-4e852d3133bb"}]}, {"@id": "urn:kg:ofev:section:5c02e58f-d437-4892-839f-e2623ccf518e", "@type": "Section", "graphScope": "brand", "section_title": "3.0 Logo Rationale 3.7 monograph Spread", "section_type": "heading", "page_number": 35, "source_document_type": "brand_book", "section_id": "5c02e58f-d437-4892-839f-e2623ccf518e", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "and Construction\n\nThe OFEV® brandmark consists of 3 the monograph spread is a good example of how the brand identity assets work together.\n\nelements: the logotype, the symbol,\n\nand the generic name. The brandmark\n\nis a depiction of wings in motion that\n\ndependably guards over patients.\n\nBecause the symbol is moving forward,\n\nit embodies high performance while also\n\nbeing inspiring. The dark blue and all\n\ncaps typeface communicate reliability\n\nand vigilance. Personality traits that\n\ncome through   in this brandmark: High\n\nperforming, Protective\n\nLorem ipsum dolor sit amet, consectetur\n\nadipiscing elit. Maecenas molestie lacinia\n\norci. Nunc mi turpis, vulputate et pharetra\n\nsed, convallis ut sapien. Proin auctor\n\nmauris in egestas rutrum. Aenean arcu\n\nmetus, blandit in risus a, feugiat mattis mi.\n\nPhasellus ultricies est in massa posuere,\n\nin imperdiet orci auctor. Nullam tincidunt\n\nurna quis lorem lacinia, sed euismod diam\n\nconsequat. Donec quis fringilla magna.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:57808c0e-243c-44dc-ad61-a25aa614b07e"}]}, {"@id": "urn:kg:ofev:section:7acb7805-523b-488f-8421-149f8d133751", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 1, "source_document_type": "product_information", "section_id": "7acb7805-523b-488f-8421-149f8d133751", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "<!-- image -->\n\nEMA/66511/2025 EMEA/H/C/003821", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8f29c178-c75d-4841-bf0d-1415c9e3947d"}]}, {"@id": "urn:kg:ofev:section:b8b10953-95c7-413d-a909-6022cf02797a", "@type": "Section", "graphScope": "brand", "section_title": "Ofev ( nintedanib )", "section_type": "heading", "page_number": 1, "source_document_type": "product_information", "section_id": "b8b10953-95c7-413d-a909-6022cf02797a", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": ""}, {"@id": "urn:kg:ofev:section:6e22bd8c-fd4c-4bd9-82c0-e11b4a5ab450", "@type": "Section", "graphScope": "brand", "section_title": "An overview of Ofev and why it is authorised in the EU", "section_type": "heading", "page_number": 1, "source_document_type": "product_information", "section_id": "6e22bd8c-fd4c-4bd9-82c0-e11b4a5ab450", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": ""}, {"@id": "urn:kg:ofev:section:da9b36ca-7e9f-47e9-89c1-167e724757c3", "@type": "Section", "graphScope": "brand", "section_title": "What is Ofev and what is it used for?", "section_type": "heading", "page_number": 1, "source_document_type": "product_information", "section_id": "da9b36ca-7e9f-47e9-89c1-167e724757c3", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev is a medicine used to treat:\n\n-  adults with idiopathic pulmonary fibrosis (IPF), a disease of unknown cause in which fibrous (scar) tissue forms in the lungs;\n-  adults and children above the age of 6 years with systemic sclerosis-associated interstitial lung disease (ILD), a disease in which the immune system (the body's natural defences) is overactive, causing development of fibrous tissue and progressive scarring of the lungs;\n-  adults with other chronic interstitial lung diseases that are fibrosing (causing production of fibrous tissue) and progressive (getting worse);\n-  children aged 6 to 17 years with clinically significant,  progressive fibrosing ILDs.\n\nOfev contains the active substance nintedanib.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:69dec0e2-5c34-4d10-ad01-644c09037b23"}]}, {"@id": "urn:kg:ofev:section:c2ba0763-97e9-48b9-9e73-0a6fde6ab1db", "@type": "Section", "graphScope": "brand", "section_title": "How is Ofev used?", "section_type": "heading", "page_number": 1, "source_document_type": "product_information", "section_id": "c2ba0763-97e9-48b9-9e73-0a6fde6ab1db", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev can only be obtained with a prescription, and treatment should be started by a doctor experienced in the diagnosis and treatment of the diseases it is used for. For children, treatment should be started only after involvement of a multidisciplinary team (physicians, radiologists, pathologists) experienced in the diagnosis and treatment of ILDs.\n\nOfev is available as capsules taken twice a day with food, approximately 12 hours apart. In patients who do not tolerate this dose, the doctor should reduce the dose or interrupt treatment.\n\nChildren receiving Ofev will undergo dental examinations at least every six months until their teeth are fully developed, and their growth will be monitored annually through bone imaging.\n\nFor more information about using Ofev, see the package leaflet or contact your doctor or pharmacist.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:fd14a398-b3fb-4349-aa42-d0cf48f899d4"}]}, {"@id": "urn:kg:ofev:section:431a8949-d68d-4026-b6fc-068dc633baa9", "@type": "Section", "graphScope": "brand", "section_title": "How does Ofev work?", "section_type": "heading", "page_number": 2, "source_document_type": "product_information", "section_id": "431a8949-d68d-4026-b6fc-068dc633baa9", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "The active substance in Ofev, nintedanib, blocks the activity of some enzymes known as tyrosine kinases. These enzymes are present in certain receptors (such as VEGF, FGF and PDGF receptors) in cells in the lungs, where they activate several processes involved in the generation of fibrous tissue. By blocking these enzymes, nintedanib helps to reduce the formation of fibrous tissue in the lungs, thereby helping to prevent worsening of the disease symptoms.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:812580b2-9cbf-4dc3-9184-024ee5c3a724"}]}, {"@id": "urn:kg:ofev:section:13760ddc-2921-4e57-b3f1-f2f10da5c57a", "@type": "Section", "graphScope": "brand", "section_title": "What benefits of Ofev have been shown in studies?", "section_type": "heading", "page_number": 2, "source_document_type": "product_information", "section_id": "13760ddc-2921-4e57-b3f1-f2f10da5c57a", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev has been compared with placebo (a dummy treatment) in four main studies involving a total of 1,066 adults with IPF, 580 adults with systemic sclerosis-associated ILD and 663 adults with progressive fibrosing ILD. In all studies, the main measure of effectiveness was the decline in the functioning of the patients' lungs over the course of 1 year of treatment, measured by their forced vital capacity (FVC). FVC is the maximum amount of air a person can breathe out forcefully after taking in a deep breath and decreases as the condition gets worse.\n\nIn 2 studies involving adults with IPF, patients taking Ofev had a smaller decline in FVC than patients taking placebo, meaning that Ofev slowed down the worsening of the condition. The average FVC before treatment was between 2,600 and 2,700 millilitres (ml). In the first study, the average decrease in FVC over 1 year was 115 ml in patients taking Ofev compared with 240 ml in patients taking placebo. In the second study, the average decrease was 114 ml for Ofev compared with 207 ml for placebo. A further analysis of the results of the 2 main studies, which took into account that some patients stopped treatment, confirmed the benefits of Ofev over placebo, although the difference in FVC between the two was less pronounced.\n\nIn the study involving adult patients with systemic sclerosis-associated ILD, the average decrease in FVC was 52 ml for Ofev compared with 93 ml for placebo. The average FVC before treatment was around 2,500 ml.\n\nIn the study in adults with progressive fibrosing ILD, the average decrease in FVC was 81 ml for Ofev compared with 188 ml for placebo. The average FVC before treatment was around 2,330 ml.\n\nIn addition, data in children with fibrosing ILD aged 6 to 17 years showed that, at the recommended doses, blood levels of the medicine were similar to those seen in adults at the recommended doses.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ec588503-a85b-4bcb-8500-2c3fe93d7623"}, {"@id": "urn:kg:ofev:chunk:a8dc6f2c-b420-473a-a407-471aadb14930"}]}, {"@id": "urn:kg:ofev:section:305d4f42-378d-478d-aaa3-ac9d5c838b6a", "@type": "Section", "graphScope": "brand", "section_title": "What are the risks associated with Ofev?", "section_type": "heading", "page_number": 2, "source_document_type": "product_information", "section_id": "305d4f42-378d-478d-aaa3-ac9d5c838b6a", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "For the full list of side effects and restrictions with Ofev, see the package leaflet.\n\nThe most common side effects with Ofev (which may affect more than 1 in 10 people) include diarrhoea, nausea (feeling sick), vomiting, abdominal pain (belly ache), decreased appetite and raised levels of liver enzymes in the blood (a sign of liver problems). Weight loss (which may affect up to 1 in 10 people) is also common.\n\nOfev must not be used in patients who are hypersensitive (allergic) to nintedanib, peanut or soya, or any of the other ingredients. Ofev must also not be used in pregnant women.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:cbc212ea-e6ed-48c7-bd7a-19252dd56e26"}]}, {"@id": "urn:kg:ofev:section:8725de24-48b7-4c09-8ba2-7d1eefd322aa", "@type": "Section", "graphScope": "brand", "section_title": "Why is Ofev authorised in the EU?", "section_type": "heading", "page_number": 2, "source_document_type": "product_information", "section_id": "8725de24-48b7-4c09-8ba2-7d1eefd322aa", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "The European Medicines Agency decided that Ofev's benefits are greater than its risks and it can be authorised for use in the EU. The Agency considered that Ofev is effective at slowing down the worsening of lung function in adult patients with IPF, systemic sclerosis-associated ILD and other chronic fibrosing ILDs that are progressive.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:744166f0-37e1-45ab-8068-09885063c733"}]}, {"@id": "urn:kg:ofev:section:cb34e383-a4e4-405d-9df0-348aeeed7701", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 3, "source_document_type": "product_information", "section_id": "cb34e383-a4e4-405d-9df0-348aeeed7701", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Based on the disease characteristics and how the medicine works, the medicine's effectiveness for treating clinically significant progressive fibrosing ILD and systemic sclerosis-associated ILD in children is expected to be similar as in adults. However, long-term safety data for children are not available and there are uncertainties on the potential impact on growth and tooth development, which require regular monitoring.\n\nRegarding safety, the side effects associated with Ofev were considered manageable with dose interruptions or reductions.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:63596c76-dcbc-44f1-899a-754eed9b302f"}]}, {"@id": "urn:kg:ofev:section:dc466117-741b-4411-a8c6-0893e6dd88bc", "@type": "Section", "graphScope": "brand", "section_title": "What measures are being taken to ensure the safe and effective use of Ofev?", "section_type": "heading", "page_number": 3, "source_document_type": "product_information", "section_id": "dc466117-741b-4411-a8c6-0893e6dd88bc", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Recommendations and precautions to be followed by healthcare professionals and patients for the safe and effective use of Ofev have been included in the summary of product characteristics and the package leaflet.\n\nAs for all medicines, data on the use of Ofev are continuously monitored. Side effects reported with Ofev are carefully evaluated and any necessary action taken to protect patients.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b8694e1f-60ff-4cd0-9c61-96e111b258b5"}]}, {"@id": "urn:kg:ofev:section:334a4964-ba3d-453c-aba8-6208c206a20c", "@type": "Section", "graphScope": "brand", "section_title": "Other information about Ofev", "section_type": "heading", "page_number": 3, "source_document_type": "product_information", "section_id": "334a4964-ba3d-453c-aba8-6208c206a20c", "extraction_method": "docling", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev received a marketing authorisation valid throughout the EU on 14 January 2015.\n\nFurther information on Ofev can be found on the Agency's website: ema.europa.eu/medicines/human/EPAR/ofev.\n\nThis overview was last updated in 01-2025.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a96cf3c8-1a17-4e3c-bd1d-303086e8776f"}]}, {"@id": "urn:kg:ofev:section:eab8203a-a7e4-4af4-9a88-ead72d731491", "@type": "Section", "graphScope": "brand", "section_title": "8.8  Smokers", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "eab8203a-a7e4-4af4-9a88-ead72d731491", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Smoking was associated with decreased exposure to OFEV [see Clinical Pharmacology (12.3)], which may alter the efficacy profile of OFEV . Encourage patients to stop smoking prior to treatment with OFEV and to avoid smoking when using OFEV.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ee99340c-2dce-4217-9b1b-3b8d92c9e10a"}]}, {"@id": "urn:kg:ofev:section:c9cf59d0-cdc4-47b3-ac2e-23f72b2d0b02", "@type": "Section", "graphScope": "brand", "section_title": "Patients with Renal Impairment", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "c9cf59d0-cdc4-47b3-ac2e-23f72b2d0b02", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on a population PK analysis of data from 933 patients with IPF, exposure to nintedanib was not influenced by mild (CrCl: 60 to 90 mL/min; n=399) or moderate (CrCl: 30 to 60 mL/min; n=116) renal impairment. Data in severe renal impairment (CrCl below 30 mL/min) was limited.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6bc50deb-7929-463f-a5d3-f5f0a1483e84"}]}, {"@id": "urn:kg:ofev:section:96d38928-6fe8-4fae-bf41-95f4878df0c8", "@type": "Section", "graphScope": "brand", "section_title": "HIGHLIGHTS OF PRESCRIBING INFORMATION", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "96d38928-6fe8-4fae-bf41-95f4878df0c8", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "These highlights do not include all the information needed to use OFEV safely and effectively. See full prescribing information for OFEV.\n\nOFEV ®  (nintedanib capsules), for oral use Initial U.S. Approval: 2014", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8df6587d-30fb-4061-b3b2-d73130ed1604"}]}, {"@id": "urn:kg:ofev:section:164ad312-f86c-41c1-ba2c-afce22038fc5", "@type": "Section", "graphScope": "brand", "section_title": "----------------------------INDICATIONS AND USAGE---------------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "164ad312-f86c-41c1-ba2c-afce22038fc5", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is a kinase inhibitor indicated in adults for:\n\n- Treatment of idiopathic pulmonary fibrosis (IPF) (1.1)\n- Treatment of chronic fibrosing interstitial lung diseases (ILDs) with a progressive phenotype (1.2)\n- Slowing the rate of decline in pulmonary function in patients with systemic sclerosis-associated interstitial lung disease (SSc-ILD) (1.3)", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e0cf4742-4821-4ae0-9872-8c33c1206da4"}]}, {"@id": "urn:kg:ofev:section:6e058b55-c461-46b2-b07a-9d99ebc88ec7", "@type": "Section", "graphScope": "brand", "section_title": "----------------------DOSAGE AND ADMINISTRATION-----------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "6e058b55-c461-46b2-b07a-9d99ebc88ec7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Recommended dosage: 150 mg taken orally twice daily approximately 12 hours apart taken with food. (2.2)\n- Recommended dosage in patients with mild hepatic impairment (Child Pugh A): 100 mg taken orally twice daily approximately 12 hours apart taken with food. (2.3, 8.6)\n- Consider temporary dose reduction to 100 mg, treatment interruption, or discontinuation for management of adverse reactions. (2.4, 5.2, 5.3, 6)\n- Prior to treatment initiation, conduct liver function tests in all patients and a pregnancy test in females of reproductive potential. (2.1, 5.2, 5.4)", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:73a6d5b5-26ba-4276-b1b4-7f36c7767d89"}]}, {"@id": "urn:kg:ofev:section:fc8653d0-43b8-40b5-a2e3-796578bedd9b", "@type": "Section", "graphScope": "brand", "section_title": "---------------------DOSAGE FORMS AND STRENGTHS----------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "fc8653d0-43b8-40b5-a2e3-796578bedd9b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Capsules: 150 mg and 100 mg (3)\n\n-------------------------------CONTRAINDICATIONS------------------------------\n\nNone (4)", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9d718cc1-dce8-4385-96b9-c5d6bc52e9a6"}]}, {"@id": "urn:kg:ofev:section:688df660-1573-4aa4-9374-bac703e0b348", "@type": "Section", "graphScope": "brand", "section_title": "-----------------------WARNINGS AND PRECAUTIONS------------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "688df660-1573-4aa4-9374-bac703e0b348", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Hepatic impairment: OFEV is not recommended for use in patients with moderate or severe hepatic impairment. In patients with mild hepatic impairment (Child Pugh A), the recommended dosage is 100 mg twice daily approximately 12 hours apart taken with food. Consider treatment interruption, or discontinuation for management of adverse reactions in these patients. (2.3, 2.4, 5.1, 8.6, 12.3)\n- Elevated liver enzymes and drug-induced liver injury: ALT, AST, and bilirubin elevations have occurred with OFEV, including cases of druginduced liver injury. In the postmarketing period, non-serious and serious cases of drug-induced liver injury, including severe liver injury with fatal outcome, have been reported. The majority of hepatic events occur within the first three months of treatment. Liver enzyme and bilirubin increases were reversible with dose modification or interruption in the majority of cases. Monitor ALT, AST, and bilirubin prior to initiation of treatment, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Temporary dosage reductions or discontinuations may be required. (2.1, 2.4, 5.2)\n- Gastrointestinal disorders: Diarrhea, nausea, and vomiting have occurred with OFEV. Treat patients at first signs with adequate hydration and antidiarrheal medicine (e.g., loperamide) or anti-emetics. Discontinue OFEV if severe diarrhea, nausea, or vomiting persists despite symptomatic treatment. (5.3)\n- Embryo-Fetal toxicity: Can cause fetal harm. Advise females of reproductive potential of the potential risk to a fetus and to use highly effective contraception. Advise women taking oral hormonal contraceptives experiencing vomiting, diarrhea, or other conditions where the drug absorption may be reduced to use alternative highly effective contraception. (5.4, 8.1, 8.3)\n- Arterial thromboembolic events have been reported. Use caution when treating patients at higher cardiovascular risk including known coronary artery disease. (5.5)\n- Bleeding events have been reported. Use OFEV in patients with known bleeding risk only if anticipated benefit outweighs the potential risk. (5.6)\n- Gastrointestinal perforation has been reported. Use OFEV with caution when treating patients with recent abdominal surgery, previous history of diverticular disease or receiving concomitant corticosteroids or NSAIDs. Discontinue OFEV in patients who develop gastrointestinal perforation. Only use OFEV in patients with known risk of gastrointestinal perforation if the anticipated benefit outweighs the potential risk. (5.7)\n- Nephrotic range proteinuria has been reported. Consider treatment interruption in patients who develop new or worsening proteinuria. (5.8)\n\n------------------------------ADVERSE REACTIONS-------------------------------\n\nMost common adverse reactions (≥5%) are: diarrhea, nausea, abdominal pain, vomiting, liver enzyme elevation, decreased appetite, headache, weight decreased, and hypertension. (6.1)\n\nTo report SUSPECTED ADVERSE REACTIONS, contact Boehringer Ingelheim Pharmaceuticals, Inc. at (800) 542-6257 or FDA at 1-800-FDA1088 or www.fda.gov/medwatch .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c6da9989-0f53-4df1-94f6-389e0eb85c8e"}, {"@id": "urn:kg:ofev:chunk:bd177582-6933-48aa-8ec6-898b8f7463c7"}, {"@id": "urn:kg:ofev:chunk:3074a971-f4c1-454c-b0fb-38123ff06a06"}, {"@id": "urn:kg:ofev:chunk:3099738b-7fd7-4e84-9826-4177c8bff178"}]}, {"@id": "urn:kg:ofev:section:ec2cf348-f6af-4ee0-ade1-f87726f92c1f", "@type": "Section", "graphScope": "brand", "section_title": "-------------------------------DRUG INTERACTIONS------------------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "ec2cf348-f6af-4ee0-ade1-f87726f92c1f", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Coadministration of P-gp and CYP3A4 inhibitors may increase nintedanib exposure. Monitor patients closely for tolerability of OFEV. (7.1)", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6b303cd4-8720-4e20-ad1c-bc3590d3abc3"}]}, {"@id": "urn:kg:ofev:section:9fdcda17-4250-4366-892a-14b50500c12e", "@type": "Section", "graphScope": "brand", "section_title": "-----------------------USE IN SPECIFIC POPULATIONS------------------------", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "9fdcda17-4250-4366-892a-14b50500c12e", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Lactation: Breastfeeding is not recommended. (8.2)\n- Renal impairment: The safety and efficacy of OFEV have not been studied in patients with severe renal impairment and end-stage renal disease. (8.7, 12.3)\n- Smokers: Decreased exposure has been noted in smokers which may alter the efficacy profile of OFEV. (8.8)\n\nSee 17 for PATIENT COUNSELING INFORMATION and FDAapproved patient labeling.\n\nRevised: 06/2024\n\n\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:78a86ca0-d856-40ff-8380-dc7b1615b2fe"}]}, {"@id": "urn:kg:ofev:section:f9739371-07a0-42b3-8334-bd81045f713b", "@type": "Section", "graphScope": "brand", "section_title": "FULL PRESCRIBING INFORMATION: CONTENTS*", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "f9739371-07a0-42b3-8334-bd81045f713b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:d3850114-8def-4c6a-b090-f07c0535d3b6", "@type": "Section", "graphScope": "brand", "section_title": "1 INDICATIONS AND USAGE", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "d3850114-8def-4c6a-b090-f07c0535d3b6", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 1.1 Idiopathic Pulmonary Fibrosis\n- 1.2 Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype\n- 1.3 Systemic Sclerosis-Associated Interstitial Lung Disease", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:186e365f-084e-44e2-93fa-d76a700bcb86"}]}, {"@id": "urn:kg:ofev:section:88f7c10f-7855-49e5-9698-23d306d76750", "@type": "Section", "graphScope": "brand", "section_title": "2  DOSAGE AND ADMINISTRATION", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "88f7c10f-7855-49e5-9698-23d306d76750", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 2.1 Testing Prior to OFEV Administration\n- 2.2 Recommended Dosage\n- 2.3 Recommended Dosage for Patients with Hepatic Impairment\n- 2.4 Dosage Modification due to Adverse Reactions\n- 3  DOSAGE FORMS AND STRENGTHS\n- 4  CONTRAINDICATIONS", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:87f359cb-264d-48c6-b9a0-18f0dbfa1361"}]}, {"@id": "urn:kg:ofev:section:7c7c699f-44b8-4a6a-a888-0055e70596e1", "@type": "Section", "graphScope": "brand", "section_title": "5  WARNINGS AND PRECAUTIONS", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "7c7c699f-44b8-4a6a-a888-0055e70596e1", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 5.1 Hepatic Impairment\n- 5.2 Elevated Liver Enzymes and Drug-Induced Liver Injury\n- 5.3 Gastrointestinal Disorders\n- 5.4 Embryo-Fetal Toxicity\n- 5.5 Arterial Thromboembolic Events\n- 5.6 Risk of Bleeding\n- 5.7 Gastrointestinal Perforation\n- 5.8 Nephrotic Range Proteinuria", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:bcc805d3-1a68-4adf-ba28-e9357402711e"}]}, {"@id": "urn:kg:ofev:section:ea96f293-17db-4474-acdf-8214f7d8372e", "@type": "Section", "graphScope": "brand", "section_title": "6  ADVERSE REACTIONS", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "ea96f293-17db-4474-acdf-8214f7d8372e", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 6.1 Clinical Trials Experience\n- 6.2 Postmarketing Experience", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e9d08a80-6411-4c9a-8155-756fb1e8bbdc"}]}, {"@id": "urn:kg:ofev:section:970c5868-991c-4d68-926e-5febc4458981", "@type": "Section", "graphScope": "brand", "section_title": "7  DRUG INTERACTIONS", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "970c5868-991c-4d68-926e-5febc4458981", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 7.1 P-glycoprotein (P-gp) and CYP3A4 Inhibitors and Inducers\n- 7.2 Anticoagulants\n- 7.3 Pirfenidone\n- 7.4 Bosentan", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c7f3d39f-3f4c-4484-a170-4ae23a2dc054"}]}, {"@id": "urn:kg:ofev:section:4710c794-ec31-42e5-aabe-d350fb6966de", "@type": "Section", "graphScope": "brand", "section_title": "8 USE IN SPECIFIC POPULATIONS", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "4710c794-ec31-42e5-aabe-d350fb6966de", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 8.1 Pregnancy\n- 8.2 Lactation\n- 8.3 Females and Males of Reproductive Potential\n- 8.4 Pediatric Use\n- 8.5 Geriatric Use\n- 8.6 Hepatic Impairment\n- 8.7 Renal Impairment\n- 8.8 Smokers\n- 10 OVERDOSAGE\n- 11 DESCRIPTION", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:bc5f9930-bc24-4215-a489-77ff2a30f6b2"}]}, {"@id": "urn:kg:ofev:section:d2ad3259-c669-4849-9f6e-730a52da8615", "@type": "Section", "graphScope": "brand", "section_title": "12 CLINICAL PHARMACOLOGY", "section_type": "heading", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "d2ad3259-c669-4849-9f6e-730a52da8615", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 12.1  Mechanism of Action\n- 12.2  Pharmacodynamics", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:337c0498-eaa8-4fc3-b5d1-90f16f0a97e5"}]}, {"@id": "urn:kg:ofev:section:d21ab2d0-a27c-452e-adb1-1b2eca277610", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "d21ab2d0-a27c-452e-adb1-1b2eca277610", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "12.3  Pharmacokinetics", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:14faf55e-820f-4d4c-8ed9-9d8edf05a07b"}]}, {"@id": "urn:kg:ofev:section:8812673f-987c-43b7-925c-d8682e41f5c2", "@type": "Section", "graphScope": "brand", "section_title": "13 NONCLINICAL TOXICOLOGY", "section_type": "heading", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "8812673f-987c-43b7-925c-d8682e41f5c2", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "13.1  Carcinogenesis, Mutagenesis, Impairment of Fertility", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:1ede9d7f-ff8c-49a9-a4e2-dc77b406b5d4"}]}, {"@id": "urn:kg:ofev:section:148a6661-0169-4838-9609-f205e4a18d47", "@type": "Section", "graphScope": "brand", "section_title": "14 CLINICAL STUDIES", "section_type": "heading", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "148a6661-0169-4838-9609-f205e4a18d47", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "14.1  Idiopathic Pulmonary Fibrosis\n\n14.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:0a56879d-dd6b-43f4-a7d9-f9316945d53e"}]}, {"@id": "urn:kg:ofev:section:6b81ea50-7d91-48f7-864b-1a95b9e5e9db", "@type": "Section", "graphScope": "brand", "section_title": "Phenotype", "section_type": "heading", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "6b81ea50-7d91-48f7-864b-1a95b9e5e9db", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "14.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d4fe2489-738d-4a4a-a03a-546635b12494"}]}, {"@id": "urn:kg:ofev:section:9215197a-682f-47d6-8784-856d1089e686", "@type": "Section", "graphScope": "brand", "section_title": "16 HOW SUPPLIED/STORAGE AND HANDLING 17 PATIENT COUNSELING INFORMATION", "section_type": "heading", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "9215197a-682f-47d6-8784-856d1089e686", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "*Sections or subsections omitted from the full prescribing information are not listed.\n\n\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:44bdc33b-e786-4c98-a0c3-83ffe7a7388a"}]}, {"@id": "urn:kg:ofev:section:e15fbcb5-0b00-4791-8d8f-69592c273a11", "@type": "Section", "graphScope": "brand", "section_title": "FULL PRESCRIBING INFORMATION", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "e15fbcb5-0b00-4791-8d8f-69592c273a11", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:bbcebda3-f550-45d8-aafc-3ebda9f7426c", "@type": "Section", "graphScope": "brand", "section_title": "1 INDICATIONS AND USAGE", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "bbcebda3-f550-45d8-aafc-3ebda9f7426c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "@type": "Section", "graphScope": "brand", "section_title": "1.1  Idiopathic Pulmonary Fibrosis", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated for the treatment of adults with idiopathic pulmonary fibrosis (IPF).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5156eef8-6fc1-4b91-b330-9e3cfaa52b70"}]}, {"@id": "urn:kg:ofev:section:ea8e62e0-53b8-430f-943a-c799fa9eee3d", "@type": "Section", "graphScope": "brand", "section_title": "1.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "ea8e62e0-53b8-430f-943a-c799fa9eee3d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated for the treatment of adults with chronic fibrosing interstitial lung diseases (ILDs) with a progressive phenotype [see Clinical Studies (14.2)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:49738c53-79f7-4673-a6fe-d40ef56c8511"}]}, {"@id": "urn:kg:ofev:section:efb29753-d5d1-492e-ba48-17c2159184d0", "@type": "Section", "graphScope": "brand", "section_title": "1.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "efb29753-d5d1-492e-ba48-17c2159184d0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated to slow the rate of decline in pulmonary function in adult patients with systemic sclerosisassociated interstitial lung disease (SSc-ILD).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:77514d30-8ee2-497e-8879-7a519bd2a338"}]}, {"@id": "urn:kg:ofev:section:a08245b6-6bde-4322-9df9-558538b91313", "@type": "Section", "graphScope": "brand", "section_title": "2 DOSAGE AND ADMINISTRATION", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "a08245b6-6bde-4322-9df9-558538b91313", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:a80139d2-f611-4453-b99b-71578451a7bb", "@type": "Section", "graphScope": "brand", "section_title": "2.1  Testing Prior to OFEV Administration", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "a80139d2-f611-4453-b99b-71578451a7bb", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Conduct liver function tests in all patients and a pregnancy test in females of reproductive potential prior to initiating treatment with OFEV [see Warnings and Precautions (5.2, 5.4)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5830abf3-0056-4e13-b25d-7c60b3df9a62"}]}, {"@id": "urn:kg:ofev:section:495cbee6-ed37-438c-b6bd-b8c671af5b9d", "@type": "Section", "graphScope": "brand", "section_title": "2.2  Recommended Dosage", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "495cbee6-ed37-438c-b6bd-b8c671af5b9d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The recommended dosage of OFEV is 150 mg taken orally twice daily administered approximately 12 hours apart.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2245005a-4ffd-4e6a-8c75-47b5e9c9f10e"}]}, {"@id": "urn:kg:ofev:section:2fb52a50-d6de-4fb8-99cc-e9af0c25d9cb", "@type": "Section", "graphScope": "brand", "section_title": "Administration Information", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "2fb52a50-d6de-4fb8-99cc-e9af0c25d9cb", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV capsules should be taken with food [see Clinical Pharmacology (12.3)] and swallowed whole with liquid. OFEV capsules should not be chewed because of a bitter taste.\n\nOFEV capsules should not be opened or crushed. If contact with the content of the capsule occurs, wash hands immediately and thoroughly. The effect of chewing or crushing of the capsule on the pharmacokinetics of nintedanib is not known.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:25363df5-f6ef-4088-8b0e-fe092140410c"}]}, {"@id": "urn:kg:ofev:section:32e4de96-8694-4511-bc14-f29466291d9f", "@type": "Section", "graphScope": "brand", "section_title": "Information for Missed Dose", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "32e4de96-8694-4511-bc14-f29466291d9f", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "If a dose of OFEV is missed, the next dose should be taken at the next scheduled time. Advise the patient to not make up for a missed dose. Do not exceed the recommended maximum daily dosage of 300 mg.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5ee35fa3-b6c9-435a-960c-256ce9217611"}]}, {"@id": "urn:kg:ofev:section:0873e02b-617c-423d-9433-d6550bb56786", "@type": "Section", "graphScope": "brand", "section_title": "2.3  Recommended Dosage for Patients with Hepatic Impairment", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "0873e02b-617c-423d-9433-d6550bb56786", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:9d127930-11a8-4369-bac9-9293140bed84", "@type": "Section", "graphScope": "brand", "section_title": "Mild Hepatic Impairment", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "9d127930-11a8-4369-bac9-9293140bed84", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In patients with mild hepatic impairment (Child Pugh A), the recommended dosage of OFEV is 100 mg orally twice daily approximately 12 hours apart taken with food [see Use in Specific Populations (8.6)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e0da0123-3ee0-490b-9969-75d42f21564e"}]}, {"@id": "urn:kg:ofev:section:94bba718-8cea-42f5-97db-22fe4c153ff5", "@type": "Section", "graphScope": "brand", "section_title": "Moderate or Severe Hepatic Impairment", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "94bba718-8cea-42f5-97db-22fe4c153ff5", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Treatment with OFEV is not recommended [see Warnings and Precautions (5.1) and Use in Specific Populations (8.6)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:10417dd8-8087-48a3-98a3-b12b9602a2e9"}]}, {"@id": "urn:kg:ofev:section:639d3847-3a89-4e25-9c7a-0e8315d88faf", "@type": "Section", "graphScope": "brand", "section_title": "2.4  Dosage Modification due to Adverse Reactions", "section_type": "heading", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "639d3847-3a89-4e25-9c7a-0e8315d88faf", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In addition to symptomatic treatment, if applicable, the management of adverse reactions of OFEV may require dose reduction or temporary interruption until the specific adverse reaction resolves to levels that allow continuation of therapy . OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If a patient does not tolerate 100 mg twice daily, discontinue treatment with OFEV [see Warnings and Precautions (5.2, 5.3, 5.5, 5.7) and Adverse Reactions (6.1)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:1e7e5579-d532-4ace-8fc4-61f83bfe2690"}]}, {"@id": "urn:kg:ofev:section:1f6ae5cf-071d-4307-b8ef-d54550733eb3", "@type": "Section", "graphScope": "brand", "section_title": "Elevated Liver Enzymes", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "1f6ae5cf-071d-4307-b8ef-d54550733eb3", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Dose modifications or interruptions may be necessary for liver enzyme elevations. Conduct liver function tests (aspartate aminotransferase (AST), alanine aminotransferase (ALT), and bilirubin) prior to initiation of treatment with OFEV, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Measure liver tests promptly in patients who report symptoms that may indicate liver injury, including fatigue, anorexia, right upper abdominal discomfort, dark urine or jaundice. Discontinue OFEV in patients with AST or ALT greater than 3 times the upper limit of normal (ULN) with signs or symptoms of liver injury and for AST or ALT elevations greater than 5 times the upper limit of normal. For AST or ALT greater than 3 times to less than 5 times the ULN without signs of liver damage, interrupt treatment or reduce OFEV to 100 mg twice daily. Once liver enzymes have returned to baseline values, treatment with OFEV may be reintroduced at a reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage (150 mg twice daily) [see Warnings and Precautions (5.2) and Adverse Reactions (6.1)].\n\nIn patients with mild hepatic impairment (Child Pugh A), consider treatment interruption, or discontinuation for management of adverse reactions.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9a4b4e71-f6cd-4cb3-aa62-3873350f2406"}, {"@id": "urn:kg:ofev:chunk:4b1c19af-5285-4555-a26b-9c4aa61aa6df"}]}, {"@id": "urn:kg:ofev:section:59a24917-1b9f-4dff-b3c2-81cf1a87adc4", "@type": "Section", "graphScope": "brand", "section_title": "3 DOSAGE FORMS AND STRENGTHS", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "59a24917-1b9f-4dff-b3c2-81cf1a87adc4", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:c42ade1c-5700-46f5-a4b1-963307bea7cc", "@type": "Section", "graphScope": "brand", "section_title": "Capsules:", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "c42ade1c-5700-46f5-a4b1-963307bea7cc", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 150 mg, brown, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"150\".\n- 100 mg, peach, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"100\".", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:da1c44c7-be96-4afe-83e2-bf98d685c77d"}]}, {"@id": "urn:kg:ofev:section:25f3c693-b300-452a-bef5-a346cfae6fe7", "@type": "Section", "graphScope": "brand", "section_title": "4 CONTRAINDICATIONS", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "25f3c693-b300-452a-bef5-a346cfae6fe7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "None", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:71b416ff-7f7f-44eb-ba71-bbe724d5b3a5"}]}, {"@id": "urn:kg:ofev:section:4cf80c9a-8ebf-408d-afcb-76526a61ae59", "@type": "Section", "graphScope": "brand", "section_title": "5 WARNINGS AND PRECAUTIONS", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "4cf80c9a-8ebf-408d-afcb-76526a61ae59", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:016180eb-524e-4868-8480-7c5079d8c5b2", "@type": "Section", "graphScope": "brand", "section_title": "5.1  Hepatic Impairment", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "016180eb-524e-4868-8480-7c5079d8c5b2", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Treatment with OFEV is not recommended in patients with moderate (Child Pugh B) or severe (Child Pugh C) hepatic impairment [see Use in Specific Populations (8.6) and Clinical Pharmacology (12.3)] . Patients with mild hepatic impairment (Child Pugh A) can be treated with a reduced dose of OFEV [see Dosage and Administration (2.3)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a384f55b-6f88-4498-aed8-291f1e4a9bd5"}]}, {"@id": "urn:kg:ofev:section:671f09a2-b137-458a-82ba-ce66ef90fe1f", "@type": "Section", "graphScope": "brand", "section_title": "How should I take OFEV?", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "671f09a2-b137-458a-82ba-ce66ef90fe1f", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Take OFEV exactly as your doctor tells you to take it.\n- Your doctor will tell you how much OFEV to take and when to take it.\n- Take OFEV with food. Swallow the OFEV capsules whole with a liquid.\n- Do not chew, crush, or open OFEV capsules. If you or your caregiver accidently comes in contact with the content of the capsule, wash hands well right away.\n- If you miss a dose of OFEV, take your next dose at your regular time. Do not take the missed dose.\n- Do not take more than 300 mg of OFEV in 1 day.\n- If you take too much OFEV, call your doctor or go to the nearest hospital emergency room right away.\n- Your doctor should do certain blood tests before you start taking OFEV.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:27f2befe-9638-49b5-bbe9-e85bfded4e54"}]}, {"@id": "urn:kg:ofev:section:32223790-0cd5-4fac-ab7e-c194cbd049a6", "@type": "Section", "graphScope": "brand", "section_title": "8.7  Renal Impairment", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "32223790-0cd5-4fac-ab7e-c194cbd049a6", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on a single-dose study, less than 1% of the total dose of nintedanib is excreted via the kidney [see Clinical Pharmacology (12.3)] . Adjustment of the starting dose in patients with mild to moderate renal impairment is not required. The safety, efficacy, and pharmacokinetics of nintedanib have not been studied in patients with severe renal impairment (less than 30 mL/min CrCl) and end-stage renal disease.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:88be1530-988d-445d-b85b-650e77e08bfe"}]}, {"@id": "urn:kg:ofev:section:5476add7-f4f8-4a10-b4b4-82947a98ff3d", "@type": "Section", "graphScope": "brand", "section_title": "Risk Summary", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "5476add7-f4f8-4a10-b4b4-82947a98ff3d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action [see Clinical Pharmacology (12.1)] , OFEV can cause fetal harm when administered to a pregnant woman. There are no data on the use of OFEV during pregnancy. In animal studies of pregnant rats and rabbits treated during organogenesis, nintedanib caused embryo-fetal deaths and structural abnormalities at less than (rats) and approximately 5 times (rabbits) the maximum recommended human dose [see Data] . Advise pregnant women of the potential risk to a fetus.\n\nThe estimated background risk of major birth defects and miscarriage for the indicated population is unknown. In the U.S. general population, the estimated background risk of major birth defects is 2% to 4% and miscarriage in clinically recognized pregnancies is 15% to 20%.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7f4c28d0-af28-4418-bd23-b5c318f06506"}]}, {"@id": "urn:kg:ofev:section:bfdd686a-7837-4063-a84a-da00940626a0", "@type": "Section", "graphScope": "brand", "section_title": "5.2  Elevated Liver Enzymes and Drug-Induced Liver Injury", "section_type": "heading", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "bfdd686a-7837-4063-a84a-da00940626a0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Cases of drug-induced liver injury (DILI) have been observed with OFEV treatment. In the clinical trials and postmarketing period, non-serious and serious cases of DILI were reported.  Cases of severe liver injury with fatal outcome have been reported in the postmarketing period. The majority of hepatic events occur within the first three months of treatment. In clinical trials, administration of OFEV was associated with elevations of liver enzymes (ALT, AST, ALKP, GGT) and bilirubin. Liver enzyme and bilirubin increases were reversible with dose modification or interruption in the majority of cases. In IPF studies (Study 1, Study 2, and Study 3), the majority (94%) of patients with ALT and/or AST elevations had elevations less than 5 times ULN and the majority (95%) of patients with bilirubin elevations had elevations less than 2 times ULN. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), the majority (95%) of patients with ALT and/or AST elevations had elevations less than 5 times ULN and the majority (94%) of patients with bilirubin elevations had elevations less than 2 times ULN. In the SSc-ILD study (Study 4), a maximum ALT and/or AST greater than or equal to 3 times ULN was observed for 4.9% of patients in the OFEV group and for 0.7% of patients in the placebo group [see Use in Specific Populations (8.6) and Clinical Pharmacology (12.3)] . Patients with a low body weight (less than 65 kg), Asian, and female patients may have a higher risk of elevations in liver enzymes. Nintedanib exposure increased with patient age, which may also result in a higher risk of increased liver enzymes [see Clinical Pharmacology (12.3)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f794da90-ea59-4047-94eb-029d611f9b03"}, {"@id": "urn:kg:ofev:chunk:5ddbeb32-22dd-44ff-9f1d-192b0f56d3ee"}]}, {"@id": "urn:kg:ofev:section:00b10163-f35a-493a-b44f-1b88f9a2adab", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "00b10163-f35a-493a-b44f-1b88f9a2adab", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Conduct liver function tests (ALT, AST, and bilirubin) prior to initiation of treatment with OFEV, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Measure liver tests promptly in patients who report symptoms that may indicate liver injury, including fatigue, anorexia, right upper abdominal discomfort, dark urine or jaundice. Dosage modifications or interruption may be necessary for liver enzyme elevations [see Dosage and Administration (2.1, 2.4)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f2ee4617-b787-4606-8cad-22a810555b1e"}]}, {"@id": "urn:kg:ofev:section:8dd00287-c6fb-452f-bc8f-89ed54f19ca3", "@type": "Section", "graphScope": "brand", "section_title": "5.3  Gastrointestinal Disorders", "section_type": "heading", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "8dd00287-c6fb-452f-bc8f-89ed54f19ca3", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:4af45440-1a4c-40e7-89c6-c4fe9171b8f4", "@type": "Section", "graphScope": "brand", "section_title": "Diarrhea", "section_type": "heading", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "4af45440-1a4c-40e7-89c6-c4fe9171b8f4", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In clinical trials, diarrhea was the most frequent gastrointestinal event reported. In most patients, the event was of mild to moderate intensity and occurred within the first 3 months of treatment. In IPF studies (Study 1, Study 2, and Study 3), diarrhea was reported in 62% versus 18% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 11% of patients treated with OFEV compared to 0 placebo-treated patients. Diarrhea led to discontinuation of OFEV in 5% of the patients compared to less than 1% of placebo-treated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), diarrhea was reported in 67% versus 24% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 16% of patients treated with OFEV compared to less than 1% of placebo-treated patients. Diarrhea led to discontinuation of OFEV in 6% of the patients compared to less than 1% of placebo-treated patients. In the SScILD study (Study 4), diarrhea was reported in 76% versus 32% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 22% of patients treated with OFEV compared to 1% of placebo-treated patients. Diarrhea led to discontinuation of OFEV in 7% of the patients compared to 0.3% of placebo-treated patients.\n\nDosage modifications or treatment interruptions may be necessary in patients with adverse reactions of diarrhea. Treat diarrhea at first signs with adequate hydration and antidiarrheal medication (e.g., loperamide), and consider dose reduction or treatment interruption if diarrhea continues [see Dosage and Administration (2.4)]. OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If severe diarrhea persists despite symptomatic treatment, discontinue treatment with OFEV.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:51f6e439-c09a-4788-bd1e-bafd1bf699a4"}, {"@id": "urn:kg:ofev:chunk:3a9270c9-2b52-42a5-b803-525a2d94801a"}]}, {"@id": "urn:kg:ofev:section:d155d159-cf19-4a92-99b6-baf15353036b", "@type": "Section", "graphScope": "brand", "section_title": "OFEV may cause serious side effects, including:", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "d155d159-cf19-4a92-99b6-baf15353036b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- See 'What is the most important information I should know about OFEV?'\n- liver problems. Call your doctor right away if you have unexplained symptoms such as yellowing of your skin or the white part of your eyes (jaundice), dark or brown (tea colored) urine, pain on the upper right side of your stomach area (abdomen), bleeding or bruising more easily than normal, feeling tired, or loss of appetite. Your doctor will do blood tests to check how well your liver is working before starting and during your treatment with OFEV.\n- diarrhea, nausea, and vomiting. While you are taking OFEV, your doctor may recommend that you drink fluids or take medicine to treat these side effects. Tell your doctor if you have diarrhea, nausea, or vomiting or if these", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7350b932-2ae3-4e96-842e-8157ddb56815"}]}, {"@id": "urn:kg:ofev:section:460d3160-c99a-49cc-bbe0-1f26dcfbee8c", "@type": "Section", "graphScope": "brand", "section_title": "Infertility", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "460d3160-c99a-49cc-bbe0-1f26dcfbee8c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on animal data, OFEV may reduce fertility in females of reproductive potential [see Nonclinical Toxicology (13.1)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:68483cde-281e-476f-8367-d2fa88d6d461"}]}, {"@id": "urn:kg:ofev:section:91983fed-49c3-48ad-bcce-8a2ee884137a", "@type": "Section", "graphScope": "brand", "section_title": "Nausea and Vomiting", "section_type": "heading", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "91983fed-49c3-48ad-bcce-8a2ee884137a", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In IPF studies (Study 1, Study 2, and Study 3), nausea was reported in 24% versus 7% and vomiting was reported in 12% versus 3% of patients treated with OFEV and placebo, respectively. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), nausea was reported in 29% versus 9% and vomiting was reported in 18% versus 5% of patients treated with OFEV and placebo, respectively. In the SSc-ILD study (Study 4), nausea was reported in 32% versus 14% and vomiting was reported in 25% versus 10% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)] . In most patients, these events were of mild to moderate intensity. In IPF studies (Study 1, Study 2, and Study 3), nausea led to discontinuation of OFEV in 2% of patients and vomiting led to discontinuation of OFEV in 1% of the patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), nausea led to discontinuation of OFEV in less than 1% of patients and vomiting led to discontinuation of OFEV in 1% of the patients. In the SSc-ILD study (Study 4), nausea led to discontinuation of OFEV in 2% of patients and vomiting led to discontinuation of OFEV in 1% of the patients.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7b8fa28c-e232-4dd1-b0ed-3165187ac9ef"}, {"@id": "urn:kg:ofev:chunk:c0c5f09f-0f4b-4a5b-8fd4-2bc05a2d0ebe"}]}, {"@id": "urn:kg:ofev:section:aa3ff00e-17ac-40bb-b6d4-6e110df50bff", "@type": "Section", "graphScope": "brand", "section_title": "10 OVERDOSAGE", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "aa3ff00e-17ac-40bb-b6d4-6e110df50bff", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In IPF trials, one patient was inadvertently exposed to a dose of 600 mg daily for a total of 21 days. A nonserious adverse event (nasopharyngitis) occurred and resolved during the period of incorrect dosing, with no onset of other reported events. Overdosage was also reported in two patients in oncology studies who were exposed to a maximum of 600 mg twice daily for up to 8 days. Adverse events reported were consistent with the existing safety profile of OFEV. Both patients recovered. In case of overdosage, interrupt treatment and initiate general supportive measures as appropriate.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:de201dfc-a32e-48ea-8416-e92a53ea3b88"}]}, {"@id": "urn:kg:ofev:section:a4673fef-9d6d-461c-8ebd-800465280c8c", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "a4673fef-9d6d-461c-8ebd-800465280c8c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "For nausea or vomiting that persists despite appropriate supportive care including anti-emetic therapy, dose reduction or treatment interruption may be required [see Dosage and Administration (2.4)] . OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If severe nausea or vomiting does not resolve, discontinue treatment with OFEV.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:12a94596-9118-4578-bde0-af999466a4d1"}]}, {"@id": "urn:kg:ofev:section:01c74061-80da-4bdc-86f6-f2e4039c7ae3", "@type": "Section", "graphScope": "brand", "section_title": "5.4  Embryo-Fetal Toxicity", "section_type": "heading", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "01c74061-80da-4bdc-86f6-f2e4039c7ae3", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action, OFEV can cause fetal harm when administered to a pregnant woman. Nintedanib caused embryo-fetal deaths and structural abnormalities in rats and rabbits when administered during organogenesis at less than (rats) and approximately 5 times (rabbits) the maximum recommended human dose (MRHD) in adults. Advise pregnant women of the potential risk to a fetus. Advise females of reproductive potential to avoid becoming pregnant while receiving treatment with OFEV and to use highly effective contraception at initiation of, during treatment, and at least 3 months after the last dose of OFEV. Nintedanib does not change the exposure to oral contraceptive containing ethinylestradiol and levonorgestrel in patients with SSc-ILD. However, the efficacy of oral hormonal contraceptives may be compromised by vomiting and/or diarrhea or other conditions where the drug absorption may be reduced. Advise women taking oral hormonal contraceptives experiencing these conditions to use alternative highly effective contraception. Verify pregnancy status prior to treatment with OFEV and during treatment as appropriate [see Use in Specific Populations (8.1, 8.3) and Clinical Pharmacology (12.1, 12.3)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c2fcec7d-eef8-48c0-9c9c-0394ea8cdc98"}, {"@id": "urn:kg:ofev:chunk:c801640f-47c7-4753-afe1-2e44ecf497a7"}]}, {"@id": "urn:kg:ofev:section:5663f967-b9e9-4c57-983c-9b971a6b4fbd", "@type": "Section", "graphScope": "brand", "section_title": "7.1  P-glycoprotein (P-gp) and CYP3A4 Inhibitors and Inducers", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "5663f967-b9e9-4c57-983c-9b971a6b4fbd", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a substrate of P-gp and, to a minor extent, CYP3A4 [see Clinical Pharmacology (12.3)] . Coadministration with oral doses of a P-gp and CYP3A4 inhibitor, ketoconazole, increased exposure to nintedanib by 60%. Concomitant use of P-gp and CYP3A4 inhibitors (e.g., erythromycin) with OFEV may increase exposure to nintedanib [see Clinical Pharmacology (12.3)] . In such cases, patients should be monitored closely for tolerability of OFEV. Management of adverse reactions may require interruption, dose reduction, or discontinuation of therapy with OFEV [see Dosage and Administration (2.4)] .\n\nCoadministration with oral doses of a P-gp and CYP3A4 inducer, rifampicin, decreased exposure to nintedanib by 50%. Concomitant use of P-gp and CYP3A4 inducers (e.g., carbamazepine, phenytoin, and St. John's wort) with OFEV should be avoided as these drugs may decrease exposure to nintedanib [see Clinical Pharmacology (12.3)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:260aba51-6057-4011-b962-b41135e19697"}]}, {"@id": "urn:kg:ofev:section:4c207467-b50e-40a6-926f-4f56802e8340", "@type": "Section", "graphScope": "brand", "section_title": "Combination with Pirfenidone", "section_type": "heading", "page_number": 8, "source_document_type": "prescribing_information", "section_id": "4c207467-b50e-40a6-926f-4f56802e8340", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Concomitant treatment with nintedanib and pirfenidone was investigated in an exploratory open-label, randomized (1:1) trial of nintedanib 150 mg twice daily with add-on pirfenidone (titrated to 801 mg three times a day) compared to nintedanib 150 mg twice daily alone in 105 randomized patients for 12 weeks. The primary endpoint was the percentage of patients with gastrointestinal adverse events from baseline to Week 12. Gastrointestinal adverse events were in line with the established safety profile of each component and were experienced in 37 (70%) patients treated with pirfenidone added to nintedanib versus 27 (53%) patients treated with nintedanib alone.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:17b92d9b-f1d3-4b0c-8f85-f1bb4c98b64e"}]}, {"@id": "urn:kg:ofev:section:9fc9f49b-5b15-45e5-8cf4-4690e6661db0", "@type": "Section", "graphScope": "brand", "section_title": "5.5  Arterial Thromboembolic Events", "section_type": "heading", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "9fc9f49b-5b15-45e5-8cf4-4690e6661db0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Arterial thromboembolic events have been reported in patients taking OFEV. In IPF studies (Study 1, Study 2, and Study 3), arterial thromboembolic events were reported in 2.5% of patients treated with OFEV and less than 1% of placebo-treated patients. Myocardial infarction was the most common adverse reaction under arterial thromboembolic events, occurring in 1.5% of OFEV-treated patients compared to less than 1% of placebotreated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), arterial thromboembolic events were reported in less than 1% of patients in both treatment arms. Myocardial infarction was observed in less than 1% of patients in both treatment arms. In the SSc-ILD study (Study 4), arterial thromboembolic events were reported in 0.7% of patients in both treatment arms. There were 0 cases of myocardial infarction in OFEV-treated patients compared to 0.7% of placebo-treated patients.\n\nUse caution when treating patients at higher cardiovascular risk including known coronary artery disease. Consider treatment interruption in patients who develop signs or symptoms of acute myocardial ischemia.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4ccb810a-03ac-4b80-b0c0-8ff1edb8953d"}, {"@id": "urn:kg:ofev:chunk:4d0184fc-001c-4ea7-8811-fd728a23df5a"}]}, {"@id": "urn:kg:ofev:section:30e4db24-2953-4c11-a086-d7f9687e383d", "@type": "Section", "graphScope": "brand", "section_title": "What are the ingredients in OFEV?", "section_type": "heading", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "30e4db24-2953-4c11-a086-d7f9687e383d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Active ingredient:\n\nnintedanib\n\nInactive ingredients: Fill Material: triglycerides, hard fat, lecithin. Capsule Shell: gelatin, glycerol, titanium dioxide, red ferric oxide, yellow ferric oxide, black ink\n\nDistributed by: Boehringer Ingelheim Pharmaceuticals, Inc. Ridgefield, CT 06877 USA\n\nLicensed from: Boehringer Ingelheim International GmbH\n\nOFEV is a registered trademark of and used under license from Boehringer Ingelheim International GmbH.\n\nCopyright © 202X Boehringer Ingelheim International GmbH, ALL RIGHTS RESERVED\n\nCOL9114HD262024\n\nThis Patient Information has been approved by the U.S. Food and Drug Administration.\n\nRevised: XXX 202X", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8ae9fa7a-85e6-40ae-9062-aa429d330dcb"}]}, {"@id": "urn:kg:ofev:section:f94298fb-422a-4154-b6cd-b1226caaa6eb", "@type": "Section", "graphScope": "brand", "section_title": "5.6  Risk of Bleeding", "section_type": "heading", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "f94298fb-422a-4154-b6cd-b1226caaa6eb", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on the mechanism of action (VEGFR inhibition), OFEV may increase the risk of bleeding. In IPF studies (Study 1, Study 2, and Study 3), bleeding events were reported in 10% of patients treated with OFEV and in 7% of patients treated with placebo. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), bleeding events were reported in 11% of patients treated with OFEV and in 13% of patients treated with placebo. In the SSc-ILD study (Study 4), bleeding events were reported in 11% of patients treated with OFEV and in 8% of patients treated with placebo. In clinical trials, epistaxis was the most frequent bleeding event reported.\n\nIn the postmarketing period non-serious and serious bleeding events, some of which were fatal, have been observed.\n\nUse OFEV in patients with known risk of bleeding only if the anticipated benefit outweighs the potential risk.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9024b902-c7ff-456e-a0b4-7334a9c18b02"}]}, {"@id": "urn:kg:ofev:section:0d2d6de1-abb2-4f86-a497-077227ab29d4", "@type": "Section", "graphScope": "brand", "section_title": "What are the possible side effects of OFEV?", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "0d2d6de1-abb2-4f86-a497-077227ab29d4", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:3eef6067-5ce7-4439-b6f5-b9e4766aea08", "@type": "Section", "graphScope": "brand", "section_title": "8.4  Pediatric Use", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "3eef6067-5ce7-4439-b6f5-b9e4766aea08", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The safety and effectiveness of OFEV have not been established in pediatric patients for the treatment of fibrosing interstitial lung diseases. Effectiveness was not demonstrated in a randomized, double-blind, placebocontrolled study conducted in 26 OFEV-treated pediatric patients aged 6 to 17 years with fibrosing interstitial lung diseases, who were treated with OFEV based on weight.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:38a31a23-e2b7-45c8-93c2-e99a2dfc6c98"}]}, {"@id": "urn:kg:ofev:section:72235e47-f19c-4d6d-9129-d75e2319f70d", "@type": "Section", "graphScope": "brand", "section_title": "5.7  Gastrointestinal Perforation", "section_type": "heading", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "72235e47-f19c-4d6d-9129-d75e2319f70d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on the mechanism of action, OFEV may increase the risk of gastrointestinal perforation. In IPF studies (Study 1, Study 2, and Study 3), gastrointestinal perforation was reported in less than 1% of patients treated with OFEV, compared to 0 cases in the placebo-treated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), gastrointestinal perforation was not reported in any patients in any treatment arm. In the SSc-ILD study (Study 4), no cases of gastrointestinal perforation were reported in patients treated with OFEV or in placebo-treated patients.\n\nIn the postmarketing period, cases of gastrointestinal perforations have been reported, some of which were fatal.\n\nUse caution when treating patients who have had recent abdominal surgery, previous history of diverticular disease or receiving concomitant corticosteroids or NSAIDs. Discontinue therapy with OFEV in patients who develop gastrointestinal perforation. Only use OFEV in patients with known risk of gastrointestinal perforation if the anticipated benefit outweighs the potential risk.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ba6eac01-9b7b-4e49-a153-b129edbfa52a"}, {"@id": "urn:kg:ofev:chunk:7b1e5716-779f-4d41-9eb5-e5e9dfc3e674"}]}, {"@id": "urn:kg:ofev:section:64890b31-6f1d-43c7-a51c-97a181e5d589", "@type": "Section", "graphScope": "brand", "section_title": "8.3  Females and Males of Reproductive Potential", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "64890b31-6f1d-43c7-a51c-97a181e5d589", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action, OFEV can cause fetal harm when administered to a pregnant woman and may reduce fertility in females of reproductive potential [see Use in Specific Populations (8.1), Clinical Pharmacology (12.1, 12.3), and Nonclinical Toxicology (13.1)] . Counsel patients on pregnancy prevention and planning.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2ae08914-d216-41a1-bc8a-6c88b6a8e8eb"}]}, {"@id": "urn:kg:ofev:section:4370dcc0-a8ac-48d0-80b6-5a5e4a7b4cf1", "@type": "Section", "graphScope": "brand", "section_title": "8.2  Lactation", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "4370dcc0-a8ac-48d0-80b6-5a5e4a7b4cf1", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:4b94816f-7f4c-49e2-8d03-0f6130b243f8", "@type": "Section", "graphScope": "brand", "section_title": "Pregnancy Testing", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "4b94816f-7f4c-49e2-8d03-0f6130b243f8", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Verify the pregnancy status of females of reproductive potential prior to treatment with OFEV and during treatment as appropriate [see Dosage and Administration (2.1), Warnings and Precautions (5.4), and Use in Specific Populations (8.1)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b8aa29a2-79d9-4794-8233-0253c26cd619"}]}, {"@id": "urn:kg:ofev:section:e3079d35-7ca8-4e4d-94e3-d84e77d501df", "@type": "Section", "graphScope": "brand", "section_title": "8.1  Pregnancy", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "e3079d35-7ca8-4e4d-94e3-d84e77d501df", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:4fb91b95-1d96-4b6a-9bdc-5f1d3a93916a", "@type": "Section", "graphScope": "brand", "section_title": "5.8  Nephrotic Range Proteinuria", "section_type": "heading", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "4fb91b95-1d96-4b6a-9bdc-5f1d3a93916a", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Cases of proteinuria within the nephrotic range have been reported in the postmarketing period. Histological findings, when available, were consistent with glomerular microangiopathy with or without renal thrombi. Improvement in proteinuria has been observed after OFEV was discontinued; however, in some cases, residual proteinuria persisted. Consider treatment interruption in patients who develop new or worsening proteinuria.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5097774f-c01f-4450-862e-253bf2063b36"}]}, {"@id": "urn:kg:ofev:section:bdf0ed24-ea6a-4893-86f5-600f95b23748", "@type": "Section", "graphScope": "brand", "section_title": "How should I store OFEV?", "section_type": "heading", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "bdf0ed24-ea6a-4893-86f5-600f95b23748", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Store OFEV at room temperature between 68°F to 77°F (20°C to 25°C).\n- Keep OFEV dry and protect from high heat.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4a6685ca-a0b7-4de4-8934-5531d78cf119"}]}, {"@id": "urn:kg:ofev:section:8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1", "@type": "Section", "graphScope": "brand", "section_title": "8.5  Geriatric Use", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Of the total number of subjects in phase 2 and 3 clinical studies of OFEV in IPF (Study 1, Study 2, and Study 3), 61% were 65 and over, while 16% were 75 and over. In the chronic fibrosing ILDs with a progressive phenotype clinical study (Study 5), 61% were 65 and over, while 19% were 75 and older. In SSc-ILD (Study 4), 21.4% were 65 and over, while 1.9% were 75 and older. In phase 3 studies, no overall differences in effectiveness were observed between subjects who were 65 and over and younger subjects; no overall differences in safety were observed between subjects who were 65 and over or 75 and over and younger subjects, but greater sensitivity of some older individuals cannot be ruled out .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6b26567b-195d-48e9-9d00-2b8648c2e843"}]}, {"@id": "urn:kg:ofev:section:6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa", "@type": "Section", "graphScope": "brand", "section_title": "6 ADVERSE REACTIONS", "section_type": "heading", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The following clinically significant adverse reactions are discussed in greater detail in other sections of the labeling:\n\n- Elevated Liver Enzymes and Drug-Induced Liver Injury [see Warnings and Precautions (5.2)]\n- Gastrointestinal Disorders [see Warnings and Precautions (5.3)]\n- Embryo-Fetal Toxicity [see Warnings and Precautions (5.4)]\n- Arterial Thromboembolic Events [see Warnings and Precautions (5.5)]\n- Risk of Bleeding [see Warnings and Precautions (5.6)]\n- Gastrointestinal Perforation [see Warnings and Precautions (5.7)]\n- Nephrotic Range Proteinuria [see Warnings and Precautions (5.8)]", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9aa33ce4-5d38-4085-9c50-0fff11e08ecc"}]}, {"@id": "urn:kg:ofev:section:d2d3fed3-3838-425a-af8a-118326fe3ab8", "@type": "Section", "graphScope": "brand", "section_title": "6.1  Clinical Trials Experience", "section_type": "heading", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "d2d3fed3-3838-425a-af8a-118326fe3ab8", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Because clinical trials are conducted under widely varying conditions, adverse reaction rates observed in the clinical trials of a drug cannot be directly compared to rates in the clinical trials of another drug and may not reflect the rates observed in practice.\n\nThe safety of OFEV was evaluated in over 1000 IPF patients, 332 patients with chronic fibrosing ILDs with a progressive phenotype, and over 280 patients with SSc-ILD. Over 200 IPF patients were exposed to OFEV for more than 2 years in clinical trials.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b8fd6ff0-a9a9-44aa-ab2c-052e40e004f3"}]}, {"@id": "urn:kg:ofev:section:c5f8a9ed-34b8-4e65-a395-2e5e5dc88dc6", "@type": "Section", "graphScope": "brand", "section_title": "Idiopathic Pulmonary Fibrosis", "section_type": "heading", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "c5f8a9ed-34b8-4e65-a395-2e5e5dc88dc6", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in three randomized, double-blind, placebo-controlled, 52-week trials. In the phase 2 (Study 1) and phase 3 (Study 2 and Study 3) trials, 723 patients with IPF received OFEV 150 mg twice daily and 508 patients received placebo. The median duration of exposure was 10 months for patients treated with OFEV and 11 months for patients treated with placebo. Subjects ranged in age from 42 to 89 years (median age of 67 years). Most patients were male (79%) and Caucasian (60%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d6bb80a9-9262-4b6a-89e2-83668ac5c9aa"}]}, {"@id": "urn:kg:ofev:section:ac3e7b53-7690-46bf-9423-402e000c9740", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 8, "source_document_type": "prescribing_information", "section_id": "ac3e7b53-7690-46bf-9423-402e000c9740", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The most frequent serious adverse reactions reported in patients treated with OFEV, more than placebo, were bronchitis (1.2% vs. 0.8%) and myocardial infarction (1.5% vs. 0.4%). The most common adverse events leading to death in patients treated with OFEV, more than placebo, were pneumonia (0.7% vs. 0.6%), lung neoplasm malignant (0.3% vs. 0%), and myocardial infarction (0.3% vs. 0.2%). In the predefined category of major adverse cardiovascular events (MACE) including MI, fatal events were reported in 0.6% of OFEVtreated patients and 1.8% of placebo-treated patients.\n\nAdverse reactions leading to permanent dose reductions were reported in 16% of OFEV-treated patients and 1% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (11%).\n\nAdverse reactions leading to discontinuation were reported in 21% of OFEV-treated patients and 15% of placebo-treated patients. The most frequent adverse reactions that led to discontinuation in OFEV-treated patients were diarrhea (5%), nausea (2%), and decreased appetite (2%).\n\nThe most common adverse reactions with an incidence of greater than or equal to 5% and more frequent in the OFEV than placebo treatment group are listed in Table 1.\n\nTable 1 Adverse Reactions Occurring in ≥5% of OFEV-treated Patients with Idiopathic Pulmonary Fibrosis and More Commonly Than Placebo in Study 1, Study 2, and Study 3\n\n| Adverse Reaction                   | OFEV, 150 mg n=723   | Placebo n=508   |\n|------------------------------------|----------------------|-----------------|\n| Gastrointestinal disorders         |                      |                 |\n| Diarrhea                           | 62%                  | 18%             |\n| Nausea                             | 24%                  | 7%              |\n| Abdominal pain a                   | 15%                  | 6%              |\n| Vomiting                           | 12%                  | 3%              |\n| Hepatobiliary disorders            |                      |                 |\n| Liver enzyme elevation b           | 14%                  | 3%              |\n| Metabolism and nutrition disorders |                      |                 |\n| Decreased appetite                 | 11%                  | 5%              |\n| Nervous system disorders           |                      |                 |\n| Headache                           | 8%                   | 5%              |\n| Investigations                     |                      |                 |\n| Weight decreased                   | 10%                  | 3%              |\n| Vascular disorders                 |                      |                 |\n| Hypertension c                     | 5%                   | 4%              |\n\nIn addition, hypothyroidism was reported in patients treated with OFEV, more than placebo (1.1% vs. 0.6%). Alopecia was also reported in more patients treated with OFEV than placebo (0.8% vs. 0.4%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:51eeb137-cbeb-4527-a616-9e0583f6244c"}, {"@id": "urn:kg:ofev:chunk:cbc9ff30-1ef2-4eaa-8fab-78e776609966"}, {"@id": "urn:kg:ofev:chunk:246406a5-c5c4-4493-a7d5-0df2f2495e90"}]}, {"@id": "urn:kg:ofev:section:8e50ecd9-a631-4459-ae17-a792631abd5c", "@type": "Section", "graphScope": "brand", "section_title": "Risk Summary", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "8e50ecd9-a631-4459-ae17-a792631abd5c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "There is no information on the presence of nintedanib in human milk, the effects on the breast-fed infant or the effects on milk production. Nintedanib and/or its metabolites are present in the milk of lactating rats [see Data] . Because of the potential for serious adverse reactions in nursing infants from OFEV, advise women that breastfeeding is not recommended during treatment with OFEV.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:552ecab1-8b3b-4e35-a7c1-822898c4ac7a"}]}, {"@id": "urn:kg:ofev:section:98341d95-f8bf-4830-9e39-aac374043a01", "@type": "Section", "graphScope": "brand", "section_title": "7.4  Bosentan", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "98341d95-f8bf-4830-9e39-aac374043a01", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Coadministration of nintedanib with bosentan did not alter the pharmacokinetics of nintedanib [see Clinical Pharmacology (12.3)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:30572a74-f34d-4b75-9e06-d98bdb166215"}]}, {"@id": "urn:kg:ofev:section:a3adf5e4-0f19-4de8-9688-733bf0aa67e8", "@type": "Section", "graphScope": "brand", "section_title": "8 USE IN SPECIFIC POPULATIONS", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "a3adf5e4-0f19-4de8-9688-733bf0aa67e8", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:037c54d6-db02-4eac-8922-c3877467ae3b", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "037c54d6-db02-4eac-8922-c3877467ae3b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Diarrhea, nausea, vomiting, and abdominal pain (includes upper abdominal pain, abdominal discomfort, and abdominal pain) were the most frequent adverse events reported in 20 (38%) versus 16 (31%), in 22 (42%) versus 6 (12%), in 15 (28%) versus 6 (12%), and in 15 (28%) versus 7 (14%) patients treated with pirfenidone added to nintedanib versus nintedanib alone, respectively. More subjects reported AST or ALT elevations (greater than or equal to 3x the upper limit of normal) when using pirfenidone in combination with nintedanib (n=3 (6%)) compared to nintedanib alone (n=0) [see Warnings and Precautions (5.2, 5.3)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7b6c020d-55b9-4897-a792-a79ed70e1051"}]}, {"@id": "urn:kg:ofev:section:fa78888a-5761-48e5-81ac-b441136c8675", "@type": "Section", "graphScope": "brand", "section_title": "Keep OFEV and all medicines out of the reach of children.", "section_type": "heading", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "fa78888a-5761-48e5-81ac-b441136c8675", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:7101abae-5410-4da3-8b6c-9f717303089c", "@type": "Section", "graphScope": "brand", "section_title": "Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "section_type": "heading", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "7101abae-5410-4da3-8b6c-9f717303089c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in a phase 3, double-blind, placebo-controlled trial (Study 5) in which 663 patients with chronic fibrosing ILDs with a progressive phenotype were randomized to receive OFEV 150 mg twice daily (n=332) or placebo (n=331) for at least 52 weeks. At 52 weeks, the median duration of exposure was 12 months for patients in both treatment arms. Subjects ranged in age from 27 to 87 years (median age of 67 years). The majority of patients were Caucasian (74%) or Asian (25%). Most patients were male (54%).\n\nThe most frequent serious adverse event reported in patients treated with OFEV, more than placebo, was pneumonia (4% vs. 3%). Adverse events leading to death were reported in 3% of patients treated with OFEV and in 5% of patients treated with placebo. No pattern was identified in the adverse events leading to death.\n\nAdverse reactions leading to permanent dose reductions were reported in 33% of OFEV-treated patients and 4% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (16%).\n\nAdverse reactions leading to discontinuation were reported in 20% of OFEV-treated patients and 10% of placebo-treated patients. The most frequent adverse reaction that led to discontinuation in OFEV-treated patients was diarrhea (6%).\n\nThe safety profile in patients with chronic fibrosing ILDs with a progressive phenotype treated with OFEV was consistent with that observed in IPF patients. In addition, the following adverse events were reported in OFEV more than placebo in chronic progressive fibrosing ILD: nasopharyngitis (13% vs. 12%), upper respiratory tract infection (7% vs 6%), urinary tract infection (6% vs. 4%), fatigue (10% vs. 6%), and back pain (6% vs. 5%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ff54203d-19cb-4057-87f1-c99b63574453"}, {"@id": "urn:kg:ofev:chunk:513f546e-f51a-46da-990e-26f056201fdc"}]}, {"@id": "urn:kg:ofev:section:d02488c4-6e6b-4e92-8028-b5a0d3304adb", "@type": "Section", "graphScope": "brand", "section_title": "8.6  Hepatic Impairment", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "d02488c4-6e6b-4e92-8028-b5a0d3304adb", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is predominantly eliminated via biliary/fecal excretion (greater than 90%). In a PK study performed in patients with hepatic impairment (Child Pugh A, Child Pugh B), exposure to nintedanib was increased [see Clinical Pharmacology (12.3)] . In patients with mild hepatic impairment (Child Pugh A), the recommended dosage of OFEV is 100 mg twice daily [see Dosage and Administration (2.3)] . Monitor for adverse reactions and consider treatment interruption, or discontinuation for management of adverse reactions in these patients [see Dosage and Administration (2.4)]. Treatment of patients with moderate (Child Pugh B) and severe (Child Pugh C) hepatic impairment with OFEV is not recommended [see Warnings and Precautions (5.1)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c8633e11-c806-45b0-9dbe-52af82db8b21"}]}, {"@id": "urn:kg:ofev:section:efed4a8e-9045-4c78-9f95-22ceceb7340c", "@type": "Section", "graphScope": "brand", "section_title": "Data", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "efed4a8e-9045-4c78-9f95-22ceceb7340c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Milk and plasma of lactating rats have similar concentrations of nintedanib and its metabolites.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:31a58131-4b5e-422a-986d-bcdc0cfb485e"}]}, {"@id": "urn:kg:ofev:section:e132de83-5540-40ac-8205-fbf673f5350b", "@type": "Section", "graphScope": "brand", "section_title": "7.3  Pirfenidone", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "e132de83-5540-40ac-8205-fbf673f5350b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In a multiple-dose study conducted to assess the pharmacokinetic effects of concomitant treatment with nintedanib and pirfenidone, the coadministration of nintedanib with pirfenidone did not alter the exposure of either agent [see Clinical Pharmacology (12.3)] . Therefore, no dose adjustment is necessary during concomitant administration of nintedanib with pirfenidone.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:52db56bf-9745-4c06-b7ad-78530b39b786"}]}, {"@id": "urn:kg:ofev:section:0e541a3b-e900-4408-b66d-615f89d1249a", "@type": "Section", "graphScope": "brand", "section_title": "Systemic Sclerosis-Associated Interstitial Lung Disease", "section_type": "heading", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "0e541a3b-e900-4408-b66d-615f89d1249a", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in a phase 3, randomized, double-blind, placebo-controlled trial (Study 4) in which 576 patients with SSc-ILD received OFEV 150 mg twice daily (n=288) or placebo (n=288).  Patients were to receive treatment for at least 52 weeks; individual patients were treated for up to 100 weeks. The median duration of exposure was 15 months for patients treated with OFEV and 16 months for patients treated with placebo. Subjects ranged in age from 20 to 79 years (median age of 55 years). Most patients were female (75%). Patients were mostly Caucasian (67%), Asian (25%), or Black (6%). At baseline, 49% of patients were on stable therapy with mycophenolate.\n\nThe most frequent serious adverse events reported in patients treated with OFEV, more than placebo, were interstitial lung disease (2.4% nintedanib vs. 1.7% placebo) and pneumonia (2.8% nintedanib vs. 0.3% placebo). Within 52 weeks, 5 patients treated with OFEV (1.7%) and 4 patients treated with placebo (1.4%) died. There was no pattern among adverse events leading to death in either treatment arm.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:786c266f-2318-4e7b-a795-2c87eb702f5e"}, {"@id": "urn:kg:ofev:chunk:ed47e921-2154-44b3-a53b-5aab8812840e"}]}, {"@id": "urn:kg:ofev:section:6b53371e-93c7-457b-a9cc-9b26c3e89c85", "@type": "Section", "graphScope": "brand", "section_title": "Animal Toxicity Data", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "6b53371e-93c7-457b-a9cc-9b26c3e89c85", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In repeat-dose toxicology studies, young animals (mice, rats, and monkeys) dosed with nintedanib showed changes in the bone and fast-growing teeth. Bone changes include thickening of the growth plate in all species. These changes were fully or at least partially reversible in rats and monkeys; reversibility in mice has not been studied.\n\nTooth changes include broken incisors and discoloration in rodents. These changes were irreversible after discontinuation of nintedanib treatment .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5a9cb6bb-7ffa-4db0-a6b6-4d102da0a52c"}]}, {"@id": "urn:kg:ofev:section:bb4bf01d-0141-4b83-8161-67022dd9966b", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 10, "source_document_type": "prescribing_information", "section_id": "bb4bf01d-0141-4b83-8161-67022dd9966b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Adverse reactions leading to permanent dose reductions were reported in 34% of OFEV-treated patients and 4% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (22%).\n\nAdverse reactions leading to discontinuation were reported in 16% of OFEV-treated patients and 9% of placebo-treated patients. The most frequent adverse reactions that led to discontinuation in OFEV-treated patients were diarrhea (7%), nausea (2%), vomiting (1%), abdominal pain (1%), and interstitial lung disease (1%).\n\nThe safety profile in patients treated with OFEV with or without mycophenolate at baseline was comparable.\n\nThe most common adverse reactions with an incidence of greater than or equal to 5% in OFEV-treated patients and more commonly than in placebo are listed in Table 2.\n\nTable 2 Adverse Reactions Occurring in ≥5% of OFEV-treated Patients with Systemic SclerosisAssociated Interstitial Lung Disease and More Commonly Than Placebo in Study 4\n\n| Adverse Reaction         | OFEV, 150 mg n=288   | Placebo n=288   |\n|--------------------------|----------------------|-----------------|\n| Diarrhea                 | 76%                  | 32%             |\n| Nausea                   | 32%                  | 14%             |\n| Vomiting                 | 25%                  | 10%             |\n| Skin ulcer               | 18%                  | 17%             |\n| Abdominal pain a         | 18%                  | 11%             |\n| Liver enzyme elevation b | 13%                  | 3%              |\n| Weight decreased         | 12%                  | 4%              |\n| Fatigue                  | 11%                  | 7%              |\n| Decreased appetite       | 9%                   | 4%              |\n| Headache                 | 9%                   | 8%              |\n| Pyrexia                  | 6%                   | 5%              |\n| Back pain                | 6%                   | 4%              |\n| Dizziness                | 6%                   | 4%              |\n| Hypertension c           | 5%                   | 2%              |\n\nIn addition, alopecia was reported in patients treated with OFEV, more than placebo (1.4% vs. 1.0%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:bc86f02d-e23f-423b-82d3-232b3a58f759"}, {"@id": "urn:kg:ofev:chunk:5c2ec0f7-0f68-4f57-ad69-c58abbd5b12b"}, {"@id": "urn:kg:ofev:chunk:a4ce2e45-e651-46a2-b885-dc02eb784256"}]}, {"@id": "urn:kg:ofev:section:16b697b1-2d28-41a6-9698-b87c9099fcec", "@type": "Section", "graphScope": "brand", "section_title": "7.2  Anticoagulants", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "16b697b1-2d28-41a6-9698-b87c9099fcec", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a VEGFR inhibitor and may increase the risk of bleeding. Monitor patients on full anticoagulation therapy closely for bleeding and adjust anticoagulation treatment as necessary [see Warnings and Precautions (5.6)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:74446ddf-2949-45b9-ae11-b419c9d70d4f"}]}, {"@id": "urn:kg:ofev:section:bc63ed41-9b9f-493b-bd37-0c045a467f39", "@type": "Section", "graphScope": "brand", "section_title": "Animal Data", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "bc63ed41-9b9f-493b-bd37-0c045a467f39", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In animal reproduction toxicity studies, nintedanib caused embryo-fetal deaths and structural abnormalities in rats and rabbits at less than and approximately 5 times the maximum recommended human dose (MRHD) in adults (on a plasma AUC basis at maternal oral doses of 2.5 and 15 mg/kg/day in rats and rabbits, respectively). Malformations included abnormalities in the vasculature, urogenital, and skeletal systems. Vasculature anomalies included missing or additional major blood vessels. Skeletal anomalies included abnormalities in the thoracic, lumbar, and caudal vertebrae (e.g., hemivertebra, missing, or asymmetrically ossified), ribs (bifid or fused), and sternebrae (fused, split, or unilaterally ossified). In some fetuses, organs in the urogenital system were missing. In rabbits, a significant change in sex ratio was observed in fetuses (female:male ratio of approximately 71%:29%) at approximately 15 times the MRHD in adults (on an AUC basis at a maternal oral dose of 60 mg/kg/day). Nintedanib decreased post-natal viability of rat pups during the first 4 post-natal days when dams were exposed to less than the MRHD (on an AUC basis at a maternal oral dose of 10 mg/kg/day).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:fc1e82e1-69a0-4ea9-80f8-406f28621ca0"}, {"@id": "urn:kg:ofev:chunk:509c0e3a-5d5c-4955-8bcb-eb843def58c7"}]}, {"@id": "urn:kg:ofev:section:15c18c86-6a73-4fa7-96c1-6f4699a8aca0", "@type": "Section", "graphScope": "brand", "section_title": "6.2 Postmarketing Experience", "section_type": "heading", "page_number": 10, "source_document_type": "prescribing_information", "section_id": "15c18c86-6a73-4fa7-96c1-6f4699a8aca0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The following adverse reactions have been identified during postapproval use of OFEV. Because these reactions are reported voluntarily from a population of uncertain size, it is not always possible to reliably estimate their frequency or establish a causal relationship to drug exposure. The following adverse reactions have been identified during postapproval use of OFEV: drug-induced liver injury [see Warnings and Precautions (5.2)] , non-serious and serious bleeding events, some of which were fatal [see Warnings and Precautions (5.6)], proteinuria [see Warnings and Precautions (5.8)] , pancreatitis, thrombocytopenia, rash, pruritus.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:057e659d-5f16-4541-957a-a87422f68756"}]}, {"@id": "urn:kg:ofev:section:8210acc5-e3a6-43f3-9aee-9ddffde6eadc", "@type": "Section", "graphScope": "brand", "section_title": "Contraception", "section_type": "heading", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "8210acc5-e3a6-43f3-9aee-9ddffde6eadc", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV can cause fetal harm when administered to a pregnant woman. Advise females of reproductive potential to avoid becoming pregnant while receiving treatment with OFEV. Advise females of reproductive potential to use highly effective contraception at initiation of, during treatment, and for at least 3 months after taking the last dose of OFEV. Nintedanib does not change the exposure to oral contraceptive containing ethinylestradiol and levonorgestrel in patients with SSc-ILD. However, the efficacy of oral hormonal contraceptives may be compromised by vomiting and/or diarrhea or other conditions where the drug absorption may be reduced. Advise women taking oral hormonal contraceptives experiencing these conditions to use alternative highly effective contraception.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:53479369-4351-4bb5-a333-ee2f4861c168"}]}, {"@id": "urn:kg:ofev:section:f1ef3602-7e66-4635-b2fc-6a43095c9533", "@type": "Section", "graphScope": "brand", "section_title": "Data", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "f1ef3602-7e66-4635-b2fc-6a43095c9533", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:2201299c-0fe7-4cb4-9e0e-09f8886e8639", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "2201299c-0fe7-4cb4-9e0e-09f8886e8639", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "symptoms do not go away or become worse. Tell your doctor if you are taking over-the-counter laxatives, stool softeners, and other medicines or dietary supplements that can cause diarrhea.\n\n- heart attack. Tell your doctor right away if you have symptoms of a heart problem. These symptoms may include chest pain or pressure, pain in your arms, back, neck or jaw, or shortness of breath.\n- stroke. Tell your doctor right away if you have symptoms of a stroke. These symptoms may include numbness or weakness on 1 side of your body, trouble talking, headache, or dizziness.\n- bleeding problems. OFEV may increase your chances of having bleeding problems. Tell your doctor if you have unusual bleeding, bruising, or wounds that do not heal. Tell your doctor if you are taking a blood thinner, including prescription blood thinners and over-the-counter aspirin.\n- tear in your stomach or intestinal wall (perforation). OFEV may increase your chances of having a tear in your stomach or intestinal wall. Tell your doctor if you have pain or swelling in your stomach area.\n- increased protein in your urine (proteinuria). OFEV may increase your chances of having protein in your urine. Tell your doctor if you have any signs and symptoms of protein in the urine such as foamy urine, swelling, including in your hands, arms, legs, or feet, or sudden weight gain.\n\nThe most common side effects of OFEV are diarrhea, nausea, stomach pain, vomiting, liver problems, decreased appetite, headache, weight loss, and high blood pressure.\n\nThese are not all the possible side effects of OFEV. For more information, ask your doctor or pharmacist. Call your doctor for medical advice about side effects. You may report side effects to FDA at 1-800-FDA-1088.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3e5da516-4da8-4d7d-9182-e9c4a8887680"}, {"@id": "urn:kg:ofev:chunk:4197e007-57b5-48db-b01e-72d9ab8d20c8"}]}, {"@id": "urn:kg:ofev:section:35f0964c-aec3-4015-a415-2ef2c4af0d21", "@type": "Section", "graphScope": "brand", "section_title": "7 DRUG INTERACTIONS", "section_type": "heading", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "35f0964c-aec3-4015-a415-2ef2c4af0d21", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:be0dae61-300a-44a1-b7e9-54e1195173eb", "@type": "Section", "graphScope": "brand", "section_title": "11 DESCRIPTION", "section_type": "heading", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "be0dae61-300a-44a1-b7e9-54e1195173eb", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV capsules contain nintedanib, a kinase inhibitor [see Mechanism of Action (12.1)]. Nintedanib is presented as the ethanesulfonate salt (esylate), with the chemical name 1 H -Indole-6-carboxylic acid, 2,3- dihydro-3-[[[4-[methyl[(4-methyl-1-piperazinyl)acetyl]amino]phenyl]amino]phenylmethylene]-2-oxo-,methyl ester, (3 Z )-, ethanesulfonate (1:1).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d7fd3dce-585f-47a6-b58e-6b8359ad2787"}]}, {"@id": "urn:kg:ofev:section:2f4aa101-da41-4ebc-af80-9fc0275c10e7", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "2f4aa101-da41-4ebc-af80-9fc0275c10e7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Its structural formula is:\n\n<!-- image -->\n\nNintedanib esylate is a bright yellow powder with an empirical formula of C31H33N5O4·C2H6O3S and a molecular weight of 649.76 g/mol.\n\nOFEV capsules for oral administration are available in 2 dose strengths containing 100 mg or 150 mg of nintedanib (equivalent to 120.40 mg or 180.60 mg nintedanib ethanesulfonate, respectively). The inactive ingredients of OFEV are the following: Fill Material: triglycerides, hard fat, lecithin. Capsule Shell: gelatin, glycerol, titanium dioxide, red ferric oxide, yellow ferric oxide, black ink.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:52f20d07-3dfa-4e30-bce1-05dbdec35151"}]}, {"@id": "urn:kg:ofev:section:60c981ab-d129-4d5f-9560-a20407d2f0a4", "@type": "Section", "graphScope": "brand", "section_title": "12 CLINICAL PHARMACOLOGY", "section_type": "heading", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "60c981ab-d129-4d5f-9560-a20407d2f0a4", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:bbd92294-efcb-4239-93fa-71a64b748863", "@type": "Section", "graphScope": "brand", "section_title": "12.1  Mechanism of Action", "section_type": "heading", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "bbd92294-efcb-4239-93fa-71a64b748863", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a small molecule that inhibits multiple receptor tyrosine kinases (RTKs) and non-receptor tyrosine kinases (nRTKs). Nintedanib inhibits the following RTKs: platelet-derived growth factor receptor (PDGFR) α and β, fibroblast growth factor receptor (FGFR) 1-3, vascular endothelial growth factor receptor (VEGFR) 1-3, colony stimulating factor 1 receptor (CSF1R), and Fms-like tyrosine kinase-3 (FLT-3). These kinases except for FLT-3 have been implicated in pathogenesis of interstitial lung diseases (ILD). Nintedanib binds competitively to the adenosine triphosphate (ATP) binding pocket of these kinases and blocks the intracellular signaling cascades, which have been demonstrated to be involved in the pathogenesis of fibrotic tissue remodeling in ILD. Nintedanib also inhibits the following nRTKs: Lck, Lyn and Src kinases.  The contribution of FLT-3 and nRTK inhibition to nintedanib efficacy in ILD is unknown.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b7f9ed9a-e2a3-434d-a84e-9d683d1c0757"}]}, {"@id": "urn:kg:ofev:section:872fc0cc-8d81-4568-9f2b-277ffba4e222", "@type": "Section", "graphScope": "brand", "section_title": "12.2  Pharmacodynamics", "section_type": "heading", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "872fc0cc-8d81-4568-9f2b-277ffba4e222", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:7f19e7ea-b8d2-4b24-9b58-e2ef9e2a8d0e", "@type": "Section", "graphScope": "brand", "section_title": "Cardiac Electrophysiology", "section_type": "heading", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "7f19e7ea-b8d2-4b24-9b58-e2ef9e2a8d0e", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In a study in renal cell cancer patients, QT/QTc measurements were recorded and showed that a single oral dose of 200 mg nintedanib as well as multiple oral doses of 200 mg nintedanib administered twice daily for 15 days did not prolong the QTcF interval.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c9378762-438b-4e4e-9608-7b6a1c4a6f62"}]}, {"@id": "urn:kg:ofev:section:cea72526-c554-46b2-8ec2-4d2fa4d9c688", "@type": "Section", "graphScope": "brand", "section_title": "12.3  Pharmacokinetics", "section_type": "heading", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "cea72526-c554-46b2-8ec2-4d2fa4d9c688", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The PK properties of nintedanib were similar in healthy volunteers, patients with IPF, patients with chronic fibrosing ILDs with a progressive phenotype, patients with SSc-ILD, and cancer patients. The PK of nintedanib is linear. Dose proportionality was shown by an increase of nintedanib exposure with increasing doses (dose range 50 to 450 mg once daily and 150 to 300 mg twice daily). Accumulation upon multiple administrations in patients with IPF was 1.76-fold for AUC. Steady-state plasma concentrations were achieved within one week of dosing. Nintedanib trough concentrations remained stable for more than one year. The inter-individual variability in the PK of nintedanib was moderate to high (coefficient of variation of standard PK parameters in the range of 30% to 70%), intra-individual variability low to moderate (coefficients of variation below 40%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8ca23ab7-ea42-4891-855d-10bb9fe1c63d"}]}, {"@id": "urn:kg:ofev:section:6935b2d8-a58f-4cd7-8833-6cf17d976232", "@type": "Section", "graphScope": "brand", "section_title": "Absorption", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "6935b2d8-a58f-4cd7-8833-6cf17d976232", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib reached maximum plasma concentrations approximately 2 to 4 hours after oral administration as a soft gelatin capsule under fed conditions. The absolute bioavailability of a 100 mg dose was 4.7% (90% CI: 3.62 to 6.08) in healthy volunteers. Absorption and bioavailability are decreased by transporter effects and substantial first-pass metabolism.\n\nAfter food intake, nintedanib exposure increased by approximately 20% compared to administration under fasted conditions (90% CI: 95.3% to 152.5%) and absorption was delayed (median tmax fasted: 2.00 hours; fed: 3.98 hours), irrespective of the food type.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:eba2f924-430f-4010-b05c-8b27364f5d21"}]}, {"@id": "urn:kg:ofev:section:55064bbe-7178-489d-b951-0bd97302af73", "@type": "Section", "graphScope": "brand", "section_title": "Distribution", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "55064bbe-7178-489d-b951-0bd97302af73", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib follows bi-phasic disposition kinetics. After intravenous infusion, a high volume of distribution which was larger than total body volume (Vss: 1050 L) was observed.\n\nThe in vitro protein binding of nintedanib in human plasma was high, with a bound fraction of 97.8%. Serum albumin is considered to be the major binding protein. Nintedanib is preferentially distributed in plasma with a blood to plasma ratio of 0.87.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8b0faa98-9ee6-4572-9681-c3628c08fd88"}]}, {"@id": "urn:kg:ofev:section:be71574b-804d-4d1a-94c5-e8c6257a0576", "@type": "Section", "graphScope": "brand", "section_title": "Elimination", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "be71574b-804d-4d1a-94c5-e8c6257a0576", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The effective half-life of nintedanib in patients with IPF was 9.5 hours (gCV 31.9%). Total plasma clearance after intravenous infusion was high (CL: 1390 mL/min; gCV 28.8%). Urinary excretion of unchanged drug within 48 hours was about 0.05% of the dose after oral and about 1.4% of the dose after intravenous administration; the renal clearance was 20 mL/min.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:cd507246-3a03-4a15-8984-df1563861d3a"}]}, {"@id": "urn:kg:ofev:section:01b005ee-0d67-4852-9303-b50892e831e7", "@type": "Section", "graphScope": "brand", "section_title": "Metabolism", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "01b005ee-0d67-4852-9303-b50892e831e7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The prevalent metabolic reaction for nintedanib is hydrolytic cleavage by esterases resulting in the free acid moiety BIBF 1202. BIBF 1202 is subsequently glucuronidated by UGT enzymes, namely UGT 1A1, UGT 1A7, UGT 1A8, and UGT 1A10 to BIBF 1202 glucuronide. Only a minor extent of the biotransformation of nintedanib consisted of CYP pathways, with CYP3A4 being the predominant enzyme involved. The major CYP-dependent metabolite could not be detected in plasma in the human absorption, distribution, metabolism, and elimination study. In vitro , CYP-dependent metabolism accounted for about 5% compared to about 25% ester cleavage.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:32e29b46-58e9-4196-8f5e-8c6a7bfde0c2"}]}, {"@id": "urn:kg:ofev:section:4f7f8f81-109a-4044-b44a-092bbfbe27d6", "@type": "Section", "graphScope": "brand", "section_title": "Excretion", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "4f7f8f81-109a-4044-b44a-092bbfbe27d6", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The major route of elimination of drug-related radioactivity after oral administration of [ 14 C] nintedanib was via fecal/biliary excretion (93.4% of dose), and the majority of OFEV was excreted as BIBF 1202. The contribution of renal excretion to the total clearance was low (0.65% of dose). The overall recovery was considered complete (above 90%) within 4 days after dosing.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:740f8c75-33b4-4699-9f5f-765ad09d67cf"}]}, {"@id": "urn:kg:ofev:section:f2995859-b5da-452e-aa3b-d6b92a3be849", "@type": "Section", "graphScope": "brand", "section_title": "Specific Populations", "section_type": "heading", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "f2995859-b5da-452e-aa3b-d6b92a3be849", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Age, Body Weight, and Sex\n\nBased on population PK analysis, age and body weight were correlated with nintedanib exposure. However, the effects on exposure are not sufficient to warrant a dose adjustment. There was no influence of sex on the exposure of nintedanib.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:dc44a838-ba37-4358-8241-db6cfb3d1f26"}]}, {"@id": "urn:kg:ofev:section:62e6af3f-24d5-457f-ae4b-9f95297cd3bd", "@type": "Section", "graphScope": "brand", "section_title": "Patients with Hepatic Impairment", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "62e6af3f-24d5-457f-ae4b-9f95297cd3bd", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A dedicated single-dose phase I pharmacokinetics study of OFEV compared 8 subjects with mild hepatic impairment (Child Pugh A) and 8 subjects with moderate hepatic impairment (Child Pugh B) to 17 subjects with normal hepatic function. In subjects with mild hepatic impairment, the mean exposure to nintedanib was 2.4-fold higher based on Cmax (90% CI: 1.6 to 3.6) and 2.2-fold higher based on AUC0-inf (90% CI: 1.4 to 3.5). In subjects with moderate hepatic impairment, exposure was 6.9-fold higher based on Cmax (90% CI: 4.4 to 11.0) and 7.6-fold higher based on AUC0-inf (90% CI: 5.1 to 11.3). Subjects with severe hepatic impairment (Child Pugh C) have not been studied.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:acaabb3b-56fe-4817-bd33-90539956ca99"}]}, {"@id": "urn:kg:ofev:section:b0b0d20a-922d-4f41-a581-ccca194e499a", "@type": "Section", "graphScope": "brand", "section_title": "Smokers", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "b0b0d20a-922d-4f41-a581-ccca194e499a", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In the population PK analysis, the exposure of nintedanib was 21% lower in current smokers compared to ex- and never-smokers. The effect is not sufficient to warrant a dose adjustment.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5bfb339c-c1ea-47fd-ae3a-7f02f0547475"}]}, {"@id": "urn:kg:ofev:section:577c605e-45b9-43ba-a90e-dda0f83b76d3", "@type": "Section", "graphScope": "brand", "section_title": "Drug Interaction Studies", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "577c605e-45b9-43ba-a90e-dda0f83b76d3", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:25e731d5-eefb-4fd3-9b97-cccd24520984", "@type": "Section", "graphScope": "brand", "section_title": "Potential for Nintedanib to Affect Other Drugs", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "25e731d5-eefb-4fd3-9b97-cccd24520984", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Effect of nintedanib coadministration on pirfenidone AUC and Cmax  was evaluated in a multiple-dose study. Nintedanib did not have an effect on the exposure of pirfenidone.\n\nFifteen female patients with SSc-ILD received a single dose of a combination of 30 mcg ethinylestradiol and 150 mcg levonorgestrel before and after twice daily dosing of 150 mg nintedanib for at least 10 days. Coadministration of nintedanib did not change the exposure of ethinylestradiol and levonorgestrel [see Warnings and Precautions (5.4) and Use in Specific Populations (8.3)] .\n\nIn in vitro studies, nintedanib was shown not to be an inhibitor of OATP-1B1, OATP-1B3, OATP-2B1, OCT-2, or MRP-2. In vitro studies also showed that nintedanib has weak inhibitory potential on OCT-1, BCRP, and P-gp; these findings are considered to be of low clinical relevance. Nintedanib and its metabolites, BIBF 1202 and BIBF 1202 glucuronide, did not inhibit or induce CYP enzymes in vitro .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:044188d4-8c78-4191-a63f-c0a5406c7015"}]}, {"@id": "urn:kg:ofev:section:4ad2440b-8a75-4a18-b294-c83cc03f0fe1", "@type": "Section", "graphScope": "brand", "section_title": "Potential for Other Drugs to Affect Nintedanib", "section_type": "heading", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "4ad2440b-8a75-4a18-b294-c83cc03f0fe1", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a substrate of P-gp and, to a minor extent, CYP3A4. Coadministration with the P-gp and CYP3A4 inhibitor, ketoconazole, increased exposure to nintedanib 1.61-fold based on AUC and 1.83-fold based on Cmax in a dedicated drug-drug interaction study. In a drug-drug interaction study with the P-gp and CYP3A4 inducer, rifampicin, exposure to nintedanib decreased to 50.3% based on AUC and to 60.3% based on Cmax upon coadministration with rifampicin compared to administration of nintedanib alone.\n\nEffect of pirfenidone coadministration on nintedanib AUC and Cmax was evaluated in a multiple-dose drug-drug interaction study. Pirfenidone did not have an effect on the exposure of nintedanib. Concomitant treatment with nintedanib and pirfenidone was also investigated in a separate trial, which was an exploratory open-label, randomized (1:1) trial of nintedanib 150 mg twice daily with add-on pirfenidone (titrated to 801 mg three times a day) compared to nintedanib 150 mg twice daily alone in 105 randomized patients for 12 weeks. Similar nintedanib trough plasma concentrations were observed when comparing patients receiving nintedanib alone with patients receiving nintedanib with add-on pirfenidone.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a8ecc1cc-f955-410c-99d2-8d2d6e5b1c13"}, {"@id": "urn:kg:ofev:chunk:a315c850-0c88-43ed-bdc0-dd35eec78aa3"}]}, {"@id": "urn:kg:ofev:section:a058e191-7bb7-4ed5-a7ba-f3ac3527d332", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "a058e191-7bb7-4ed5-a7ba-f3ac3527d332", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Healthy volunteers received a single dose of 150 mg nintedanib before and after multiple dosing of 125 mg bosentan twice daily at steady state. Coadministration of nintedanib with bosentan did not alter the pharmacokinetics of nintedanib.\n\nNintedanib displays a pH-dependent solubility profile with increased solubility at acidic pH less than 3. However, in the clinical trials, coadministration with proton pump inhibitors or histamine H2 antagonists did not influence the exposure (trough concentrations) of nintedanib.\n\nIn in vitro studies, nintedanib was shown not to be a substrate of OATP-1B1, OATP-1B3, OATP-2B1, OCT-2, MRP-2, or BCRP. In vitro studies also showed that nintedanib was a substrate of OCT-1; these findings are considered to be of low clinical relevance.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7f6325ff-5fe3-4af6-94fc-0b44bb542e0a"}]}, {"@id": "urn:kg:ofev:section:10099939-f99c-4c40-907c-70c901c5e68f", "@type": "Section", "graphScope": "brand", "section_title": "13 NONCLINICAL TOXICOLOGY", "section_type": "heading", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "10099939-f99c-4c40-907c-70c901c5e68f", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:1d3cf6dc-b0f5-473f-8afb-c366ff663190", "@type": "Section", "graphScope": "brand", "section_title": "13.1  Carcinogenesis, Mutagenesis, Impairment of Fertility", "section_type": "heading", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "1d3cf6dc-b0f5-473f-8afb-c366ff663190", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Two-year oral carcinogenicity studies of nintedanib in rats and mice have not revealed any evidence of carcinogenic potential. Nintedanib was dosed up to 10 and 30 mg/kg/day in rats and mice, respectively. These doses were less than and approximately 4 times the MRHD on a plasma drug AUC basis.\n\nNintedanib was negative for genotoxicity in the in vitro bacterial reverse mutation assay, the mouse lymphoma cell forward mutation assay, and the in vivo rat micronucleus assay.\n\nIn rats, nintedanib reduced female fertility at exposure levels approximately 3 times the MRHD (on an AUC basis at an oral dose of 100 mg/kg/day). Effects included increases in resorption and post-implantation loss, and a decrease in gestation index. Changes in the number and size of corpora lutea in the ovaries were observed in chronic toxicity studies in rats and mice. An increase in the number of females with resorptions only was observed at exposures approximately equal to the MRHD (on an AUC basis at an oral dose of 20 mg/kg/day). Nintedanib had no effects on male fertility in rats at exposure levels approximately 3 times the MRHD (on an AUC basis at an oral dose of 100 mg/kg/day).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:54632b47-679f-4ab7-a85c-3ea55032991e"}, {"@id": "urn:kg:ofev:chunk:129d513f-f317-4a39-821a-a1109fdbea33"}]}, {"@id": "urn:kg:ofev:section:817df3b9-b5b3-4f8c-aeb4-988ee72e7305", "@type": "Section", "graphScope": "brand", "section_title": "14 CLINICAL STUDIES", "section_type": "heading", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "817df3b9-b5b3-4f8c-aeb4-988ee72e7305", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a34f", "@type": "Section", "graphScope": "brand", "section_title": "14.1  Idiopathic Pulmonary Fibrosis", "section_type": "heading", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of OFEV has been studied in 1231 patients with IPF in one phase 2 (Study 1 [NCT00514683]) and two phase 3 studies (Study 2 [NCT01335464] and Study 3 [NCT01335477]). These were randomized, double-blind, placebo-controlled studies comparing treatment with OFEV 150 mg twice daily to placebo for 52 weeks.\n\nStudy 2 and Study 3 were identical in design. Study 1 was very similar in design. Patients were randomized in a 3:2 ratio (1:1 for Study 1) to either OFEV 150 mg or placebo twice daily for 52 weeks. Study 1 also included other treatment arms (50 mg daily, 50 mg twice daily, and 100 mg twice daily) that are not further discussed. The primary endpoint was the annual rate of decline in Forced Vital Capacity (FVC). Time to first acute IPF exacerbation was a key secondary endpoint in Study 2 and Study 3 and a secondary endpoint in Study 1. Change from baseline in FVC percent predicted and survival were additional secondary endpoints in all studies.\n\nPatients were required to have a diagnosis of IPF (ATS/ERS/JRS/ALAT criteria) for less than 5 years. Diagnoses were centrally adjudicated based on radiologic and, if applicable, histopathologic confirmation. Patients were required to be greater than or equal to 40 years of age with an FVC greater than or equal to 50% of predicted and a carbon monoxide diffusing capacity (DLCO, corrected for hemoglobin) 30% to 79% of predicted. Patients with relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7) or, in the opinion of the investigator, likely to receive a lung transplant during the studies were excluded (being listed for lung transplant was acceptable for inclusion). Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded from the studies. Patients were also excluded if they received other investigational therapy, azathioprine, cyclophosphamide, or cyclosporine A within 8 weeks of entry into this trial, or n-acetyl cysteine and prednisone (greater than 15 mg/day or equivalent) within 2 weeks. The majority of patients were Caucasian (60%) or Asian (30%) and male (79%). Patients had a mean age of 67 years and a mean FVC percent predicted of 80%.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4deee41d-9c5c-4b60-aa8b-9c658bce4c1f"}, {"@id": "urn:kg:ofev:chunk:21fc65a7-238b-4ef0-97b6-88625174ec1b"}, {"@id": "urn:kg:ofev:chunk:923b6ae3-d9c7-4097-965c-d6169fdeb01e"}]}, {"@id": "urn:kg:ofev:section:58ccad26-88df-41ad-8591-e84156c7b202", "@type": "Section", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "section_type": "heading", "page_number": 18, "source_document_type": "prescribing_information", "section_id": "58ccad26-88df-41ad-8591-e84156c7b202", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A statistically significant reduction in the annual rate of decline of FVC (in mL) was demonstrated in patients receiving OFEV compared to patients receiving placebo based on the random coefficient regression model, adjusted for gender, height, and age. The treatment effect on FVC was consistent in all 3 studies. See Table 3 for individual study results.\n\nTable 3 Annual Rate of Decline in FVC (mL) in Study 1, Study 2, and Study 3 a\n\n|                                    | Study 1                 | Study 1   | Study 2                 | Study 2   | Study 3                 | Study 3   |\n|------------------------------------|-------------------------|-----------|-------------------------|-----------|-------------------------|-----------|\n|                                    | OFEV 150 mg twice daily | Placebo   | OFEV 150 mg twice daily | Placebo   | OFEV 150 mg twice daily | Placebo   |\n| Number of analyzed patients        | 84                      | 83        | 309                     | 204       | 329                     | 219       |\n| Rate a of decline over 52 weeks    | -60                     | -191      | -115                    | -240      | -114                    | -207      |\n| Comparison vs placebo Difference b | 131                     | 131       | 125                     | 125       | 94                      | 94        |\n| 95% CI                             | (27, 235)               | (27, 235) | (78, 173)               | (78, 173) | (45, 143)               | (45, 143) |\n\nFigure 1 displays the change from baseline over time in both treatment groups for Study 2. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52. Similar plots were seen for Study 1 and Study 3.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:82d6befb-dc02-465d-886d-ee6fd6472f29"}, {"@id": "urn:kg:ofev:chunk:5be79309-d08c-45da-b400-14157d50c498"}]}, {"@id": "urn:kg:ofev:section:166e6c43-94bf-4b14-b6d6-8b2c83a20681", "@type": "Section", "graphScope": "brand", "section_title": "Figure 1 Mean (SEM) Observed FVC Change from Baseline (mL) Over Time in Study 2", "section_type": "heading", "page_number": 19, "source_document_type": "prescribing_information", "section_id": "166e6c43-94bf-4b14-b6d6-8b2c83a20681", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "bid = twice daily\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b1732e59-f63a-4daa-9e40-40e31578c34d"}]}, {"@id": "urn:kg:ofev:section:5c96615a-f77b-4894-b50e-67747b31d772", "@type": "Section", "graphScope": "brand", "section_title": "Change from Baseline in Percent Predicted Forced Vital Capacity", "section_type": "heading", "page_number": 19, "source_document_type": "prescribing_information", "section_id": "5c96615a-f77b-4894-b50e-67747b31d772", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 2 presents the cumulative distribution for all cut-offs for the change from baseline in FVC percent predicted at Week 52 for Study 2. For all categorical declines in lung function, the proportion of patients declining was lower on OFEV than on placebo. Study 3 showed similar results.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:67c947b2-5110-4cee-a7e2-5372443aa9ef"}]}, {"@id": "urn:kg:ofev:section:1b4a09eb-d493-4fc2-bfc7-8b41f7459cc9", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "1b4a09eb-d493-4fc2-bfc7-8b41f7459cc9", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 2 Cumulative Distribution of Patients by Change in Percent Predicted FVC from Baseline to Week 52 (Study 2).* The vertical lines indicate ≥0% decline or ≥10% decline.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:654f2acd-ce02-4a9a-a9f6-677dea885966"}]}, {"@id": "urn:kg:ofev:section:7f693733-17b1-494e-8e31-762835700832", "@type": "Section", "graphScope": "brand", "section_title": "Time to First Acute IPF Exacerbation", "section_type": "heading", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "7f693733-17b1-494e-8e31-762835700832", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Acute IPF exacerbation was defined as unexplained worsening or development of dyspnea within 30 days, new diffuse pulmonary infiltrates on chest x-ray, and/or new high-resolution CT parenchymal abnormalities with no pneumothorax or pleural effusion, and exclusion of alternative causes. Acute IPF exacerbation was adjudicated in Study 2 and Study 3. In Study 1 (investigator-reported) and Study 3 (adjudicated), the risk of first acute IPF exacerbation over 52 weeks was significantly reduced in patients receiving OFEV compared to placebo (hazard ratio [HR]: 0.16, 95% CI: 0.04, 0.71) and (HR: 0.20, 95% CI: 0.07, 0.56), respectively. In Study 2 (adjudicated), there was no difference between the treatment groups (HR: 0.55, 95% CI: 0.20, 1.54).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:376debe6-4661-442f-b50b-49c1366aaa3c"}]}, {"@id": "urn:kg:ofev:section:e49931ec-9215-444f-963d-2f82d6261e86", "@type": "Section", "graphScope": "brand", "section_title": "Survival", "section_type": "heading", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "e49931ec-9215-444f-963d-2f82d6261e86", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Survival was evaluated for OFEV compared to placebo in Study 2 and Study 3 as an exploratory analysis to support the primary endpoint (FVC). All-cause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (See Figure 3).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:77bd2805-c8ad-4602-a654-e5c4aff54e27"}]}, {"@id": "urn:kg:ofev:section:9b5d8f8a-cabb-40b2-9f74-4f09be43e974", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 21, "source_document_type": "prescribing_information", "section_id": "9b5d8f8a-cabb-40b2-9f74-4f09be43e974", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 3 Kaplan-Meier Estimates of All-Cause Mortality at Vital Status End of Study: Study 2 and Study 3\n\n7\n\n<!-- image -->\n\nbid = twice daily", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:375ee171-fd16-4762-9708-39d4261d305e"}]}, {"@id": "urn:kg:ofev:section:8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "@type": "Section", "graphScope": "brand", "section_title": "14.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "section_type": "heading", "page_number": 21, "source_document_type": "prescribing_information", "section_id": "8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of OFEV has been studied in patients with chronic fibrosing ILDs with a progressive phenotype in a randomized, double-blind, placebo-controlled phase 3 trial (Study 5 [NCT02999178]). A total of 663 patients were randomized in a 1:1 ratio to receive either OFEV 150 mg twice daily or matching placebo for at least 52 weeks. Randomization was stratified based on high resolution computed tomography (HRCT) fibrotic pattern as assessed by central readers: 412 patients with UIP-like HRCT pattern and 251 patients with other HRCT fibrotic patterns were randomized. There were 2 co-primary populations defined for the analyses in this trial: all patients (the overall population) and patients with HRCT with UIP-like HRCT fibrotic pattern.\n\nThe primary endpoint was the annual rate of decline in FVC (in mL) over 52 weeks. Other endpoints included time to first acute ILD exacerbation and time to death.\n\nPatients with a clinical diagnosis of a chronic fibrosing ILD were selected if they had relevant fibrosis (greater than 10% fibrotic features) on HRCT and presented with clinical signs of progression (defined as FVC decline ≥ 10%, FVC decline ≥ 5% and &lt;10% with worsening symptoms or imaging, or worsening symptoms and worsening imaging all in the 24 months prior to screening). Patients were required to have an FVC greater than or equal to 45% of predicted and a DLCO 30% to less than 80% of predicted. Patients were required to have progressed despite management deemed appropriate in clinical practice by investigators for the patient's relevant ILD.\n\nPatients with IPF, relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7), or significant pulmonary hypertension were excluded from the trial. Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded. Patients were also excluded if they received other investigational therapy, azathioprine, cyclosporine, mycophenolate mofetil, tacrolimus, oral corticosteroids greater than 20 mg/day, or the combination of oral corticosteroids + azathioprine + n-acetylcysteine within 4 weeks of randomization, cyclophosphamide within 8 weeks prior to randomization, rituximab within 6 months, or previous treatment with nintedanib or pirfenidone.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:78671a95-b7d9-4315-a629-508de39765d7"}, {"@id": "urn:kg:ofev:chunk:1a1970f4-c8e0-4282-8be1-937cc8488d82"}, {"@id": "urn:kg:ofev:chunk:47375e19-8156-4421-abc4-5bc0d2fa26b3"}]}, {"@id": "urn:kg:ofev:section:ce5bae28-2e04-4264-918e-5980b4dd50a7", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 22, "source_document_type": "prescribing_information", "section_id": "ce5bae28-2e04-4264-918e-5980b4dd50a7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The majority of patients were Caucasian (74%) or Asian (25%). Patients were mostly male (54%) and had a mean age of 66 years and a mean FVC percent predicted of 69%, and 49% were never-smokers. The underlying clinical ILD diagnoses in groups represented in the trial were hypersensitivity pneumonitis (26%), autoimmune ILDs (26%), idiopathic nonspecific interstitial pneumonia (19%), unclassifiable idiopathic interstitial pneumonia (17%), and other ILDs (12%).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9215c1b0-e31f-4d23-af1e-51fd5b82d44e"}]}, {"@id": "urn:kg:ofev:section:3b44b253-3c5e-4edf-8134-59aeb8a2f171", "@type": "Section", "graphScope": "brand", "section_title": "Percent Change from Baseline in Forced Vital Capacity", "section_type": "heading", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "3b44b253-3c5e-4edf-8134-59aeb8a2f171", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 9 presents the percent change from baseline in FVC in mL at Week 52 for Study 4. For the majority of patients, the decline in lung function was less on OFEV than on placebo.\n\nFigure 9 Histogram of the Percent Change in FVC (mL) from Baseline to Week 52 According to Treatment and Percent Increments or Decrements of 5 (Study 4) a\n\n25\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5e0e7494-623a-4c07-83e4-081c3f5b74bb"}]}, {"@id": "urn:kg:ofev:section:0a8d2cd2-13e6-45ad-97f3-b4d22a555491", "@type": "Section", "graphScope": "brand", "section_title": "Modified Rodnan Skin Score", "section_type": "heading", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "0a8d2cd2-13e6-45ad-97f3-b4d22a555491", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "No benefit in mRSS was observed in patients receiving OFEV. The adjusted mean absolute change from baseline in mRSS at Week 52 was comparable between the OFEV group (-2.17 (95% CI: -2.69, -1.65)) and the placebo group (-1.96 (95% CI: -2.48, -1.45)). The adjusted mean difference between the treatment groups was -0.21 (95% CI: -0.94, 0.53).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c306b7d6-60e7-468e-a7bd-0cf399584ae2"}]}, {"@id": "urn:kg:ofev:section:9f0b3134-ddb8-4c86-a16f-9e1401e08d98", "@type": "Section", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "section_type": "heading", "page_number": 22, "source_document_type": "prescribing_information", "section_id": "9f0b3134-ddb8-4c86-a16f-9e1401e08d98", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "There was a statistically significant reduction in the annual rate of decline in FVC (in mL) over 52 weeks in patients receiving OFEV compared to patients receiving placebo. The annual rate of decline in FVC (in mL) over 52 weeks was significantly reduced by 107 mL in patients receiving OFEV compared to patients receiving placebo. Results in the subpopulations of patients with HRCT with UIP-like fibrotic pattern and patients with other fibrotic patterns (Other HRCT) are included with the overall population in Table 4.\n\nTable 4 Annual Rate of Decline in FVC (mL) in Study 5\n\n|                                               | Overall   | Overall   | UIP-like Subpopulation   | UIP-like Subpopulation   | Other HRCT Subpopulation   | Other HRCT Subpopulation   |\n|-----------------------------------------------|-----------|-----------|--------------------------|--------------------------|----------------------------|----------------------------|\n|                                               | OFEV      | Placebo   | OFEV                     | Placebo                  | OFEV                       | Placebo                    |\n| Number of analyzed patients                   | 331       | 331       | 206                      | 206                      | 125                        | 125                        |\n| Adjusted annual rate of decline over 52 weeks | -81       | -188      | -83                      | -211                     | -79                        | -154                       |\n| Comparison vs placebo difference a            | 107       | 107       | 128                      | 128                      | 75*                        | 75*                        |\n| 95% CI                                        | (65, 148) | (65, 148) | (71, 186)                | (71, 186)                | (16, 135)*                 | (16, 135)*                 |", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a408706f-913f-404f-94e1-19c25c67467e"}, {"@id": "urn:kg:ofev:chunk:21d0424e-ea84-4835-85d3-f76b093aea5d"}]}, {"@id": "urn:kg:ofev:section:3eddbfc7-62a0-4308-94f6-93395dc75c9b", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 23, "source_document_type": "prescribing_information", "section_id": "3eddbfc7-62a0-4308-94f6-93395dc75c9b", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A post-hoc exploratory analysis by ILD diagnosis was performed and is shown in Figure 4. Treatment response across ILD diagnoses was consistent for FVC.\n\nFigure 4 Annual Rate of Decline in FVC (mL) over 52 Weeks based on Underlying ILD Diagnosis in Study 5*\n\n<!-- image -->\n\nILD = interstitial lung disease; Autoimmune ILDs: includes rheumatoid arthritis-associated ILD, mixed connective tissue disease, systemic sclerosis-associated ILD, and other terms; Other ILDs: includes fibrosing ILDs not categorized under autoimmune ILDs, hypersensitivity pneumonitis, idiopathic nonspecific interstitial pneumonia, or unclassifiable idiopathic interstitial pneumonia. The three most common ILDs in this category are exposure-related ILD, sarcoidosis, and pleuro-parenchymal fibroelastosis. *These results are from a post-hoc exploratory analysis. Values shown here are for descriptive purposes.\n\nFigure 5 shows the change in FVC from baseline over time in the treatment groups. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b2012201-6524-4554-b7e7-a656db3da480"}, {"@id": "urn:kg:ofev:chunk:d2cabfc9-9654-49b2-b257-62a9ad36c899"}]}, {"@id": "urn:kg:ofev:section:61f1bd22-1741-4a62-af2b-64bf8f2f94ab", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 24, "source_document_type": "prescribing_information", "section_id": "61f1bd22-1741-4a62-af2b-64bf8f2f94ab", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 5 Mean (SEM) Observed FVC Change from Baseline (mL) Over 52 Weeks in Study 5\n\n<!-- image -->\n\nbid = twice daily", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d79f37fe-daa1-40ae-97de-818ce63ba532"}]}, {"@id": "urn:kg:ofev:section:0651d94a-11c7-44d3-ae44-df56d8361bc9", "@type": "Section", "graphScope": "brand", "section_title": "Percent Change from Baseline in Forced Vital Capacity", "section_type": "heading", "page_number": 24, "source_document_type": "prescribing_information", "section_id": "0651d94a-11c7-44d3-ae44-df56d8361bc9", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 6 presents the percent change from baseline in FVC in mL at Week 52 for Study 5. For the majority of patients, the decline in lung function was less on OFEV than on placebo.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:dfcb8065-b85c-400a-a125-f2abb8389653"}]}, {"@id": "urn:kg:ofev:section:3a6ec795-c11b-4571-839f-19321f818cb7", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "3a6ec795-c11b-4571-839f-19321f818cb7", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 6 Histogram of the Percent Change in FVC (mL) from Baseline to Week 52 According to Treatment and Percent Increments or Decrements of 5 (Study 5) a\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b2278c37-164d-4f5c-af81-91ebe070bc9b"}]}, {"@id": "urn:kg:ofev:section:6ad4dd31-dcd4-4ea0-bc69-54a13057e025", "@type": "Section", "graphScope": "brand", "section_title": "Time to First Acute ILD Exacerbation", "section_type": "heading", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "6ad4dd31-dcd4-4ea0-bc69-54a13057e025", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Acute ILD exacerbation was defined as unexplained worsening or development of dyspnea within 30 days, new diffuse pulmonary infiltrates on chest x-ray, and/or new HRCT parenchymal abnormalities with no pneumothorax or pleural effusion, and exclusion of alternative causes. Acute ILD exacerbations were not adjudicated.\n\nThe risk of first acute ILD exacerbation did not show a statistically significant difference between the OFEV group compared to placebo (52 week treatment period: HR 0.72, (95% CI: 0.38, 1.37); whole trial: HR 0.63 (95% CI: 0.37, 1.07)).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:14d49f95-98b4-4064-8a21-a34d6f9bf1ff"}]}, {"@id": "urn:kg:ofev:section:d98137e4-1182-40a9-a960-56289cab694d", "@type": "Section", "graphScope": "brand", "section_title": "Survival", "section_type": "heading", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "d98137e4-1182-40a9-a960-56289cab694d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Survival was evaluated for OFEV compared to placebo in Study 5 to support the primary endpoint (FVC). Allcause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (52 week treatment period: HR 0.94 (95% CI: 0.47, 1.86); whole trial: HR 0.78 (95% CI: 0.50, 1.21)).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:32a50cc3-f02b-4b7f-9734-60f6a70030de"}]}, {"@id": "urn:kg:ofev:section:7a66ed23-733e-4b09-96f1-5519c32ef66c", "@type": "Section", "graphScope": "brand", "section_title": "14.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "section_type": "heading", "page_number": 26, "source_document_type": "prescribing_information", "section_id": "7a66ed23-733e-4b09-96f1-5519c32ef66c", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of nintedanib has been studied in patients with SSc-ILD in a randomized, double-blind, placebo-controlled phase 3 trial (Study 4 [NCT02597933]). A total of 580 patients were randomized in a 1:1 ratio to receive either OFEV 150 mg twice daily or matching placebo for at least 52 weeks, of which 576 patients were treated. Randomization was stratified by anti-topoisomerase antibody (ATA) status. Individual patients remained on blinded trial treatment for up to 100 weeks. The primary endpoint was the annual rate of decline in FVC over 52 weeks. The absolute change from baseline in the modified Rodnan skin score (mRSS) at Week 52 was a key secondary endpoint. Mortality over the whole trial was an additional secondary endpoint.\n\nPatients were diagnosed with SSc-ILD based upon the 2013 American College of Rheumatology / European League Against Rheumatism classification criteria for SSc with onset of disease (first non-Raynaud symptom) of less than 7 years and greater than or equal to 10% fibrosis on a chest high resolution computed tomography (HRCT) scan conducted within the previous 12 months. Patients were required to have an FVC greater than or equal to 40% of predicted and a DLCO 30-89% of predicted. Patients with relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7) or previous or planned hematopoietic stem cell transplant were excluded from the trial. Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded from the study. Patients were excluded if they had significant pulmonary hypertension, more than three digital fingertip ulcers, a history of severe digital necrosis requiring hospitalization, or a history of scleroderma renal crisis. Patients were also excluded if they received other investigational therapy, azathioprine within 8 weeks prior to randomization, cyclophosphamide or cyclosporine A within 6 months prior to randomization, or previous treatment with nintedanib or pirfenidone.\n\nThe majority of patients were female (75%). Patients were mostly Caucasian (67%), Asian (25%), or Black (6%). The mean age was 54 years. Overall, 52% of patients had diffuse cutaneous systemic sclerosis (SSc) and 48% had limited cutaneous SSc. The mean time since first onset of a non-Raynaud symptom was 3.49 years. At baseline, 49% of patients were on stable therapy with mycophenolate.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a64edbde-554f-4873-a777-e6943bd4cb35"}, {"@id": "urn:kg:ofev:chunk:68b39376-4400-44f4-b245-bd2327d0d7ea"}, {"@id": "urn:kg:ofev:chunk:b781316c-5007-40ae-bc1d-1b163425afa9"}]}, {"@id": "urn:kg:ofev:section:1b4cad53-af36-425a-a0ac-a1e91f52fc34", "@type": "Section", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "section_type": "heading", "page_number": 26, "source_document_type": "prescribing_information", "section_id": "1b4cad53-af36-425a-a0ac-a1e91f52fc34", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The annual rate of decline of FVC (in mL) over 52 weeks was significantly reduced by 41 mL in patients receiving OFEV compared to patients receiving placebo, corresponding to a relative treatment effect of 44%. See Table 5.\n\nTable 5 Annual Rate of Decline in FVC (mL) in Study 4\n\n|                                        | OFEV 150 mg twice daily   |   Placebo |\n|----------------------------------------|---------------------------|-----------|\n| Number of analyzed patients            | 287                       |       288 |\n| Adjusted rate of decline over 52 weeks | -52                       |       -93 |\n| Comparison vs placebo Difference a     |                           |           |\n|                                        | 41                        |           |\n| 95% CI                                 | (3, 79)                   |           |\n\nFigure 7 displays the change from baseline over time in both treatment groups. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52. Separation of the mean values is seen after 12 weeks of treatment.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ecaf57c2-a9b5-4d5e-a054-501546d7e687"}, {"@id": "urn:kg:ofev:chunk:9a82d2d3-9772-426f-9ffa-1920136cc82e"}]}, {"@id": "urn:kg:ofev:section:9d0fc594-0f4e-43e9-94f8-02377f972355", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 27, "source_document_type": "prescribing_information", "section_id": "9d0fc594-0f4e-43e9-94f8-02377f972355", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 7 Mean (SEM) Observed FVC Change from Baseline (mL) Over Time in Study 4\n\n<!-- image -->\n\nbid = twice daily\n\nIn two pre-specified subgroup efficacy analyses, the mean treatment difference in FVC decline at 52 weeks in patients were examined by region and mycophenolate use (Figure 8).\n\nFigure 8 Subgroup Analyses of the Mean Treatment Difference in FVC (mL) Decline at Week 52 by Region and Mycophenolate Use (Study 4)\n\n|                               | Placebo   | Placebo         | Nmtedanib 150bid   | Nmtedanib 150bid   | Difference [95%Cij   |\n|-------------------------------|-----------|-----------------|--------------------|--------------------|----------------------|\n|                               | N         | Rate of Decline | N                  | Rate of Decline    |                      |\n| Region                        |           |                 |                    |                    |                      |\n| Asia                          | 71        | -92             | 59                 | -48                | 43 (-37; 124]        |\n| Europe                        | 126       | -107            | 139                | -67                | 40 (-17; 96]         |\n| Canada and United States      | 73        | -52             | 69                 | -42                | 10 (-66; 86]         |\n| Rest ofWor1d                  | 18        | -176            | 20                 | 2                  | 178 (28; 329]        |\n| Mycophenolate use at baseline |           |                 |                    |                    |                      |\n| Yes                           | 140       | -67             | 138                | -40                | 26 (-28; 81]         |\n| No                            | 148       | -1 19           | 149                | .64                | 55 [2, 109]          |\n| ALL                           | 288       | -93             | 287                | -52                | 41 [3; 79]           |\n\n<!-- image -->\n\nNintedamb 150bid - Placebo difference in ad1usted rate of decline in FVC [ml/yr) and 95% confidence interval", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:cac1bf1f-3b6a-4cf7-9011-1b5258e1159d"}, {"@id": "urn:kg:ofev:chunk:06372ee2-f5f1-408a-8ee1-561a15e85ef0"}]}, {"@id": "urn:kg:ofev:section:ef644a7a-b2cb-4872-96fa-c27c9364854d", "@type": "Section", "graphScope": "brand", "section_title": "Survival", "section_type": "heading", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "ef644a7a-b2cb-4872-96fa-c27c9364854d", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "No difference in survival was observed in an exploratory analysis of mortality over the whole trial (OFEV: n=10 (3.5%) vs. placebo: n=9 (3.1%)). The analysis of time to death over the whole trial resulted in a HR of 1.16 (95% CI: 0.47, 2.84).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:337a23b5-7181-4292-8753-efd010791688"}]}, {"@id": "urn:kg:ofev:section:9145a320-c5e0-4d9e-92e5-60e0f39171ef", "@type": "Section", "graphScope": "brand", "section_title": "16 HOW SUPPLIED/STORAGE AND HANDLING", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9145a320-c5e0-4d9e-92e5-60e0f39171ef", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "150 mg:  brown, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"150\". They are packaged in HDPE bottles with a child-resistant closure, available as follows: Bottles of 60 NDC:  0597-0145-60\n\n100 mg:  peach, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"100\". They are packaged in HDPE bottles with a child-resistant closure, available as follows: Bottles of 60                                        NDC:  0597-0143-60", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ab98b15d-f566-421e-bae9-81bee5d1b9b8"}]}, {"@id": "urn:kg:ofev:section:257ef4a8-88af-4578-b3b6-8f1e17f07614", "@type": "Section", "graphScope": "brand", "section_title": "Storage", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "257ef4a8-88af-4578-b3b6-8f1e17f07614", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Store at 20°C to 25°C (68°F to 77°F); excursions permitted to 15°C to 30°C (59°F to 86°F) [see USP Controlled Room Temperature]. Protect from exposure to high humidity and avoid excessive heat. If repackaged, use USP tight container.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:dab4af6e-b563-4ce6-b21d-6a521676854f"}]}, {"@id": "urn:kg:ofev:section:78374f81-0a9a-4bae-900d-44e6ed0c7269", "@type": "Section", "graphScope": "brand", "section_title": "17 PATIENT COUNSELING INFORMATION", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "78374f81-0a9a-4bae-900d-44e6ed0c7269", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise the patient to read the FDA-approved patient labeling (Patient Information).", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ba92e54c-7913-4d09-bba2-629b53080f4f"}]}, {"@id": "urn:kg:ofev:section:1d8f3cf2-5f38-4923-9b95-09d069c29030", "@type": "Section", "graphScope": "brand", "section_title": "Elevated Liver Enzymes and Drug-Induced Liver Injury", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "1d8f3cf2-5f38-4923-9b95-09d069c29030", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients that they will need to undergo liver function testing periodically. Advise patients to immediately report any symptoms of a liver problem (e.g., skin or the whites of eyes turn yellow, urine turns dark or brown (tea colored), pain on the right side of stomach, bleed or bruise more easily than normal, lethargy, loss of appetite) [see Warnings and Precautions (5.2)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:be4c7b7f-7438-43f1-9a3d-6180ae9f97bf"}]}, {"@id": "urn:kg:ofev:section:9a6557c9-da30-4940-ba0f-3114966d16bd", "@type": "Section", "graphScope": "brand", "section_title": "Gastrointestinal Disorders", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9a6557c9-da30-4940-ba0f-3114966d16bd", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Inform patients that gastrointestinal disorders such as diarrhea, nausea, and vomiting were the most commonly reported gastrointestinal events occurring in patients who received OFEV. Advise patients that their healthcare provider may recommend hydration, antidiarrheal medications (e.g., loperamide), or anti-emetic medications to treat these side effects. Temporary dosage reductions or discontinuations may be required. Instruct patients to contact their healthcare provider at the first signs of diarrhea or for any severe or persistent diarrhea, nausea, or vomiting [see Warnings and Precautions (5.3) and Adverse Reactions (6.1)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4589a5a8-3939-4006-85ed-cfaa8185b9a3"}]}, {"@id": "urn:kg:ofev:section:9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e", "@type": "Section", "graphScope": "brand", "section_title": "Embryo-Fetal Toxicity", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Counsel patients on pregnancy prevention and planning. Advise females of reproductive potential of the potential risk to a fetus and to avoid becoming pregnant while receiving treatment with OFEV. Advise females of reproductive potential to use highly effective contraception at initiation of, during treatment, and for at least 3 months after taking the last dose of OFEV. Advise women taking oral hormonal contraceptives who experience vomiting and/or diarrhea or other conditions where the drug absorption may be reduced to contact their doctor to discuss alternative highly effective contraception. Advise female patients to notify their doctor if they become pregnant or suspect they are pregnant during therapy with OFEV [see Warnings and Precautions (5.4) and Use in Specific Populations (8.1, 8.3)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b61af2fd-8696-4ce0-a9c0-a09292f4825f"}]}, {"@id": "urn:kg:ofev:section:c86d5e52-8881-44d3-808e-eeab92a27e40", "@type": "Section", "graphScope": "brand", "section_title": "Arterial Thromboembolic Events", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "c86d5e52-8881-44d3-808e-eeab92a27e40", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients about the signs and symptoms of acute myocardial ischemia and other arterial thromboembolic events and the urgency to seek immediate medical care for these conditions [see Warnings and Precautions (5.5)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:91898a45-98bc-4602-a186-58a7e9ff3ff0"}]}, {"@id": "urn:kg:ofev:section:37ba6678-1ba6-4a79-8c51-68f2993f974e", "@type": "Section", "graphScope": "brand", "section_title": "Risk of Bleeding", "section_type": "heading", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "37ba6678-1ba6-4a79-8c51-68f2993f974e", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Bleeding events have been reported. Advise patients to report unusual bleeding [see Warnings and Precautions (5.6)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7ade6b72-7be3-4008-a1ef-f49a299b61fa"}]}, {"@id": "urn:kg:ofev:section:35eea8c4-bdf2-4e0c-9f23-0854287ede88", "@type": "Section", "graphScope": "brand", "section_title": "Gastrointestinal Perforation", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "35eea8c4-bdf2-4e0c-9f23-0854287ede88", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Serious gastrointestinal perforation events have been reported. Advise patients to report signs and symptoms of gastrointestinal perforation [see Warnings and Precautions (5.7)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:664ee1e1-3bfa-4904-b412-aefcb0444452"}]}, {"@id": "urn:kg:ofev:section:89b01160-bc2e-4359-a76c-078a9593c774", "@type": "Section", "graphScope": "brand", "section_title": "Nephrotic Range Proteinuria", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "89b01160-bc2e-4359-a76c-078a9593c774", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nephrotic range proteinuria has been reported. Advise patients to report signs and symptoms of proteinuria (e.g., fluid retention, foamy urine) [see Warnings and Precautions (5.8)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:af7ec372-59d9-4aa7-9283-1b9889beee69"}]}, {"@id": "urn:kg:ofev:section:dff60917-e4b1-4acc-b573-acf13137cbf2", "@type": "Section", "graphScope": "brand", "section_title": "Lactation", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "dff60917-e4b1-4acc-b573-acf13137cbf2", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients that breastfeeding is not recommended while taking OFEV [see Use in Specific Populations (8.2)].", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:94486bb5-901a-4c06-9316-765155b24ad0"}]}, {"@id": "urn:kg:ofev:section:3573d564-f0aa-4e08-9b68-71a8dd228a88", "@type": "Section", "graphScope": "brand", "section_title": "Smokers", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "3573d564-f0aa-4e08-9b68-71a8dd228a88", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Encourage patients to stop smoking prior to treatment with OFEV and to avoid smoking when using OFEV [see Clinical Pharmacology (12.3)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c732fc4c-475e-472f-b21d-e786dd8089e2"}]}, {"@id": "urn:kg:ofev:section:2534378c-d573-4f8e-823f-646211314283", "@type": "Section", "graphScope": "brand", "section_title": "Administration", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "2534378c-d573-4f8e-823f-646211314283", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Instruct patients to take OFEV with food, to swallow OFEV capsules whole with liquid, and not to chew the capsules due to the bitter taste . Advise patients or caregivers not to open or crush OFEV capsules and to wash hands immediately and thoroughly if contact with the content of the capsule occurs. Advise patients to not make up for a missed dose [see Dosage and Administration (2.2)] .", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d557ec5b-85fa-479b-a27d-162076a364b3"}]}, {"@id": "urn:kg:ofev:section:bd907bfe-9933-4dce-b260-fdc470024227", "@type": "Section", "graphScope": "brand", "section_title": "Distributed by:", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "bd907bfe-9933-4dce-b260-fdc470024227", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Boehringer Ingelheim Pharmaceuticals, Inc. Ridgefield, CT 06877 USA", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6ba6208a-923b-42d6-9665-257477a6781e"}]}, {"@id": "urn:kg:ofev:section:2b0570b6-9d18-4dfe-b178-6179cb6ba1b0", "@type": "Section", "graphScope": "brand", "section_title": "Licensed from:", "section_type": "heading", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "2b0570b6-9d18-4dfe-b178-6179cb6ba1b0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Boehringer Ingelheim International GmbH\n\nOFEV is a registered trademark of and used under license from Boehringer Ingelheim International GmbH.\n\nCopyright © 202X Boehringer Ingelheim International GmbH ALL RIGHTS RESERVED\n\nCOL9114HD262024", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e0fbfba0-d5ef-4011-9a2b-9c6448269052"}]}, {"@id": "urn:kg:ofev:section:1c425628-fac5-4210-b73d-ef02433e48b0", "@type": "Section", "graphScope": "brand", "section_title": "Patient Information OFEV ® (OH-fev) (nintedanib capsules)", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "1c425628-fac5-4210-b73d-ef02433e48b0", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:af6cc911-7a9e-4976-b179-57a7a8e118ad", "@type": "Section", "graphScope": "brand", "section_title": "What is the most important information I should know about OFEV?", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "af6cc911-7a9e-4976-b179-57a7a8e118ad", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- OFEV can cause birth defects or death to an unborn baby. Women should not become pregnant while taking OFEV. Women who are able to become pregnant should have a pregnancy test before starting treatment with OFEV.\n- Women who are able to become pregnant should use highly effective birth control at the start of treatment, during treatment, and for at least 3 months after treatment. Talk with your doctor about what birth control method is right for you during this time.\n- Birth control pills may not work as well in women having vomiting, diarrhea, or other problems reducing the drug absorption. If you have any of these problems, talk with your doctor about which highly effective birth control method is right for you.\n- If you become pregnant or think you are pregnant while taking OFEV, tell your doctor right away.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3319f045-a6cf-48b1-b538-4e968a32861c"}]}, {"@id": "urn:kg:ofev:section:6c673293-1075-4628-9d62-571468ca4608", "@type": "Section", "graphScope": "brand", "section_title": "What is OFEV?", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "6c673293-1075-4628-9d62-571468ca4608", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- OFEV is a prescription medicine used:\n- o to treat adults with a lung disease called idiopathic pulmonary fibrosis (IPF).\n- o to treat adults with a long-lasting (chronic) interstitial lung disease in which lung fibrosis continues to worsen (progress).\n- o to slow the rate of decline in lung function in adults with systemic sclerosis-associated interstitial lung disease (SSc-ILD) (also known as scleroderma-associated ILD).\n- It is not known if OFEV is safe and effective in children.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4e20f879-5a1c-42af-b397-dfd2fea227c0"}]}, {"@id": "urn:kg:ofev:section:e617d484-046b-488f-89a5-5159d7711130", "@type": "Section", "graphScope": "brand", "section_title": "What should I tell my doctor before taking OFEV?", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "e617d484-046b-488f-89a5-5159d7711130", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": ""}, {"@id": "urn:kg:ofev:section:769f8a50-7997-4e9d-bef1-a063ec1f3191", "@type": "Section", "graphScope": "brand", "section_title": "Before you take OFEV, tell your doctor about all of your medical conditions, including if you:", "section_type": "heading", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "769f8a50-7997-4e9d-bef1-a063ec1f3191", "extraction_method": "docling", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- have liver problems.\n- have heart problems.\n- have a history of blood clots.\n- have a bleeding problem or a family history of a bleeding problem.\n- have had recent surgery in your stomach (abdominal) area.\n- are a smoker.\n- are pregnant or plan to become pregnant. OFEV can harm your unborn baby. OFEV can cause birth defects or death to an unborn baby. See 'What is the most important information I should know about OFEV?'\n- are breastfeeding or plan to breastfeed. It is not known if OFEV passes into your breast milk. You should not breastfeed while taking OFEV.\n\nTell your doctor about all the medicines you take, including prescription and over-the-counter medicines, vitamins, and herbal supplements such as St. John's wort. Keep a list of the medicines you take and show it to your doctor and pharmacist when you get a new medicine.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:843021b2-839a-453e-8e3e-cff396d2fbdf"}]}, {"@id": "urn:kg:ofev:section:1ae49046-385c-4004-8b4d-5b79b58453b8", "@type": "Section", "graphScope": "brand", "section_title": "tYPoGrAPHY", "section_type": "heading", "page_number": 57, "source_document_type": "brand_book", "section_id": "1ae49046-385c-4004-8b4d-5b79b58453b8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Headlines should be Co Text Bold sentence case\n\nSUBHEADS SHOULD BE CO TEXT BOLD ALL CAPS\n\nBody copy should be Gotham Book sentence case in 80%K. Body call-outs should be in Gotham Bold.\n\nCall-outs should be Co Text Light sentence case\n\nPAtiEnt journAL\n\n<!-- image -->\n\niMPortAnt contAct cArd\n\n<!-- image -->\n\nPAtiEnt StArtEr Kit FoLdEr\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b0fee3ae-11ca-4336-a3de-75b42dcc59cd"}]}, {"@id": "urn:kg:ofev:section:426548d3-811c-4eba-a041-2dc22d50a17f", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 58, "source_document_type": "brand_book", "section_id": "426548d3-811c-4eba-a041-2dc22d50a17f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "e\n\nr\n\ns\n\ni\n\no\n\nn\n\n3\n\nV\n\n8\n\n.\n\n5\n\nT\n\nP\n\nA\n\nT\n\nI\n\nE\n\nN\n\nB\n\nR\n\nA\n\nD\n\nY\n\nS\n\nS\n\nE\n\nM", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e5bb1515-e75e-4aad-b369-1f96d91ee28d"}]}, {"@id": "urn:kg:ofev:section:635e1ec2-6ad4-47cb-8ace-014ce4686fe1", "@type": "Section", "graphScope": "brand", "section_title": "Patient Branded Identity System Summary (cont'd)", "section_type": "heading", "page_number": 58, "source_document_type": "brand_book", "section_id": "635e1ec2-6ad4-47cb-8ace-014ce4686fe1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "ALtErnAtE coLor PALEttE (onLY For uSE in countriES tHAt HAVE  rEStrictionS)\n\n<!-- image -->\n\nPAtiEnt BrocHurE WitHout iMAGE\n\n<!-- image -->\n\nintErior SPrEAd\n\n<!-- image -->\n\nPAtiEnt BrocHurE WitH iMAGE\n\n<!-- image -->\n\n.\n\nY\n\nR\n\nU\n\nS\n\nO\n\nN\n\nF\n\nI\n\nD\n\nE\n\nT\n\nA\n\nL\n\n.\n\nC", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:621b20f4-e26d-4aca-8623-bc01e99d8a0e"}]}, {"@id": "urn:kg:ofev:section:d8624806-6eb4-4b24-a32f-1fa592abb4ac", "@type": "Section", "graphScope": "brand", "section_title": "hcP unbranded Identity System 6.0", "section_type": "heading", "page_number": 59, "source_document_type": "brand_book", "section_id": "d8624806-6eb4-4b24-a32f-1fa592abb4ac", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The HCP unbranded identity system comprises key assets that are designed, managed, and used in a recognizable way across all of our disease state communication materials.\n\nOur identity system unifies our unbranded materials in a consistent, flexible, and ownable way across all channels, allowing us to communicate consistently to the HCP community.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b97af278-7722-400a-a960-f3e25a4d9250"}]}, {"@id": "urn:kg:ofev:section:24f0c4b5-9c1f-4034-af17-2e27ec66c546", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 60, "source_document_type": "brand_book", "section_id": "24f0c4b5-9c1f-4034-af17-2e27ec66c546", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "6.1", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5a04ec6a-35ab-44bf-b2d9-29eb1988ea4f"}]}, {"@id": "urn:kg:ofev:section:0aaba83d-728c-40f8-9ab0-55b2b7ac4b4c", "@type": "Section", "graphScope": "brand", "section_title": "Typography", "section_type": "heading", "page_number": 60, "source_document_type": "brand_book", "section_id": "0aaba83d-728c-40f8-9ab0-55b2b7ac4b4c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Typography is another important element of our unbranded identity and a way to communicate our personality.\n\nHelvetica Neue Black Italic and Bold were selected for their strong sense of urgency and for assigning prominence to communication materials. They are also extremely legible in various font sizes.\n\nIn applications such as Microsoft ®  Word, Microsoft ®  PowerPoint, and programs with restrictive font sets, use Arial Regular for body text and Arial Bold Italic for headline and subheadline text.\n\n<!-- image -->\n\nAa", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3b6f9709-80d5-4e57-806a-a66e46c79efd"}]}, {"@id": "urn:kg:ofev:section:8b33174e-a0cb-4a5f-abb4-75c44f985607", "@type": "Section", "graphScope": "brand", "section_title": "HEADLINE OR PAGE TITLE IN ALL CAPS HELVETICA NEUE BLACK ITALIC IN BLACK", "section_type": "heading", "page_number": 60, "source_document_type": "brand_book", "section_id": "8b33174e-a0cb-4a5f-abb4-75c44f985607", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "SUBTITLE IN ALL CAPS HELVETICA NEUE BLACK ITALIC IN TEAL\n\nPage subheadline in sentence case Helvetica Neue Black Italic in teal\n\nBody copy in sentence case Helvetica Neue Bold in black. Lorem ipsum dolor sit amet.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9e405987-8b53-4560-8376-1b1e8122ad15"}]}, {"@id": "urn:kg:ofev:section:d3345bfa-473e-4735-9b7e-fdfd217e8fbd", "@type": "Section", "graphScope": "brand", "section_title": "6.2", "section_type": "heading", "page_number": 61, "source_document_type": "brand_book", "section_id": "d3345bfa-473e-4735-9b7e-fdfd217e8fbd", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:e13195d5-70eb-4b93-bfa9-788e7dd45818", "@type": "Section", "graphScope": "brand", "section_title": "Color Palette", "section_type": "heading", "page_number": 61, "source_document_type": "brand_book", "section_id": "e13195d5-70eb-4b93-bfa9-788e7dd45818", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Color has the ability to affect human behavior, emotion, and memory. It helps convey our tone and makes us distinct.\n\nOur color palette reflects our personality and achieves the urgency (black) and encouraging (teal) effect we want to express while unifying (taupe) our message.\n\nA secondary palette of grays is available for use in charts and graphs. This secondary palette can also be used to provide additional design hierarchy when needed in complex layouts.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:61c49f9a-cb06-4877-ab50-eda9af23a7d3"}]}, {"@id": "urn:kg:ofev:section:1a391d36-4898-4488-b964-394116252214", "@type": "Section", "graphScope": "brand", "section_title": "6.3", "section_type": "heading", "page_number": 62, "source_document_type": "brand_book", "section_id": "1a391d36-4898-4488-b964-394116252214", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:00a8dac1-51ad-420a-ad75-0eafb991f12b", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics", "section_type": "heading", "page_number": 62, "source_document_type": "brand_book", "section_id": "00a8dac1-51ad-420a-ad75-0eafb991f12b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A secondary graphic is an additional brand element that adds visual distinction and unifies our brand across all of our touchpoints.\n\nOur secondary graphic consists of the teal and black background, divided on a diagonal, and a white holding shape. The flexible background can be used across a whole page or scaled down as small as a footer graphic.\n\nThe white holding shape was designed to contain headline and subheadline text or photography. Silhouetted photography can be placed on the top of the background and/or the white holding shape, as shown below.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:07fa9ad3-fe77-4d2b-ab8f-27dee3d17d2a"}]}, {"@id": "urn:kg:ofev:section:8df7ee12-3c89-4d93-9f8b-b380d7be2ad7", "@type": "Section", "graphScope": "brand", "section_title": "6.4", "section_type": "heading", "page_number": 63, "source_document_type": "brand_book", "section_id": "8df7ee12-3c89-4d93-9f8b-b380d7be2ad7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:da2f8d8a-b726-4297-9439-dc059f857b8d", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics Flexibility", "section_type": "heading", "page_number": 63, "source_document_type": "brand_book", "section_id": "da2f8d8a-b726-4297-9439-dc059f857b8d", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\nBrocHurE And intErior SPrEAd ExAMPLES\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8c16d3a7-997a-4c91-878f-2ce158d372a5"}]}, {"@id": "urn:kg:ofev:section:92765f3c-8103-49cd-af1c-acf7184ddd8c", "@type": "Section", "graphScope": "brand", "section_title": "6.5", "section_type": "heading", "page_number": 64, "source_document_type": "brand_book", "section_id": "92765f3c-8103-49cd-af1c-acf7184ddd8c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:aba56e41-f812-4087-864d-9b80c5b0eaf8", "@type": "Section", "graphScope": "brand", "section_title": "Campaign Visual", "section_type": "heading", "page_number": 64, "source_document_type": "brand_book", "section_id": "aba56e41-f812-4087-864d-9b80c5b0eaf8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The campaign visual works to clearly communicate the unstable and unpredictable nature of IPF. The visual features a man walking on ice that is beginning to crack behind him. The ice symbolizes the uncertain and harsh landscape of IPF, while the cracks in the ice represent the unpredictable and severe outcomes for patients with IPF.\n\nThe campaign is flexible and can be utilized across all unbranded communications. The artwork is able to accommodate large areas and can also be cropped around the man walking on ice when needed. However, it is advised that the cracks of ice not be cropped too much so that the impact of the visual is not lost.\n\nThe campaign headline should always accompany the visual (see 6.6 for headline).\n\nAdditional artwork is available for the sheet of ice without the patient or ice cracks. This can be used when the full campaign is not needed.\n\n<!-- image -->\n\nExAMPLES oF cAMPAiGn ViSuAL in ProMotionAL MAtEriALS\n\n<!-- image -->\n\n<!-- image -->\n\nicE SHEEt ArtWorK\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:bd820940-f6f3-41cb-b2d6-94d1c93fb8f2"}]}, {"@id": "urn:kg:ofev:section:1f48ea64-e34f-4cea-b282-aa74a34688a0", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 65, "source_document_type": "brand_book", "section_id": "1f48ea64-e34f-4cea-b282-aa74a34688a0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "6.6", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3bca2e2d-58b4-47c0-9fd6-15205cadfa9b"}]}, {"@id": "urn:kg:ofev:section:16bd04b8-2565-429f-91f0-69fc143864fd", "@type": "Section", "graphScope": "brand", "section_title": "Campaign Headline", "section_type": "heading", "page_number": 65, "source_document_type": "brand_book", "section_id": "16bd04b8-2565-429f-91f0-69fc143864fd", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The campaign headline 'Your patients are walking on unstable ground' reinforces the serious and unpredictable nature of IPF.\n\nThe headline should always be set in all caps, italicized, and in either black or white to emphasize the urgency of the communication.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:043a89d1-2033-4697-830d-92c2e48d706d"}]}, {"@id": "urn:kg:ofev:section:1161c6e2-e580-4122-86fc-1c16491cf8a5", "@type": "Section", "graphScope": "brand", "section_title": "YOUR PATIENTS ARE WALKING ON UNSTABLE GROUND", "section_type": "heading", "page_number": 65, "source_document_type": "brand_book", "section_id": "1161c6e2-e580-4122-86fc-1c16491cf8a5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:81a6b2e8-2f1b-40ed-8933-73f59ffdf109", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 66, "source_document_type": "brand_book", "section_id": "81a6b2e8-2f1b-40ed-8933-73f59ffdf109", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "6.7", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:339f823a-5e37-41cb-9a5f-fbbfcfb93f0e"}]}, {"@id": "urn:kg:ofev:section:127db073-501f-4ba3-96f7-12103bd3f408", "@type": "Section", "graphScope": "brand", "section_title": "Campaign Tagline", "section_type": "heading", "page_number": 66, "source_document_type": "brand_book", "section_id": "127db073-501f-4ba3-96f7-12103bd3f408", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The tagline communicates Boehringer Ingelheim's commitment to advancing the treatment and management of IPF with the medical community. We are dedicated to looking at IPF in a different way in order to improve the lives of patients with IPF.\n\nThe tagline should always appear in close proximity to the Boehringer Ingelhiem logo.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9c6659e6-588c-408a-af89-f5058b783506"}]}, {"@id": "urn:kg:ofev:section:7e2a9d33-4caf-4770-bac7-fb56f88a6556", "@type": "Section", "graphScope": "brand", "section_title": "TOGEThER, WE cAN SEE IPF DIFFERENTLY", "section_type": "heading", "page_number": 66, "source_document_type": "brand_book", "section_id": "7e2a9d33-4caf-4770-bac7-fb56f88a6556", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:a6dcb5d6-3299-4c1d-9983-b84223e2cc43", "@type": "Section", "graphScope": "brand", "section_title": "6.8", "section_type": "heading", "page_number": 67, "source_document_type": "brand_book", "section_id": "a6dcb5d6-3299-4c1d-9983-b84223e2cc43", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:a1565e89-6b42-4f6e-b26a-4ff9e5a54791", "@type": "Section", "graphScope": "brand", "section_title": "How Our Campaign Elements Work Together", "section_type": "heading", "page_number": 67, "source_document_type": "brand_book", "section_id": "a1565e89-6b42-4f6e-b26a-4ff9e5a54791", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The key elements of the campaign-the visual, headline, tagline, and secondary graphics-are all designed to illustrate the unpredictable and devastating nature of IPF. All the elements complement one another and work synergistically to communicate the urgency of the disease state.\n\nBrocHurE coVEr ExAMPLE\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ef85817d-010b-44f6-a818-db7eedf68901"}]}, {"@id": "urn:kg:ofev:section:075bb995-ebf7-4680-a457-fc6f56263812", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 68, "source_document_type": "brand_book", "section_id": "075bb995-ebf7-4680-a457-fc6f56263812", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:068cd4ec-da97-4c37-b8e0-5fb3e48dddd0"}]}, {"@id": "urn:kg:ofev:section:b0eb612e-4b92-40ba-b7c0-1c3181f2d227", "@type": "Section", "graphScope": "brand", "section_title": "6.9", "section_type": "heading", "page_number": 68, "source_document_type": "brand_book", "section_id": "b0eb612e-4b92-40ba-b7c0-1c3181f2d227", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:10f0bc4a-b61e-426e-8854-6c403e241bb1", "@type": "Section", "graphScope": "brand", "section_title": "HCP Unbranded Identity System Summary", "section_type": "heading", "page_number": 68, "source_document_type": "brand_book", "section_id": "10f0bc4a-b61e-426e-8854-6c403e241bb1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "coLor PALEttE\n\n<!-- image -->\n\njournAL Ad\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b7301204-6c2b-4eff-8f03-5e141684fa20"}]}, {"@id": "urn:kg:ofev:section:6e7e882f-6abe-489c-b684-0f7a99a49749", "@type": "Section", "graphScope": "brand", "section_title": "coLor PALEttE", "section_type": "heading", "page_number": 68, "source_document_type": "brand_book", "section_id": "6e7e882f-6abe-489c-b684-0f7a99a49749", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\ncAMPAiGn PAnEL\n\n<!-- image -->\n\ntYPoGrAPHY", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9dd5ea67-9ee8-4695-ab80-8c9c21e41543"}]}, {"@id": "urn:kg:ofev:section:ad921e46-42da-484e-9716-21f41165b244", "@type": "Section", "graphScope": "brand", "section_title": "HEADLINE OR PAGE TITLE IN ALL CAPS HELVETICA NEUE BLACK ITALIC IN BLACK", "section_type": "heading", "page_number": 68, "source_document_type": "brand_book", "section_id": "ad921e46-42da-484e-9716-21f41165b244", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "SUBTITLE IN ALL CAPS HELVETICA NEUE BLACK ITALIC IN TEAL\n\nPage subheadline in sentence case Helvetica Neue Black Italic in teal\n\nBody copy in sentence case Helvetica Neue Bold in black. Lorem ipsum dolor sit amet.\n\nBrocHurE coVEr &amp; intErior SPrEAd\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:9bec21fa-51b9-493e-b2af-141c223be85f"}]}, {"@id": "urn:kg:ofev:section:ac548616-122c-4ca0-a4c3-01eb83b4a49a", "@type": "Section", "graphScope": "brand", "section_title": "Patient Unbranded Identity System 7.0", "section_type": "heading", "page_number": 69, "source_document_type": "brand_book", "section_id": "ac548616-122c-4ca0-a4c3-01eb83b4a49a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The patient unbranded identity system comprises key assets that are designed, managed, and used in all of our disease education communication materials.\n\nOur identity system unifies our unbranded materials in a consistent, flexible, and ownable way across all channels, allowing us to communicate consistently to the IPF patient community.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:e8cc6b6b-9ccd-40ce-8f78-568952d99462"}]}, {"@id": "urn:kg:ofev:section:b65d1614-0ef6-4c6f-873b-d90bda4945fe", "@type": "Section", "graphScope": "brand", "section_title": "7.1", "section_type": "heading", "page_number": 70, "source_document_type": "brand_book", "section_id": "b65d1614-0ef6-4c6f-873b-d90bda4945fe", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:8ef37cfd-36e8-4299-b27a-c20c73cbb5b9", "@type": "Section", "graphScope": "brand", "section_title": "Typography", "section_type": "heading", "page_number": 70, "source_document_type": "brand_book", "section_id": "8ef37cfd-36e8-4299-b27a-c20c73cbb5b9", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Typography is another important element of our unbranded patient identity and a way to communicate our personality.\n\nThe Museo type family was selected for its friendliness and unique letterforms. They are also extremely legible in various font sizes.\n\nIn applications such as Microsoft ®  Word, Microsoft ®  PowerPoint, and programs with restrictive font sets, use Arial Regular for body text and Arial Bold for headline, subtitle, and subheadline text. Museo can be purchased as a Typekit ®  Web font for Web use from typekit.com.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:92a5d3fd-9710-4116-bade-2f5854c2a3c4"}]}, {"@id": "urn:kg:ofev:section:8e38787f-5bb1-4506-824a-07e355e00557", "@type": "Section", "graphScope": "brand", "section_title": "Aa", "section_type": "heading", "page_number": 70, "source_document_type": "brand_book", "section_id": "8e38787f-5bb1-4506-824a-07e355e00557", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:b2bc92b9-39d9-49dd-bb38-d3b79573cb1c", "@type": "Section", "graphScope": "brand", "section_title": "Headline or page title in sentence case Museo 700 in Gray", "section_type": "heading", "page_number": 70, "source_document_type": "brand_book", "section_id": "b2bc92b9-39d9-49dd-bb38-d3b79573cb1c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Subtitle in Museo 700 sentence case in Salmon\n\nPage subhead in sentence case Museo 500 in Salmon\n\nBody copy in Museo 100 sentence case in Gray. Lorem ipsum dolor sit amet.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:72821581-c1a8-47ce-8625-8926b075fde9"}]}, {"@id": "urn:kg:ofev:section:6bc67760-f1c6-41dc-864e-eebdbd72b139", "@type": "Section", "graphScope": "brand", "section_title": "7.2", "section_type": "heading", "page_number": 71, "source_document_type": "brand_book", "section_id": "6bc67760-f1c6-41dc-864e-eebdbd72b139", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:da5d26bb-3aa5-4f5b-8be4-78fb6851cc6a", "@type": "Section", "graphScope": "brand", "section_title": "Color Palette", "section_type": "heading", "page_number": 71, "source_document_type": "brand_book", "section_id": "da5d26bb-3aa5-4f5b-8be4-78fb6851cc6a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The unbranded colors were chosen to convey feelings of hope and encouragement.\n\nGREEN\n\nPMS 374 C25 M0 Y85 K0 R195 G230 B85 HEX C3E655\n\nSALMON\n\nPMS 486 C0 M53 Y50 K0 R250 G145 B120 HEX FA9178\n\nGRAY\n\nPMS WARM GRAY 11 C0 M12 Y20 K70 R110 G98 B89 HEX 6E6259", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:0aa46c56-c5e1-4265-b5dd-8c8bfe99e5e8"}]}, {"@id": "urn:kg:ofev:section:e44e44a9-2d36-4155-b272-1cf98560bc53", "@type": "Section", "graphScope": "brand", "section_title": "7.3", "section_type": "heading", "page_number": 72, "source_document_type": "brand_book", "section_id": "e44e44a9-2d36-4155-b272-1cf98560bc53", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:9b9e6ed5-c03d-4f75-9449-a4801c781f3b", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics", "section_type": "heading", "page_number": 72, "source_document_type": "brand_book", "section_id": "9b9e6ed5-c03d-4f75-9449-a4801c781f3b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "A secondary graphic is an additional brand element that adds visual distinction and unifies our brand identity across all of our touchpoints.\n\nOur secondary graphic consists of a framing device with a horizontal rectangular tab that holds the headline or any important information that needs to be highlighted.\n\nThe holding shape was designed to contain headline and subheadline text. Photography can be placed on the top of the background and/or in the white holding shape, as shown below.\n\n.3'\n\n1. cHooSE A FuLLBLEEd iMAGE\n\n<!-- image -->\n\n<!-- image -->\n\n3. Add rEctAnGuLAr HorizontAL tAB\n\n<!-- image -->\n\nFLExiBiLitY ExAMPLES\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n2. APPLY GrEEn or SALMon oVErLAY\n\n<!-- image -->\n\n4. APPLY HEAdLinE or otHEr tYPE\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:fd456e80-2ffb-4d86-8acb-b598fba83fb3"}]}, {"@id": "urn:kg:ofev:section:6de56287-0ccb-4e3f-a59d-8531e08fade3", "@type": "Section", "graphScope": "brand", "section_title": "7.4", "section_type": "heading", "page_number": 73, "source_document_type": "brand_book", "section_id": "6de56287-0ccb-4e3f-a59d-8531e08fade3", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:43d074d2-766a-4d69-8a44-0f3343e73d05", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics Flexibility", "section_type": "heading", "page_number": 73, "source_document_type": "brand_book", "section_id": "43d074d2-766a-4d69-8a44-0f3343e73d05", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\nBrocHurE And intErior SPrEAd ExAMPLES\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:20eb5e39-b980-4fa7-8b5b-0614a1d0faab"}]}, {"@id": "urn:kg:ofev:section:fc27cb6a-2a7b-4022-8c7a-9ae60f3cbefb", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 74, "source_document_type": "brand_book", "section_id": "fc27cb6a-2a7b-4022-8c7a-9ae60f3cbefb", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "7.5", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:836bd4b3-d52b-4e3b-9097-df8427197bb8"}]}, {"@id": "urn:kg:ofev:section:f0a13c5a-0ff8-48ee-b489-607c2e629705", "@type": "Section", "graphScope": "brand", "section_title": "How Our Brand Identity Assets Work Together", "section_type": "heading", "page_number": 74, "source_document_type": "brand_book", "section_id": "f0a13c5a-0ff8-48ee-b489-607c2e629705", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Assets such as typeface, color, and graphics together form our brand identity system, through which we achieve our unique look and feel.\n\nunBrAndEd PAtiEnt BrocHurE\n\n<!-- image -->\n\ncAMPAiGn iMAGE\n\nHEAdLinE", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d2fa95d1-d076-4d66-8460-5d4448f137d0"}]}, {"@id": "urn:kg:ofev:section:7b4f2c2d-6527-42af-ab42-60114444911f", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 75, "source_document_type": "brand_book", "section_id": "7b4f2c2d-6527-42af-ab42-60114444911f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "7.5\n\nHow Our Brand Identity Assets Work Together (cont'd)", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:186c84d5-816e-4aa8-b91a-03f5568999b7"}]}, {"@id": "urn:kg:ofev:section:2698b3b3-1b4d-4571-855d-8c43e3ad5e20", "@type": "Section", "graphScope": "brand", "section_title": "unBrAndEd PAtiEnt BrocHurE intErior SPrEAd ExAMPLE", "section_type": "heading", "page_number": 75, "source_document_type": "brand_book", "section_id": "2698b3b3-1b4d-4571-855d-8c43e3ad5e20", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4b6e71de-04ec-4667-9729-382725a31c9c"}]}, {"@id": "urn:kg:ofev:section:5c7318a0-ff94-4049-baef-91cc0952404a", "@type": "Section", "graphScope": "brand", "section_title": "7.6", "section_type": "heading", "page_number": 76, "source_document_type": "brand_book", "section_id": "5c7318a0-ff94-4049-baef-91cc0952404a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:778831f5-2296-4e17-8899-50d255896b25", "@type": "Section", "graphScope": "brand", "section_title": "Patient Unbranded Identity System Summary", "section_type": "heading", "page_number": 76, "source_document_type": "brand_book", "section_id": "778831f5-2296-4e17-8899-50d255896b25", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "PAtiEnt BrocHurE WitH iMAGE\n\n<!-- image -->\n\ncoLor PALEttE\n\n<!-- image -->\n\nintErior SPrEAd\n\n<!-- image -->\n\nSEcondArY GrAPHicS\n\n<!-- image -->\n\ntYPoGrAPHY", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3db85171-463c-4eaf-827f-8dbcc5b86643"}]}, {"@id": "urn:kg:ofev:section:8ccbbe30-9b3c-435c-bfd7-19a3fba1e98a", "@type": "Section", "graphScope": "brand", "section_title": "Headline or page title in sentence case Museo 700 in Gray", "section_type": "heading", "page_number": 76, "source_document_type": "brand_book", "section_id": "8ccbbe30-9b3c-435c-bfd7-19a3fba1e98a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Subtitle in Museo 700 sentence case in Salmon\n\nPage subhead in sentence case Museo 500 in Salmon\n\nBody copy in Museo 100 sentence case in Gray. Lorem ipsum dolor sit amet.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:47dd4c27-d93b-4d5d-9e90-cbad4901c032"}]}, {"@id": "urn:kg:ofev:section:22871919-5050-4ac5-ad6f-3e7ac5323e58", "@type": "Section", "graphScope": "brand", "section_title": "clinical trial visual Identity System 8.0", "section_type": "heading", "page_number": 77, "source_document_type": "brand_book", "section_id": "22871919-5050-4ac5-ad6f-3e7ac5323e58", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The clinical trial visual assets for OFEV ® are designed, managed, and used in promotional materials in a recognizable way, as established by our Clinical Trial Visual Identity System. The system helps to unify our materials, creating a consistent, flexible, and ownable visual communication style that is maintained across all channels.\n\nDeveloping a strong and consistent link between strategic and design elements is essential to the overall success and recognition of study-related communications.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4186f6f5-9922-4626-a7d4-1795188152a9"}]}, {"@id": "urn:kg:ofev:section:19d3fa87-e887-440f-9cee-10bd24aaea3b", "@type": "Section", "graphScope": "brand", "section_title": "8.1", "section_type": "heading", "page_number": 78, "source_document_type": "brand_book", "section_id": "19d3fa87-e887-440f-9cee-10bd24aaea3b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:280ae365-b37a-47f3-a039-1b441d0ab689", "@type": "Section", "graphScope": "brand", "section_title": "Advantages of a Clinical T rial Visual Identity System", "section_type": "heading", "page_number": 78, "source_document_type": "brand_book", "section_id": "280ae365-b37a-47f3-a039-1b441d0ab689", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The following pages provide details on use of the clinical trial identity assets for OFEV ® . These assets have been created for use in study-related communications; clear direction is provided for utilizing visual elements.\n\nThis section will guide you on how to utilize the unbranded elements, including color palette, typography, templates, and grid systems. Follow these guidelines closely.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5829d303-a218-4ef2-803d-81c4e0aabdcd"}]}, {"@id": "urn:kg:ofev:section:b581539f-6b02-4b5b-88d3-dff4be94ef9d", "@type": "Section", "graphScope": "brand", "section_title": "8.2", "section_type": "heading", "page_number": 79, "source_document_type": "brand_book", "section_id": "b581539f-6b02-4b5b-88d3-dff4be94ef9d", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:56af75fc-c480-4feb-8350-7b48c6c65c02", "@type": "Section", "graphScope": "brand", "section_title": "Logo Rationale and Construction", "section_type": "heading", "page_number": 79, "source_document_type": "brand_book", "section_id": "56af75fc-c480-4feb-8350-7b48c6c65c02", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Our clinical trial logo consists of 2 elements: the trial name and the symbol. The symbol depicts a hummingbird, representing vigor and energy. The dark blue, all-caps typeface in the trial name communicates innovation and intelligence.\n\n<!-- image -->\n\ntriAL nAME", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8ff7ee90-d9d1-4f12-bc98-0235599a6fa1"}]}, {"@id": "urn:kg:ofev:section:18304e1f-656a-4cf4-bed8-8d34c70126a8", "@type": "Section", "graphScope": "brand", "section_title": "8.3", "section_type": "heading", "page_number": 80, "source_document_type": "brand_book", "section_id": "18304e1f-656a-4cf4-bed8-8d34c70126a8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:971ba75f-0ca6-4f47-aefe-3f2045e45250", "@type": "Section", "graphScope": "brand", "section_title": "Individual Trial Names", "section_type": "heading", "page_number": 80, "source_document_type": "brand_book", "section_id": "971ba75f-0ca6-4f47-aefe-3f2045e45250", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "There are 6 individual clinical trial names, each with its own logo. These assets are available for download.\n\nLoGo FAMiLY\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d3acfb71-7fb6-47fd-9399-68306ec06582"}]}, {"@id": "urn:kg:ofev:section:98745e70-9bd7-401a-89c8-a72e84643e6b", "@type": "Section", "graphScope": "brand", "section_title": "8.4", "section_type": "heading", "page_number": 81, "source_document_type": "brand_book", "section_id": "98745e70-9bd7-401a-89c8-a72e84643e6b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:309b47f4-7d60-44d0-ac8c-35905423838e", "@type": "Section", "graphScope": "brand", "section_title": "Clear Space and Minimum Size", "section_type": "heading", "page_number": 81, "source_document_type": "brand_book", "section_id": "309b47f4-7d60-44d0-ac8c-35905423838e", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Clear space is the recommended area of white or an empty space surrounding the INPULSIS ® -1 logo. 100% of the cap height of the logotype is equal to 1x. A minimum clear space of 1x should be maintained around the entire mark at all times.\n\nMinimum size is the smallest size at which our brandmark can be reproduced. The minimum size of the INPULSIS ® -1 brandmark is 7/8' (22mm) in width for print and 125 pixels in width for digital applications. For legibility reasons, the brandmark should never be smaller than that.\n\n<!-- image -->\n\ncLEAr SPAcE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->\n\nPrint: 7/8' (22 mm) diGitAL: 125 PixELS", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:664c258a-a5d1-430e-96b7-f91eeb448bea"}]}, {"@id": "urn:kg:ofev:section:060c2da0-9926-4dd5-84bb-fa1856696ccf", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 82, "source_document_type": "brand_book", "section_id": "060c2da0-9926-4dd5-84bb-fa1856696ccf", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "8.5", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:3f930efe-bd30-4d39-88a1-ddfab7c39a42"}]}, {"@id": "urn:kg:ofev:section:6a3f0f49-45f8-4651-8367-36706164a224", "@type": "Section", "graphScope": "brand", "section_title": "Logo Color Versions", "section_type": "heading", "page_number": 82, "source_document_type": "brand_book", "section_id": "6a3f0f49-45f8-4651-8367-36706164a224", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The preferred use of the INPULSIS ® -1 logo is the CMYK version on white background.\n\nThe CMYK and PMS logos are used when printing communication pieces. When printing in black and white, use the grayscale version of the logo. The RGB version of the logo is used for design pieces intended for electronic use such as interfaces, websites, and PowerPoint documents.\n\ncMYK\n\n(PrEFErrEd For ALL PrintEd coMMunicAtionS)\n\n<!-- image -->\n\n(uSEd WHEn SPot coLor PrintinG iS\n\n4 PMS tHE onLY oPtion AVAiLABLE)\n\n<!-- image -->\n\nrGB\n\n(uSEd For diGitAL APPLicAtionS)\n\n<!-- image -->\n\nGrAYScALE (uSEd WHEn FuLL-coLor PrintinG iS not AVAiLABLE)\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:4c7beca7-9f1f-44f4-afbd-6b1946a314a1"}]}, {"@id": "urn:kg:ofev:section:463df2b6-3a95-4994-a9c1-8556545a8fba", "@type": "Section", "graphScope": "brand", "section_title": "8.6", "section_type": "heading", "page_number": 83, "source_document_type": "brand_book", "section_id": "463df2b6-3a95-4994-a9c1-8556545a8fba", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:48ecd0e5-8bf0-430c-824b-9214a8537f37", "@type": "Section", "graphScope": "brand", "section_title": "Incorrect Usage of Logo", "section_type": "heading", "page_number": 83, "source_document_type": "brand_book", "section_id": "48ecd0e5-8bf0-430c-824b-9214a8537f37", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "It can be easy to misuse our logo when implementing across marketing materials.\n\nFor your reference, here are some ways our logo should not be used.\n\n<!-- image -->\n\ndo not ALtEr or SWAP AnY oF tHE LoGo'S coLorS\n\n<!-- image -->\n\ndo not crEAtE outLinEd VErSionS oF tHE LoGo\n\n<!-- image -->\n\ndo not rotAtE tHE LoGo\n\n<!-- image -->\n\ndo not iLLuStrAtE tHE LoGo\n\n<!-- image -->\n\ndo not StrEtcH or SKEW tHE LoGo\n\n<!-- image -->\n\ndo not Add droP SHAdoWS to tHE LoGo\n\n<!-- image -->\n\nLorem ipsum dolor                     consectetur adipiscing elit. Vestibulum pellentesque risus pulvinar mauris suscipit volutpat. Duis eleifend quam nibh, in pharetra lorem dapibus.\n\ndo not uSE tHE LoGo in coPY\n\n<!-- image -->\n\ndo not ModiFY or crEAtE nEW LoGotYPE/SYMBoL LocKuPS\n\n<!-- image -->\n\nINPULSIS-1\n\ndo not ModiFY or rEcrEAtE tHE LoGotYPE\n\ndo not PLAcE tHE LoGo on BAcKGroundS tHAt do not ProVidE SuFFiciEnt contrASt\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d62086e2-8718-454c-99ee-aed73d15aa38"}]}, {"@id": "urn:kg:ofev:section:5c1cbb75-11ae-4d04-8984-08df19b97060", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 84, "source_document_type": "brand_book", "section_id": "5c1cbb75-11ae-4d04-8984-08df19b97060", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "8.7", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:5fbf64a5-39f8-4829-afb1-c38ad7a66dd5"}]}, {"@id": "urn:kg:ofev:section:214eca65-ca27-49f0-af14-a8dc20079943", "@type": "Section", "graphScope": "brand", "section_title": "Typography", "section_type": "heading", "page_number": 84, "source_document_type": "brand_book", "section_id": "214eca65-ca27-49f0-af14-a8dc20079943", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The primary font selected for the clinical trial branding is Chalet. Progressive and scientific, Chalet complements the logo well; it is also the font in which the trial names are set. The secondary font used for body copy is Helvetica Neue Roman.\n\n<!-- image -->\n\nAa Headlines should be Chalet-London Nineteen Seventy sentence case SUBHEADS SHOULD BE CHALET-NEW YORK NINETEEN SEVENTY\n\nBody copy should be Helvetica Neue Roman sentence case in 80%K. Body call-outs should be in Helvetica Neue Bold.\n\nCall-outs should be Chalet-London Nineteen Seventy sentence case", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8be15576-14fd-40ea-a499-a3e27e31eb87"}]}, {"@id": "urn:kg:ofev:section:3e4e98c0-3b1f-4a3a-997e-f857798e2bcc", "@type": "Section", "graphScope": "brand", "section_title": "8.8", "section_type": "heading", "page_number": 85, "source_document_type": "brand_book", "section_id": "3e4e98c0-3b1f-4a3a-997e-f857798e2bcc", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:beaac254-f209-4cd1-887a-843966bcfb18", "@type": "Section", "graphScope": "brand", "section_title": "Color Palette", "section_type": "heading", "page_number": 85, "source_document_type": "brand_book", "section_id": "beaac254-f209-4cd1-887a-843966bcfb18", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The clinical trial colors are the same as our brand colors. They should be used to help maintain brand recognition and impact, and to establish a visual link between the brand and the clinical trials.\n\nIn this color palette, Inspiring Yellow and Brilliant Gold are the primary colors and should be the most prominent colors in the color palette.\n\nGuardian Blue is a secondary color and Premium Orange may be used for highlights in applications as well as in typographical call-outs and subheads.\n\nComfort Gray is included again as a neutral tertiary color that helps balance the palette. Comfort Gray can be used in clinical and scientific situations such as charts or to represent placebo.\n\nINPULSIS COLOR PALETTE", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:6c891c2c-0127-43f5-9f00-bffbf13ea981"}]}, {"@id": "urn:kg:ofev:section:2e8838a4-9413-4256-9275-b85373ea8aaf", "@type": "Section", "graphScope": "brand", "section_title": "inPuLSiS ®  coLor PALEttE", "section_type": "heading", "page_number": 85, "source_document_type": "brand_book", "section_id": "2e8838a4-9413-4256-9275-b85373ea8aaf", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\nPMS Orange 021", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c01ddf10-ab34-48f6-8acd-04699f5c7aad"}]}, {"@id": "urn:kg:ofev:section:885a58fd-e3b8-4791-bf34-66c0e061024c", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 86, "source_document_type": "brand_book", "section_id": "885a58fd-e3b8-4791-bf34-66c0e061024c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "8.9", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:7a93dac4-9a68-4830-aeff-33f2e9c132ca"}]}, {"@id": "urn:kg:ofev:section:3379ee4f-b2e1-4db9-8e67-7a79ea26d2c5", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics", "section_type": "heading", "page_number": 86, "source_document_type": "brand_book", "section_id": "3379ee4f-b2e1-4db9-8e67-7a79ea26d2c5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Clinical trial visual identity assets include more than just color and typography. The secondary graphics for the clinical trials provide an ownable and recognizable look-beyond the logo-that can be used on all study-related communications.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:ce48a9ed-8c5d-4c57-b053-e0d1e6035b56"}]}, {"@id": "urn:kg:ofev:section:f47bbd33-cfa3-4196-b385-82832d4e04a8", "@type": "Section", "graphScope": "brand", "section_title": "8.10", "section_type": "heading", "page_number": 87, "source_document_type": "brand_book", "section_id": "f47bbd33-cfa3-4196-b385-82832d4e04a8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:76eba09f-7bc3-4db1-a3c1-f29d47d0686b", "@type": "Section", "graphScope": "brand", "section_title": "Secondary Graphics Flexibility", "section_type": "heading", "page_number": 87, "source_document_type": "brand_book", "section_id": "76eba09f-7bc3-4db1-a3c1-f29d47d0686b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Our secondary graphics have been designed to accommodate a variety of layouts and content. The size of the shapes can be scaled up, down, and sideways, adding flexibility to the system while maintaining a consistent look.\n\nBlue should always be the dominant color on the page; the golden supergraphic should be used as a secondary element.\n\noFEV\\_HorizontAL\\_cMYK.Ai\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d8534697-6adc-4605-b9e0-01dbcd22097e"}]}, {"@id": "urn:kg:ofev:section:3543ae81-63f8-4e9c-836f-e0ae2fe9cc74", "@type": "Section", "graphScope": "brand", "section_title": "8.11", "section_type": "heading", "page_number": 88, "source_document_type": "brand_book", "section_id": "3543ae81-63f8-4e9c-836f-e0ae2fe9cc74", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:1e45624e-d809-4909-a45f-11c6fffa514e", "@type": "Section", "graphScope": "brand", "section_title": "How Our Brand Identity Assets Work Together", "section_type": "heading", "page_number": 88, "source_document_type": "brand_book", "section_id": "1e45624e-d809-4909-a45f-11c6fffa514e", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The key elements of the clinical trial materials are the secondary graphics (the dominant blue color and the golden supergraphic), the clinical trial logo, and the written content. These elements complement one another and work synergistically to communicate in a clear and compelling way.\n\n<!-- image -->\n\n.\n\nY", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:acdcfc77-a332-4305-8663-905db766ac16"}]}, {"@id": "urn:kg:ofev:section:29657375-6f17-4257-b09f-7a0a7ed0004e", "@type": "Section", "graphScope": "brand", "section_title": "8.12", "section_type": "heading", "page_number": 89, "source_document_type": "brand_book", "section_id": "29657375-6f17-4257-b09f-7a0a7ed0004e", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:0d081977-3ef6-4372-b0c2-b6b43442bfaf", "@type": "Section", "graphScope": "brand", "section_title": "Clinical T rial PowerPoint Template", "section_type": "heading", "page_number": 89, "source_document_type": "brand_book", "section_id": "0d081977-3ef6-4372-b0c2-b6b43442bfaf", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "PowerPoint templates enable us to present information with clarity, credibility, and consistency.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:f2fdba14-ada4-4dd4-a88b-4ca0821a5311"}]}, {"@id": "urn:kg:ofev:section:1e0ce469-8e0a-42de-8149-ee7bf02ca83f", "@type": "Section", "graphScope": "brand", "section_title": "8.13", "section_type": "heading", "page_number": 90, "source_document_type": "brand_book", "section_id": "1e0ce469-8e0a-42de-8149-ee7bf02ca83f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:956e02af-78dd-45f6-8188-fe1db695eedc", "@type": "Section", "graphScope": "brand", "section_title": "Clinical T rial Folder", "section_type": "heading", "page_number": 90, "source_document_type": "brand_book", "section_id": "956e02af-78dd-45f6-8188-fe1db695eedc", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Illustrated to the right is an example of a clinical trial folder.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:2f1aceeb-7d67-41b1-b87e-86c25a6d9359"}]}, {"@id": "urn:kg:ofev:section:60372b10-c191-4cde-a264-df5ed6c6198f", "@type": "Section", "graphScope": "brand", "section_title": "8.14 Clinical T rial Stationery System", "section_type": "heading", "page_number": 91, "source_document_type": "brand_book", "section_id": "60372b10-c191-4cde-a264-df5ed6c6198f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The letterhead to the right demonstrates use of the clinical trial stationery system.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:1fc87fa1-4b41-4475-817a-d19395b696f5"}]}, {"@id": "urn:kg:ofev:section:f4593eab-5882-4278-a647-d2963d6ee472", "@type": "Section", "graphScope": "brand", "section_title": "8.15", "section_type": "heading", "page_number": 92, "source_document_type": "brand_book", "section_id": "f4593eab-5882-4278-a647-d2963d6ee472", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:5463938d-d6a7-442b-bfff-a7e6d4c8c760", "@type": "Section", "graphScope": "brand", "section_title": "Clinical T rial Visual Identity System Summary", "section_type": "heading", "page_number": 92, "source_document_type": "brand_book", "section_id": "5463938d-d6a7-442b-bfff-a7e6d4c8c760", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:b18da0fb-d74f-4f3b-8356-d03b1dc296e4"}]}, {"@id": "urn:kg:ofev:section:564892e7-16a6-4e83-99f7-309913fdae70", "@type": "Section", "graphScope": "brand", "section_title": "references 9.0", "section_type": "heading", "page_number": 93, "source_document_type": "brand_book", "section_id": "564892e7-16a6-4e83-99f7-309913fdae70", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Knowing how to access and use the OFEV ® brand assets is critical for ease in applying them. This section explains the file nomenclature and provides assets for download, contact information, and a quick reference guide.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:8b5c72b6-823d-45ab-9107-a0a7c8b90c6f"}]}, {"@id": "urn:kg:ofev:section:460da3db-8322-4c80-9e44-61d109c861c5", "@type": "Section", "graphScope": "brand", "section_title": "9.1", "section_type": "heading", "page_number": 94, "source_document_type": "brand_book", "section_id": "460da3db-8322-4c80-9e44-61d109c861c5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:85a8ee51-9331-49ce-9d98-b4ae48e70509", "@type": "Section", "graphScope": "brand", "section_title": "Marketing Materials", "section_type": "heading", "page_number": 94, "source_document_type": "brand_book", "section_id": "85a8ee51-9331-49ce-9d98-b4ae48e70509", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Please refer to the document entitled Overview of IPF Materials (ID number in BI Vault: 000). It lists all of the branded and unbranded campaign tactics prepared by the corporate marketing team. These tactics are meant to be translated and adapted for use in your local market. Use the identification numbers in this document to locate and download the tactics. A PDF of each tactic is accompanied by a literature pack as well as a ZIP file containing the art files; your agency can use these materials to customize the tactic and prepare for regulatory review.\n\n<!-- image -->", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:d4d5fbfa-6b11-45af-a23c-39af0fef430d"}]}, {"@id": "urn:kg:ofev:section:29f4a2ae-c22a-424d-a02a-706e1975fe9b", "@type": "Section", "graphScope": "brand", "section_type": "body", "page_number": 95, "source_document_type": "brand_book", "section_id": "29f4a2ae-c22a-424d-a02a-706e1975fe9b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "9.2", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:c0f70cf6-36f5-4363-bffc-f5471dc107bb"}]}, {"@id": "urn:kg:ofev:section:89202da0-0ccd-4f15-acee-1666d4e198de", "@type": "Section", "graphScope": "brand", "section_title": "Logo File Nomenclature", "section_type": "heading", "page_number": 95, "source_document_type": "brand_book", "section_id": "89202da0-0ccd-4f15-acee-1666d4e198de", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The following nomenclature system has been developed to help identify and easily locate the various graphic files. Please always use the downloadable electronic reproducible art we have provided.\n\nThe various file formats available are: AI (Adobe Illustrator) files are used for all high-quality printing. These files are in a vector format and can be scaled up or down without loss of quality.\n\nJPG (Joint Photographic Experts Group) files are in a compressed format best used on the Internet because they are in RGB. They cannot be scaled up without loss of quality.\n\nPNG (Portable Network Graphics) files are used for importing artwork into PowerPoint for on-screen presentations. These files can also be used on the Internet. This is a compressed format; files are best created at full size and not scaled up or down. PNG files are created with a transparent background.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:35b24151-9162-49fa-8cd6-34add4bf74fc"}]}, {"@id": "urn:kg:ofev:section:94ef50bb-4c16-4fd6-8098-b08e1bd5e6b1", "@type": "Section", "graphScope": "brand", "section_title": "OFEV\\_L\\_TAG\\_P\\_CMYK.eps", "section_type": "heading", "page_number": 95, "source_document_type": "brand_book", "section_id": "94ef50bb-4c16-4fd6-8098-b08e1bd5e6b1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "Product Name\n\nOFEV OFEV ®  (nintedanib)\n\n| Type of Asset L Logo   | TAG Tagline US United States GLOBAL Global PURE No Tagline SYMBOL Symbol Only   | Positive/ Negative/ Graphic Color Type P Positive N Negative   | Color Mode 3PMS 3 Pantone Spot Color CMYK 4-Color Process RGB Digital Publishing GS Grayscale   | Extension .ai .jpg .pdf .png   |\n|------------------------|---------------------------------------------------------------------------------|----------------------------------------------------------------|-------------------------------------------------------------------------------------------------|--------------------------------|", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:98b857f8-9bcd-4e91-9a53-751ba0f44b1b"}]}, {"@id": "urn:kg:ofev:section:1da780e3-724d-4df0-b92f-263453704a51", "@type": "Section", "graphScope": "brand", "section_title": "9.2 Logo File", "section_type": "heading", "page_number": 96, "source_document_type": "brand_book", "section_id": "1da780e3-724d-4df0-b92f-263453704a51", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": ""}, {"@id": "urn:kg:ofev:section:968357fa-6ef8-422f-9dba-15bf92f4b8cb", "@type": "Section", "graphScope": "brand", "section_title": "Nomenclature (cont'd)", "section_type": "heading", "page_number": 96, "source_document_type": "brand_book", "section_id": "968357fa-6ef8-422f-9dba-15bf92f4b8cb", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text": "The following nomenclature system has been developed to help identify and easily locate the various graphic files. Please always use the downloadable electronic reproducible art we have provided.\n\nThe various file formats available are: AI (Adobe Illustrator) files are used for all high-quality printing. These files are in a vector format and can be scaled up or down without loss of quality.\n\nJPG (Joint Photographic Experts Group) files are in a compressed format best used on the Internet because they are in RGB. They cannot be scaled up without loss of quality.\n\nPNG (Portable Network Graphics) files are used for importing artwork into PowerPoint for on-screen presentations. These files can also be used on the Internet. This is a compressed format; files are best created at full size and not scaled up or down. PNG files are created with a transparent background.", "SECTION_HAS_CHUNK": [{"@id": "urn:kg:ofev:chunk:a198018d-d669-420f-9587-881a74664b8d"}]}, {"@id": "urn:kg:ofev:section:ecef8a2b-9330-4beb-9d70-00653a90b973", "@type": "Section", "graphScope": "brand", "section_title": "LoGoS", "section_type": "heading", "page_number": 96, "source_document_type": "brand_book", "section_id": "ecef8a2b-9330-4beb-9d70-00653a90b973", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "text"