573-acf13137cbf2"}, {"@id": "urn:kg:ofev:section:3573d564-f0aa-4e08-9b68-71a8dd228a88"}, {"@id": "urn:kg:ofev:section:2534378c-d573-4f8e-823f-646211314283"}, {"@id": "urn:kg:ofev:section:bd907bfe-9933-4dce-b260-fdc470024227"}, {"@id": "urn:kg:ofev:section:2b0570b6-9d18-4dfe-b178-6179cb6ba1b0"}, {"@id": "urn:kg:ofev:section:1c425628-fac5-4210-b73d-ef02433e48b0"}, {"@id": "urn:kg:ofev:section:af6cc911-7a9e-4976-b179-57a7a8e118ad"}, {"@id": "urn:kg:ofev:section:6c673293-1075-4628-9d62-571468ca4608"}, {"@id": "urn:kg:ofev:section:e617d484-046b-488f-89a5-5159d7711130"}, {"@id": "urn:kg:ofev:section:769f8a50-7997-4e9d-bef1-a063ec1f3191"}]}, {"@id": "urn:kg:ofev:indication:ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "@type": "Indication", "graphScope": "brand", "market": "US", "source_page": 3, "indication_text": "OFEV is indicated for the treatment of adults with idiopathic pulmonary fibrosis (IPF).", "source_document_type": "prescribing_information", "section_id": "ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ce99ebb1-2851-47b3-bf8f-780bc9979eb6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:indication:ea8e62e0-53b8-430f-943a-c799fa9eee3d", "@type": "Indication", "graphScope": "brand", "market": "US", "source_page": 3, "indication_text": "OFEV is indicated for the treatment of adults with chronic fibrosing interstitial lung diseases (ILDs) with a progressive phenotype [see Clinical Studies (14.2)] .", "source_document_type": "prescribing_information", "section_id": "ea8e62e0-53b8-430f-943a-c799fa9eee3d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ea8e62e0-53b8-430f-943a-c799fa9eee3d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:indication:efb29753-d5d1-492e-ba48-17c2159184d0", "@type": "Indication", "graphScope": "brand", "market": "US", "source_page": 3, "indication_text": "OFEV is indicated to slow the rate of decline in pulmonary function in adult patients with systemic sclerosisassociated interstitial lung disease (SSc-ILD).", "source_document_type": "prescribing_information", "section_id": "efb29753-d5d1-492e-ba48-17c2159184d0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:efb29753-d5d1-492e-ba48-17c2159184d0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:enterprise:market:usa", "@type": "Market", "graphScope": "enterprise", "source_document_type": "ai_disclosure_matrix", "name": "USA", "source_file_name": "ai_disclosure_matrix.xlsx", "region": "USA", "source_document_id": "af71b132-580d-4e61-9318-1237237b3e05", "MARKET_PART_OF_REGION": [{"@id": "urn:kg:enterprise:market:region:usa"}]}, {"@id": "urn:kg:ofev:pisection:7acb7805-523b-488f-8421-149f8d133751", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 1, "source_document_type": "product_information", "section_id": "7acb7805-523b-488f-8421-149f8d133751", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "<!-- image -->\n\nEMA/66511/2025 EMEA/H/C/003821", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7acb7805-523b-488f-8421-149f8d133751"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:b8b10953-95c7-413d-a909-6022cf02797a", "@type": "PISection", "graphScope": "brand", "section_title": "Ofev ( nintedanib )", "page_number": 1, "source_document_type": "product_information", "section_id": "b8b10953-95c7-413d-a909-6022cf02797a", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:b8b10953-95c7-413d-a909-6022cf02797a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:6e22bd8c-fd4c-4bd9-82c0-e11b4a5ab450", "@type": "PISection", "graphScope": "brand", "section_title": "An overview of Ofev and why it is authorised in the EU", "page_number": 1, "source_document_type": "product_information", "section_id": "6e22bd8c-fd4c-4bd9-82c0-e11b4a5ab450", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6e22bd8c-fd4c-4bd9-82c0-e11b4a5ab450"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:da9b36ca-7e9f-47e9-89c1-167e724757c3", "@type": "PISection", "graphScope": "brand", "section_title": "What is Ofev and what is it used for?", "page_number": 1, "source_document_type": "product_information", "section_id": "da9b36ca-7e9f-47e9-89c1-167e724757c3", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev is a medicine used to treat:\n\n-  adults with idiopathic pulmonary fibrosis (IPF), a disease of unknown cause in which fibrous (scar) tissue forms in the lungs;\n-  adults and children above the age of 6 years with systemic sclerosis-associated interstitial lung disease (ILD), a disease in which the immune system (the body's natural defences) is overactive, causing development of fibrous tissue and progressive scarring of the lungs;\n-  adults with other chronic interstitial lung diseases that are fibrosing (causing production of fibrous tissue) and progressive (getting worse);\n-  children aged 6 to 17 years with clinically significant,  progressive fibrosing ILDs.\n\nOfev contains the active substance nintedanib.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:da9b36ca-7e9f-47e9-89c1-167e724757c3"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:c2ba0763-97e9-48b9-9e73-0a6fde6ab1db", "@type": "PISection", "graphScope": "brand", "section_title": "How is Ofev used?", "page_number": 1, "source_document_type": "product_information", "section_id": "c2ba0763-97e9-48b9-9e73-0a6fde6ab1db", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev can only be obtained with a prescription, and treatment should be started by a doctor experienced in the diagnosis and treatment of the diseases it is used for. For children, treatment should be started only after involvement of a multidisciplinary team (physicians, radiologists, pathologists) experienced in the diagnosis and treatment of ILDs.\n\nOfev is available as capsules taken twice a day with food, approximately 12 hours apart. In patients who do not tolerate this dose, the doctor should reduce the dose or interrupt treatment.\n\nChildren receiving Ofev will undergo dental examinations at least every six months until their teeth are fully developed, and their growth will be monitored annually through bone imaging.\n\nFor more information about using Ofev, see the package leaflet or contact your doctor or pharmacist.\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:c2ba0763-97e9-48b9-9e73-0a6fde6ab1db"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:431a8949-d68d-4026-b6fc-068dc633baa9", "@type": "PISection", "graphScope": "brand", "section_title": "How does Ofev work?", "page_number": 2, "source_document_type": "product_information", "section_id": "431a8949-d68d-4026-b6fc-068dc633baa9", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "The active substance in Ofev, nintedanib, blocks the activity of some enzymes known as tyrosine kinases. These enzymes are present in certain receptors (such as VEGF, FGF and PDGF receptors) in cells in the lungs, where they activate several processes involved in the generation of fibrous tissue. By blocking these enzymes, nintedanib helps to reduce the formation of fibrous tissue in the lungs, thereby helping to prevent worsening of the disease symptoms.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:431a8949-d68d-4026-b6fc-068dc633baa9"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:13760ddc-2921-4e57-b3f1-f2f10da5c57a", "@type": "PISection", "graphScope": "brand", "section_title": "What benefits of Ofev have been shown in studies?", "page_number": 2, "source_document_type": "product_information", "section_id": "13760ddc-2921-4e57-b3f1-f2f10da5c57a", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev has been compared with placebo (a dummy treatment) in four main studies involving a total of 1,066 adults with IPF, 580 adults with systemic sclerosis-associated ILD and 663 adults with progressive fibrosing ILD. In all studies, the main measure of effectiveness was the decline in the functioning of the patients' lungs over the course of 1 year of treatment, measured by their forced vital capacity (FVC). FVC is the maximum amount of air a person can breathe out forcefully after taking in a deep breath and decreases as the condition gets worse.\n\nIn 2 studies involving adults with IPF, patients taking Ofev had a smaller decline in FVC than patients taking placebo, meaning that Ofev slowed down the worsening of the condition. The average FVC before treatment was between 2,600 and 2,700 millilitres (ml). In the first study, the average decrease in FVC over 1 year was 115 ml in patients taking Ofev compared with 240 ml in patients taking placebo. In the second study, the average decrease was 114 ml for Ofev compared with 207 ml for placebo. A further analysis of the results of the 2 main studies, which took into account that some patients stopped treatment, confirmed the benefits of Ofev over placebo, although the difference in FVC between the two was less pronounced.\n\nIn the study involving adult patients with systemic sclerosis-associated ILD, the average decrease in FVC was 52 ml for Ofev compared with 93 ml for placebo. The average FVC before treatment was around 2,500 ml.\n\nIn the study in adults with progressive fibrosing ILD, the average decrease in FVC was 81 ml for Ofev compared with 188 ml for placebo. The average FVC before treatment was around 2,330 ml.\n\nIn addition, data in children with fibrosing ILD aged 6 to 17 years showed that, at the recommended doses, blood levels of the medicine were similar to those seen in adults at the recommended doses.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:13760ddc-2921-4e57-b3f1-f2f10da5c57a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:305d4f42-378d-478d-aaa3-ac9d5c838b6a", "@type": "PISection", "graphScope": "brand", "section_title": "What are the risks associated with Ofev?", "page_number": 2, "source_document_type": "product_information", "section_id": "305d4f42-378d-478d-aaa3-ac9d5c838b6a", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "For the full list of side effects and restrictions with Ofev, see the package leaflet.\n\nThe most common side effects with Ofev (which may affect more than 1 in 10 people) include diarrhoea, nausea (feeling sick), vomiting, abdominal pain (belly ache), decreased appetite and raised levels of liver enzymes in the blood (a sign of liver problems). Weight loss (which may affect up to 1 in 10 people) is also common.\n\nOfev must not be used in patients who are hypersensitive (allergic) to nintedanib, peanut or soya, or any of the other ingredients. Ofev must also not be used in pregnant women.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:305d4f42-378d-478d-aaa3-ac9d5c838b6a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:8725de24-48b7-4c09-8ba2-7d1eefd322aa", "@type": "PISection", "graphScope": "brand", "section_title": "Why is Ofev authorised in the EU?", "page_number": 2, "source_document_type": "product_information", "section_id": "8725de24-48b7-4c09-8ba2-7d1eefd322aa", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "The European Medicines Agency decided that Ofev's benefits are greater than its risks and it can be authorised for use in the EU. The Agency considered that Ofev is effective at slowing down the worsening of lung function in adult patients with IPF, systemic sclerosis-associated ILD and other chronic fibrosing ILDs that are progressive.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8725de24-48b7-4c09-8ba2-7d1eefd322aa"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:cb34e383-a4e4-405d-9df0-348aeeed7701", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 3, "source_document_type": "product_information", "section_id": "cb34e383-a4e4-405d-9df0-348aeeed7701", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Based on the disease characteristics and how the medicine works, the medicine's effectiveness for treating clinically significant progressive fibrosing ILD and systemic sclerosis-associated ILD in children is expected to be similar as in adults. However, long-term safety data for children are not available and there are uncertainties on the potential impact on growth and tooth development, which require regular monitoring.\n\nRegarding safety, the side effects associated with Ofev were considered manageable with dose interruptions or reductions.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:cb34e383-a4e4-405d-9df0-348aeeed7701"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:cb34e383-a4e4-405d-9df0-348aeeed7701"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:dc466117-741b-4411-a8c6-0893e6dd88bc", "@type": "PISection", "graphScope": "brand", "section_title": "What measures are being taken to ensure the safe and effective use of Ofev?", "page_number": 3, "source_document_type": "product_information", "section_id": "dc466117-741b-4411-a8c6-0893e6dd88bc", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Recommendations and precautions to be followed by healthcare professionals and patients for the safe and effective use of Ofev have been included in the summary of product characteristics and the package leaflet.\n\nAs for all medicines, data on the use of Ofev are continuously monitored. Side effects reported with Ofev are carefully evaluated and any necessary action taken to protect patients.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:dc466117-741b-4411-a8c6-0893e6dd88bc"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:dc466117-741b-4411-a8c6-0893e6dd88bc"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:334a4964-ba3d-453c-aba8-6208c206a20c", "@type": "PISection", "graphScope": "brand", "section_title": "Other information about Ofev", "page_number": 3, "source_document_type": "product_information", "section_id": "334a4964-ba3d-453c-aba8-6208c206a20c", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "text": "Ofev received a marketing authorisation valid throughout the EU on 14 January 2015.\n\nFurther information on Ofev can be found on the Agency's website: ema.europa.eu/medicines/human/EPAR/ofev.\n\nThis overview was last updated in 01-2025.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:334a4964-ba3d-453c-aba8-6208c206a20c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:pisection:d02488c4-6e6b-4e92-8028-b5a0d3304adb", "@type": "PISection", "graphScope": "brand", "section_title": "8.6  Hepatic Impairment", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "d02488c4-6e6b-4e92-8028-b5a0d3304adb", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is predominantly eliminated via biliary/fecal excretion (greater than 90%). In a PK study performed in patients with hepatic impairment (Child Pugh A, Child Pugh B), exposure to nintedanib was increased [see Clinical Pharmacology (12.3)] . In patients with mild hepatic impairment (Child Pugh A), the recommended dosage of OFEV is 100 mg twice daily [see Dosage and Administration (2.3)] . Monitor for adverse reactions and consider treatment interruption, or discontinuation for management of adverse reactions in these patients [see Dosage and Administration (2.4)]. Treatment of patients with moderate (Child Pugh B) and severe (Child Pugh C) hepatic impairment with OFEV is not recommended [see Warnings and Precautions (5.1)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:d02488c4-6e6b-4e92-8028-b5a0d3304adb"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d02488c4-6e6b-4e92-8028-b5a0d3304adb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:3eef6067-5ce7-4439-b6f5-b9e4766aea08", "@type": "PISection", "graphScope": "brand", "section_title": "8.4  Pediatric Use", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "3eef6067-5ce7-4439-b6f5-b9e4766aea08", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The safety and effectiveness of OFEV have not been established in pediatric patients for the treatment of fibrosing interstitial lung diseases. Effectiveness was not demonstrated in a randomized, double-blind, placebocontrolled study conducted in 26 OFEV-treated pediatric patients aged 6 to 17 years with fibrosing interstitial lung diseases, who were treated with OFEV based on weight.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:3eef6067-5ce7-4439-b6f5-b9e4766aea08"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:3eef6067-5ce7-4439-b6f5-b9e4766aea08"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:eab8203a-a7e4-4af4-9a88-ead72d731491", "@type": "PISection", "graphScope": "brand", "section_title": "8.8  Smokers", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "eab8203a-a7e4-4af4-9a88-ead72d731491", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Smoking was associated with decreased exposure to OFEV [see Clinical Pharmacology (12.3)], which may alter the efficacy profile of OFEV . Encourage patients to stop smoking prior to treatment with OFEV and to avoid smoking when using OFEV.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:eab8203a-a7e4-4af4-9a88-ead72d731491"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:c9cf59d0-cdc4-47b3-ac2e-23f72b2d0b02", "@type": "PISection", "graphScope": "brand", "section_title": "Patients with Renal Impairment", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "c9cf59d0-cdc4-47b3-ac2e-23f72b2d0b02", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on a population PK analysis of data from 933 patients with IPF, exposure to nintedanib was not influenced by mild (CrCl: 60 to 90 mL/min; n=399) or moderate (CrCl: 30 to 60 mL/min; n=116) renal impairment. Data in severe renal impairment (CrCl below 30 mL/min) was limited.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:c9cf59d0-cdc4-47b3-ac2e-23f72b2d0b02"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:96d38928-6fe8-4fae-bf41-95f4878df0c8", "@type": "PISection", "graphScope": "brand", "section_title": "HIGHLIGHTS OF PRESCRIBING INFORMATION", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "96d38928-6fe8-4fae-bf41-95f4878df0c8", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "These highlights do not include all the information needed to use OFEV safely and effectively. See full prescribing information for OFEV.\n\nOFEV ®  (nintedanib capsules), for oral use Initial U.S. Approval: 2014", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:96d38928-6fe8-4fae-bf41-95f4878df0c8"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:164ad312-f86c-41c1-ba2c-afce22038fc5", "@type": "PISection", "graphScope": "brand", "section_title": "----------------------------INDICATIONS AND USAGE---------------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "164ad312-f86c-41c1-ba2c-afce22038fc5", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is a kinase inhibitor indicated in adults for:\n\n- Treatment of idiopathic pulmonary fibrosis (IPF) (1.1)\n- Treatment of chronic fibrosing interstitial lung diseases (ILDs) with a progressive phenotype (1.2)\n- Slowing the rate of decline in pulmonary function in patients with systemic sclerosis-associated interstitial lung disease (SSc-ILD) (1.3)", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:164ad312-f86c-41c1-ba2c-afce22038fc5"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6e058b55-c461-46b2-b07a-9d99ebc88ec7", "@type": "PISection", "graphScope": "brand", "section_title": "----------------------DOSAGE AND ADMINISTRATION-----------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "6e058b55-c461-46b2-b07a-9d99ebc88ec7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Recommended dosage: 150 mg taken orally twice daily approximately 12 hours apart taken with food. (2.2)\n- Recommended dosage in patients with mild hepatic impairment (Child Pugh A): 100 mg taken orally twice daily approximately 12 hours apart taken with food. (2.3, 8.6)\n- Consider temporary dose reduction to 100 mg, treatment interruption, or discontinuation for management of adverse reactions. (2.4, 5.2, 5.3, 6)\n- Prior to treatment initiation, conduct liver function tests in all patients and a pregnancy test in females of reproductive potential. (2.1, 5.2, 5.4)", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:6e058b55-c461-46b2-b07a-9d99ebc88ec7"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6e058b55-c461-46b2-b07a-9d99ebc88ec7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:fc8653d0-43b8-40b5-a2e3-796578bedd9b", "@type": "PISection", "graphScope": "brand", "section_title": "---------------------DOSAGE FORMS AND STRENGTHS----------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "fc8653d0-43b8-40b5-a2e3-796578bedd9b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Capsules: 150 mg and 100 mg (3)\n\n-------------------------------CONTRAINDICATIONS------------------------------\n\nNone (4)", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:fc8653d0-43b8-40b5-a2e3-796578bedd9b"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:fc8653d0-43b8-40b5-a2e3-796578bedd9b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:688df660-1573-4aa4-9374-bac703e0b348", "@type": "PISection", "graphScope": "brand", "section_title": "-----------------------WARNINGS AND PRECAUTIONS------------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "688df660-1573-4aa4-9374-bac703e0b348", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Hepatic impairment: OFEV is not recommended for use in patients with moderate or severe hepatic impairment. In patients with mild hepatic impairment (Child Pugh A), the recommended dosage is 100 mg twice daily approximately 12 hours apart taken with food. Consider treatment interruption, or discontinuation for management of adverse reactions in these patients. (2.3, 2.4, 5.1, 8.6, 12.3)\n- Elevated liver enzymes and drug-induced liver injury: ALT, AST, and bilirubin elevations have occurred with OFEV, including cases of druginduced liver injury. In the postmarketing period, non-serious and serious cases of drug-induced liver injury, including severe liver injury with fatal outcome, have been reported. The majority of hepatic events occur within the first three months of treatment. Liver enzyme and bilirubin increases were reversible with dose modification or interruption in the majority of cases. Monitor ALT, AST, and bilirubin prior to initiation of treatment, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Temporary dosage reductions or discontinuations may be required. (2.1, 2.4, 5.2)\n- Gastrointestinal disorders: Diarrhea, nausea, and vomiting have occurred with OFEV. Treat patients at first signs with adequate hydration and antidiarrheal medicine (e.g., loperamide) or anti-emetics. Discontinue OFEV if severe diarrhea, nausea, or vomiting persists despite symptomatic treatment. (5.3)\n- Embryo-Fetal toxicity: Can cause fetal harm. Advise females of reproductive potential of the potential risk to a fetus and to use highly effective contraception. Advise women taking oral hormonal contraceptives experiencing vomiting, diarrhea, or other conditions where the drug absorption may be reduced to use alternative highly effective contraception. (5.4, 8.1, 8.3)\n- Arterial thromboembolic events have been reported. Use caution when treating patients at higher cardiovascular risk including known coronary artery disease. (5.5)\n- Bleeding events have been reported. Use OFEV in patients with known bleeding risk only if anticipated benefit outweighs the potential risk. (5.6)\n- Gastrointestinal perforation has been reported. Use OFEV with caution when treating patients with recent abdominal surgery, previous history of diverticular disease or receiving concomitant corticosteroids or NSAIDs. Discontinue OFEV in patients who develop gastrointestinal perforation. Only use OFEV in patients with known risk of gastrointestinal perforation if the anticipated benefit outweighs the potential risk. (5.7)\n- Nephrotic range proteinuria has been reported. Consider treatment interruption in patients who develop new or worsening proteinuria. (5.8)\n\n------------------------------ADVERSE REACTIONS-------------------------------\n\nMost common adverse reactions (≥5%) are: diarrhea, nausea, abdominal pain, vomiting, liver enzyme elevation, decreased appetite, headache, weight decreased, and hypertension. (6.1)\n\nTo report SUSPECTED ADVERSE REACTIONS, contact Boehringer Ingelheim Pharmaceuticals, Inc. at (800) 542-6257 or FDA at 1-800-FDA1088 or www.fda.gov/medwatch .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:688df660-1573-4aa4-9374-bac703e0b348"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:688df660-1573-4aa4-9374-bac703e0b348"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ec2cf348-f6af-4ee0-ade1-f87726f92c1f", "@type": "PISection", "graphScope": "brand", "section_title": "-------------------------------DRUG INTERACTIONS------------------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "ec2cf348-f6af-4ee0-ade1-f87726f92c1f", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Coadministration of P-gp and CYP3A4 inhibitors may increase nintedanib exposure. Monitor patients closely for tolerability of OFEV. (7.1)", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ec2cf348-f6af-4ee0-ade1-f87726f92c1f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9fdcda17-4250-4366-892a-14b50500c12e", "@type": "PISection", "graphScope": "brand", "section_title": "-----------------------USE IN SPECIFIC POPULATIONS------------------------", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "9fdcda17-4250-4366-892a-14b50500c12e", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Lactation: Breastfeeding is not recommended. (8.2)\n- Renal impairment: The safety and efficacy of OFEV have not been studied in patients with severe renal impairment and end-stage renal disease. (8.7, 12.3)\n- Smokers: Decreased exposure has been noted in smokers which may alter the efficacy profile of OFEV. (8.8)\n\nSee 17 for PATIENT COUNSELING INFORMATION and FDAapproved patient labeling.\n\nRevised: 06/2024\n\n\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:9fdcda17-4250-4366-892a-14b50500c12e"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9fdcda17-4250-4366-892a-14b50500c12e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:f9739371-07a0-42b3-8334-bd81045f713b", "@type": "PISection", "graphScope": "brand", "section_title": "FULL PRESCRIBING INFORMATION: CONTENTS*", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "f9739371-07a0-42b3-8334-bd81045f713b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:f9739371-07a0-42b3-8334-bd81045f713b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d3850114-8def-4c6a-b090-f07c0535d3b6", "@type": "PISection", "graphScope": "brand", "section_title": "1 INDICATIONS AND USAGE", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "d3850114-8def-4c6a-b090-f07c0535d3b6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 1.1 Idiopathic Pulmonary Fibrosis\n- 1.2 Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype\n- 1.3 Systemic Sclerosis-Associated Interstitial Lung Disease", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d3850114-8def-4c6a-b090-f07c0535d3b6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:88f7c10f-7855-49e5-9698-23d306d76750", "@type": "PISection", "graphScope": "brand", "section_title": "2  DOSAGE AND ADMINISTRATION", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "88f7c10f-7855-49e5-9698-23d306d76750", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 2.1 Testing Prior to OFEV Administration\n- 2.2 Recommended Dosage\n- 2.3 Recommended Dosage for Patients with Hepatic Impairment\n- 2.4 Dosage Modification due to Adverse Reactions\n- 3  DOSAGE FORMS AND STRENGTHS\n- 4  CONTRAINDICATIONS", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:88f7c10f-7855-49e5-9698-23d306d76750"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:88f7c10f-7855-49e5-9698-23d306d76750"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:7c7c699f-44b8-4a6a-a888-0055e70596e1", "@type": "PISection", "graphScope": "brand", "section_title": "5  WARNINGS AND PRECAUTIONS", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "7c7c699f-44b8-4a6a-a888-0055e70596e1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 5.1 Hepatic Impairment\n- 5.2 Elevated Liver Enzymes and Drug-Induced Liver Injury\n- 5.3 Gastrointestinal Disorders\n- 5.4 Embryo-Fetal Toxicity\n- 5.5 Arterial Thromboembolic Events\n- 5.6 Risk of Bleeding\n- 5.7 Gastrointestinal Perforation\n- 5.8 Nephrotic Range Proteinuria", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:7c7c699f-44b8-4a6a-a888-0055e70596e1"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7c7c699f-44b8-4a6a-a888-0055e70596e1"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ea96f293-17db-4474-acdf-8214f7d8372e", "@type": "PISection", "graphScope": "brand", "section_title": "6  ADVERSE REACTIONS", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "ea96f293-17db-4474-acdf-8214f7d8372e", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 6.1 Clinical Trials Experience\n- 6.2 Postmarketing Experience", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:ea96f293-17db-4474-acdf-8214f7d8372e"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ea96f293-17db-4474-acdf-8214f7d8372e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:970c5868-991c-4d68-926e-5febc4458981", "@type": "PISection", "graphScope": "brand", "section_title": "7  DRUG INTERACTIONS", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "970c5868-991c-4d68-926e-5febc4458981", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 7.1 P-glycoprotein (P-gp) and CYP3A4 Inhibitors and Inducers\n- 7.2 Anticoagulants\n- 7.3 Pirfenidone\n- 7.4 Bosentan", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:970c5868-991c-4d68-926e-5febc4458981"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4710c794-ec31-42e5-aabe-d350fb6966de", "@type": "PISection", "graphScope": "brand", "section_title": "8 USE IN SPECIFIC POPULATIONS", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "4710c794-ec31-42e5-aabe-d350fb6966de", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 8.1 Pregnancy\n- 8.2 Lactation\n- 8.3 Females and Males of Reproductive Potential\n- 8.4 Pediatric Use\n- 8.5 Geriatric Use\n- 8.6 Hepatic Impairment\n- 8.7 Renal Impairment\n- 8.8 Smokers\n- 10 OVERDOSAGE\n- 11 DESCRIPTION", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4710c794-ec31-42e5-aabe-d350fb6966de"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d2ad3259-c669-4849-9f6e-730a52da8615", "@type": "PISection", "graphScope": "brand", "section_title": "12 CLINICAL PHARMACOLOGY", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "d2ad3259-c669-4849-9f6e-730a52da8615", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 12.1  Mechanism of Action\n- 12.2  Pharmacodynamics", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d2ad3259-c669-4849-9f6e-730a52da8615"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d21ab2d0-a27c-452e-adb1-1b2eca277610", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "d21ab2d0-a27c-452e-adb1-1b2eca277610", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "12.3  Pharmacokinetics", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d21ab2d0-a27c-452e-adb1-1b2eca277610"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8812673f-987c-43b7-925c-d8682e41f5c2", "@type": "PISection", "graphScope": "brand", "section_title": "13 NONCLINICAL TOXICOLOGY", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "8812673f-987c-43b7-925c-d8682e41f5c2", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "13.1  Carcinogenesis, Mutagenesis, Impairment of Fertility", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8812673f-987c-43b7-925c-d8682e41f5c2"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:148a6661-0169-4838-9609-f205e4a18d47", "@type": "PISection", "graphScope": "brand", "section_title": "14 CLINICAL STUDIES", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "148a6661-0169-4838-9609-f205e4a18d47", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "14.1  Idiopathic Pulmonary Fibrosis\n\n14.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:148a6661-0169-4838-9609-f205e4a18d47"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6b81ea50-7d91-48f7-864b-1a95b9e5e9db", "@type": "PISection", "graphScope": "brand", "section_title": "Phenotype", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "6b81ea50-7d91-48f7-864b-1a95b9e5e9db", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "14.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6b81ea50-7d91-48f7-864b-1a95b9e5e9db"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9215197a-682f-47d6-8784-856d1089e686", "@type": "PISection", "graphScope": "brand", "section_title": "16 HOW SUPPLIED/STORAGE AND HANDLING 17 PATIENT COUNSELING INFORMATION", "page_number": 2, "source_document_type": "prescribing_information", "section_id": "9215197a-682f-47d6-8784-856d1089e686", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "*Sections or subsections omitted from the full prescribing information are not listed.\n\n\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9215197a-682f-47d6-8784-856d1089e686"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:e15fbcb5-0b00-4791-8d8f-69592c273a11", "@type": "PISection", "graphScope": "brand", "section_title": "FULL PRESCRIBING INFORMATION", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "e15fbcb5-0b00-4791-8d8f-69592c273a11", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:e15fbcb5-0b00-4791-8d8f-69592c273a11"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bbcebda3-f550-45d8-aafc-3ebda9f7426c", "@type": "PISection", "graphScope": "brand", "section_title": "1 INDICATIONS AND USAGE", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "bbcebda3-f550-45d8-aafc-3ebda9f7426c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bbcebda3-f550-45d8-aafc-3ebda9f7426c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "@type": "PISection", "graphScope": "brand", "section_title": "1.1  Idiopathic Pulmonary Fibrosis", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "ce99ebb1-2851-47b3-bf8f-780bc9979eb6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated for the treatment of adults with idiopathic pulmonary fibrosis (IPF).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ce99ebb1-2851-47b3-bf8f-780bc9979eb6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ea8e62e0-53b8-430f-943a-c799fa9eee3d", "@type": "PISection", "graphScope": "brand", "section_title": "1.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "ea8e62e0-53b8-430f-943a-c799fa9eee3d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated for the treatment of adults with chronic fibrosing interstitial lung diseases (ILDs) with a progressive phenotype [see Clinical Studies (14.2)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ea8e62e0-53b8-430f-943a-c799fa9eee3d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:efb29753-d5d1-492e-ba48-17c2159184d0", "@type": "PISection", "graphScope": "brand", "section_title": "1.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "efb29753-d5d1-492e-ba48-17c2159184d0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV is indicated to slow the rate of decline in pulmonary function in adult patients with systemic sclerosisassociated interstitial lung disease (SSc-ILD).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:efb29753-d5d1-492e-ba48-17c2159184d0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:a08245b6-6bde-4322-9df9-558538b91313", "@type": "PISection", "graphScope": "brand", "section_title": "2 DOSAGE AND ADMINISTRATION", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "a08245b6-6bde-4322-9df9-558538b91313", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a08245b6-6bde-4322-9df9-558538b91313"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:a80139d2-f611-4453-b99b-71578451a7bb", "@type": "PISection", "graphScope": "brand", "section_title": "2.1  Testing Prior to OFEV Administration", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "a80139d2-f611-4453-b99b-71578451a7bb", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Conduct liver function tests in all patients and a pregnancy test in females of reproductive potential prior to initiating treatment with OFEV [see Warnings and Precautions (5.2, 5.4)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:a80139d2-f611-4453-b99b-71578451a7bb"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a80139d2-f611-4453-b99b-71578451a7bb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:495cbee6-ed37-438c-b6bd-b8c671af5b9d", "@type": "PISection", "graphScope": "brand", "section_title": "2.2  Recommended Dosage", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "495cbee6-ed37-438c-b6bd-b8c671af5b9d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The recommended dosage of OFEV is 150 mg taken orally twice daily administered approximately 12 hours apart.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:495cbee6-ed37-438c-b6bd-b8c671af5b9d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:2fb52a50-d6de-4fb8-99cc-e9af0c25d9cb", "@type": "PISection", "graphScope": "brand", "section_title": "Administration Information", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "2fb52a50-d6de-4fb8-99cc-e9af0c25d9cb", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV capsules should be taken with food [see Clinical Pharmacology (12.3)] and swallowed whole with liquid. OFEV capsules should not be chewed because of a bitter taste.\n\nOFEV capsules should not be opened or crushed. If contact with the content of the capsule occurs, wash hands immediately and thoroughly. The effect of chewing or crushing of the capsule on the pharmacokinetics of nintedanib is not known.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:2fb52a50-d6de-4fb8-99cc-e9af0c25d9cb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:32e4de96-8694-4511-bc14-f29466291d9f", "@type": "PISection", "graphScope": "brand", "section_title": "Information for Missed Dose", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "32e4de96-8694-4511-bc14-f29466291d9f", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "If a dose of OFEV is missed, the next dose should be taken at the next scheduled time. Advise the patient to not make up for a missed dose. Do not exceed the recommended maximum daily dosage of 300 mg.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:32e4de96-8694-4511-bc14-f29466291d9f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:0873e02b-617c-423d-9433-d6550bb56786", "@type": "PISection", "graphScope": "brand", "section_title": "2.3  Recommended Dosage for Patients with Hepatic Impairment", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "0873e02b-617c-423d-9433-d6550bb56786", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:0873e02b-617c-423d-9433-d6550bb56786"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9d127930-11a8-4369-bac9-9293140bed84", "@type": "PISection", "graphScope": "brand", "section_title": "Mild Hepatic Impairment", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "9d127930-11a8-4369-bac9-9293140bed84", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In patients with mild hepatic impairment (Child Pugh A), the recommended dosage of OFEV is 100 mg orally twice daily approximately 12 hours apart taken with food [see Use in Specific Populations (8.6)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9d127930-11a8-4369-bac9-9293140bed84"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:94bba718-8cea-42f5-97db-22fe4c153ff5", "@type": "PISection", "graphScope": "brand", "section_title": "Moderate or Severe Hepatic Impairment", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "94bba718-8cea-42f5-97db-22fe4c153ff5", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Treatment with OFEV is not recommended [see Warnings and Precautions (5.1) and Use in Specific Populations (8.6)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:94bba718-8cea-42f5-97db-22fe4c153ff5"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:94bba718-8cea-42f5-97db-22fe4c153ff5"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:639d3847-3a89-4e25-9c7a-0e8315d88faf", "@type": "PISection", "graphScope": "brand", "section_title": "2.4  Dosage Modification due to Adverse Reactions", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "639d3847-3a89-4e25-9c7a-0e8315d88faf", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In addition to symptomatic treatment, if applicable, the management of adverse reactions of OFEV may require dose reduction or temporary interruption until the specific adverse reaction resolves to levels that allow continuation of therapy . OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If a patient does not tolerate 100 mg twice daily, discontinue treatment with OFEV [see Warnings and Precautions (5.2, 5.3, 5.5, 5.7) and Adverse Reactions (6.1)] .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:639d3847-3a89-4e25-9c7a-0e8315d88faf"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:639d3847-3a89-4e25-9c7a-0e8315d88faf"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1f6ae5cf-071d-4307-b8ef-d54550733eb3", "@type": "PISection", "graphScope": "brand", "section_title": "Elevated Liver Enzymes", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "1f6ae5cf-071d-4307-b8ef-d54550733eb3", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Dose modifications or interruptions may be necessary for liver enzyme elevations. Conduct liver function tests (aspartate aminotransferase (AST), alanine aminotransferase (ALT), and bilirubin) prior to initiation of treatment with OFEV, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Measure liver tests promptly in patients who report symptoms that may indicate liver injury, including fatigue, anorexia, right upper abdominal discomfort, dark urine or jaundice. Discontinue OFEV in patients with AST or ALT greater than 3 times the upper limit of normal (ULN) with signs or symptoms of liver injury and for AST or ALT elevations greater than 5 times the upper limit of normal. For AST or ALT greater than 3 times to less than 5 times the ULN without signs of liver damage, interrupt treatment or reduce OFEV to 100 mg twice daily. Once liver enzymes have returned to baseline values, treatment with OFEV may be reintroduced at a reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage (150 mg twice daily) [see Warnings and Precautions (5.2) and Adverse Reactions (6.1)].\n\nIn patients with mild hepatic impairment (Child Pugh A), consider treatment interruption, or discontinuation for management of adverse reactions.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:1f6ae5cf-071d-4307-b8ef-d54550733eb3"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1f6ae5cf-071d-4307-b8ef-d54550733eb3"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:59a24917-1b9f-4dff-b3c2-81cf1a87adc4", "@type": "PISection", "graphScope": "brand", "section_title": "3 DOSAGE FORMS AND STRENGTHS", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "59a24917-1b9f-4dff-b3c2-81cf1a87adc4", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:59a24917-1b9f-4dff-b3c2-81cf1a87adc4"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:c42ade1c-5700-46f5-a4b1-963307bea7cc", "@type": "PISection", "graphScope": "brand", "section_title": "Capsules:", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "c42ade1c-5700-46f5-a4b1-963307bea7cc", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- 150 mg, brown, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"150\".\n- 100 mg, peach, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"100\".", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:c42ade1c-5700-46f5-a4b1-963307bea7cc"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:25f3c693-b300-452a-bef5-a346cfae6fe7", "@type": "PISection", "graphScope": "brand", "section_title": "4 CONTRAINDICATIONS", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "25f3c693-b300-452a-bef5-a346cfae6fe7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "None", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:25f3c693-b300-452a-bef5-a346cfae6fe7"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:25f3c693-b300-452a-bef5-a346cfae6fe7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4cf80c9a-8ebf-408d-afcb-76526a61ae59", "@type": "PISection", "graphScope": "brand", "section_title": "5 WARNINGS AND PRECAUTIONS", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "4cf80c9a-8ebf-408d-afcb-76526a61ae59", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:4cf80c9a-8ebf-408d-afcb-76526a61ae59"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4cf80c9a-8ebf-408d-afcb-76526a61ae59"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:016180eb-524e-4868-8480-7c5079d8c5b2", "@type": "PISection", "graphScope": "brand", "section_title": "5.1  Hepatic Impairment", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "016180eb-524e-4868-8480-7c5079d8c5b2", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Treatment with OFEV is not recommended in patients with moderate (Child Pugh B) or severe (Child Pugh C) hepatic impairment [see Use in Specific Populations (8.6) and Clinical Pharmacology (12.3)] . Patients with mild hepatic impairment (Child Pugh A) can be treated with a reduced dose of OFEV [see Dosage and Administration (2.3)].", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:016180eb-524e-4868-8480-7c5079d8c5b2"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:32223790-0cd5-4fac-ab7e-c194cbd049a6", "@type": "PISection", "graphScope": "brand", "section_title": "8.7  Renal Impairment", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "32223790-0cd5-4fac-ab7e-c194cbd049a6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on a single-dose study, less than 1% of the total dose of nintedanib is excreted via the kidney [see Clinical Pharmacology (12.3)] . Adjustment of the starting dose in patients with mild to moderate renal impairment is not required. The safety, efficacy, and pharmacokinetics of nintedanib have not been studied in patients with severe renal impairment (less than 30 mL/min CrCl) and end-stage renal disease.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:32223790-0cd5-4fac-ab7e-c194cbd049a6"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:32223790-0cd5-4fac-ab7e-c194cbd049a6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:671f09a2-b137-458a-82ba-ce66ef90fe1f", "@type": "PISection", "graphScope": "brand", "section_title": "How should I take OFEV?", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "671f09a2-b137-458a-82ba-ce66ef90fe1f", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Take OFEV exactly as your doctor tells you to take it.\n- Your doctor will tell you how much OFEV to take and when to take it.\n- Take OFEV with food. Swallow the OFEV capsules whole with a liquid.\n- Do not chew, crush, or open OFEV capsules. If you or your caregiver accidently comes in contact with the content of the capsule, wash hands well right away.\n- If you miss a dose of OFEV, take your next dose at your regular time. Do not take the missed dose.\n- Do not take more than 300 mg of OFEV in 1 day.\n- If you take too much OFEV, call your doctor or go to the nearest hospital emergency room right away.\n- Your doctor should do certain blood tests before you start taking OFEV.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:671f09a2-b137-458a-82ba-ce66ef90fe1f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bfdd686a-7837-4063-a84a-da00940626a0", "@type": "PISection", "graphScope": "brand", "section_title": "5.2  Elevated Liver Enzymes and Drug-Induced Liver Injury", "page_number": 4, "source_document_type": "prescribing_information", "section_id": "bfdd686a-7837-4063-a84a-da00940626a0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Cases of drug-induced liver injury (DILI) have been observed with OFEV treatment. In the clinical trials and postmarketing period, non-serious and serious cases of DILI were reported.  Cases of severe liver injury with fatal outcome have been reported in the postmarketing period. The majority of hepatic events occur within the first three months of treatment. In clinical trials, administration of OFEV was associated with elevations of liver enzymes (ALT, AST, ALKP, GGT) and bilirubin. Liver enzyme and bilirubin increases were reversible with dose modification or interruption in the majority of cases. In IPF studies (Study 1, Study 2, and Study 3), the majority (94%) of patients with ALT and/or AST elevations had elevations less than 5 times ULN and the majority (95%) of patients with bilirubin elevations had elevations less than 2 times ULN. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), the majority (95%) of patients with ALT and/or AST elevations had elevations less than 5 times ULN and the majority (94%) of patients with bilirubin elevations had elevations less than 2 times ULN. In the SSc-ILD study (Study 4), a maximum ALT and/or AST greater than or equal to 3 times ULN was observed for 4.9% of patients in the OFEV group and for 0.7% of patients in the placebo group [see Use in Specific Populations (8.6) and Clinical Pharmacology (12.3)] . Patients with a low body weight (less than 65 kg), Asian, and female patients may have a higher risk of elevations in liver enzymes. Nintedanib exposure increased with patient age, which may also result in a higher risk of increased liver enzymes [see Clinical Pharmacology (12.3)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bfdd686a-7837-4063-a84a-da00940626a0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:00b10163-f35a-493a-b44f-1b88f9a2adab", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "00b10163-f35a-493a-b44f-1b88f9a2adab", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Conduct liver function tests (ALT, AST, and bilirubin) prior to initiation of treatment with OFEV, at regular intervals during the first three months of treatment, and periodically thereafter or as clinically indicated. Measure liver tests promptly in patients who report symptoms that may indicate liver injury, including fatigue, anorexia, right upper abdominal discomfort, dark urine or jaundice. Dosage modifications or interruption may be necessary for liver enzyme elevations [see Dosage and Administration (2.1, 2.4)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:00b10163-f35a-493a-b44f-1b88f9a2adab"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8dd00287-c6fb-452f-bc8f-89ed54f19ca3", "@type": "PISection", "graphScope": "brand", "section_title": "5.3  Gastrointestinal Disorders", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "8dd00287-c6fb-452f-bc8f-89ed54f19ca3", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8dd00287-c6fb-452f-bc8f-89ed54f19ca3"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8e50ecd9-a631-4459-ae17-a792631abd5c", "@type": "PISection", "graphScope": "brand", "section_title": "Risk Summary", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "8e50ecd9-a631-4459-ae17-a792631abd5c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "There is no information on the presence of nintedanib in human milk, the effects on the breast-fed infant or the effects on milk production. Nintedanib and/or its metabolites are present in the milk of lactating rats [see Data] . Because of the potential for serious adverse reactions in nursing infants from OFEV, advise women that breastfeeding is not recommended during treatment with OFEV.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:8e50ecd9-a631-4459-ae17-a792631abd5c"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8e50ecd9-a631-4459-ae17-a792631abd5c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:e3079d35-7ca8-4e4d-94e3-d84e77d501df", "@type": "PISection", "graphScope": "brand", "section_title": "8.1  Pregnancy", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "e3079d35-7ca8-4e4d-94e3-d84e77d501df", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:e3079d35-7ca8-4e4d-94e3-d84e77d501df"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4af45440-1a4c-40e7-89c6-c4fe9171b8f4", "@type": "PISection", "graphScope": "brand", "section_title": "Diarrhea", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "4af45440-1a4c-40e7-89c6-c4fe9171b8f4", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In clinical trials, diarrhea was the most frequent gastrointestinal event reported. In most patients, the event was of mild to moderate intensity and occurred within the first 3 months of treatment. In IPF studies (Study 1, Study 2, and Study 3), diarrhea was reported in 62% versus 18% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 11% of patients treated with OFEV compared to 0 placebo-treated patients. Diarrhea led to discontinuation of OFEV in 5% of the patients compared to less than 1% of placebo-treated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), diarrhea was reported in 67% versus 24% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 16% of patients treated with OFEV compared to less than 1% of placebo-treated patients. Diarrhea led to discontinuation of OFEV in 6% of the patients compared to less than 1% of placebo-treated patients. In the SScILD study (Study 4), diarrhea was reported in 76% versus 32% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)]. Diarrhea led to permanent dose reduction in 22% of patients treated with OFEV compared to 1% of placebo-treated patients. Diarrhea led to discontinuation of OFEV in 7% of the patients compared to 0.3% of placebo-treated patients.\n\nDosage modifications or treatment interruptions may be necessary in patients with adverse reactions of diarrhea. Treat diarrhea at first signs with adequate hydration and antidiarrheal medication (e.g., loperamide), and consider dose reduction or treatment interruption if diarrhea continues [see Dosage and Administration (2.4)]. OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If severe diarrhea persists despite symptomatic treatment, discontinue treatment with OFEV.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:4af45440-1a4c-40e7-89c6-c4fe9171b8f4"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4af45440-1a4c-40e7-89c6-c4fe9171b8f4"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4b94816f-7f4c-49e2-8d03-0f6130b243f8", "@type": "PISection", "graphScope": "brand", "section_title": "Pregnancy Testing", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "4b94816f-7f4c-49e2-8d03-0f6130b243f8", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Verify the pregnancy status of females of reproductive potential prior to treatment with OFEV and during treatment as appropriate [see Dosage and Administration (2.1), Warnings and Precautions (5.4), and Use in Specific Populations (8.1)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:4b94816f-7f4c-49e2-8d03-0f6130b243f8"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4b94816f-7f4c-49e2-8d03-0f6130b243f8"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:91983fed-49c3-48ad-bcce-8a2ee884137a", "@type": "PISection", "graphScope": "brand", "section_title": "Nausea and Vomiting", "page_number": 5, "source_document_type": "prescribing_information", "section_id": "91983fed-49c3-48ad-bcce-8a2ee884137a", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In IPF studies (Study 1, Study 2, and Study 3), nausea was reported in 24% versus 7% and vomiting was reported in 12% versus 3% of patients treated with OFEV and placebo, respectively. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), nausea was reported in 29% versus 9% and vomiting was reported in 18% versus 5% of patients treated with OFEV and placebo, respectively. In the SSc-ILD study (Study 4), nausea was reported in 32% versus 14% and vomiting was reported in 25% versus 10% of patients treated with OFEV and placebo, respectively [see Adverse Reactions (6.1)] . In most patients, these events were of mild to moderate intensity. In IPF studies (Study 1, Study 2, and Study 3), nausea led to discontinuation of OFEV in 2% of patients and vomiting led to discontinuation of OFEV in 1% of the patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), nausea led to discontinuation of OFEV in less than 1% of patients and vomiting led to discontinuation of OFEV in 1% of the patients. In the SSc-ILD study (Study 4), nausea led to discontinuation of OFEV in 2% of patients and vomiting led to discontinuation of OFEV in 1% of the patients.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:91983fed-49c3-48ad-bcce-8a2ee884137a"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:91983fed-49c3-48ad-bcce-8a2ee884137a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:a4673fef-9d6d-461c-8ebd-800465280c8c", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "a4673fef-9d6d-461c-8ebd-800465280c8c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "For nausea or vomiting that persists despite appropriate supportive care including anti-emetic therapy, dose reduction or treatment interruption may be required [see Dosage and Administration (2.4)] . OFEV treatment may be resumed at the full dosage (150 mg twice daily), or at the reduced dosage (100 mg twice daily), which subsequently may be increased to the full dosage. If severe nausea or vomiting does not resolve, discontinue treatment with OFEV.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a4673fef-9d6d-461c-8ebd-800465280c8c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:01c74061-80da-4bdc-86f6-f2e4039c7ae3", "@type": "PISection", "graphScope": "brand", "section_title": "5.4  Embryo-Fetal Toxicity", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "01c74061-80da-4bdc-86f6-f2e4039c7ae3", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action, OFEV can cause fetal harm when administered to a pregnant woman. Nintedanib caused embryo-fetal deaths and structural abnormalities in rats and rabbits when administered during organogenesis at less than (rats) and approximately 5 times (rabbits) the maximum recommended human dose (MRHD) in adults. Advise pregnant women of the potential risk to a fetus. Advise females of reproductive potential to avoid becoming pregnant while receiving treatment with OFEV and to use highly effective contraception at initiation of, during treatment, and at least 3 months after the last dose of OFEV. Nintedanib does not change the exposure to oral contraceptive containing ethinylestradiol and levonorgestrel in patients with SSc-ILD. However, the efficacy of oral hormonal contraceptives may be compromised by vomiting and/or diarrhea or other conditions where the drug absorption may be reduced. Advise women taking oral hormonal contraceptives experiencing these conditions to use alternative highly effective contraception. Verify pregnancy status prior to treatment with OFEV and during treatment as appropriate [see Use in Specific Populations (8.1, 8.3) and Clinical Pharmacology (12.1, 12.3)].", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:01c74061-80da-4bdc-86f6-f2e4039c7ae3"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4c207467-b50e-40a6-926f-4f56802e8340", "@type": "PISection", "graphScope": "brand", "section_title": "Combination with Pirfenidone", "page_number": 8, "source_document_type": "prescribing_information", "section_id": "4c207467-b50e-40a6-926f-4f56802e8340", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Concomitant treatment with nintedanib and pirfenidone was investigated in an exploratory open-label, randomized (1:1) trial of nintedanib 150 mg twice daily with add-on pirfenidone (titrated to 801 mg three times a day) compared to nintedanib 150 mg twice daily alone in 105 randomized patients for 12 weeks. The primary endpoint was the percentage of patients with gastrointestinal adverse events from baseline to Week 12. Gastrointestinal adverse events were in line with the established safety profile of each component and were experienced in 37 (70%) patients treated with pirfenidone added to nintedanib versus 27 (53%) patients treated with nintedanib alone.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:4c207467-b50e-40a6-926f-4f56802e8340"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4c207467-b50e-40a6-926f-4f56802e8340"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d155d159-cf19-4a92-99b6-baf15353036b", "@type": "PISection", "graphScope": "brand", "section_title": "OFEV may cause serious side effects, including:", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "d155d159-cf19-4a92-99b6-baf15353036b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- See 'What is the most important information I should know about OFEV?'\n- liver problems. Call your doctor right away if you have unexplained symptoms such as yellowing of your skin or the white part of your eyes (jaundice), dark or brown (tea colored) urine, pain on the upper right side of your stomach area (abdomen), bleeding or bruising more easily than normal, feeling tired, or loss of appetite. Your doctor will do blood tests to check how well your liver is working before starting and during your treatment with OFEV.\n- diarrhea, nausea, and vomiting. While you are taking OFEV, your doctor may recommend that you drink fluids or take medicine to treat these side effects. Tell your doctor if you have diarrhea, nausea, or vomiting or if these", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d155d159-cf19-4a92-99b6-baf15353036b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9fc9f49b-5b15-45e5-8cf4-4690e6661db0", "@type": "PISection", "graphScope": "brand", "section_title": "5.5  Arterial Thromboembolic Events", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "9fc9f49b-5b15-45e5-8cf4-4690e6661db0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Arterial thromboembolic events have been reported in patients taking OFEV. In IPF studies (Study 1, Study 2, and Study 3), arterial thromboembolic events were reported in 2.5% of patients treated with OFEV and less than 1% of placebo-treated patients. Myocardial infarction was the most common adverse reaction under arterial thromboembolic events, occurring in 1.5% of OFEV-treated patients compared to less than 1% of placebotreated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), arterial thromboembolic events were reported in less than 1% of patients in both treatment arms. Myocardial infarction was observed in less than 1% of patients in both treatment arms. In the SSc-ILD study (Study 4), arterial thromboembolic events were reported in 0.7% of patients in both treatment arms. There were 0 cases of myocardial infarction in OFEV-treated patients compared to 0.7% of placebo-treated patients.\n\nUse caution when treating patients at higher cardiovascular risk including known coronary artery disease. Consider treatment interruption in patients who develop signs or symptoms of acute myocardial ischemia.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:9fc9f49b-5b15-45e5-8cf4-4690e6661db0"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9fc9f49b-5b15-45e5-8cf4-4690e6661db0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:aa3ff00e-17ac-40bb-b6d4-6e110df50bff", "@type": "PISection", "graphScope": "brand", "section_title": "10 OVERDOSAGE", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "aa3ff00e-17ac-40bb-b6d4-6e110df50bff", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In IPF trials, one patient was inadvertently exposed to a dose of 600 mg daily for a total of 21 days. A nonserious adverse event (nasopharyngitis) occurred and resolved during the period of incorrect dosing, with no onset of other reported events. Overdosage was also reported in two patients in oncology studies who were exposed to a maximum of 600 mg twice daily for up to 8 days. Adverse events reported were consistent with the existing safety profile of OFEV. Both patients recovered. In case of overdosage, interrupt treatment and initiate general supportive measures as appropriate.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:aa3ff00e-17ac-40bb-b6d4-6e110df50bff"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:aa3ff00e-17ac-40bb-b6d4-6e110df50bff"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:f94298fb-422a-4154-b6cd-b1226caaa6eb", "@type": "PISection", "graphScope": "brand", "section_title": "5.6  Risk of Bleeding", "page_number": 6, "source_document_type": "prescribing_information", "section_id": "f94298fb-422a-4154-b6cd-b1226caaa6eb", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on the mechanism of action (VEGFR inhibition), OFEV may increase the risk of bleeding. In IPF studies (Study 1, Study 2, and Study 3), bleeding events were reported in 10% of patients treated with OFEV and in 7% of patients treated with placebo. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), bleeding events were reported in 11% of patients treated with OFEV and in 13% of patients treated with placebo. In the SSc-ILD study (Study 4), bleeding events were reported in 11% of patients treated with OFEV and in 8% of patients treated with placebo. In clinical trials, epistaxis was the most frequent bleeding event reported.\n\nIn the postmarketing period non-serious and serious bleeding events, some of which were fatal, have been observed.\n\nUse OFEV in patients with known risk of bleeding only if the anticipated benefit outweighs the potential risk.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:f94298fb-422a-4154-b6cd-b1226caaa6eb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bdf0ed24-ea6a-4893-86f5-600f95b23748", "@type": "PISection", "graphScope": "brand", "section_title": "How should I store OFEV?", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "bdf0ed24-ea6a-4893-86f5-600f95b23748", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- Store OFEV at room temperature between 68°F to 77°F (20°C to 25°C).\n- Keep OFEV dry and protect from high heat.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bdf0ed24-ea6a-4893-86f5-600f95b23748"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:e132de83-5540-40ac-8205-fbf673f5350b", "@type": "PISection", "graphScope": "brand", "section_title": "7.3  Pirfenidone", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "e132de83-5540-40ac-8205-fbf673f5350b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In a multiple-dose study conducted to assess the pharmacokinetic effects of concomitant treatment with nintedanib and pirfenidone, the coadministration of nintedanib with pirfenidone did not alter the exposure of either agent [see Clinical Pharmacology (12.3)] . Therefore, no dose adjustment is necessary during concomitant administration of nintedanib with pirfenidone.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:e132de83-5540-40ac-8205-fbf673f5350b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:460d3160-c99a-49cc-bbe0-1f26dcfbee8c", "@type": "PISection", "graphScope": "brand", "section_title": "Infertility", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "460d3160-c99a-49cc-bbe0-1f26dcfbee8c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on animal data, OFEV may reduce fertility in females of reproductive potential [see Nonclinical Toxicology (13.1)].", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:460d3160-c99a-49cc-bbe0-1f26dcfbee8c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:72235e47-f19c-4d6d-9129-d75e2319f70d", "@type": "PISection", "graphScope": "brand", "section_title": "5.7  Gastrointestinal Perforation", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "72235e47-f19c-4d6d-9129-d75e2319f70d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on the mechanism of action, OFEV may increase the risk of gastrointestinal perforation. In IPF studies (Study 1, Study 2, and Study 3), gastrointestinal perforation was reported in less than 1% of patients treated with OFEV, compared to 0 cases in the placebo-treated patients. In the chronic fibrosing ILDs with a progressive phenotype study (Study 5), gastrointestinal perforation was not reported in any patients in any treatment arm. In the SSc-ILD study (Study 4), no cases of gastrointestinal perforation were reported in patients treated with OFEV or in placebo-treated patients.\n\nIn the postmarketing period, cases of gastrointestinal perforations have been reported, some of which were fatal.\n\nUse caution when treating patients who have had recent abdominal surgery, previous history of diverticular disease or receiving concomitant corticosteroids or NSAIDs. Discontinue therapy with OFEV in patients who develop gastrointestinal perforation. Only use OFEV in patients with known risk of gastrointestinal perforation if the anticipated benefit outweighs the potential risk.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:72235e47-f19c-4d6d-9129-d75e2319f70d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1", "@type": "PISection", "graphScope": "brand", "section_title": "8.5  Geriatric Use", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Of the total number of subjects in phase 2 and 3 clinical studies of OFEV in IPF (Study 1, Study 2, and Study 3), 61% were 65 and over, while 16% were 75 and over. In the chronic fibrosing ILDs with a progressive phenotype clinical study (Study 5), 61% were 65 and over, while 19% were 75 and older. In SSc-ILD (Study 4), 21.4% were 65 and over, while 1.9% were 75 and older. In phase 3 studies, no overall differences in effectiveness were observed between subjects who were 65 and over and younger subjects; no overall differences in safety were observed between subjects who were 65 and over or 75 and over and younger subjects, but greater sensitivity of some older individuals cannot be ruled out .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8666fba5-65f6-4cd8-9c4c-33bbc1a99ca1"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4fb91b95-1d96-4b6a-9bdc-5f1d3a93916a", "@type": "PISection", "graphScope": "brand", "section_title": "5.8  Nephrotic Range Proteinuria", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "4fb91b95-1d96-4b6a-9bdc-5f1d3a93916a", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Cases of proteinuria within the nephrotic range have been reported in the postmarketing period. Histological findings, when available, were consistent with glomerular microangiopathy with or without renal thrombi. Improvement in proteinuria has been observed after OFEV was discontinued; however, in some cases, residual proteinuria persisted. Consider treatment interruption in patients who develop new or worsening proteinuria.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4fb91b95-1d96-4b6a-9bdc-5f1d3a93916a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa", "@type": "PISection", "graphScope": "brand", "section_title": "6 ADVERSE REACTIONS", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The following clinically significant adverse reactions are discussed in greater detail in other sections of the labeling:\n\n- Elevated Liver Enzymes and Drug-Induced Liver Injury [see Warnings and Precautions (5.2)]\n- Gastrointestinal Disorders [see Warnings and Precautions (5.3)]\n- Embryo-Fetal Toxicity [see Warnings and Precautions (5.4)]\n- Arterial Thromboembolic Events [see Warnings and Precautions (5.5)]\n- Risk of Bleeding [see Warnings and Precautions (5.6)]\n- Gastrointestinal Perforation [see Warnings and Precautions (5.7)]\n- Nephrotic Range Proteinuria [see Warnings and Precautions (5.8)]", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6f4bb7ee-c5b8-46ff-9c7c-be4f0664c6fa"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d2d3fed3-3838-425a-af8a-118326fe3ab8", "@type": "PISection", "graphScope": "brand", "section_title": "6.1  Clinical Trials Experience", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "d2d3fed3-3838-425a-af8a-118326fe3ab8", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Because clinical trials are conducted under widely varying conditions, adverse reaction rates observed in the clinical trials of a drug cannot be directly compared to rates in the clinical trials of another drug and may not reflect the rates observed in practice.\n\nThe safety of OFEV was evaluated in over 1000 IPF patients, 332 patients with chronic fibrosing ILDs with a progressive phenotype, and over 280 patients with SSc-ILD. Over 200 IPF patients were exposed to OFEV for more than 2 years in clinical trials.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:d2d3fed3-3838-425a-af8a-118326fe3ab8"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d2d3fed3-3838-425a-af8a-118326fe3ab8"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:f1ef3602-7e66-4635-b2fc-6a43095c9533", "@type": "PISection", "graphScope": "brand", "section_title": "Data", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "f1ef3602-7e66-4635-b2fc-6a43095c9533", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:f1ef3602-7e66-4635-b2fc-6a43095c9533"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:c5f8a9ed-34b8-4e65-a395-2e5e5dc88dc6", "@type": "PISection", "graphScope": "brand", "section_title": "Idiopathic Pulmonary Fibrosis", "page_number": 7, "source_document_type": "prescribing_information", "section_id": "c5f8a9ed-34b8-4e65-a395-2e5e5dc88dc6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in three randomized, double-blind, placebo-controlled, 52-week trials. In the phase 2 (Study 1) and phase 3 (Study 2 and Study 3) trials, 723 patients with IPF received OFEV 150 mg twice daily and 508 patients received placebo. The median duration of exposure was 10 months for patients treated with OFEV and 11 months for patients treated with placebo. Subjects ranged in age from 42 to 89 years (median age of 67 years). Most patients were male (79%) and Caucasian (60%).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:c5f8a9ed-34b8-4e65-a395-2e5e5dc88dc6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:0d2d6de1-abb2-4f86-a497-077227ab29d4", "@type": "PISection", "graphScope": "brand", "section_title": "What are the possible side effects of OFEV?", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "0d2d6de1-abb2-4f86-a497-077227ab29d4", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:0d2d6de1-abb2-4f86-a497-077227ab29d4"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bc63ed41-9b9f-493b-bd37-0c045a467f39", "@type": "PISection", "graphScope": "brand", "section_title": "Animal Data", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "bc63ed41-9b9f-493b-bd37-0c045a467f39", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In animal reproduction toxicity studies, nintedanib caused embryo-fetal deaths and structural abnormalities in rats and rabbits at less than and approximately 5 times the maximum recommended human dose (MRHD) in adults (on a plasma AUC basis at maternal oral doses of 2.5 and 15 mg/kg/day in rats and rabbits, respectively). Malformations included abnormalities in the vasculature, urogenital, and skeletal systems. Vasculature anomalies included missing or additional major blood vessels. Skeletal anomalies included abnormalities in the thoracic, lumbar, and caudal vertebrae (e.g., hemivertebra, missing, or asymmetrically ossified), ribs (bifid or fused), and sternebrae (fused, split, or unilaterally ossified). In some fetuses, organs in the urogenital system were missing. In rabbits, a significant change in sex ratio was observed in fetuses (female:male ratio of approximately 71%:29%) at approximately 15 times the MRHD in adults (on an AUC basis at a maternal oral dose of 60 mg/kg/day). Nintedanib decreased post-natal viability of rat pups during the first 4 post-natal days when dams were exposed to less than the MRHD (on an AUC basis at a maternal oral dose of 10 mg/kg/day).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bc63ed41-9b9f-493b-bd37-0c045a467f39"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ac3e7b53-7690-46bf-9423-402e000c9740", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 8, "source_document_type": "prescribing_information", "section_id": "ac3e7b53-7690-46bf-9423-402e000c9740", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The most frequent serious adverse reactions reported in patients treated with OFEV, more than placebo, were bronchitis (1.2% vs. 0.8%) and myocardial infarction (1.5% vs. 0.4%). The most common adverse events leading to death in patients treated with OFEV, more than placebo, were pneumonia (0.7% vs. 0.6%), lung neoplasm malignant (0.3% vs. 0%), and myocardial infarction (0.3% vs. 0.2%). In the predefined category of major adverse cardiovascular events (MACE) including MI, fatal events were reported in 0.6% of OFEVtreated patients and 1.8% of placebo-treated patients.\n\nAdverse reactions leading to permanent dose reductions were reported in 16% of OFEV-treated patients and 1% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (11%).\n\nAdverse reactions leading to discontinuation were reported in 21% of OFEV-treated patients and 15% of placebo-treated patients. The most frequent adverse reactions that led to discontinuation in OFEV-treated patients were diarrhea (5%), nausea (2%), and decreased appetite (2%).\n\nThe most common adverse reactions with an incidence of greater than or equal to 5% and more frequent in the OFEV than placebo treatment group are listed in Table 1.\n\nTable 1 Adverse Reactions Occurring in ≥5% of OFEV-treated Patients with Idiopathic Pulmonary Fibrosis and More Commonly Than Placebo in Study 1, Study 2, and Study 3\n\n| Adverse Reaction                   | OFEV, 150 mg n=723   | Placebo n=508   |\n|------------------------------------|----------------------|-----------------|\n| Gastrointestinal disorders         |                      |                 |\n| Diarrhea                           | 62%                  | 18%             |\n| Nausea                             | 24%                  | 7%              |\n| Abdominal pain a                   | 15%                  | 6%              |\n| Vomiting                           | 12%                  | 3%              |\n| Hepatobiliary disorders            |                      |                 |\n| Liver enzyme elevation b           | 14%                  | 3%              |\n| Metabolism and nutrition disorders |                      |                 |\n| Decreased appetite                 | 11%                  | 5%              |\n| Nervous system disorders           |                      |                 |\n| Headache                           | 8%                   | 5%              |\n| Investigations                     |                      |                 |\n| Weight decreased                   | 10%                  | 3%              |\n| Vascular disorders                 |                      |                 |\n| Hypertension c                     | 5%                   | 4%              |\n\nIn addition, hypothyroidism was reported in patients treated with OFEV, more than placebo (1.1% vs. 0.6%). Alopecia was also reported in more patients treated with OFEV than placebo (0.8% vs. 0.4%).", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:ac3e7b53-7690-46bf-9423-402e000c9740"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ac3e7b53-7690-46bf-9423-402e000c9740"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:98341d95-f8bf-4830-9e39-aac374043a01", "@type": "PISection", "graphScope": "brand", "section_title": "7.4  Bosentan", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "98341d95-f8bf-4830-9e39-aac374043a01", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Coadministration of nintedanib with bosentan did not alter the pharmacokinetics of nintedanib [see Clinical Pharmacology (12.3)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:98341d95-f8bf-4830-9e39-aac374043a01"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:a3adf5e4-0f19-4de8-9688-733bf0aa67e8", "@type": "PISection", "graphScope": "brand", "section_title": "8 USE IN SPECIFIC POPULATIONS", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "a3adf5e4-0f19-4de8-9688-733bf0aa67e8", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a3adf5e4-0f19-4de8-9688-733bf0aa67e8"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:037c54d6-db02-4eac-8922-c3877467ae3b", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "037c54d6-db02-4eac-8922-c3877467ae3b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Diarrhea, nausea, vomiting, and abdominal pain (includes upper abdominal pain, abdominal discomfort, and abdominal pain) were the most frequent adverse events reported in 20 (38%) versus 16 (31%), in 22 (42%) versus 6 (12%), in 15 (28%) versus 6 (12%), and in 15 (28%) versus 7 (14%) patients treated with pirfenidone added to nintedanib versus nintedanib alone, respectively. More subjects reported AST or ALT elevations (greater than or equal to 3x the upper limit of normal) when using pirfenidone in combination with nintedanib (n=3 (6%)) compared to nintedanib alone (n=0) [see Warnings and Precautions (5.2, 5.3)] .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:037c54d6-db02-4eac-8922-c3877467ae3b"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:037c54d6-db02-4eac-8922-c3877467ae3b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:16b697b1-2d28-41a6-9698-b87c9099fcec", "@type": "PISection", "graphScope": "brand", "section_title": "7.2  Anticoagulants", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "16b697b1-2d28-41a6-9698-b87c9099fcec", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a VEGFR inhibitor and may increase the risk of bleeding. Monitor patients on full anticoagulation therapy closely for bleeding and adjust anticoagulation treatment as necessary [see Warnings and Precautions (5.6)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:16b697b1-2d28-41a6-9698-b87c9099fcec"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:16b697b1-2d28-41a6-9698-b87c9099fcec"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:35f0964c-aec3-4015-a415-2ef2c4af0d21", "@type": "PISection", "graphScope": "brand", "section_title": "7 DRUG INTERACTIONS", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "35f0964c-aec3-4015-a415-2ef2c4af0d21", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:35f0964c-aec3-4015-a415-2ef2c4af0d21"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8210acc5-e3a6-43f3-9aee-9ddffde6eadc", "@type": "PISection", "graphScope": "brand", "section_title": "Contraception", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "8210acc5-e3a6-43f3-9aee-9ddffde6eadc", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV can cause fetal harm when administered to a pregnant woman. Advise females of reproductive potential to avoid becoming pregnant while receiving treatment with OFEV. Advise females of reproductive potential to use highly effective contraception at initiation of, during treatment, and for at least 3 months after taking the last dose of OFEV. Nintedanib does not change the exposure to oral contraceptive containing ethinylestradiol and levonorgestrel in patients with SSc-ILD. However, the efficacy of oral hormonal contraceptives may be compromised by vomiting and/or diarrhea or other conditions where the drug absorption may be reduced. Advise women taking oral hormonal contraceptives experiencing these conditions to use alternative highly effective contraception.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8210acc5-e3a6-43f3-9aee-9ddffde6eadc"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:7101abae-5410-4da3-8b6c-9f717303089c", "@type": "PISection", "graphScope": "brand", "section_title": "Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "7101abae-5410-4da3-8b6c-9f717303089c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in a phase 3, double-blind, placebo-controlled trial (Study 5) in which 663 patients with chronic fibrosing ILDs with a progressive phenotype were randomized to receive OFEV 150 mg twice daily (n=332) or placebo (n=331) for at least 52 weeks. At 52 weeks, the median duration of exposure was 12 months for patients in both treatment arms. Subjects ranged in age from 27 to 87 years (median age of 67 years). The majority of patients were Caucasian (74%) or Asian (25%). Most patients were male (54%).\n\nThe most frequent serious adverse event reported in patients treated with OFEV, more than placebo, was pneumonia (4% vs. 3%). Adverse events leading to death were reported in 3% of patients treated with OFEV and in 5% of patients treated with placebo. No pattern was identified in the adverse events leading to death.\n\nAdverse reactions leading to permanent dose reductions were reported in 33% of OFEV-treated patients and 4% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (16%).\n\nAdverse reactions leading to discontinuation were reported in 20% of OFEV-treated patients and 10% of placebo-treated patients. The most frequent adverse reaction that led to discontinuation in OFEV-treated patients was diarrhea (6%).\n\nThe safety profile in patients with chronic fibrosing ILDs with a progressive phenotype treated with OFEV was consistent with that observed in IPF patients. In addition, the following adverse events were reported in OFEV more than placebo in chronic progressive fibrosing ILD: nasopharyngitis (13% vs. 12%), upper respiratory tract infection (7% vs 6%), urinary tract infection (6% vs. 4%), fatigue (10% vs. 6%), and back pain (6% vs. 5%).", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:7101abae-5410-4da3-8b6c-9f717303089c"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7101abae-5410-4da3-8b6c-9f717303089c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:64890b31-6f1d-43c7-a51c-97a181e5d589", "@type": "PISection", "graphScope": "brand", "section_title": "8.3  Females and Males of Reproductive Potential", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "64890b31-6f1d-43c7-a51c-97a181e5d589", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action, OFEV can cause fetal harm when administered to a pregnant woman and may reduce fertility in females of reproductive potential [see Use in Specific Populations (8.1), Clinical Pharmacology (12.1, 12.3), and Nonclinical Toxicology (13.1)] . Counsel patients on pregnancy prevention and planning.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:64890b31-6f1d-43c7-a51c-97a181e5d589"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:5663f967-b9e9-4c57-983c-9b971a6b4fbd", "@type": "PISection", "graphScope": "brand", "section_title": "7.1  P-glycoprotein (P-gp) and CYP3A4 Inhibitors and Inducers", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "5663f967-b9e9-4c57-983c-9b971a6b4fbd", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a substrate of P-gp and, to a minor extent, CYP3A4 [see Clinical Pharmacology (12.3)] . Coadministration with oral doses of a P-gp and CYP3A4 inhibitor, ketoconazole, increased exposure to nintedanib by 60%. Concomitant use of P-gp and CYP3A4 inhibitors (e.g., erythromycin) with OFEV may increase exposure to nintedanib [see Clinical Pharmacology (12.3)] . In such cases, patients should be monitored closely for tolerability of OFEV. Management of adverse reactions may require interruption, dose reduction, or discontinuation of therapy with OFEV [see Dosage and Administration (2.4)] .\n\nCoadministration with oral doses of a P-gp and CYP3A4 inducer, rifampicin, decreased exposure to nintedanib by 50%. Concomitant use of P-gp and CYP3A4 inducers (e.g., carbamazepine, phenytoin, and St. John's wort) with OFEV should be avoided as these drugs may decrease exposure to nintedanib [see Clinical Pharmacology (12.3)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:5663f967-b9e9-4c57-983c-9b971a6b4fbd"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:5663f967-b9e9-4c57-983c-9b971a6b4fbd"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4370dcc0-a8ac-48d0-80b6-5a5e4a7b4cf1", "@type": "PISection", "graphScope": "brand", "section_title": "8.2  Lactation", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "4370dcc0-a8ac-48d0-80b6-5a5e4a7b4cf1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4370dcc0-a8ac-48d0-80b6-5a5e4a7b4cf1"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:0e541a3b-e900-4408-b66d-615f89d1249a", "@type": "PISection", "graphScope": "brand", "section_title": "Systemic Sclerosis-Associated Interstitial Lung Disease", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "0e541a3b-e900-4408-b66d-615f89d1249a", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV was studied in a phase 3, randomized, double-blind, placebo-controlled trial (Study 4) in which 576 patients with SSc-ILD received OFEV 150 mg twice daily (n=288) or placebo (n=288).  Patients were to receive treatment for at least 52 weeks; individual patients were treated for up to 100 weeks. The median duration of exposure was 15 months for patients treated with OFEV and 16 months for patients treated with placebo. Subjects ranged in age from 20 to 79 years (median age of 55 years). Most patients were female (75%). Patients were mostly Caucasian (67%), Asian (25%), or Black (6%). At baseline, 49% of patients were on stable therapy with mycophenolate.\n\nThe most frequent serious adverse events reported in patients treated with OFEV, more than placebo, were interstitial lung disease (2.4% nintedanib vs. 1.7% placebo) and pneumonia (2.8% nintedanib vs. 0.3% placebo). Within 52 weeks, 5 patients treated with OFEV (1.7%) and 4 patients treated with placebo (1.4%) died. There was no pattern among adverse events leading to death in either treatment arm.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:0e541a3b-e900-4408-b66d-615f89d1249a"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:0e541a3b-e900-4408-b66d-615f89d1249a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bb4bf01d-0141-4b83-8161-67022dd9966b", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 10, "source_document_type": "prescribing_information", "section_id": "bb4bf01d-0141-4b83-8161-67022dd9966b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Adverse reactions leading to permanent dose reductions were reported in 34% of OFEV-treated patients and 4% of placebo-treated patients. The most frequent adverse reaction that led to permanent dose reduction in the patients treated with OFEV was diarrhea (22%).\n\nAdverse reactions leading to discontinuation were reported in 16% of OFEV-treated patients and 9% of placebo-treated patients. The most frequent adverse reactions that led to discontinuation in OFEV-treated patients were diarrhea (7%), nausea (2%), vomiting (1%), abdominal pain (1%), and interstitial lung disease (1%).\n\nThe safety profile in patients treated with OFEV with or without mycophenolate at baseline was comparable.\n\nThe most common adverse reactions with an incidence of greater than or equal to 5% in OFEV-treated patients and more commonly than in placebo are listed in Table 2.\n\nTable 2 Adverse Reactions Occurring in ≥5% of OFEV-treated Patients with Systemic SclerosisAssociated Interstitial Lung Disease and More Commonly Than Placebo in Study 4\n\n| Adverse Reaction         | OFEV, 150 mg n=288   | Placebo n=288   |\n|--------------------------|----------------------|-----------------|\n| Diarrhea                 | 76%                  | 32%             |\n| Nausea                   | 32%                  | 14%             |\n| Vomiting                 | 25%                  | 10%             |\n| Skin ulcer               | 18%                  | 17%             |\n| Abdominal pain a         | 18%                  | 11%             |\n| Liver enzyme elevation b | 13%                  | 3%              |\n| Weight decreased         | 12%                  | 4%              |\n| Fatigue                  | 11%                  | 7%              |\n| Decreased appetite       | 9%                   | 4%              |\n| Headache                 | 9%                   | 8%              |\n| Pyrexia                  | 6%                   | 5%              |\n| Back pain                | 6%                   | 4%              |\n| Dizziness                | 6%                   | 4%              |\n| Hypertension c           | 5%                   | 2%              |\n\nIn addition, alopecia was reported in patients treated with OFEV, more than placebo (1.4% vs. 1.0%).", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:bb4bf01d-0141-4b83-8161-67022dd9966b"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bb4bf01d-0141-4b83-8161-67022dd9966b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:681f4c2c-8132-4a89-b73f-4ee7735ddb85", "@type": "PISection", "graphScope": "brand", "section_title": "General information about the safe and effective use of OFEV.", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "681f4c2c-8132-4a89-b73f-4ee7735ddb85", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Medicines are sometimes prescribed for purposes other than those listed in a Patient Information leaflet. Do not use OFEV for a condition for which it was not prescribed. Do not give OFEV to other people, even if they have the same symptoms you have. It may harm them. This Patient Information leaflet summarizes the most important information about OFEV. If you would like more information, talk to your doctor. You can ask your pharmacist or doctor for information about OFEV that is written for health professionals.\n\nFor more information about OFEV, including the current prescribing information, and patient support, go to www.ofev.com/support or call Boehringer Ingelheim Pharmaceuticals, Inc. at 1-800-542-6257, or scan the code to go to www.ofev.com/support .\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:681f4c2c-8132-4a89-b73f-4ee7735ddb85"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6b53371e-93c7-457b-a9cc-9b26c3e89c85", "@type": "PISection", "graphScope": "brand", "section_title": "Animal Toxicity Data", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "6b53371e-93c7-457b-a9cc-9b26c3e89c85", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In repeat-dose toxicology studies, young animals (mice, rats, and monkeys) dosed with nintedanib showed changes in the bone and fast-growing teeth. Bone changes include thickening of the growth plate in all species. These changes were fully or at least partially reversible in rats and monkeys; reversibility in mice has not been studied.\n\nTooth changes include broken incisors and discoloration in rodents. These changes were irreversible after discontinuation of nintedanib treatment .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6b53371e-93c7-457b-a9cc-9b26c3e89c85"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:5476add7-f4f8-4a10-b4b4-82947a98ff3d", "@type": "PISection", "graphScope": "brand", "section_title": "Risk Summary", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "5476add7-f4f8-4a10-b4b4-82947a98ff3d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Based on findings from animal studies and its mechanism of action [see Clinical Pharmacology (12.1)] , OFEV can cause fetal harm when administered to a pregnant woman. There are no data on the use of OFEV during pregnancy. In animal studies of pregnant rats and rabbits treated during organogenesis, nintedanib caused embryo-fetal deaths and structural abnormalities at less than (rats) and approximately 5 times (rabbits) the maximum recommended human dose [see Data] . Advise pregnant women of the potential risk to a fetus.\n\nThe estimated background risk of major birth defects and miscarriage for the indicated population is unknown. In the U.S. general population, the estimated background risk of major birth defects is 2% to 4% and miscarriage in clinically recognized pregnancies is 15% to 20%.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:5476add7-f4f8-4a10-b4b4-82947a98ff3d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:fa78888a-5761-48e5-81ac-b441136c8675", "@type": "PISection", "graphScope": "brand", "section_title": "Keep OFEV and all medicines out of the reach of children.", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "fa78888a-5761-48e5-81ac-b441136c8675", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:fa78888a-5761-48e5-81ac-b441136c8675"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:efed4a8e-9045-4c78-9f95-22ceceb7340c", "@type": "PISection", "graphScope": "brand", "section_title": "Data", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "efed4a8e-9045-4c78-9f95-22ceceb7340c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Milk and plasma of lactating rats have similar concentrations of nintedanib and its metabolites.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:efed4a8e-9045-4c78-9f95-22ceceb7340c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:15c18c86-6a73-4fa7-96c1-6f4699a8aca0", "@type": "PISection", "graphScope": "brand", "section_title": "6.2 Postmarketing Experience", "page_number": 10, "source_document_type": "prescribing_information", "section_id": "15c18c86-6a73-4fa7-96c1-6f4699a8aca0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The following adverse reactions have been identified during postapproval use of OFEV. Because these reactions are reported voluntarily from a population of uncertain size, it is not always possible to reliably estimate their frequency or establish a causal relationship to drug exposure. The following adverse reactions have been identified during postapproval use of OFEV: drug-induced liver injury [see Warnings and Precautions (5.2)] , non-serious and serious bleeding events, some of which were fatal [see Warnings and Precautions (5.6)], proteinuria [see Warnings and Precautions (5.8)] , pancreatitis, thrombocytopenia, rash, pruritus.", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:15c18c86-6a73-4fa7-96c1-6f4699a8aca0"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:15c18c86-6a73-4fa7-96c1-6f4699a8aca0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:58ccad26-88df-41ad-8591-e84156c7b202", "@type": "PISection", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "page_number": 18, "source_document_type": "prescribing_information", "section_id": "58ccad26-88df-41ad-8591-e84156c7b202", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A statistically significant reduction in the annual rate of decline of FVC (in mL) was demonstrated in patients receiving OFEV compared to patients receiving placebo based on the random coefficient regression model, adjusted for gender, height, and age. The treatment effect on FVC was consistent in all 3 studies. See Table 3 for individual study results.\n\nTable 3 Annual Rate of Decline in FVC (mL) in Study 1, Study 2, and Study 3 a\n\n|                                    | Study 1                 | Study 1   | Study 2                 | Study 2   | Study 3                 | Study 3   |\n|------------------------------------|-------------------------|-----------|-------------------------|-----------|-------------------------|-----------|\n|                                    | OFEV 150 mg twice daily | Placebo   | OFEV 150 mg twice daily | Placebo   | OFEV 150 mg twice daily | Placebo   |\n| Number of analyzed patients        | 84                      | 83        | 309                     | 204       | 329                     | 219       |\n| Rate a of decline over 52 weeks    | -60                     | -191      | -115                    | -240      | -114                    | -207      |\n| Comparison vs placebo Difference b | 131                     | 131       | 125                     | 125       | 94                      | 94        |\n| 95% CI                             | (27, 235)               | (27, 235) | (78, 173)               | (78, 173) | (45, 143)               | (45, 143) |\n\nFigure 1 displays the change from baseline over time in both treatment groups for Study 2. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52. Similar plots were seen for Study 1 and Study 3.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:58ccad26-88df-41ad-8591-e84156c7b202"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:be0dae61-300a-44a1-b7e9-54e1195173eb", "@type": "PISection", "graphScope": "brand", "section_title": "11 DESCRIPTION", "page_number": 13, "source_document_type": "prescribing_information", "section_id": "be0dae61-300a-44a1-b7e9-54e1195173eb", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "OFEV capsules contain nintedanib, a kinase inhibitor [see Mechanism of Action (12.1)]. Nintedanib is presented as the ethanesulfonate salt (esylate), with the chemical name 1 H -Indole-6-carboxylic acid, 2,3- dihydro-3-[[[4-[methyl[(4-methyl-1-piperazinyl)acetyl]amino]phenyl]amino]phenylmethylene]-2-oxo-,methyl ester, (3 Z )-, ethanesulfonate (1:1).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:be0dae61-300a-44a1-b7e9-54e1195173eb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:2f4aa101-da41-4ebc-af80-9fc0275c10e7", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "2f4aa101-da41-4ebc-af80-9fc0275c10e7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Its structural formula is:\n\n<!-- image -->\n\nNintedanib esylate is a bright yellow powder with an empirical formula of C31H33N5O4·C2H6O3S and a molecular weight of 649.76 g/mol.\n\nOFEV capsules for oral administration are available in 2 dose strengths containing 100 mg or 150 mg of nintedanib (equivalent to 120.40 mg or 180.60 mg nintedanib ethanesulfonate, respectively). The inactive ingredients of OFEV are the following: Fill Material: triglycerides, hard fat, lecithin. Capsule Shell: gelatin, glycerol, titanium dioxide, red ferric oxide, yellow ferric oxide, black ink.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:2f4aa101-da41-4ebc-af80-9fc0275c10e7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:60c981ab-d129-4d5f-9560-a20407d2f0a4", "@type": "PISection", "graphScope": "brand", "section_title": "12 CLINICAL PHARMACOLOGY", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "60c981ab-d129-4d5f-9560-a20407d2f0a4", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:60c981ab-d129-4d5f-9560-a20407d2f0a4"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bbd92294-efcb-4239-93fa-71a64b748863", "@type": "PISection", "graphScope": "brand", "section_title": "12.1  Mechanism of Action", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "bbd92294-efcb-4239-93fa-71a64b748863", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a small molecule that inhibits multiple receptor tyrosine kinases (RTKs) and non-receptor tyrosine kinases (nRTKs). Nintedanib inhibits the following RTKs: platelet-derived growth factor receptor (PDGFR) α and β, fibroblast growth factor receptor (FGFR) 1-3, vascular endothelial growth factor receptor (VEGFR) 1-3, colony stimulating factor 1 receptor (CSF1R), and Fms-like tyrosine kinase-3 (FLT-3). These kinases except for FLT-3 have been implicated in pathogenesis of interstitial lung diseases (ILD). Nintedanib binds competitively to the adenosine triphosphate (ATP) binding pocket of these kinases and blocks the intracellular signaling cascades, which have been demonstrated to be involved in the pathogenesis of fibrotic tissue remodeling in ILD. Nintedanib also inhibits the following nRTKs: Lck, Lyn and Src kinases.  The contribution of FLT-3 and nRTK inhibition to nintedanib efficacy in ILD is unknown.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bbd92294-efcb-4239-93fa-71a64b748863"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:872fc0cc-8d81-4568-9f2b-277ffba4e222", "@type": "PISection", "graphScope": "brand", "section_title": "12.2  Pharmacodynamics", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "872fc0cc-8d81-4568-9f2b-277ffba4e222", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:872fc0cc-8d81-4568-9f2b-277ffba4e222"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:7f19e7ea-b8d2-4b24-9b58-e2ef9e2a8d0e", "@type": "PISection", "graphScope": "brand", "section_title": "Cardiac Electrophysiology", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "7f19e7ea-b8d2-4b24-9b58-e2ef9e2a8d0e", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In a study in renal cell cancer patients, QT/QTc measurements were recorded and showed that a single oral dose of 200 mg nintedanib as well as multiple oral doses of 200 mg nintedanib administered twice daily for 15 days did not prolong the QTcF interval.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7f19e7ea-b8d2-4b24-9b58-e2ef9e2a8d0e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:cea72526-c554-46b2-8ec2-4d2fa4d9c688", "@type": "PISection", "graphScope": "brand", "section_title": "12.3  Pharmacokinetics", "page_number": 14, "source_document_type": "prescribing_information", "section_id": "cea72526-c554-46b2-8ec2-4d2fa4d9c688", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The PK properties of nintedanib were similar in healthy volunteers, patients with IPF, patients with chronic fibrosing ILDs with a progressive phenotype, patients with SSc-ILD, and cancer patients. The PK of nintedanib is linear. Dose proportionality was shown by an increase of nintedanib exposure with increasing doses (dose range 50 to 450 mg once daily and 150 to 300 mg twice daily). Accumulation upon multiple administrations in patients with IPF was 1.76-fold for AUC. Steady-state plasma concentrations were achieved within one week of dosing. Nintedanib trough concentrations remained stable for more than one year. The inter-individual variability in the PK of nintedanib was moderate to high (coefficient of variation of standard PK parameters in the range of 30% to 70%), intra-individual variability low to moderate (coefficients of variation below 40%).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:cea72526-c554-46b2-8ec2-4d2fa4d9c688"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6935b2d8-a58f-4cd7-8833-6cf17d976232", "@type": "PISection", "graphScope": "brand", "section_title": "Absorption", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "6935b2d8-a58f-4cd7-8833-6cf17d976232", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib reached maximum plasma concentrations approximately 2 to 4 hours after oral administration as a soft gelatin capsule under fed conditions. The absolute bioavailability of a 100 mg dose was 4.7% (90% CI: 3.62 to 6.08) in healthy volunteers. Absorption and bioavailability are decreased by transporter effects and substantial first-pass metabolism.\n\nAfter food intake, nintedanib exposure increased by approximately 20% compared to administration under fasted conditions (90% CI: 95.3% to 152.5%) and absorption was delayed (median tmax fasted: 2.00 hours; fed: 3.98 hours), irrespective of the food type.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6935b2d8-a58f-4cd7-8833-6cf17d976232"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:55064bbe-7178-489d-b951-0bd97302af73", "@type": "PISection", "graphScope": "brand", "section_title": "Distribution", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "55064bbe-7178-489d-b951-0bd97302af73", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib follows bi-phasic disposition kinetics. After intravenous infusion, a high volume of distribution which was larger than total body volume (Vss: 1050 L) was observed.\n\nThe in vitro protein binding of nintedanib in human plasma was high, with a bound fraction of 97.8%. Serum albumin is considered to be the major binding protein. Nintedanib is preferentially distributed in plasma with a blood to plasma ratio of 0.87.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:55064bbe-7178-489d-b951-0bd97302af73"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:be71574b-804d-4d1a-94c5-e8c6257a0576", "@type": "PISection", "graphScope": "brand", "section_title": "Elimination", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "be71574b-804d-4d1a-94c5-e8c6257a0576", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The effective half-life of nintedanib in patients with IPF was 9.5 hours (gCV 31.9%). Total plasma clearance after intravenous infusion was high (CL: 1390 mL/min; gCV 28.8%). Urinary excretion of unchanged drug within 48 hours was about 0.05% of the dose after oral and about 1.4% of the dose after intravenous administration; the renal clearance was 20 mL/min.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:be71574b-804d-4d1a-94c5-e8c6257a0576"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:01b005ee-0d67-4852-9303-b50892e831e7", "@type": "PISection", "graphScope": "brand", "section_title": "Metabolism", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "01b005ee-0d67-4852-9303-b50892e831e7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The prevalent metabolic reaction for nintedanib is hydrolytic cleavage by esterases resulting in the free acid moiety BIBF 1202. BIBF 1202 is subsequently glucuronidated by UGT enzymes, namely UGT 1A1, UGT 1A7, UGT 1A8, and UGT 1A10 to BIBF 1202 glucuronide. Only a minor extent of the biotransformation of nintedanib consisted of CYP pathways, with CYP3A4 being the predominant enzyme involved. The major CYP-dependent metabolite could not be detected in plasma in the human absorption, distribution, metabolism, and elimination study. In vitro , CYP-dependent metabolism accounted for about 5% compared to about 25% ester cleavage.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:01b005ee-0d67-4852-9303-b50892e831e7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4f7f8f81-109a-4044-b44a-092bbfbe27d6", "@type": "PISection", "graphScope": "brand", "section_title": "Excretion", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "4f7f8f81-109a-4044-b44a-092bbfbe27d6", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The major route of elimination of drug-related radioactivity after oral administration of [ 14 C] nintedanib was via fecal/biliary excretion (93.4% of dose), and the majority of OFEV was excreted as BIBF 1202. The contribution of renal excretion to the total clearance was low (0.65% of dose). The overall recovery was considered complete (above 90%) within 4 days after dosing.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4f7f8f81-109a-4044-b44a-092bbfbe27d6"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:f2995859-b5da-452e-aa3b-d6b92a3be849", "@type": "PISection", "graphScope": "brand", "section_title": "Specific Populations", "page_number": 15, "source_document_type": "prescribing_information", "section_id": "f2995859-b5da-452e-aa3b-d6b92a3be849", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Age, Body Weight, and Sex\n\nBased on population PK analysis, age and body weight were correlated with nintedanib exposure. However, the effects on exposure are not sufficient to warrant a dose adjustment. There was no influence of sex on the exposure of nintedanib.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:f2995859-b5da-452e-aa3b-d6b92a3be849"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:62e6af3f-24d5-457f-ae4b-9f95297cd3bd", "@type": "PISection", "graphScope": "brand", "section_title": "Patients with Hepatic Impairment", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "62e6af3f-24d5-457f-ae4b-9f95297cd3bd", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A dedicated single-dose phase I pharmacokinetics study of OFEV compared 8 subjects with mild hepatic impairment (Child Pugh A) and 8 subjects with moderate hepatic impairment (Child Pugh B) to 17 subjects with normal hepatic function. In subjects with mild hepatic impairment, the mean exposure to nintedanib was 2.4-fold higher based on Cmax (90% CI: 1.6 to 3.6) and 2.2-fold higher based on AUC0-inf (90% CI: 1.4 to 3.5). In subjects with moderate hepatic impairment, exposure was 6.9-fold higher based on Cmax (90% CI: 4.4 to 11.0) and 7.6-fold higher based on AUC0-inf (90% CI: 5.1 to 11.3). Subjects with severe hepatic impairment (Child Pugh C) have not been studied.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:62e6af3f-24d5-457f-ae4b-9f95297cd3bd"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:b0b0d20a-922d-4f41-a581-ccca194e499a", "@type": "PISection", "graphScope": "brand", "section_title": "Smokers", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "b0b0d20a-922d-4f41-a581-ccca194e499a", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "In the population PK analysis, the exposure of nintedanib was 21% lower in current smokers compared to ex- and never-smokers. The effect is not sufficient to warrant a dose adjustment.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:b0b0d20a-922d-4f41-a581-ccca194e499a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:577c605e-45b9-43ba-a90e-dda0f83b76d3", "@type": "PISection", "graphScope": "brand", "section_title": "Drug Interaction Studies", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "577c605e-45b9-43ba-a90e-dda0f83b76d3", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:577c605e-45b9-43ba-a90e-dda0f83b76d3"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:25e731d5-eefb-4fd3-9b97-cccd24520984", "@type": "PISection", "graphScope": "brand", "section_title": "Potential for Nintedanib to Affect Other Drugs", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "25e731d5-eefb-4fd3-9b97-cccd24520984", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Effect of nintedanib coadministration on pirfenidone AUC and Cmax  was evaluated in a multiple-dose study. Nintedanib did not have an effect on the exposure of pirfenidone.\n\nFifteen female patients with SSc-ILD received a single dose of a combination of 30 mcg ethinylestradiol and 150 mcg levonorgestrel before and after twice daily dosing of 150 mg nintedanib for at least 10 days. Coadministration of nintedanib did not change the exposure of ethinylestradiol and levonorgestrel [see Warnings and Precautions (5.4) and Use in Specific Populations (8.3)] .\n\nIn in vitro studies, nintedanib was shown not to be an inhibitor of OATP-1B1, OATP-1B3, OATP-2B1, OCT-2, or MRP-2. In vitro studies also showed that nintedanib has weak inhibitory potential on OCT-1, BCRP, and P-gp; these findings are considered to be of low clinical relevance. Nintedanib and its metabolites, BIBF 1202 and BIBF 1202 glucuronide, did not inhibit or induce CYP enzymes in vitro .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:25e731d5-eefb-4fd3-9b97-cccd24520984"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:25e731d5-eefb-4fd3-9b97-cccd24520984"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:2201299c-0fe7-4cb4-9e0e-09f8886e8639", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "2201299c-0fe7-4cb4-9e0e-09f8886e8639", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "symptoms do not go away or become worse. Tell your doctor if you are taking over-the-counter laxatives, stool softeners, and other medicines or dietary supplements that can cause diarrhea.\n\n- heart attack. Tell your doctor right away if you have symptoms of a heart problem. These symptoms may include chest pain or pressure, pain in your arms, back, neck or jaw, or shortness of breath.\n- stroke. Tell your doctor right away if you have symptoms of a stroke. These symptoms may include numbness or weakness on 1 side of your body, trouble talking, headache, or dizziness.\n- bleeding problems. OFEV may increase your chances of having bleeding problems. Tell your doctor if you have unusual bleeding, bruising, or wounds that do not heal. Tell your doctor if you are taking a blood thinner, including prescription blood thinners and over-the-counter aspirin.\n- tear in your stomach or intestinal wall (perforation). OFEV may increase your chances of having a tear in your stomach or intestinal wall. Tell your doctor if you have pain or swelling in your stomach area.\n- increased protein in your urine (proteinuria). OFEV may increase your chances of having protein in your urine. Tell your doctor if you have any signs and symptoms of protein in the urine such as foamy urine, swelling, including in your hands, arms, legs, or feet, or sudden weight gain.\n\nThe most common side effects of OFEV are diarrhea, nausea, stomach pain, vomiting, liver problems, decreased appetite, headache, weight loss, and high blood pressure.\n\nThese are not all the possible side effects of OFEV. For more information, ask your doctor or pharmacist. Call your doctor for medical advice about side effects. You may report side effects to FDA at 1-800-FDA-1088.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:2201299c-0fe7-4cb4-9e0e-09f8886e8639"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:4ad2440b-8a75-4a18-b294-c83cc03f0fe1", "@type": "PISection", "graphScope": "brand", "section_title": "Potential for Other Drugs to Affect Nintedanib", "page_number": 16, "source_document_type": "prescribing_information", "section_id": "4ad2440b-8a75-4a18-b294-c83cc03f0fe1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nintedanib is a substrate of P-gp and, to a minor extent, CYP3A4. Coadministration with the P-gp and CYP3A4 inhibitor, ketoconazole, increased exposure to nintedanib 1.61-fold based on AUC and 1.83-fold based on Cmax in a dedicated drug-drug interaction study. In a drug-drug interaction study with the P-gp and CYP3A4 inducer, rifampicin, exposure to nintedanib decreased to 50.3% based on AUC and to 60.3% based on Cmax upon coadministration with rifampicin compared to administration of nintedanib alone.\n\nEffect of pirfenidone coadministration on nintedanib AUC and Cmax was evaluated in a multiple-dose drug-drug interaction study. Pirfenidone did not have an effect on the exposure of nintedanib. Concomitant treatment with nintedanib and pirfenidone was also investigated in a separate trial, which was an exploratory open-label, randomized (1:1) trial of nintedanib 150 mg twice daily with add-on pirfenidone (titrated to 801 mg three times a day) compared to nintedanib 150 mg twice daily alone in 105 randomized patients for 12 weeks. Similar nintedanib trough plasma concentrations were observed when comparing patients receiving nintedanib alone with patients receiving nintedanib with add-on pirfenidone.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4ad2440b-8a75-4a18-b294-c83cc03f0fe1"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:a058e191-7bb7-4ed5-a7ba-f3ac3527d332", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "a058e191-7bb7-4ed5-a7ba-f3ac3527d332", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Healthy volunteers received a single dose of 150 mg nintedanib before and after multiple dosing of 125 mg bosentan twice daily at steady state. Coadministration of nintedanib with bosentan did not alter the pharmacokinetics of nintedanib.\n\nNintedanib displays a pH-dependent solubility profile with increased solubility at acidic pH less than 3. However, in the clinical trials, coadministration with proton pump inhibitors or histamine H2 antagonists did not influence the exposure (trough concentrations) of nintedanib.\n\nIn in vitro studies, nintedanib was shown not to be a substrate of OATP-1B1, OATP-1B3, OATP-2B1, OCT-2, MRP-2, or BCRP. In vitro studies also showed that nintedanib was a substrate of OCT-1; these findings are considered to be of low clinical relevance.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a058e191-7bb7-4ed5-a7ba-f3ac3527d332"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:10099939-f99c-4c40-907c-70c901c5e68f", "@type": "PISection", "graphScope": "brand", "section_title": "13 NONCLINICAL TOXICOLOGY", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "10099939-f99c-4c40-907c-70c901c5e68f", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:10099939-f99c-4c40-907c-70c901c5e68f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1d3cf6dc-b0f5-473f-8afb-c366ff663190", "@type": "PISection", "graphScope": "brand", "section_title": "13.1  Carcinogenesis, Mutagenesis, Impairment of Fertility", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "1d3cf6dc-b0f5-473f-8afb-c366ff663190", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Two-year oral carcinogenicity studies of nintedanib in rats and mice have not revealed any evidence of carcinogenic potential. Nintedanib was dosed up to 10 and 30 mg/kg/day in rats and mice, respectively. These doses were less than and approximately 4 times the MRHD on a plasma drug AUC basis.\n\nNintedanib was negative for genotoxicity in the in vitro bacterial reverse mutation assay, the mouse lymphoma cell forward mutation assay, and the in vivo rat micronucleus assay.\n\nIn rats, nintedanib reduced female fertility at exposure levels approximately 3 times the MRHD (on an AUC basis at an oral dose of 100 mg/kg/day). Effects included increases in resorption and post-implantation loss, and a decrease in gestation index. Changes in the number and size of corpora lutea in the ovaries were observed in chronic toxicity studies in rats and mice. An increase in the number of females with resorptions only was observed at exposures approximately equal to the MRHD (on an AUC basis at an oral dose of 20 mg/kg/day). Nintedanib had no effects on male fertility in rats at exposure levels approximately 3 times the MRHD (on an AUC basis at an oral dose of 100 mg/kg/day).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1d3cf6dc-b0f5-473f-8afb-c366ff663190"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:817df3b9-b5b3-4f8c-aeb4-988ee72e7305", "@type": "PISection", "graphScope": "brand", "section_title": "14 CLINICAL STUDIES", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "817df3b9-b5b3-4f8c-aeb4-988ee72e7305", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:817df3b9-b5b3-4f8c-aeb4-988ee72e7305"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ebb892d5-08b1-49bf-b307-e908ca83a34f", "@type": "PISection", "graphScope": "brand", "section_title": "14.1  Idiopathic Pulmonary Fibrosis", "page_number": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of OFEV has been studied in 1231 patients with IPF in one phase 2 (Study 1 [NCT00514683]) and two phase 3 studies (Study 2 [NCT01335464] and Study 3 [NCT01335477]). These were randomized, double-blind, placebo-controlled studies comparing treatment with OFEV 150 mg twice daily to placebo for 52 weeks.\n\nStudy 2 and Study 3 were identical in design. Study 1 was very similar in design. Patients were randomized in a 3:2 ratio (1:1 for Study 1) to either OFEV 150 mg or placebo twice daily for 52 weeks. Study 1 also included other treatment arms (50 mg daily, 50 mg twice daily, and 100 mg twice daily) that are not further discussed. The primary endpoint was the annual rate of decline in Forced Vital Capacity (FVC). Time to first acute IPF exacerbation was a key secondary endpoint in Study 2 and Study 3 and a secondary endpoint in Study 1. Change from baseline in FVC percent predicted and survival were additional secondary endpoints in all studies.\n\nPatients were required to have a diagnosis of IPF (ATS/ERS/JRS/ALAT criteria) for less than 5 years. Diagnoses were centrally adjudicated based on radiologic and, if applicable, histopathologic confirmation. Patients were required to be greater than or equal to 40 years of age with an FVC greater than or equal to 50% of predicted and a carbon monoxide diffusing capacity (DLCO, corrected for hemoglobin) 30% to 79% of predicted. Patients with relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7) or, in the opinion of the investigator, likely to receive a lung transplant during the studies were excluded (being listed for lung transplant was acceptable for inclusion). Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded from the studies. Patients were also excluded if they received other investigational therapy, azathioprine, cyclophosphamide, or cyclosporine A within 8 weeks of entry into this trial, or n-acetyl cysteine and prednisone (greater than 15 mg/day or equivalent) within 2 weeks. The majority of patients were Caucasian (60%) or Asian (30%) and male (79%). Patients had a mean age of 67 years and a mean FVC percent predicted of 80%.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a34f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:30e4db24-2953-4c11-a086-d7f9687e383d", "@type": "PISection", "graphScope": "brand", "section_title": "What are the ingredients in OFEV?", "page_number": 32, "source_document_type": "prescribing_information", "section_id": "30e4db24-2953-4c11-a086-d7f9687e383d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Active ingredient:\n\nnintedanib\n\nInactive ingredients: Fill Material: triglycerides, hard fat, lecithin. Capsule Shell: gelatin, glycerol, titanium dioxide, red ferric oxide, yellow ferric oxide, black ink\n\nDistributed by: Boehringer Ingelheim Pharmaceuticals, Inc. Ridgefield, CT 06877 USA\n\nLicensed from: Boehringer Ingelheim International GmbH\n\nOFEV is a registered trademark of and used under license from Boehringer Ingelheim International GmbH.\n\nCopyright © 202X Boehringer Ingelheim International GmbH, ALL RIGHTS RESERVED\n\nCOL9114HD262024\n\nThis Patient Information has been approved by the U.S. Food and Drug Administration.\n\nRevised: XXX 202X", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:30e4db24-2953-4c11-a086-d7f9687e383d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:166e6c43-94bf-4b14-b6d6-8b2c83a20681", "@type": "PISection", "graphScope": "brand", "section_title": "Figure 1 Mean (SEM) Observed FVC Change from Baseline (mL) Over Time in Study 2", "page_number": 19, "source_document_type": "prescribing_information", "section_id": "166e6c43-94bf-4b14-b6d6-8b2c83a20681", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "bid = twice daily\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:166e6c43-94bf-4b14-b6d6-8b2c83a20681"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:5c96615a-f77b-4894-b50e-67747b31d772", "@type": "PISection", "graphScope": "brand", "section_title": "Change from Baseline in Percent Predicted Forced Vital Capacity", "page_number": 19, "source_document_type": "prescribing_information", "section_id": "5c96615a-f77b-4894-b50e-67747b31d772", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 2 presents the cumulative distribution for all cut-offs for the change from baseline in FVC percent predicted at Week 52 for Study 2. For all categorical declines in lung function, the proportion of patients declining was lower on OFEV than on placebo. Study 3 showed similar results.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:5c96615a-f77b-4894-b50e-67747b31d772"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1b4a09eb-d493-4fc2-bfc7-8b41f7459cc9", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "1b4a09eb-d493-4fc2-bfc7-8b41f7459cc9", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 2 Cumulative Distribution of Patients by Change in Percent Predicted FVC from Baseline to Week 52 (Study 2).* The vertical lines indicate ≥0% decline or ≥10% decline.\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1b4a09eb-d493-4fc2-bfc7-8b41f7459cc9"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:7f693733-17b1-494e-8e31-762835700832", "@type": "PISection", "graphScope": "brand", "section_title": "Time to First Acute IPF Exacerbation", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "7f693733-17b1-494e-8e31-762835700832", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Acute IPF exacerbation was defined as unexplained worsening or development of dyspnea within 30 days, new diffuse pulmonary infiltrates on chest x-ray, and/or new high-resolution CT parenchymal abnormalities with no pneumothorax or pleural effusion, and exclusion of alternative causes. Acute IPF exacerbation was adjudicated in Study 2 and Study 3. In Study 1 (investigator-reported) and Study 3 (adjudicated), the risk of first acute IPF exacerbation over 52 weeks was significantly reduced in patients receiving OFEV compared to placebo (hazard ratio [HR]: 0.16, 95% CI: 0.04, 0.71) and (HR: 0.20, 95% CI: 0.07, 0.56), respectively. In Study 2 (adjudicated), there was no difference between the treatment groups (HR: 0.55, 95% CI: 0.20, 1.54).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7f693733-17b1-494e-8e31-762835700832"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:e49931ec-9215-444f-963d-2f82d6261e86", "@type": "PISection", "graphScope": "brand", "section_title": "Survival", "page_number": 20, "source_document_type": "prescribing_information", "section_id": "e49931ec-9215-444f-963d-2f82d6261e86", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Survival was evaluated for OFEV compared to placebo in Study 2 and Study 3 as an exploratory analysis to support the primary endpoint (FVC). All-cause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (See Figure 3).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:e49931ec-9215-444f-963d-2f82d6261e86"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9b5d8f8a-cabb-40b2-9f74-4f09be43e974", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 21, "source_document_type": "prescribing_information", "section_id": "9b5d8f8a-cabb-40b2-9f74-4f09be43e974", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 3 Kaplan-Meier Estimates of All-Cause Mortality at Vital Status End of Study: Study 2 and Study 3\n\n7\n\n<!-- image -->\n\nbid = twice daily", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9b5d8f8a-cabb-40b2-9f74-4f09be43e974"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "@type": "PISection", "graphScope": "brand", "section_title": "14.2  Chronic Fibrosing Interstitial Lung Diseases with a Progressive Phenotype", "page_number": 21, "source_document_type": "prescribing_information", "section_id": "8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of OFEV has been studied in patients with chronic fibrosing ILDs with a progressive phenotype in a randomized, double-blind, placebo-controlled phase 3 trial (Study 5 [NCT02999178]). A total of 663 patients were randomized in a 1:1 ratio to receive either OFEV 150 mg twice daily or matching placebo for at least 52 weeks. Randomization was stratified based on high resolution computed tomography (HRCT) fibrotic pattern as assessed by central readers: 412 patients with UIP-like HRCT pattern and 251 patients with other HRCT fibrotic patterns were randomized. There were 2 co-primary populations defined for the analyses in this trial: all patients (the overall population) and patients with HRCT with UIP-like HRCT fibrotic pattern.\n\nThe primary endpoint was the annual rate of decline in FVC (in mL) over 52 weeks. Other endpoints included time to first acute ILD exacerbation and time to death.\n\nPatients with a clinical diagnosis of a chronic fibrosing ILD were selected if they had relevant fibrosis (greater than 10% fibrotic features) on HRCT and presented with clinical signs of progression (defined as FVC decline ≥ 10%, FVC decline ≥ 5% and &lt;10% with worsening symptoms or imaging, or worsening symptoms and worsening imaging all in the 24 months prior to screening). Patients were required to have an FVC greater than or equal to 45% of predicted and a DLCO 30% to less than 80% of predicted. Patients were required to have progressed despite management deemed appropriate in clinical practice by investigators for the patient's relevant ILD.\n\nPatients with IPF, relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7), or significant pulmonary hypertension were excluded from the trial. Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded. Patients were also excluded if they received other investigational therapy, azathioprine, cyclosporine, mycophenolate mofetil, tacrolimus, oral corticosteroids greater than 20 mg/day, or the combination of oral corticosteroids + azathioprine + n-acetylcysteine within 4 weeks of randomization, cyclophosphamide within 8 weeks prior to randomization, rituximab within 6 months, or previous treatment with nintedanib or pirfenidone.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8b6b4a35-b692-4b20-814b-062cbd5f4e9a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ce5bae28-2e04-4264-918e-5980b4dd50a7", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 22, "source_document_type": "prescribing_information", "section_id": "ce5bae28-2e04-4264-918e-5980b4dd50a7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The majority of patients were Caucasian (74%) or Asian (25%). Patients were mostly male (54%) and had a mean age of 66 years and a mean FVC percent predicted of 69%, and 49% were never-smokers. The underlying clinical ILD diagnoses in groups represented in the trial were hypersensitivity pneumonitis (26%), autoimmune ILDs (26%), idiopathic nonspecific interstitial pneumonia (19%), unclassifiable idiopathic interstitial pneumonia (17%), and other ILDs (12%).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ce5bae28-2e04-4264-918e-5980b4dd50a7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:3b44b253-3c5e-4edf-8134-59aeb8a2f171", "@type": "PISection", "graphScope": "brand", "section_title": "Percent Change from Baseline in Forced Vital Capacity", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "3b44b253-3c5e-4edf-8134-59aeb8a2f171", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 9 presents the percent change from baseline in FVC in mL at Week 52 for Study 4. For the majority of patients, the decline in lung function was less on OFEV than on placebo.\n\nFigure 9 Histogram of the Percent Change in FVC (mL) from Baseline to Week 52 According to Treatment and Percent Increments or Decrements of 5 (Study 4) a\n\n25\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:3b44b253-3c5e-4edf-8134-59aeb8a2f171"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:0a8d2cd2-13e6-45ad-97f3-b4d22a555491", "@type": "PISection", "graphScope": "brand", "section_title": "Modified Rodnan Skin Score", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "0a8d2cd2-13e6-45ad-97f3-b4d22a555491", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "No benefit in mRSS was observed in patients receiving OFEV. The adjusted mean absolute change from baseline in mRSS at Week 52 was comparable between the OFEV group (-2.17 (95% CI: -2.69, -1.65)) and the placebo group (-1.96 (95% CI: -2.48, -1.45)). The adjusted mean difference between the treatment groups was -0.21 (95% CI: -0.94, 0.53).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:0a8d2cd2-13e6-45ad-97f3-b4d22a555491"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9f0b3134-ddb8-4c86-a16f-9e1401e08d98", "@type": "PISection", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "page_number": 22, "source_document_type": "prescribing_information", "section_id": "9f0b3134-ddb8-4c86-a16f-9e1401e08d98", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "There was a statistically significant reduction in the annual rate of decline in FVC (in mL) over 52 weeks in patients receiving OFEV compared to patients receiving placebo. The annual rate of decline in FVC (in mL) over 52 weeks was significantly reduced by 107 mL in patients receiving OFEV compared to patients receiving placebo. Results in the subpopulations of patients with HRCT with UIP-like fibrotic pattern and patients with other fibrotic patterns (Other HRCT) are included with the overall population in Table 4.\n\nTable 4 Annual Rate of Decline in FVC (mL) in Study 5\n\n|                                               | Overall   | Overall   | UIP-like Subpopulation   | UIP-like Subpopulation   | Other HRCT Subpopulation   | Other HRCT Subpopulation   |\n|-----------------------------------------------|-----------|-----------|--------------------------|--------------------------|----------------------------|----------------------------|\n|                                               | OFEV      | Placebo   | OFEV                     | Placebo                  | OFEV                       | Placebo                    |\n| Number of analyzed patients                   | 331       | 331       | 206                      | 206                      | 125                        | 125                        |\n| Adjusted annual rate of decline over 52 weeks | -81       | -188      | -83                      | -211                     | -79                        | -154                       |\n| Comparison vs placebo difference a            | 107       | 107       | 128                      | 128                      | 75*                        | 75*                        |\n| 95% CI                                        | (65, 148) | (65, 148) | (71, 186)                | (71, 186)                | (16, 135)*                 | (16, 135)*                 |", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9f0b3134-ddb8-4c86-a16f-9e1401e08d98"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:3eddbfc7-62a0-4308-94f6-93395dc75c9b", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 23, "source_document_type": "prescribing_information", "section_id": "3eddbfc7-62a0-4308-94f6-93395dc75c9b", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "A post-hoc exploratory analysis by ILD diagnosis was performed and is shown in Figure 4. Treatment response across ILD diagnoses was consistent for FVC.\n\nFigure 4 Annual Rate of Decline in FVC (mL) over 52 Weeks based on Underlying ILD Diagnosis in Study 5*\n\n<!-- image -->\n\nILD = interstitial lung disease; Autoimmune ILDs: includes rheumatoid arthritis-associated ILD, mixed connective tissue disease, systemic sclerosis-associated ILD, and other terms; Other ILDs: includes fibrosing ILDs not categorized under autoimmune ILDs, hypersensitivity pneumonitis, idiopathic nonspecific interstitial pneumonia, or unclassifiable idiopathic interstitial pneumonia. The three most common ILDs in this category are exposure-related ILD, sarcoidosis, and pleuro-parenchymal fibroelastosis. *These results are from a post-hoc exploratory analysis. Values shown here are for descriptive purposes.\n\nFigure 5 shows the change in FVC from baseline over time in the treatment groups. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:3eddbfc7-62a0-4308-94f6-93395dc75c9b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:61f1bd22-1741-4a62-af2b-64bf8f2f94ab", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 24, "source_document_type": "prescribing_information", "section_id": "61f1bd22-1741-4a62-af2b-64bf8f2f94ab", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 5 Mean (SEM) Observed FVC Change from Baseline (mL) Over 52 Weeks in Study 5\n\n<!-- image -->\n\nbid = twice daily", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:61f1bd22-1741-4a62-af2b-64bf8f2f94ab"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:0651d94a-11c7-44d3-ae44-df56d8361bc9", "@type": "PISection", "graphScope": "brand", "section_title": "Percent Change from Baseline in Forced Vital Capacity", "page_number": 24, "source_document_type": "prescribing_information", "section_id": "0651d94a-11c7-44d3-ae44-df56d8361bc9", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 6 presents the percent change from baseline in FVC in mL at Week 52 for Study 5. For the majority of patients, the decline in lung function was less on OFEV than on placebo.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:0651d94a-11c7-44d3-ae44-df56d8361bc9"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:3a6ec795-c11b-4571-839f-19321f818cb7", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "3a6ec795-c11b-4571-839f-19321f818cb7", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 6 Histogram of the Percent Change in FVC (mL) from Baseline to Week 52 According to Treatment and Percent Increments or Decrements of 5 (Study 5) a\n\n<!-- image -->", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:3a6ec795-c11b-4571-839f-19321f818cb7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6ad4dd31-dcd4-4ea0-bc69-54a13057e025", "@type": "PISection", "graphScope": "brand", "section_title": "Time to First Acute ILD Exacerbation", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "6ad4dd31-dcd4-4ea0-bc69-54a13057e025", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Acute ILD exacerbation was defined as unexplained worsening or development of dyspnea within 30 days, new diffuse pulmonary infiltrates on chest x-ray, and/or new HRCT parenchymal abnormalities with no pneumothorax or pleural effusion, and exclusion of alternative causes. Acute ILD exacerbations were not adjudicated.\n\nThe risk of first acute ILD exacerbation did not show a statistically significant difference between the OFEV group compared to placebo (52 week treatment period: HR 0.72, (95% CI: 0.38, 1.37); whole trial: HR 0.63 (95% CI: 0.37, 1.07)).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6ad4dd31-dcd4-4ea0-bc69-54a13057e025"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:d98137e4-1182-40a9-a960-56289cab694d", "@type": "PISection", "graphScope": "brand", "section_title": "Survival", "page_number": 25, "source_document_type": "prescribing_information", "section_id": "d98137e4-1182-40a9-a960-56289cab694d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Survival was evaluated for OFEV compared to placebo in Study 5 to support the primary endpoint (FVC). Allcause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (52 week treatment period: HR 0.94 (95% CI: 0.47, 1.86); whole trial: HR 0.78 (95% CI: 0.50, 1.21)).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:d98137e4-1182-40a9-a960-56289cab694d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:7a66ed23-733e-4b09-96f1-5519c32ef66c", "@type": "PISection", "graphScope": "brand", "section_title": "14.3  Systemic Sclerosis-Associated Interstitial Lung Disease", "page_number": 26, "source_document_type": "prescribing_information", "section_id": "7a66ed23-733e-4b09-96f1-5519c32ef66c", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The clinical efficacy of nintedanib has been studied in patients with SSc-ILD in a randomized, double-blind, placebo-controlled phase 3 trial (Study 4 [NCT02597933]). A total of 580 patients were randomized in a 1:1 ratio to receive either OFEV 150 mg twice daily or matching placebo for at least 52 weeks, of which 576 patients were treated. Randomization was stratified by anti-topoisomerase antibody (ATA) status. Individual patients remained on blinded trial treatment for up to 100 weeks. The primary endpoint was the annual rate of decline in FVC over 52 weeks. The absolute change from baseline in the modified Rodnan skin score (mRSS) at Week 52 was a key secondary endpoint. Mortality over the whole trial was an additional secondary endpoint.\n\nPatients were diagnosed with SSc-ILD based upon the 2013 American College of Rheumatology / European League Against Rheumatism classification criteria for SSc with onset of disease (first non-Raynaud symptom) of less than 7 years and greater than or equal to 10% fibrosis on a chest high resolution computed tomography (HRCT) scan conducted within the previous 12 months. Patients were required to have an FVC greater than or equal to 40% of predicted and a DLCO 30-89% of predicted. Patients with relevant airways obstruction (i.e., pre-bronchodilator FEV1/FVC less than 0.7) or previous or planned hematopoietic stem cell transplant were excluded from the trial. Patients with greater than 1.5 times ULN of ALT, AST, or bilirubin, patients with a known risk or predisposition to bleeding, patients receiving a full dose of anticoagulation treatment, and patients with a recent history of myocardial infarction or stroke were excluded from the study. Patients were excluded if they had significant pulmonary hypertension, more than three digital fingertip ulcers, a history of severe digital necrosis requiring hospitalization, or a history of scleroderma renal crisis. Patients were also excluded if they received other investigational therapy, azathioprine within 8 weeks prior to randomization, cyclophosphamide or cyclosporine A within 6 months prior to randomization, or previous treatment with nintedanib or pirfenidone.\n\nThe majority of patients were female (75%). Patients were mostly Caucasian (67%), Asian (25%), or Black (6%). The mean age was 54 years. Overall, 52% of patients had diffuse cutaneous systemic sclerosis (SSc) and 48% had limited cutaneous SSc. The mean time since first onset of a non-Raynaud symptom was 3.49 years. At baseline, 49% of patients were on stable therapy with mycophenolate.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7a66ed23-733e-4b09-96f1-5519c32ef66c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1b4cad53-af36-425a-a0ac-a1e91f52fc34", "@type": "PISection", "graphScope": "brand", "section_title": "Annual Rate of Decline in FVC", "page_number": 26, "source_document_type": "prescribing_information", "section_id": "1b4cad53-af36-425a-a0ac-a1e91f52fc34", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "The annual rate of decline of FVC (in mL) over 52 weeks was significantly reduced by 41 mL in patients receiving OFEV compared to patients receiving placebo, corresponding to a relative treatment effect of 44%. See Table 5.\n\nTable 5 Annual Rate of Decline in FVC (mL) in Study 4\n\n|                                        | OFEV 150 mg twice daily   |   Placebo |\n|----------------------------------------|---------------------------|-----------|\n| Number of analyzed patients            | 287                       |       288 |\n| Adjusted rate of decline over 52 weeks | -52                       |       -93 |\n| Comparison vs placebo Difference a     |                           |           |\n|                                        | 41                        |           |\n| 95% CI                                 | (3, 79)                   |           |\n\nFigure 7 displays the change from baseline over time in both treatment groups. When the mean observed FVC change from baseline was plotted over time, the curves diverged at all timepoints through Week 52. Separation of the mean values is seen after 12 weeks of treatment.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1b4cad53-af36-425a-a0ac-a1e91f52fc34"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9d0fc594-0f4e-43e9-94f8-02377f972355", "@type": "PISection", "graphScope": "brand", "section_title": "", "page_number": 27, "source_document_type": "prescribing_information", "section_id": "9d0fc594-0f4e-43e9-94f8-02377f972355", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Figure 7 Mean (SEM) Observed FVC Change from Baseline (mL) Over Time in Study 4\n\n<!-- image -->\n\nbid = twice daily\n\nIn two pre-specified subgroup efficacy analyses, the mean treatment difference in FVC decline at 52 weeks in patients were examined by region and mycophenolate use (Figure 8).\n\nFigure 8 Subgroup Analyses of the Mean Treatment Difference in FVC (mL) Decline at Week 52 by Region and Mycophenolate Use (Study 4)\n\n|                               | Placebo   | Placebo         | Nmtedanib 150bid   | Nmtedanib 150bid   | Difference [95%Cij   |\n|-------------------------------|-----------|-----------------|--------------------|--------------------|----------------------|\n|                               | N         | Rate of Decline | N                  | Rate of Decline    |                      |\n| Region                        |           |                 |                    |                    |                      |\n| Asia                          | 71        | -92             | 59                 | -48                | 43 (-37; 124]        |\n| Europe                        | 126       | -107            | 139                | -67                | 40 (-17; 96]         |\n| Canada and United States      | 73        | -52             | 69                 | -42                | 10 (-66; 86]         |\n| Rest ofWor1d                  | 18        | -176            | 20                 | 2                  | 178 (28; 329]        |\n| Mycophenolate use at baseline |           |                 |                    |                    |                      |\n| Yes                           | 140       | -67             | 138                | -40                | 26 (-28; 81]         |\n| No                            | 148       | -1 19           | 149                | .64                | 55 [2, 109]          |\n| ALL                           | 288       | -93             | 287                | -52                | 41 [3; 79]           |\n\n<!-- image -->\n\nNintedamb 150bid - Placebo difference in ad1usted rate of decline in FVC [ml/yr) and 95% confidence interval", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9d0fc594-0f4e-43e9-94f8-02377f972355"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:ef644a7a-b2cb-4872-96fa-c27c9364854d", "@type": "PISection", "graphScope": "brand", "section_title": "Survival", "page_number": 28, "source_document_type": "prescribing_information", "section_id": "ef644a7a-b2cb-4872-96fa-c27c9364854d", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "No difference in survival was observed in an exploratory analysis of mortality over the whole trial (OFEV: n=10 (3.5%) vs. placebo: n=9 (3.1%)). The analysis of time to death over the whole trial resulted in a HR of 1.16 (95% CI: 0.47, 2.84).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ef644a7a-b2cb-4872-96fa-c27c9364854d"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9145a320-c5e0-4d9e-92e5-60e0f39171ef", "@type": "PISection", "graphScope": "brand", "section_title": "16 HOW SUPPLIED/STORAGE AND HANDLING", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9145a320-c5e0-4d9e-92e5-60e0f39171ef", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "150 mg:  brown, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"150\". They are packaged in HDPE bottles with a child-resistant closure, available as follows: Bottles of 60 NDC:  0597-0145-60\n\n100 mg:  peach, opaque, oblong, soft capsules imprinted in black with the Boehringer Ingelheim company symbol and \"100\". They are packaged in HDPE bottles with a child-resistant closure, available as follows: Bottles of 60                                        NDC:  0597-0143-60", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9145a320-c5e0-4d9e-92e5-60e0f39171ef"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:257ef4a8-88af-4578-b3b6-8f1e17f07614", "@type": "PISection", "graphScope": "brand", "section_title": "Storage", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "257ef4a8-88af-4578-b3b6-8f1e17f07614", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Store at 20°C to 25°C (68°F to 77°F); excursions permitted to 15°C to 30°C (59°F to 86°F) [see USP Controlled Room Temperature]. Protect from exposure to high humidity and avoid excessive heat. If repackaged, use USP tight container.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:257ef4a8-88af-4578-b3b6-8f1e17f07614"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:78374f81-0a9a-4bae-900d-44e6ed0c7269", "@type": "PISection", "graphScope": "brand", "section_title": "17 PATIENT COUNSELING INFORMATION", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "78374f81-0a9a-4bae-900d-44e6ed0c7269", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise the patient to read the FDA-approved patient labeling (Patient Information).", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:78374f81-0a9a-4bae-900d-44e6ed0c7269"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1d8f3cf2-5f38-4923-9b95-09d069c29030", "@type": "PISection", "graphScope": "brand", "section_title": "Elevated Liver Enzymes and Drug-Induced Liver Injury", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "1d8f3cf2-5f38-4923-9b95-09d069c29030", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients that they will need to undergo liver function testing periodically. Advise patients to immediately report any symptoms of a liver problem (e.g., skin or the whites of eyes turn yellow, urine turns dark or brown (tea colored), pain on the right side of stomach, bleed or bruise more easily than normal, lethargy, loss of appetite) [see Warnings and Precautions (5.2)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:1d8f3cf2-5f38-4923-9b95-09d069c29030"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1d8f3cf2-5f38-4923-9b95-09d069c29030"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9a6557c9-da30-4940-ba0f-3114966d16bd", "@type": "PISection", "graphScope": "brand", "section_title": "Gastrointestinal Disorders", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9a6557c9-da30-4940-ba0f-3114966d16bd", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Inform patients that gastrointestinal disorders such as diarrhea, nausea, and vomiting were the most commonly reported gastrointestinal events occurring in patients who received OFEV. Advise patients that their healthcare provider may recommend hydration, antidiarrheal medications (e.g., loperamide), or anti-emetic medications to treat these side effects. Temporary dosage reductions or discontinuations may be required. Instruct patients to contact their healthcare provider at the first signs of diarrhea or for any severe or persistent diarrhea, nausea, or vomiting [see Warnings and Precautions (5.3) and Adverse Reactions (6.1)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:9a6557c9-da30-4940-ba0f-3114966d16bd"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9a6557c9-da30-4940-ba0f-3114966d16bd"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e", "@type": "PISection", "graphScope": "brand", "section_title": "Embryo-Fetal Toxicity", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Counsel patients on pregnancy prevention and planning. Advise females of reproductive potential of the potential risk to a fetus and to avoid becoming pregnant while receiving treatment with OFEV. Advise females of reproductive potential to use highly effective contraception at initiation of, during treatment, and for at least 3 months after taking the last dose of OFEV. Advise women taking oral hormonal contraceptives who experience vomiting and/or diarrhea or other conditions where the drug absorption may be reduced to contact their doctor to discuss alternative highly effective contraception. Advise female patients to notify their doctor if they become pregnant or suspect they are pregnant during therapy with OFEV [see Warnings and Precautions (5.4) and Use in Specific Populations (8.1, 8.3)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:9c4d5cbb-30c9-4f6c-aec9-dd2b13e56f6e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:c86d5e52-8881-44d3-808e-eeab92a27e40", "@type": "PISection", "graphScope": "brand", "section_title": "Arterial Thromboembolic Events", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "c86d5e52-8881-44d3-808e-eeab92a27e40", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients about the signs and symptoms of acute myocardial ischemia and other arterial thromboembolic events and the urgency to seek immediate medical care for these conditions [see Warnings and Precautions (5.5)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:c86d5e52-8881-44d3-808e-eeab92a27e40"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:c86d5e52-8881-44d3-808e-eeab92a27e40"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:37ba6678-1ba6-4a79-8c51-68f2993f974e", "@type": "PISection", "graphScope": "brand", "section_title": "Risk of Bleeding", "page_number": 29, "source_document_type": "prescribing_information", "section_id": "37ba6678-1ba6-4a79-8c51-68f2993f974e", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Bleeding events have been reported. Advise patients to report unusual bleeding [see Warnings and Precautions (5.6)].", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:37ba6678-1ba6-4a79-8c51-68f2993f974e"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:37ba6678-1ba6-4a79-8c51-68f2993f974e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:35eea8c4-bdf2-4e0c-9f23-0854287ede88", "@type": "PISection", "graphScope": "brand", "section_title": "Gastrointestinal Perforation", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "35eea8c4-bdf2-4e0c-9f23-0854287ede88", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Serious gastrointestinal perforation events have been reported. Advise patients to report signs and symptoms of gastrointestinal perforation [see Warnings and Precautions (5.7)] .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:35eea8c4-bdf2-4e0c-9f23-0854287ede88"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:35eea8c4-bdf2-4e0c-9f23-0854287ede88"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:89b01160-bc2e-4359-a76c-078a9593c774", "@type": "PISection", "graphScope": "brand", "section_title": "Nephrotic Range Proteinuria", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "89b01160-bc2e-4359-a76c-078a9593c774", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Nephrotic range proteinuria has been reported. Advise patients to report signs and symptoms of proteinuria (e.g., fluid retention, foamy urine) [see Warnings and Precautions (5.8)] .", "PI_SECTION_CONTAINS_SAFETY": [{"@id": "urn:kg:ofev:safety:89b01160-bc2e-4359-a76c-078a9593c774"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:89b01160-bc2e-4359-a76c-078a9593c774"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:dff60917-e4b1-4acc-b573-acf13137cbf2", "@type": "PISection", "graphScope": "brand", "section_title": "Lactation", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "dff60917-e4b1-4acc-b573-acf13137cbf2", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Advise patients that breastfeeding is not recommended while taking OFEV [see Use in Specific Populations (8.2)].", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:dff60917-e4b1-4acc-b573-acf13137cbf2"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:3573d564-f0aa-4e08-9b68-71a8dd228a88", "@type": "PISection", "graphScope": "brand", "section_title": "Smokers", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "3573d564-f0aa-4e08-9b68-71a8dd228a88", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Encourage patients to stop smoking prior to treatment with OFEV and to avoid smoking when using OFEV [see Clinical Pharmacology (12.3)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:3573d564-f0aa-4e08-9b68-71a8dd228a88"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:2534378c-d573-4f8e-823f-646211314283", "@type": "PISection", "graphScope": "brand", "section_title": "Administration", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "2534378c-d573-4f8e-823f-646211314283", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Instruct patients to take OFEV with food, to swallow OFEV capsules whole with liquid, and not to chew the capsules due to the bitter taste . Advise patients or caregivers not to open or crush OFEV capsules and to wash hands immediately and thoroughly if contact with the content of the capsule occurs. Advise patients to not make up for a missed dose [see Dosage and Administration (2.2)] .", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:2534378c-d573-4f8e-823f-646211314283"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:bd907bfe-9933-4dce-b260-fdc470024227", "@type": "PISection", "graphScope": "brand", "section_title": "Distributed by:", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "bd907bfe-9933-4dce-b260-fdc470024227", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Boehringer Ingelheim Pharmaceuticals, Inc. Ridgefield, CT 06877 USA", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:bd907bfe-9933-4dce-b260-fdc470024227"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:2b0570b6-9d18-4dfe-b178-6179cb6ba1b0", "@type": "PISection", "graphScope": "brand", "section_title": "Licensed from:", "page_number": 30, "source_document_type": "prescribing_information", "section_id": "2b0570b6-9d18-4dfe-b178-6179cb6ba1b0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "Boehringer Ingelheim International GmbH\n\nOFEV is a registered trademark of and used under license from Boehringer Ingelheim International GmbH.\n\nCopyright © 202X Boehringer Ingelheim International GmbH ALL RIGHTS RESERVED\n\nCOL9114HD262024", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:2b0570b6-9d18-4dfe-b178-6179cb6ba1b0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:1c425628-fac5-4210-b73d-ef02433e48b0", "@type": "PISection", "graphScope": "brand", "section_title": "Patient Information OFEV ® (OH-fev) (nintedanib capsules)", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "1c425628-fac5-4210-b73d-ef02433e48b0", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:1c425628-fac5-4210-b73d-ef02433e48b0"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:af6cc911-7a9e-4976-b179-57a7a8e118ad", "@type": "PISection", "graphScope": "brand", "section_title": "What is the most important information I should know about OFEV?", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "af6cc911-7a9e-4976-b179-57a7a8e118ad", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- OFEV can cause birth defects or death to an unborn baby. Women should not become pregnant while taking OFEV. Women who are able to become pregnant should have a pregnancy test before starting treatment with OFEV.\n- Women who are able to become pregnant should use highly effective birth control at the start of treatment, during treatment, and for at least 3 months after treatment. Talk with your doctor about what birth control method is right for you during this time.\n- Birth control pills may not work as well in women having vomiting, diarrhea, or other problems reducing the drug absorption. If you have any of these problems, talk with your doctor about which highly effective birth control method is right for you.\n- If you become pregnant or think you are pregnant while taking OFEV, tell your doctor right away.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:af6cc911-7a9e-4976-b179-57a7a8e118ad"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:6c673293-1075-4628-9d62-571468ca4608", "@type": "PISection", "graphScope": "brand", "section_title": "What is OFEV?", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "6c673293-1075-4628-9d62-571468ca4608", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- OFEV is a prescription medicine used:\n- o to treat adults with a lung disease called idiopathic pulmonary fibrosis (IPF).\n- o to treat adults with a long-lasting (chronic) interstitial lung disease in which lung fibrosis continues to worsen (progress).\n- o to slow the rate of decline in lung function in adults with systemic sclerosis-associated interstitial lung disease (SSc-ILD) (also known as scleroderma-associated ILD).\n- It is not known if OFEV is safe and effective in children.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6c673293-1075-4628-9d62-571468ca4608"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:e617d484-046b-488f-89a5-5159d7711130", "@type": "PISection", "graphScope": "brand", "section_title": "What should I tell my doctor before taking OFEV?", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "e617d484-046b-488f-89a5-5159d7711130", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:e617d484-046b-488f-89a5-5159d7711130"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:pisection:769f8a50-7997-4e9d-bef1-a063ec1f3191", "@type": "PISection", "graphScope": "brand", "section_title": "Before you take OFEV, tell your doctor about all of your medical conditions, including if you:", "page_number": 31, "source_document_type": "prescribing_information", "section_id": "769f8a50-7997-4e9d-bef1-a063ec1f3191", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "text": "- have liver problems.\n- have heart problems.\n- have a history of blood clots.\n- have a bleeding problem or a family history of a bleeding problem.\n- have had recent surgery in your stomach (abdominal) area.\n- are a smoker.\n- are pregnant or plan to become pregnant. OFEV can harm your unborn baby. OFEV can cause birth defects or death to an unborn baby. See 'What is the most important information I should know about OFEV?'\n- are breastfeeding or plan to breastfeed. It is not known if OFEV passes into your breast milk. You should not breastfeed while taking OFEV.\n\nTell your doctor about all the medicines you take, including prescription and over-the-counter medicines, vitamins, and herbal supplements such as St. John's wort. Keep a list of the medicines you take and show it to your doctor and pharmacist when you get a new medicine.", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:769f8a50-7997-4e9d-bef1-a063ec1f3191"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:respiratoryoutcome:ebb892d5-08b1-49bf-b307-e908ca83a34f", "@type": "RespiratoryOutcome", "graphScope": "brand", "source_page": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "outcome_text": "The primary endpoint was the annual rate of decline in Forced Vital Capacity (FVC).", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "OUTCOME_FROM_TRIAL": [{"@id": "urn:kg:ofev:clinicaltrial:ofev:nct00514683"}, {"@id": "urn:kg:ofev:clinicaltrial:ofev:nct01335464"}, {"@id": "urn:kg:ofev:clinicaltrial:ofev:nct01335477"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a34f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:respiratoryoutcome:8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "@type": "RespiratoryOutcome", "graphScope": "brand", "source_page": 21, "source_document_type": "prescribing_information", "section_id": "8b6b4a35-b692-4b20-814b-062cbd5f4e9a", "outcome_text": "The primary endpoint was the annual rate of decline in FVC (in mL) over 52 weeks.", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "OUTCOME_FROM_TRIAL": [{"@id": "urn:kg:ofev:clinicaltrial:ofev:nct02999178"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:8b6b4a35-b692-4b20-814b-062cbd5f4e9a"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:respiratoryoutcome:7a66ed23-733e-4b09-96f1-5519c32ef66c", "@type": "RespiratoryOutcome", "graphScope": "brand", "source_page": 26, "source_document_type": "prescribing_information", "section_id": "7a66ed23-733e-4b09-96f1-5519c32ef66c", "outcome_text": "The primary endpoint was the annual rate of decline in FVC over 52 weeks.", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "OUTCOME_FROM_TRIAL": [{"@id": "urn:kg:ofev:clinicaltrial:ofev:nct02597933"}], "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:7a66ed23-733e-4b09-96f1-5519c32ef66c"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:4b94816f-7f4c-49e2-8d03-0f6130b243f8", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 12, "source_document_type": "prescribing_information", "section_id": "4b94816f-7f4c-49e2-8d03-0f6130b243f8", "statement_text": "Pregnancy Testing", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:4b94816f-7f4c-49e2-8d03-0f6130b243f8"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:cb34e383-a4e4-405d-9df0-348aeeed7701", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 3, "source_document_type": "product_information", "section_id": "cb34e383-a4e4-405d-9df0-348aeeed7701", "statement_text": "Based on the disease characteristics and how the medicine works, the medicine's effectiveness for treating clinically significant progressive fibrosing ILD and systemic sclerosis-associated ILD in children is expected to be similar as in adults. However, long-term safety data for", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:cb34e383-a4e4-405d-9df0-348aeeed7701"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:safety:dc466117-741b-4411-a8c6-0893e6dd88bc", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 3, "source_document_type": "product_information", "section_id": "dc466117-741b-4411-a8c6-0893e6dd88bc", "statement_text": "What measures are being taken to ensure the safe and effective use of Ofev?", "source_file_name": "ofev-epar-medicines-overview_en.pdf", "source_document_id": "dcf1cfdd-57dc-4936-b9b2-0839e9684cb2", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:dc466117-741b-4411-a8c6-0893e6dd88bc"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:dcf1cfdd-57dc-4936-b9b2-0839e9684cb2"}]}, {"@id": "urn:kg:ofev:safety:6e058b55-c461-46b2-b07a-9d99ebc88ec7", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "6e058b55-c461-46b2-b07a-9d99ebc88ec7", "statement_text": "----------------------DOSAGE AND ADMINISTRATION-----------------------", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:6e058b55-c461-46b2-b07a-9d99ebc88ec7"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:fc8653d0-43b8-40b5-a2e3-796578bedd9b", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "fc8653d0-43b8-40b5-a2e3-796578bedd9b", "statement_text": "---------------------DOSAGE FORMS AND STRENGTHS----------------------", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:fc8653d0-43b8-40b5-a2e3-796578bedd9b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:688df660-1573-4aa4-9374-bac703e0b348", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "688df660-1573-4aa4-9374-bac703e0b348", "stateme