                                                                                                                                                                                                                                                                                      |                                                                           |"}, {"@id": "urn:kg:ofev:chunk:5cadefc8-b864-4a56-87bd-a06ce81ca3f6", "@type": "Chunk", "graphScope": "brand", "chunk_index": 46, "token_count": 140, "page_number": 3, "source_document_type": "brand_book", "section_id": "c05a1067-a6ed-419e-8515-560c23e70d54", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "9e3d73e13f32cd41097a10cdee6b1f3776f79ae3c90ba09d23ebc205f28faf19", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "5cadefc8-b864-4a56-87bd-a06ce81ca3f6", "text": "|                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           | 3.8 |\n|"}, {"@id": "urn:kg:ofev:chunk:526242ad-f293-4924-8dda-cea4299555e2", "@type": "Chunk", "graphScope": "brand", "chunk_index": 47, "token_count": 158, "page_number": 3, "source_document_type": "brand_book", "section_id": "c05a1067-a6ed-419e-8515-560c23e70d54", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "8277709c90e8ea730505e285b1d97fe6bd2a9c9935b94059f41aa1a47eb36f19", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "526242ad-f293-4924-8dda-cea4299555e2", "text": "| System                                                                       |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |"}, {"@id": "urn:kg:ofev:chunk:29c70d94-0fed-48ca-87b3-008266123f84", "@type": "Chunk", "graphScope": "brand", "chunk_index": 48, "token_count": 140, "page_number": 3, "source_document_type": "brand_book", "section_id": "c05a1067-a6ed-419e-8515-560c23e70d54", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "2383f8d068d6c04a230b1b7c4ce4839b51d4026d0caef0cf8be4389167476313", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "29c70d94-0fed-48ca-87b3-008266123f84", "text": "|                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |     |"}, {"@id": "urn:kg:ofev:chunk:4ad177ec-92b0-4b0c-99ab-23fe537a54f0", "@type": "Chunk", "graphScope": "brand", "chunk_index": 49, "token_count": 46, "page_number": 4, "source_document_type": "brand_book", "section_id": "d9661045-25ca-4487-a872-14134686ea50", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "bb267a14c422fe6c801e07376833f5f5a78fddd8dc31e814f36dc45d2bb3ebb2", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "4ad177ec-92b0-4b0c-99ab-23fe537a54f0", "text": "This section presents the brand's unique position in the market, the distinctive promise the brand makes its audiences, and the personality and behavior that define the brand experience."}, {"@id": "urn:kg:ofev:chunk:33378074-7632-434f-a65b-57476f2c8b00", "@type": "Chunk", "graphScope": "brand", "chunk_index": 50, "token_count": 1, "page_number": 5, "source_document_type": "brand_book", "section_id": "24b93411-2855-48bc-804a-d92942a12c4b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "b05e244762b1e472be89a93800cc3ee326743cecb55984bf12813addb8de66d0", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "33378074-7632-434f-a65b-57476f2c8b00", "text": "1.1"}, {"@id": "urn:kg:ofev:chunk:716e2347-b0fb-4e2d-bc11-b4dbeb20a608", "@type": "Chunk", "graphScope": "brand", "chunk_index": 51, "token_count": 55, "page_number": 5, "source_document_type": "brand_book", "section_id": "d98ea450-71ce-499d-b637-423fe513a69a", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "e098ce5d6158b296803fa2c9897e069b54018b76fd44722079fb78b47c200bbc", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "716e2347-b0fb-4e2d-bc11-b4dbeb20a608", "text": "Nintedanib is a tyrosine kinase inhibitor that targets pathways involved in fibrosis.\n\nOFEV ® slows IPF disease progression so that the physician's role is restored and patients can live tomorrow like they did yesterday."}, {"@id": "urn:kg:ofev:chunk:107ef703-aff0-4c3e-a151-9bd27986977b", "@type": "Chunk", "graphScope": "brand", "chunk_index": 52, "token_count": 1, "page_number": 6, "source_document_type": "brand_book", "section_id": "b5c9dab8-6614-42cb-ae99-8081ddbf6965", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "77ac319bfe1979e2d799d9e6987e65feb54f61511c03552ebae990826c208590", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "107ef703-aff0-4c3e-a151-9bd27986977b", "text": "1.2"}, {"@id": "urn:kg:ofev:chunk:6f340619-ed8b-423b-8cc1-afe8bf76a7a8", "@type": "Chunk", "graphScope": "brand", "chunk_index": 53, "token_count": 71, "page_number": 6, "source_document_type": "brand_book", "section_id": "456e0f85-2637-47da-9144-582b50c2628b", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "0523dea8d8b8ef45f26d92645b3018abdcd76da496ab62595d96b20ff212ebcd", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "6f340619-ed8b-423b-8cc1-afe8bf76a7a8", "text": "OFEV ® slows disease progression in a broad range of IPF patient types with a 50% reduction in the decline of lung function OFEV ® reduces adjudicated acute exacerbations by 68%\n\nSide effects can be effectively managed in most patients Only 1 capsule twice a day ensures ease of dosing"}, {"@id": "urn:kg:ofev:chunk:8650f2e1-6dce-4550-9768-7ac8a8bbfe12", "@type": "Chunk", "graphScope": "brand", "chunk_index": 54, "token_count": 68, "page_number": 7, "source_document_type": "brand_book", "section_id": "5662eb42-d69c-4afe-a7e4-0d9a371ccb41", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "b8e8edcb7572e7bde7bf5b89105478d4180dfb615d821a6921c53f6b11a2dda8", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "8650f2e1-6dce-4550-9768-7ac8a8bbfe12", "text": "Our brand positioning, an internal strategic statement, is the foundation of all branded communications. It shows how we want OFEV ®  to be perceived in the minds of customers, and it is essential that brand positioning be reflected in all our branded marketing efforts."}, {"@id": "urn:kg:ofev:chunk:9124e088-3eec-4b99-9ca6-fcac4a8e926f", "@type": "Chunk", "graphScope": "brand", "chunk_index": 55, "token_count": 116, "page_number": 7, "source_document_type": "brand_book", "section_id": "3e128188-269d-498c-a537-2a7ef88f114d", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "67628c746d379468396995519e6923a10ad4838ce743347211a5f74e0af627f9", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "9124e088-3eec-4b99-9ca6-fcac4a8e926f", "text": "iPF is devastating and unpredictable. Physicians are powerless, and patients live in fear.\n\nthe progressive loss of lung function erodes life and results in death by suffocation within 2-3 years of diagnosis.\n\nWhile most patients experience gradually declining lung function, some also experience precipitous, commonly fatal drops known as acute exacerbations. these come without warning or known cause, and have a direct effect on accelerating disease progression."}, {"@id": "urn:kg:ofev:chunk:5c99cedd-14cc-4f27-812d-465cddb1b161", "@type": "Chunk", "graphScope": "brand", "chunk_index": 56, "token_count": 257, "page_number": 7, "source_document_type": "brand_book", "section_id": "483a5465-a6a0-488a-a324-ea05be19c8f7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "961e35fd5faa6f05a1128bbe78e2b3ddc828338589f854611b8abd3124ded659", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "5c99cedd-14cc-4f27-812d-465cddb1b161", "text": "| For those feeling helpless when facing the devastating diagnosis and unpredictable progression of iPF                                          |\n|------------------------------------------------------------------------------------------------------------------------------------------------|\n| oFEV ®                                                                                                                                         |\n| is a breakthrough therapy that delivers what it promises                                                                                       |\n| that slows disease progression in all iPF patient types by reliably reducing FVc decline and exacerbations with a convenient dosing regimen    |\n| unlike the complexity and uncertainties of pirfenidone and other therapies                                                                     |\n| So that physicians are confident to initiate treatment immediately after diagnosis, enabling patients to live tomorrow like they did yesterday |"}, {"@id": "urn:kg:ofev:chunk:b77ef460-eacb-4ba6-8915-3f073e3b1c99", "@type": "Chunk", "graphScope": "brand", "chunk_index": 57, "token_count": 68, "page_number": 8, "source_document_type": "brand_book", "section_id": "25116737-9f83-4ca0-b1b7-1e0ad434dbe4", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "4ebf07ee16804495a69ce905ba4482d92e202c24ae81bcd86d288f48d94fd08d", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "b77ef460-eacb-4ba6-8915-3f073e3b1c99", "text": "Our brand personality encompasses the memorable persona our brand presents to the world and how we are perceived by our audiences. It includes how our brand looks, acts, and sounds, in human terms.\n\nTogether, the following traits define the brand personality of OFEV ® ."}, {"@id": "urn:kg:ofev:chunk:49937b56-88fc-40e9-b683-a6242e253768", "@type": "Chunk", "graphScope": "brand", "chunk_index": 58, "token_count": 51, "page_number": 8, "source_document_type": "brand_book", "section_id": "ee69b436-8a02-483a-9019-ad1801339b74", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "7cd4c5d19489d9255c64e605f38cb68052d231ba01e67f7755567c322d2950bc", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "49937b56-88fc-40e9-b683-a6242e253768", "text": "Even when the others turn in or give up, i remain vigilant and proactively guard against potential pitfalls. Knowing that i stay on watch gives others strength through security and comfort.\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:98839e2d-54ba-4ae9-aeca-9cf7d355dbc0", "@type": "Chunk", "graphScope": "brand", "chunk_index": 59, "token_count": 51, "page_number": 8, "source_document_type": "brand_book", "section_id": "e5cadae2-cd95-46af-b348-57c0370a76b2", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "a2249e5ab0ea9d0031a1de3a790bc79832b6099dea4cc2caeb0912f29e1d30e8", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "98839e2d-54ba-4ae9-aeca-9cf7d355dbc0", "text": "+\n\ni believe the best partnerships are those that are sustainable. to foster these long-term relationships, i build trust by remaining transparent and behaving with unwavering consistency.\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:7f9fcc2a-56f4-4b36-a7c6-f0b9dbb4f7f6", "@type": "Chunk", "graphScope": "brand", "chunk_index": 60, "token_count": 48, "page_number": 8, "source_document_type": "brand_book", "section_id": "2111349c-59d3-4c26-ad62-972f50ad18c1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "dee50944a4d45ce5e9a73fa50fe86bc26e71e58ce560a293dc45bcff64dee442", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "7f9fcc2a-56f4-4b36-a7c6-f0b9dbb4f7f6", "text": "+\n\nMy intelligence, confidence, and the pride i take in my work allow me to regularly achieve success. By becoming the gold standard, i inevitably raise the bar higher for all.\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:f14dffeb-f09c-48e4-b328-f2e9c8add6f2", "@type": "Chunk", "graphScope": "brand", "chunk_index": 61, "token_count": 54, "page_number": 8, "source_document_type": "brand_book", "section_id": "831bc60a-71f8-4171-94fb-890256a055fa", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "da3ba8546bd3c7a11dbdc13faffd5c7daf5ead1905ae76055ba03a0c5b4efb15", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "f14dffeb-f09c-48e4-b328-f2e9c8add6f2", "text": "+\n\ni do more than deliver hope; i give others a real reason to believe in me. By inspiring them to take action in a way they didn't believe they could, i permanently shift the paradigm.\n\n<!-- image -->\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:058015bb-74f6-441c-a1fc-1b05ad58677a", "@type": "Chunk", "graphScope": "brand", "chunk_index": 62, "token_count": 50, "page_number": 8, "source_document_type": "brand_book", "section_id": "fee7a829-3d89-4e8e-bb41-bbbef50260d8", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "cef8ca7bac29da0121e4ca3730a596897ec614efa260b097157f1efddf774251", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "058015bb-74f6-441c-a1fc-1b05ad58677a", "text": "=\n\ni am an essential and stabilizing force for everyone i touch. By always being protective, reliable, high-performing, and encouraging, i provide the vital foundation others need to achieve their best."}, {"@id": "urn:kg:ofev:chunk:fbb64338-3a7f-4127-8f7e-568826261c69", "@type": "Chunk", "graphScope": "brand", "chunk_index": 63, "token_count": 4, "page_number": 9, "source_document_type": "brand_book", "section_id": "235a46e9-9ff0-4617-af28-670c8536daaa", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "f9a5d5a9fffdb1bab5779728db556b2809832250c5f2cf63e8c476b9376e9870", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "fbb64338-3a7f-4127-8f7e-568826261c69", "text": "1.5 Color Palette"}, {"@id": "urn:kg:ofev:chunk:53908489-1341-4005-b1d0-88ff9da9c2db", "@type": "Chunk", "graphScope": "brand", "chunk_index": 64, "token_count": 10, "page_number": 9, "source_document_type": "brand_book", "section_id": "8eb562d9-f82d-43d0-a542-f1c21a964c62", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "1b547b055d17d32ad196fe144e07707665c50d917ec080435e187e033f36b147", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "53908489-1341-4005-b1d0-88ff9da9c2db", "text": "coLor PALEttE oVErViEW\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:7e9163a3-1bf1-411f-af8f-c549695f92dd", "@type": "Chunk", "graphScope": "brand", "chunk_index": 65, "token_count": 99, "page_number": 10, "source_document_type": "brand_book", "section_id": "3dbd4263-7db7-437f-a6c4-412c6c8916d0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "3b522c1d51b9488d641abc8ac89ae9566f89dc76043ee2aead6c70d7e4c3d8c7", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "7e9163a3-1bf1-411f-af8f-c549695f92dd", "text": "Brand identity assets are the tools that we use to define and communicate a brand's unique characteristics. They include visual elements such as a logo, color, and type, as well as verbal and behavioral elements such as tone of voice, style, and manner. The OFEV ® brand identity assets have been carefully developed to work together to create a bold, charismatic, and memorable visual impression."}, {"@id": "urn:kg:ofev:chunk:e0f6aea7-130d-4083-9fe3-50223fa0d459", "@type": "Chunk", "graphScope": "brand", "chunk_index": 66, "token_count": 191, "page_number": 11, "source_document_type": "brand_book", "section_id": "74ba7b62-d92b-4327-9ba4-7052c1b100ec", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "a1abcded853a6b69e71affe0d1faf7dfb8d09d5f7b1418b4ffb7f42e24bd4fec", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "e0f6aea7-130d-4083-9fe3-50223fa0d459", "text": "The OFEV ®  logo consists of 3 elements: the logotype, the symbol, and the generic name. The symbol depicts wings in motion that dependably guard patients. The symbol is inspiring and representational of high performance because of its forward motion. The use of dark blue and all caps in the logotype communicate reliability and vigilance.\n\nThe logo should never be changed in any way to keep the personality consistent worldwide.\n\nuS LoGo\n\n<!-- image -->\n\nSome markets have regulations about the size relationship between the brand and generic names. the united States, for which the oFEV ®  logo is illustrated here, has very speciffc rules regarding that relationship. Please use the assets that have been provided and approved for your region.\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:7dbf2957-c600-41fa-b0d3-1718a868a054", "@type": "Chunk", "graphScope": "brand", "chunk_index": 67, "token_count": 80, "page_number": 12, "source_document_type": "brand_book", "section_id": "38b8e81a-af41-4c3a-9e9d-3ca01edcf351", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "60c72e8a9043dc5d2f8a2c353cb9fca286b1cf740583be3592244b23309d1338", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "7dbf2957-c600-41fa-b0d3-1718a868a054", "text": "The VARGATEF ®  logo is provided for countries that will launch nintedanib under the brand name VARGATEF ®  for both the IPF and lung cancer indications. These countries are required to use the same brand name for both indications; therefore, use of the brand name OFEV ® is not permitted.\n\nGLoBAL LoGo\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:43f8e335-4704-402b-a2e9-db53003e4474", "@type": "Chunk", "graphScope": "brand", "chunk_index": 68, "token_count": 147, "page_number": 13, "source_document_type": "brand_book", "section_id": "65d2c824-63a6-469e-be0b-db9f6a41096c", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "c567836099ee529efd4bc9e996d363432e6bf76a09219e39467736d075fa3d9e", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "43f8e335-4704-402b-a2e9-db53003e4474", "text": "Clear space is the specified area of empty space surrounding our brandmark. Its use allows us to maintain our brandmark's visual integrity and impact. The 'O' height in 'OFEV ® ' scaled down to 75% of its original size represents 1x. A minimum clear space of 1x should be maintained around the entire mark at all times.\n\nThe minimum size of the OFEV ® brandmark is 7/8' (22 mm, 125 pixels) in width. To maintain legibility, the brandmark should never be smaller than this.\n\n<!-- image -->\n\ncLEAr SPAcE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->\n\nPrint: 7/8' (22 mm) diGitAL: 125 PixELS"}, {"@id": "urn:kg:ofev:chunk:22ae2e6b-2a62-4ce9-a8b6-41363b400154", "@type": "Chunk", "graphScope": "brand", "chunk_index": 69, "token_count": 68, "page_number": 14, "source_document_type": "brand_book", "section_id": "801dcd86-712c-48fb-acf7-fb7260c09039", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "5bacdfa01e660fdc12e8b57c892035696e5691a20a3e5aab0801ba5fa5f19ea2", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "22ae2e6b-2a62-4ce9-a8b6-41363b400154", "text": "A version of our logo with our tagline, [TAGLINE TO COME], is also available for use. This version of our logo should be used in campaign and promotional materials.\n\nuS LoGo WitH tAGLinE\n\n<!-- image -->\n\nGLoBAL LoGo WitH tAGLinE\n\n<!-- image -->\n\nMiniMuM SizE\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:8fcbc796-54f1-404c-bebb-9cd56a4dda89", "@type": "Chunk", "graphScope": "brand", "chunk_index": 70, "token_count": 9, "page_number": 14, "source_document_type": "brand_book", "section_id": "27fc09db-234e-4c56-b413-f2d09375ddf1", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "a2a670183a9da87b702d1d43d13f373bd5a240e61ee5c39baffea55d69bf4ea3", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "8fcbc796-54f1-404c-bebb-9cd56a4dda89", "text": "<!-- image -->\n\n<!-- image -->\n\n= 1Y"}, {"@id": "urn:kg:ofev:chunk:d239ce1e-c463-41aa-8342-7bfa99613f58", "@type": "Chunk", "graphScope": "brand", "chunk_index": 71, "token_count": 1, "page_number": 15, "source_document_type": "brand_book", "section_id": "8c3fb4dd-f869-4916-8107-a8c5fb3744c0", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "b8736b999909049671d0ea075a42b308a5fbe2df1854899123fe09eb0ee9de61", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "d239ce1e-c463-41aa-8342-7bfa99613f58", "text": "2.5"}, {"@id": "urn:kg:ofev:chunk:f8e7a59e-0afa-48b3-b790-0ac66d58e4dc", "@type": "Chunk", "graphScope": "brand", "chunk_index": 72, "token_count": 82, "page_number": 15, "source_document_type": "brand_book", "section_id": "1c400ae5-86da-4278-91b8-f9361af515bb", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "03f8e0a3372430f2c46fb912b3b12f27d8039836f19c5bc1cc61d26291c69908", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "f8e7a59e-0afa-48b3-b790-0ac66d58e4dc", "text": "A version of the VARGATEF ®  logo with the tagline, [TAGLINE TO COME], is also available. This version should be used in countries that must launch with the same brand name for both the IPF and lung cancer indications and, therefore, cannot use the brand name OFEV ® .\n\nGLoBAL LoGo WitH tAGLinE\n\n<!-- image -->\n\n[taglIne to come]"}, {"@id": "urn:kg:ofev:chunk:8268c91f-206e-4241-87ff-62ed2b16ffc5", "@type": "Chunk", "graphScope": "brand", "chunk_index": 73, "token_count": 1, "page_number": 16, "source_document_type": "brand_book", "section_id": "03eb814d-b01a-4c18-9d64-0678e2e079db", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "af3266e6d0f3bba206c2e954c21ff72182e440557702a3f79f4c6bdfb577fed5", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "8268c91f-206e-4241-87ff-62ed2b16ffc5", "text": "2.6"}, {"@id": "urn:kg:ofev:chunk:2cbdaba4-2e9b-4a28-873e-426accb5aad5", "@type": "Chunk", "graphScope": "brand", "chunk_index": 74, "token_count": 157, "page_number": 16, "source_document_type": "brand_book", "section_id": "eb34159f-a331-4242-be7d-f06e60c9aec5", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "b29570b3f2c013223970a1fa4eebe3b63c6eec35f1e38395934f7ddcd36f6fc5", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "2cbdaba4-2e9b-4a28-873e-426accb5aad5", "text": "The preferred use of the OFEV ® logo is the CMYK version on a white background.\n\nThe CMYK and PMS logos are used when printing communication pieces. When printing in black and white, use the grayscale version of the logo. The RGB version of the logo should be used in digital applications, such as interfaces, websites, and PowerPoint presentations.\n\ncMYK\n\n(PrEFErrEd For ALL PrintEd coMMunicAtionS)\n\n<!-- image -->\n\n3 PMS (uSEd WHEn SPot coLor PrintinG iS tHE onLY oPtion AVAiLABLE)\n\n<!-- image -->\n\nrGB\n\n(uSEd For diGitAL APPLicAtionS)\n\n<!-- image -->\n\nGrAYScALE (uSEd WHEn FuLL-coLor PrintinG iS not AVAiLABLE)\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:c5c970c5-d1dc-430b-aa43-f8f1d3dcb5bf", "@type": "Chunk", "graphScope": "brand", "chunk_index": 75, "token_count": 136, "page_number": 17, "source_document_type": "brand_book", "section_id": "7817974b-70c2-4470-84fe-2c20a81af5b7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "c069086535420b6189b1a7a8d551dc438157b24d38a34969de4028a2c511c805", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "c5c970c5-d1dc-430b-aa43-f8f1d3dcb5bf", "text": "It can be easy to misuse our logo when implementing across marketing materials.\n\nFor your reference, here are some ways our logo should not be used.\n\n<!-- image -->\n\n<!-- image -->\n\n<!-- image -->\n\ndo not rotAtE tHE LoGo\n\n<!-- image -->\n\ndo not iLLuStrAtE tHE LoGo\n\n<!-- image -->\n\n<!-- image -->\n\ndo not Add droP SHAdoWS to tHE LoGo\n\n<!-- image -->\n\ndo not uSE tHE LoGo in coPY\n\ndo not ModiFY or rEcrEAtE tHE LoGotYPE\n\n<!-- image -->\n\n<!-- image -->\n\ndo not PLAcE tHE LoGo on BAcKGroundS tHAt do not ProVidE SuFFiciEnt contrASt\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:6ad8cafd-656e-48ff-b1bd-e58a74fe5500", "@type": "Chunk", "graphScope": "brand", "chunk_index": 76, "token_count": 2, "page_number": 18, "source_document_type": "brand_book", "section_id": "637f2ab6-00bf-479d-9266-b7d939745837", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "0f0bb32a9857246e93370c04e9a6c828df48ae3798ed2a92944c4f65bbb407c6", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "6ad8cafd-656e-48ff-b1bd-e58a74fe5500", "text": "8\n\n.\n\n2"}, {"@id": "urn:kg:ofev:chunk:223ed3a9-302c-4e86-ae1a-94e67801baad", "@type": "Chunk", "graphScope": "brand", "chunk_index": 77, "token_count": 108, "page_number": 18, "source_document_type": "brand_book", "section_id": "566084cf-6fd5-494b-87b2-c5bd95e93cef", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "b6e45fb430c3bd4ccdecfed36f8807aea476cf395f344a0f0ab5c274b90daab0", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "223ed3a9-302c-4e86-ae1a-94e67801baad", "text": "Typography is another important element of our brand identity and a way to express our personality. The OFEV ®  primary fonts are Co Text Bold and Co Text Light. Co Text complements the visual elements seen in the OFEV ®  symbol and is also the font that the OFEV ®  logotype is based on. The OFEV ®  secondary font, used for body copy, is the Gotham Family, including Gotham Book, Gotham Bold, and Gotham Italic.\n\n<!-- image -->\n\naa"}, {"@id": "urn:kg:ofev:chunk:ba94355c-92e1-4c5c-9493-b7496e521d65", "@type": "Chunk", "graphScope": "brand", "chunk_index": 78, "token_count": 24, "page_number": 18, "source_document_type": "brand_book", "section_id": "a92bc9ec-5a1e-4db5-ac8c-cf0c815f43a7", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "7c38a3be2346e8f9f15a10be500e30f1b486cb29aa4cc010f26f54e7142471b6", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "ba94355c-92e1-4c5c-9493-b7496e521d65", "text": "Body copy should be Gotham Book sentence case in 80%K. Body call-outs should be in Gotham Bold."}, {"@id": "urn:kg:ofev:chunk:e6a7b8d0-68e9-4af2-82d2-5efcf95e99b0", "@type": "Chunk", "graphScope": "brand", "chunk_index": 79, "token_count": 206, "page_number": 19, "source_document_type": "brand_book", "section_id": "5d73ab60-4648-4da2-9902-581f07f9629f", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "73e5713cc2c77bf351100ff40dbf8951b308ef537bbb4c787d7332836abd5e75", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "e6a7b8d0-68e9-4af2-82d2-5efcf95e99b0", "text": "The OFEV ®  colors were selected to reinforce our brand identity and to differentiate our brand from competitors. They should be used to help maintain brand recognition and impact. The OFEV ®  core brand color is Guardian Blue, and it should be the most prominent color in the palette. In addition, Guardian Blue is the only color that should be used with the line pattern.\n\nThe three secondary colors, Inspiring Yellow, Brilliant Gold, and Premium Orange, reflect the colors used in the OFEV ®  gradient. Premium Orange may be used for highlights in applications as well as in typographical call-outs and subheads.\n\nComfort Gray is included as a neutral tertiary color that helps balance the palette. Comfort Gray can be used in clinical and scientific situations, such as in charts or to represent placebo.\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:c9970eeb-0fa3-4ca6-82f8-15f9ff4f9b86", "@type": "Chunk", "graphScope": "brand", "chunk_index": 80, "token_count": 193, "page_number": 20, "source_document_type": "brand_book", "section_id": "b6c67302-a0f0-4c66-aa02-059141f00da2", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "9b42315fdaabaf57a1986647c176f584da61b7dc46056f038bf469c896af155c", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "c9970eeb-0fa3-4ca6-82f8-15f9ff4f9b86", "text": "A secondary graphic is a brand element that symbolizes our personality and unifies our brand across all communications. Our secondary graphic is a combination of two geometric shapes: the Guardian Blue shape that appears on the bottom of the page, and the golden gradient shape that appears on the top of the page. Together, these two shapes create a space that represents the change OFEV ®  is creating in the path of IPF.\n\nThe two shapes that make up our secondary graphic should appear together on every communication piece. The Guardian Blue shape should never appear on a page without the golden gradient shape and vice versa.\n\nOur secondary graphic has been provided in both a vertical and a horizontal format for flexibility of use (see next page).\n\n<!-- image -->"}, {"@id": "urn:kg:ofev:chunk:d9c7ad31-7c80-42c2-a1f2-6479152cbe29", "@type": "Chunk", "graphScope": "brand", "chunk_index": 81, "token_count": 126, "page_number": 21, "source_document_type": "brand_book", "section_id": "e3f4c465-5528-4fc3-b8f6-39435ba74bce", "extraction_method": "docling", "source_file_name": "OFEV_Brand-Book_Nov-2015.pdf", "source_hash": "c0f62039511fc6fe21c358454637d0e2c40d5d9a5c20462d6980e98304e2d05b", "source_document_id": "7c99d579-1450-4667-9bc5-7d13421ddab2", "chunk_id": "d9c7ad31-7c80-42c2-a1f2-6479152cbe29", "text": "Our secondary graphic has been designed to accommodate a variety of layouts and content. The shapes can be scaled up and down, adding flexibility to the system and allowing for different configurations of the shapes to provide a variety of layout options with a consistent look.\n\nThe Guardian Blue shape should always be dominant and the golden gradient shape should be used as an accent. The golden gradient shape should not take up more than 15% of the page.\n\n<!-- image -->\n\noFEV\\_HorizontAL\\_cMYK.Ai"}, {"@id": "urn:kg:ofev:clinicaltrial:ofev:nct00514683", "@type": "ClinicalTrial", "graphScope": "brand", "source_page": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "trial_name": "Study 1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "nct_number": "NCT00514683", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a34f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:clinicaltrial:ofev:nct01335464", "@type": "ClinicalTrial", "graphScope": "brand", "source_page": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "trial_name": "Study 2", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "nct_number": "NCT01335464", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a34f"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:clinicaltrial:ofev:nct01335477", "@type": "ClinicalTrial", "graphScope": "brand", "source_page": 17, "source_document_type": "prescribing_information", "section_id": "ebb892d5-08b1-49bf-b307-e908ca83a34f", "trial_name": "Study 3", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "nct_number": "NCT01335477", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ebb892d5-08b1-49bf-b307-e908ca83a