                                                                                                                               |     |\n| 3.6                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                              |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                           |                                                                                                                                                                       