nt:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:ac3e7b53-7690-46bf-9423-402e000c9740", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 8, "source_document_type": "prescribing_information", "section_id": "ac3e7b53-7690-46bf-9423-402e000c9740", "statement_text": "The most frequent serious adverse reactions reported in patients treated with OFEV, more than placebo, were bronchitis (1.2% vs. 0.8%) and myocardial infarction (1.5% vs. 0.4%). The most common adverse events leading to death in patients treated with OFEV, more than placebo, were", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ac3e7b53-7690-46bf-9423-402e000c9740"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:037c54d6-db02-4eac-8922-c3877467ae3b", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 9, "source_document_type": "prescribing_information", "section_id": "037c54d6-db02-4eac-8922-c3877467ae3b", "statement_text": "Diarrhea, nausea, vomiting, and abdominal pain (includes upper abdominal pain, abdominal discomfort, and abdominal pain) were the most frequent adverse events reported in 20 (38%) versus 16 (31%), in 22 (42%) versus 6 (12%), in 15 (28%) versus 6 (12%), and in 15 (28%) versus 7 (1", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:037c54d6-db02-4eac-8922-c3877467ae3b"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:16b697b1-2d28-41a6-9698-b87c9099fcec", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 11, "source_document_type": "prescribing_information", "section_id": "16b697b1-2d28-41a6-9698-b87c9099fcec", "statement_text": "7.2  Anticoagulants", "sourc