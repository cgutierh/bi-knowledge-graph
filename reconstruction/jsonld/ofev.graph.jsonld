": "urn:kg:ofev:section:7c7c699f-44b8-4a6a-a888-0055e70596e1"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:ea96f293-17db-4474-acdf-8214f7d8372e", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 1, "source_document_type": "prescribing_information", "section_id": "ea96f293-17db-4474-acdf-8214f7d8372e", "statement_text": "6  ADVERSE REACTIONS", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:ea96f293-17db-4474-acdf-8214f7d8372e"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:a80139d2-f611-4453-b99b-71578451a7bb", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "a80139d2-f611-4453-b99b-71578451a7bb", "statement_text": "2.1  Testing Prior to OFEV Administration", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:a80139d2-f611-4453-b99b-71578451a7bb"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:94bba718-8cea-42f5-97db-22fe4c153ff5", "@type": "SafetyStatement", "graphScope": "brand", "page_number": 3, "source_document_type": "prescribing_information", "section_id": "94bba718-8cea-42f5-97db-22fe4c153ff5", "statement_text": "Moderate or Severe Hepatic Impairment", "source_file_name": "OFEV_PI.pdf", "source_document_id": "c0db5dd8-583e-47bb-9b75-58402a32791c", "DERIVED_FROM_SECTION": [{"@id": "urn:kg:ofev:section:94bba718-8cea-42f5-97db-22fe4c153ff5"}], "DERIVED_FROM_DOCUMENT": [{"@id": "urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c"}]}, {"@id": "urn:kg:ofev:safety:639d3847-3a89-4e25-9c7a-0e8315d88faf", "@type": "Saf