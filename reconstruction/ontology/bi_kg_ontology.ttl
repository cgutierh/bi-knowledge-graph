@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kg: <urn:kg:vocab:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:BRAND_HAS_COMPLIANCE_RULE a owl:ObjectProperty ;
    rdfs:label "BRAND_HAS_COMPLIANCE_RULE"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:ComplianceRule ;
    skos:definition "A brand has a compliance rule (brand-specific governance)."@en ;
    skos:scopeNote "The corporate brand is governed by a responsible-AI compliance rule."@en .

kg:BRAND_HAS_DOCUMENT a owl:ObjectProperty ;
    rdfs:label "BRAND_HAS_DOCUMENT"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:Document ;
    skos:definition "A brand's uploaded source documents."@en .

kg:BRAND_HAS_PRODUCT a owl:ObjectProperty ;
    rdfs:label "BRAND_HAS_PRODUCT"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:Product ;
    skos:definition "A brand has one or more products."@en .

kg:BRAND_HAS_TONE_RULE a owl:ObjectProperty ;
    rdfs:label "BRAND_HAS_TONE_RULE"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:ToneRule ;
    skos:definition "A brand has tone rules."@en .

kg:BRAND_HAS_VISUAL_RULE a owl:ObjectProperty ;
    rdfs:label "BRAND_HAS_VISUAL_RULE"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:VisualRule ;
    skos:definition "A brand has visual rules."@en .

kg:BRAND_TARGETS_MARKET a owl:ObjectProperty ;
    rdfs:label "BRAND_TARGETS_MARKET"@en ;
    rdfs:domain kg:Brand ;
    rdfs:range kg:Market ;
    skos:definition "A brand targets (is commercialized in) a market."@en .

kg:CLAIM_APPLIES_TO_AUDIENCE a owl:ObjectProperty ;
    rdfs:label "CLAIM_APPLIES_TO_AUDIENCE"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:Audience ;
    skos:definition "A claim applies to an audience."@en .

kg:CLAIM_DERIVED_FROM_DOCUMENT a owl:ObjectProperty ;
    rdfs:label "CLAIM_DERIVED_FROM_DOCUMENT"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:Document ;
    rdfs:subPropertyOf kg:DERIVED_FROM_DOCUMENT ;
    skos:definition "A claim is derived from a source document."@en .

kg:CLAIM_FROM_TRIAL a owl:ObjectProperty ;
    rdfs:label "CLAIM_FROM_TRIAL"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:ClinicalTrial ;
    skos:definition "A claim is substantiated by a clinical trial."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance>,
        <urn:kg:vocab:overlay/ofev> .

kg:CLAIM_REPORTS_OUTCOME a owl:ObjectProperty ;
    rdfs:label "CLAIM_REPORTS_OUTCOME"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:ClinicalOutcome ;
    skos:definition "A claim reports a cardiovascular outcome."@en ;
    skos:scopeNote "A claim reports a respiratory outcome."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance>,
        <urn:kg:vocab:overlay/ofev> .

kg:CLAIM_REPORTS_RENAL_OUTCOME a owl:ObjectProperty ;
    rdfs:label "CLAIM_REPORTS_RENAL_OUTCOME"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:RenalOutcome ;
    skos:definition "A claim reports a renal outcome."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance> .

kg:CLAIM_REQUIRES_SAFETY a owl:ObjectProperty ;
    rdfs:label "CLAIM_REQUIRES_SAFETY"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:SafetyStatement ;
    skos:definition "A claim requires accompanying safety information."@en .

kg:CLAIM_SUPPORTED_BY_REFERENCE a owl:ObjectProperty ;
    rdfs:label "CLAIM_SUPPORTED_BY_REFERENCE"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:Reference ;
    skos:definition "A claim is supported by a reference."@en .

kg:CLAIM_VALID_FOR_CHANNEL a owl:ObjectProperty ;
    rdfs:label "CLAIM_VALID_FOR_CHANNEL"@en ;
    rdfs:domain kg:Claim ;
    rdfs:range kg:Channel ;
    skos:definition "A claim is valid for a channel."@en .

kg:COMPLIANCE_RULE_APPLIES_TO_ASSET_TYPE a owl:ObjectProperty ;
    rdfs:label "COMPLIANCE_RULE_APPLIES_TO_ASSET_TYPE"@en ;
    rdfs:domain kg:ComplianceRule ;
    rdfs:range kg:AssetType ;
    skos:definition "A compliance rule applies to an asset type."@en .

kg:COMPLIANCE_RULE_DERIVED_FROM_FRAMEWORK a owl:ObjectProperty ;
    rdfs:label "COMPLIANCE_RULE_DERIVED_FROM_FRAMEWORK"@en ;
    rdfs:domain kg:ComplianceRule ;
    rdfs:range kg:RegulatoryFramework ;
    skos:definition "A compliance rule is derived from a regulatory framework."@en .

kg:COMPLIANCE_RULE_OVERRIDES a owl:ObjectProperty ;
    rdfs:label "COMPLIANCE_RULE_OVERRIDES"@en ;
    rdfs:domain kg:ComplianceRule ;
    rdfs:range kg:ComplianceRule ;
    skos:definition "A brand-specific compliance rule overrides/extends a shared (e.g. corporate-baseline) compliance rule."@en .

kg:CONTENT_MODULE_CONTAINS_CLAIM a owl:ObjectProperty ;
    rdfs:label "CONTENT_MODULE_CONTAINS_CLAIM"@en ;
    rdfs:domain kg:ContentModule ;
    rdfs:range kg:Claim ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "A content module contains one or more claims."@en .

kg:CardiovascularOutcome a owl:Class ;
    rdfs:label "CardiovascularOutcome"@en ;
    rdfs:subClassOf kg:ClinicalOutcome ;
    skos:definition "A cardiovascular outcome reported for Jardiance (e.g. CV death, hospitalisation for heart failure), measured in a clinical trial."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance> ;
    kg:optionalField "hazard_ratio",
        "p_value",
        "relative_risk_reduction",
        "source_page",
        "trial_name" ;
    kg:requiredField "outcome_text",
        "source_document_id" .

kg:DERIVED_FROM_SECTION a owl:ObjectProperty ;
    rdfs:label "DERIVED_FROM_SECTION"@en ;
    rdfs:domain kg:DomainEntity ;
    rdfs:range kg:Section ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The document section a domain entity was extracted from (from its section_id); the section carries the page number."@en .

kg:DERIVED_FROM_TABLE a owl:ObjectProperty ;
    rdfs:label "DERIVED_FROM_TABLE"@en ;
    rdfs:domain kg:DomainEntity ;
    rdfs:range kg:Table ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The extracted table (e.g. a claims spreadsheet) a domain entity was read from (from its table_id); row_number locates the row."@en .

kg:DOCUMENT_HAS_SECTION a owl:ObjectProperty ;
    rdfs:label "DOCUMENT_HAS_SECTION"@en ;
    rdfs:domain kg:Document ;
    rdfs:range kg:Section ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "A document's segmented sections."@en .

kg:DOCUMENT_HAS_TABLE a owl:ObjectProperty ;
    rdfs:label "DOCUMENT_HAS_TABLE"@en ;
    rdfs:domain kg:Document ;
    rdfs:range kg:Table ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "A document's extracted tables."@en .

kg:GUARDRAIL_RULE_APPLIES_TO_ASSET_TYPE a owl:ObjectProperty ;
    rdfs:label "GUARDRAIL_RULE_APPLIES_TO_ASSET_TYPE"@en ;
    rdfs:domain kg:GuardrailRule ;
    rdfs:range kg:AssetType ;
    skos:definition "A guardrail rule applies to an asset type."@en .

kg:GUARDRAIL_RULE_APPLIES_TO_SERVICE_LINE a owl:ObjectProperty ;
    rdfs:label "GUARDRAIL_RULE_APPLIES_TO_SERVICE_LINE"@en ;
    rdfs:domain kg:GuardrailRule ;
    rdfs:range kg:ServiceLine ;
    skos:definition "A guardrail rule applies to a service line."@en .

kg:ILLUSTRATION_FOLLOWS_VISUAL_RULE a owl:ObjectProperty ;
    rdfs:label "ILLUSTRATION_FOLLOWS_VISUAL_RULE"@en ;
    rdfs:domain kg:SceneIllustration ;
    rdfs:range kg:VisualRule ;
    skos:definition "A scene illustration is governed by a visual rule."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/boehringer-ingelheim> .

kg:ILLUSTRATION_FROM_REFERENCE a owl:ObjectProperty ;
    rdfs:label "ILLUSTRATION_FROM_REFERENCE"@en ;
    rdfs:domain kg:SceneIllustration ;
    rdfs:range kg:ReferenceInput ;
    skos:definition "A scene illustration's character styling was directed by a non-identifying reference input."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/boehringer-ingelheim> .

kg:ILLUSTRATION_HAS_COLOR_VARIANT a owl:ObjectProperty ;
    rdfs:label "ILLUSTRATION_HAS_COLOR_VARIANT"@en ;
    rdfs:domain kg:SceneIllustration ;
    rdfs:range kg:ColorVariant ;
    skos:definition "A scene illustration ships in a predefined colour variant."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/boehringer-ingelheim> .

kg:MARKET_PART_OF_REGION a owl:ObjectProperty ;
    rdfs:label "MARKET_PART_OF_REGION"@en ;
    rdfs:domain kg:Market ;
    rdfs:range kg:Market ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    skos:definition "A market (country) is part of a region (e.g. ASKAN, MIDI, RCV)."@en .

kg:OUTCOME_FROM_TRIAL a owl:ObjectProperty ;
    rdfs:label "OUTCOME_FROM_TRIAL"@en ;
    rdfs:domain kg:ClinicalOutcome ;
    rdfs:range kg:ClinicalTrial ;
    skos:definition "A cardiovascular outcome was measured in a clinical trial."@en ;
    skos:scopeNote "A respiratory outcome was measured in a clinical trial."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance>,
        <urn:kg:vocab:overlay/ofev> .

kg:PI_SECTION_CONTAINS_SAFETY a owl:ObjectProperty ;
    rdfs:label "PI_SECTION_CONTAINS_SAFETY"@en ;
    rdfs:domain kg:PISection ;
    rdfs:range kg:SafetyStatement ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "A PI section contains safety statements."@en .

kg:PRODUCT_HAS_INDICATION a owl:ObjectProperty ;
    rdfs:label "PRODUCT_HAS_INDICATION"@en ;
    rdfs:domain kg:Product ;
    rdfs:range kg:Indication ;
    skos:definition "A product has one or more indications."@en .

kg:Persona a owl:Class ;
    rdfs:label "Persona"@en ;
    rdfs:subClassOf kg:DomainEntity ;
    skos:definition "A specific persona within an audience."@en ;
    kg:optionalField "attributes",
        "audience",
        "description" ;
    kg:requiredField "name" .

kg:QUALITY_CRITERION_APPLIES_TO_SERVICE_LINE a owl:ObjectProperty ;
    rdfs:label "QUALITY_CRITERION_APPLIES_TO_SERVICE_LINE"@en ;
    rdfs:domain kg:QualityCriterion ;
    rdfs:range kg:ServiceLine ;
    skos:definition "A quality criterion is used to evaluate a service line's output."@en .

kg:RENAL_OUTCOME_FROM_TRIAL a owl:ObjectProperty ;
    rdfs:label "RENAL_OUTCOME_FROM_TRIAL"@en ;
    rdfs:domain kg:RenalOutcome ;
    rdfs:range kg:ClinicalTrial ;
    skos:definition "A renal outcome was measured in a clinical trial."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/jardiance> .

kg:RULE_APPLIES_TO_CHANNEL a owl:ObjectProperty ;
    rdfs:label "RULE_APPLIES_TO_CHANNEL"@en ;
    rdfs:domain kg:ComplianceRule ;
    rdfs:range kg:Channel ;
    skos:definition "A rule applies to a channel."@en .

kg:RULE_APPLIES_TO_MARKET a owl:ObjectProperty ;
    rdfs:label "RULE_APPLIES_TO_MARKET"@en ;
    rdfs:domain kg:ComplianceRule ;
    rdfs:range kg:Market ;
    skos:definition "A rule applies to a market."@en .

kg:RespiratoryOutcome a owl:Class ;
    rdfs:label "RespiratoryOutcome"@en ;
    rdfs:subClassOf kg:ClinicalOutcome ;
    skos:definition "A pulmonary outcome reported for OFEV (e.g. annual rate of decline in forced vital capacity [FVC], or acute IPF exacerbations), measured in a trial."@en ;
    kg:declaredInOverlay <urn:kg:vocab:overlay/ofev> ;
    kg:optionalField "confidence_interval",
        "p_value",
        "relative_reduction",
        "source_page",
        "trial_name" ;
    kg:requiredField "outcome_text",
        "source_document_id" .

kg:SECTION_HAS_CHUNK a owl:ObjectProperty ;
    rdfs:label "SECTION_HAS_CHUNK"@en ;
    rdfs:domain kg:Section ;
    rdfs:range kg:Chunk ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "A section's retrievable chunks."@en .

kg:SERVICE_LINE_HAS_ASSET_TYPE a owl:ObjectProperty ;
    rdfs:label "SERVICE_LINE_HAS_ASSET_TYPE"@en ;
    rdfs:domain kg:ServiceLine ;
    rdfs:range kg:AssetType ;
    skos:definition "A service line produces one or more asset types."@en .

