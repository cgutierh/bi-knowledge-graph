    rdfs:range xsd:string .

kg:text a owl:DatatypeProperty ;
    rdfs:label "text"@en ;
    rdfs:range xsd:string .

kg:therapeutic_area a owl:DatatypeProperty ;
    rdfs:label "therapeutic_area"@en ;
    rdfs:range xsd:string .

kg:token_count a owl:DatatypeProperty ;
    rdfs:label "token_count"@en ;
    rdfs:range xsd:integer .

kg:trial_name a owl:DatatypeProperty ;
    rdfs:label "trial_name"@en ;
    rdfs:range xsd:string .

kg:url a owl:DatatypeProperty ;
