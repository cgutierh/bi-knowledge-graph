    rdfs:label "source_document_type"@en ;
    rdfs:range xsd:string .

kg:source_file_name a owl:DatatypeProperty ;
    rdfs:label "source_file_name"@en ;
    rdfs:range xsd:string .

kg:source_hash a owl:DatatypeProperty ;
    rdfs:label "source_hash"@en ;
    rdfs:range xsd:string .

kg:source_page a owl:DatatypeProperty ;
    rdfs:label "source_page"@en ;
    rdfs:range xsd:integer .

kg:source_status a owl:DatatypeProperty ;
    rdfs:label "source_status"@en ;
    rdfs:range xsd:string .

kg:statement_text a owl:DatatypeProperty ;
    rdfs:label "statement_text"@en ;
    rdfs:range xsd:string .

kg:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:range xsd:string .

kg:stroke a owl:DatatypeProperty ;
    rdfs:label "stroke"@en ;
    rdfs:range xsd:string .

kg:subject_type a owl:DatatypeProperty ;
    rdfs:label "subject_type"@en ;
    rdfs:range xsd:string .

kg:table_id a owl:DatatypeProperty ;
    rdfs:label "table_id"@en ;
    rdfs:range xsd:string .

kg:table_index a owl:DatatypeProperty ;
    rdfs:label "table_index"@en ;
    rdfs:range xsd:integer .

kg:technical_mechanism a owl:DatatypeProperty ;
