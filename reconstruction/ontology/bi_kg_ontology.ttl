kg:ontology a owl:Ontology ;
    rdfs:label "BI Knowledge Graph Ontology (reconstructed from JSON export)"@en ;
    dcterms:source "ontology/boehringer-ingelheim.ontology.jsonld",
        "ontology/jardiance.ontology.jsonld",
        "ontology/ofev.ontology.jsonld" ;
    rdfs:comment "OWL/RDFS rendering of the three ontology overlays (boehringer-ingelheim / 'Life Forward', jardiance, ofev). Term IRIs keep the original urn:kg:vocab: namespace so the original JSON-LD data stays compatible."@en ;
    owl:versionInfo "boehringer-ingelheim: generatedAt 2026-09-29T20:24:38.053767+00:00",
        "jardiance: generatedAt 2026-09-29T20:24:31.620301+00:00",
        "ofev: generatedAt 2026-09-29T20:24:43.910719+00:00" ;
    kg:locatorSourceKind "paged: The entity was extracted from a paged document (e.g. a PDF); the locator property is its page number."@en,
        "tabular: The entity was read from an extracted table (it carries table_id, e.g. a claims spreadsheet row); the locator property is its row number."@en .

