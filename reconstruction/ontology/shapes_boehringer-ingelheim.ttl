    sh:targetClass kg:RegulatoryFramework .

<urn:kg:vocab:shape/boehringer-ingelheim/SafetyStatement> a sh:NodeShape ;
    sh:property [ sh:message "SafetyStatement: required field 'statement_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:statement_text ],
        [ sh:message "SafetyStatement: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:SafetyStatement .

<urn:kg:vocab:shape/boehringer-ingelheim/SceneIllustration> a sh:NodeShape ;
    sh:property [ sh:message "SceneIllustration: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
