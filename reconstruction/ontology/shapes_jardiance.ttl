@prefix kg: <urn:kg:vocab:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:kg:vocab:shape/jardiance/AssetType> a sh:NodeShape ;
    sh:property [ sh:message "AssetType: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:AssetType .

<urn:kg:vocab:shape/jardiance/Audience> a sh:NodeShape ;
    sh:property [ sh:message "Audience: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Audience .

<urn:kg:vocab:shape/jardiance/Brand> a sh:NodeShape ;
    sh:property [ sh:message "Brand: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Brand .

<urn:kg:vocab:shape/jardiance/CardiovascularOutcome> a sh:NodeShape ;
    sh:property [ sh:message "CardiovascularOutcome: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "CardiovascularOutcome: required field 'outcome_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:outcome_text ] ;
    sh:targetClass kg:CardiovascularOutcome .

<urn:kg:vocab:shape/jardiance/Channel> a sh:NodeShape ;
    sh:property [ sh:message "Channel: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Channel .

<urn:kg:vocab:shape/jardiance/Chunk> a sh:NodeShape ;
    sh:property [ sh:message "Chunk: required field 'chunk_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:chunk_id ],
        [ sh:message "Chunk: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:Chunk .

<urn:kg:vocab:shape/jardiance/Claim> a sh:NodeShape ;
    sh:property [ sh:message "Claim: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:in ( "approved" "candidate" ) ;
            sh:path kg:claim_status ],
        [ sh:message "Claim: required field 'claim_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:claim_text ],
        [ sh:message "Claim: required relationship CLAIM_SUPPORTED_BY_REFERENCE is missing" ;
            sh:minCount 1 ;
            sh:path kg:CLAIM_SUPPORTED_BY_REFERENCE ] ;
    sh:targetClass kg:Claim .

<urn:kg:vocab:shape/jardiance/ClinicalTrial> a sh:NodeShape ;
    sh:property [ sh:message "ClinicalTrial: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "ClinicalTrial: required field 'trial_name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:trial_name ] ;
    sh:targetClass kg:ClinicalTrial .

<urn:kg:vocab:shape/jardiance/ComplianceRule> a sh:NodeShape ;
    sh:property [ sh:message "ComplianceRule: required field 'market' is missing" ;
            sh:minCount 1 ;
            sh:path kg:market ],
        [ sh:message "ComplianceRule: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:in ( "critical" "high" "low" "medium" ) ;
            sh:message "ComplianceRule: required field 'severity' is missing" ;
            sh:minCount 1 ;
            sh:path kg:severity ],
        [ sh:message "ComplianceRule: required field 'rule_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:rule_text ] ;
    sh:targetClass kg:ComplianceRule .

<urn:kg:vocab:shape/jardiance/ContentModule> a sh:NodeShape ;
    sh:property [ sh:in ( "approved" "draft" "pending" "rejected" ) ;
            sh:path kg:approval_status ],
        [ sh:message "ContentModule: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "ContentModule: required field 'module_name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:module_name ] ;
    sh:targetClass kg:ContentModule .

<urn:kg:vocab:shape/jardiance/Document> a sh:NodeShape ;
    sh:property [ sh:message "Document: required field 'source_file_name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_file_name ],
        [ sh:message "Document: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:Document .

<urn:kg:vocab:shape/jardiance/EfficacyClaimRequiresSafety> a sh:NodeShape ;
    sh:sparql [ sh:message "Efficacy claim has no CLAIM_REQUIRES_SAFETY link (ontology rule: every efficacy claim must carry the required Safety Information)" ;
            sh:select """PREFIX kg: <urn:kg:vocab:>
SELECT $this WHERE {
  $this kg:key_message_type ?t .
  FILTER(CONTAINS(LCASE(STR(?t)), "efficacy"))
  FILTER NOT EXISTS { $this kg:CLAIM_REQUIRES_SAFETY ?s }
}""" ] ;
    sh:targetClass kg:Claim .

<urn:kg:vocab:shape/jardiance/GuardrailRule> a sh:NodeShape ;
    sh:property [ sh:in ( "allow" "block" "escalate" "warn" ) ;
            sh:message "GuardrailRule: required field 'decision' is missing" ;
            sh:minCount 1 ;
            sh:path kg:decision ],
        [ sh:in ( "critical" "high" "low" "medium" ) ;
            sh:message "GuardrailRule: required field 'severity' is missing" ;
            sh:minCount 1 ;
            sh:path kg:severity ],
        [ sh:in ( "ai_disclosure" "brand_translation_governance" "consent" "mlr_signoff" "quality_evaluation" "terminology_management" "version_control" ) ;
            sh:message "GuardrailRule: required field 'rule_type' is missing" ;
            sh:minCount 1 ;
            sh:path kg:rule_type ],
        [ sh:message "GuardrailRule: required field 'rule_name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:rule_name ] ;
    sh:targetClass kg:GuardrailRule .

<urn:kg:vocab:shape/jardiance/Indication> a sh:NodeShape ;
    sh:property [ sh:message "Indication: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "Indication: required field 'market' is missing" ;
            sh:minCount 1 ;
            sh:path kg:market ],
        [ sh:message "Indication: required field 'indication_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:indication_text ] ;
    sh:targetClass kg:Indication .

<urn:kg:vocab:shape/jardiance/Market> a sh:NodeShape ;
    sh:property [ sh:message "Market: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Market .

