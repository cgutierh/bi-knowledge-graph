<urn:kg:vocab:shape/jardiance/ServiceLine> a sh:NodeShape ;
    sh:property [ sh:message "ServiceLine: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:ServiceLine .

<urn:kg:vocab:shape/jardiance/Table> a sh:NodeShape ;
    sh:property [ sh:message "Table: required field 'table_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:table_id ],
        [ sh:message "Table: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:Table .

<urn:kg:vocab:shape/jardiance/ToneRule> a sh:NodeShape ;
    sh:property [ sh:message "ToneRule: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "ToneRule: required field 'rule_text' is missing" ;
