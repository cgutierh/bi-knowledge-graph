    sh:targetClass kg:PISection .

<urn:kg:vocab:shape/jardiance/Persona> a sh:NodeShape ;
    sh:property [ sh:message "Persona: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Persona .

<urn:kg:vocab:shape/jardiance/Product> a sh:NodeShape ;
    sh:property [ sh:message "Product: required field 'active_ingredient' is missing" ;
            sh:minCount 1 ;
            sh:path kg:active_ingredient ],
        [ sh:message "Product: required field 'brand' is missing" ;
            sh:minCount 1 ;
            sh:path kg:brand ],
        [ sh:message "Product: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:Product .

<urn:kg:vocab:shape/jardiance/QualityCriterion> a sh:NodeShape ;
    sh:property [ sh:message "QualityCriterion: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ] ;
    sh:targetClass kg:QualityCriterion .

<urn:kg:vocab:shape/jardiance/Reference> a sh:NodeShape ;
    sh:property [ sh:message "Reference: required field 'reference_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:reference_text ],
        [ sh:message "Reference: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:Reference .

<urn:kg:vocab:shape/jardiance/RegulatoryFramework> a sh:NodeShape ;
    sh:property [ sh:message "RegulatoryFramework: required field 'scope' is missing" ;
            sh:minCount 1 ;
            sh:path kg:scope ],
        [ sh:message "RegulatoryFramework: required field 'name' is missing" ;
            sh:minCount 1 ;
            sh:path kg:name ],
        [ sh:message "RegulatoryFramework: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
    sh:targetClass kg:RegulatoryFramework .

<urn:kg:vocab:shape/jardiance/RenalOutcome> a sh:NodeShape ;
    sh:property [ sh:message "RenalOutcome: required field 'source_document_id' is missing" ;
