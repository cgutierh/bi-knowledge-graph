        [ sh:message "RenalOutcome: required field 'outcome_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:outcome_text ] ;
    sh:targetClass kg:RenalOutcome .

<urn:kg:vocab:shape/jardiance/SafetyStatement> a sh:NodeShape ;
    sh:property [ sh:message "SafetyStatement: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ],
        [ sh:message "SafetyStatement: required field 'statement_text' is missing" ;
            sh:minCount 1 ;
            sh:path kg:statement_text ] ;
    sh:targetClass kg:SafetyStatement .

<urn:kg:vocab:shape/jardiance/Section> a sh:NodeShape ;
    sh:property [ sh:message "Section: required field 'section_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:section_id ],
        [ sh:message "Section: required field 'source_document_id' is missing" ;
            sh:minCount 1 ;
            sh:path kg:source_document_id ] ;
