<node id="urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:115">
  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Guideline / Standard of care</data>
  <data key="d27">In addition to reducing the risk of CV death when added to the standard of care, JARDIANCE lowered HbA1c,  weight and blood pressure. JARDIANCE is not indicated for weight loss or reduction of blood pressure.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">115</data>
  <data key="d34">Type 2 diabetes; Cardiovascular risk / established CVD</data>
  <data key="d12">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
  <data key="d14">13ae0354-6211-4820-b97a-7634167e0ed0</data>
  <data key="d32">Corrected</data>
