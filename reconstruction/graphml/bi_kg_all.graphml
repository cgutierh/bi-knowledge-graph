  <data key="d8">15</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">7ae03919-8b67-4efd-8da4-8a93bed16280</data>
  <data key="d11">docling</data>
  <data key="d12">Jardiance_PI.pdf</data>
  <data key="d13">499d4b862c2149125912c670bc912fa873d30765b2e78c693b7d1be8cc4fe13d</data>
  <data key="d14">b2560bb2-851a-4e06-8246-07641712e8b0</data>
  <data key="d15">1667933c-ff4c-44fb-865c-2acd3015a80a</data>
  <data key="d16">In the event of an overdose with JARDIANCE, consider contacting the Poison Help line (1-800-222-1222) or a medical toxicologist for additional overdosage management recommendations. Removal of empagliflozin by hemodialysis has not been studied.

10</data>
  <data key="d3">Chunk</data>
  <data key="d4">jardiance</data>
