<node id="urn:kg:jardiance:pisection:395aac9c-f58d-496b-92a9-d24c419e8d1e">
  <data key="d0">brand</data>
  <data key="d20">13.1  Carcinogenesis, Mutagenesis, Impairment of Fertility</data>
  <data key="d8">19</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">395aac9c-f58d-496b-92a9-d24c419e8d1e</data>
  <data key="d12">Jardiance_PI.pdf</data>
  <data key="d14">b2560bb2-851a-4e06-8246-07641712e8b0</data>
