  <data key="d0">brand</data>
  <data key="d6">287</data>
  <data key="d7">118</data>
  <data key="d8">55</data>
  <data key="d9">product_information</data>
  <data key="d10">5b9b7a04-631c-44c5-b0bd-492716ba01c8</data>
  <data key="d11">docling</data>
  <data key="d12">jardiance-epar-product-information_en.pdf</data>
  <data key="d13">e1b2b8543784525ee638c76389b4681d640080f8740eb1148dbdfc3388fda288</data>
  <data key="d14">98de1eab-c096-475d-9a30-ff5319cefc40</data>
  <data key="d15">0c351728-89c0-4f30-9c71-cf419f793f7b</data>
  <data key="d16">Boehringer Ingelheim Pharma GmbH &amp;amp; Co. KG Binger Strasse 173 55216 Ingelheim am Rhein Germany

