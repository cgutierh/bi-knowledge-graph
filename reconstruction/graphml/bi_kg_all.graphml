</node>
<node id="urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:121">
  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">*Key inclusion criteria included a chronic HF (NYHA class II-IV) diagnosis, an elevated NT-proBNP level, and therapy with the appropriate doses of HF medication. Elevated NT-proBNP is defined as a level of ≥1000 pg/mL in those with an ejection fraction of 31% to 35% or a level of ≥2500 pg/mL in those with an ejection fraction of 36% to 40%, as compared with a level of ≥600 pg/mL in those with an ejection fraction of ≤30%.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">121</data>
  <data key="d34">General</data>
  <data key="d12">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
