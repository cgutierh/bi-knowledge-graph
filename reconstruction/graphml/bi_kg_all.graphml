<node id="urn:kg:jardiance:section:0efa4a18-ab94-4e1a-95e4-0391b226f43f">
  <data key="d0">brand</data>
  <data key="d19">body</data>
  <data key="d8">22</data>
  <data key="d9">prescribing_information</data>
