<node id="urn:kg:jardiance:section:db7a94c9-c210-4f78-b194-ebaaadd69373">
  <data key="d0">brand</data>
  <data key="d20">Emotional hook</data>
  <data key="d19">heading</data>
  <data key="d8">20</data>
  <data key="d9">brand_book</data>
  <data key="d10">db7a94c9-c210-4f78-b194-ebaaadd69373</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
