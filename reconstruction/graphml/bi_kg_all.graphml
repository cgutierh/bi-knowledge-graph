  <data key="d10">e4ee8634-2d11-4c03-8cae-35c54c5233d6</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d13">9567e439be9806e7905deec33487f93b8b7380f59163e09151d4f1eca20190ba</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d15">bf67bab2-a7d9-4557-8a8e-504fcda38dc8</data>
  <data key="d16">-   The emotional hook should be used only in the iVA and congress materials to ensure maximum emotional impact
-   In the iVA, the emotional hook should directly follow the campaign home page
-   The Anthem campaign should always be included with the emotional hook

&lt;!-- image --&gt;</data>
