<node id="urn:kg:boehringer-ingelheim:chunk:7eae6b2b-48c4-4226-92a5-950d9cc5ab93">
  <data key="d0">brand</data>
  <data key="d6">52</data>
  <data key="d7">31</data>
  <data key="d8">23</data>
  <data key="d9">guidance_document</data>
  <data key="d10">e5f5db49-e0ed-4b2b-9ef1-2e3ac6b4d050</data>
  <data key="d11">docling</data>
