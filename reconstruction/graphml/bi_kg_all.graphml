<node id="urn:kg:jardiance:chunk:ab9f5e3d-7667-4060-9884-b8ae948f7bc5">
  <data key="d0">brand</data>
  <data key="d6">62</data>
  <data key="d7">300</data>
  <data key="d8">10</data>
  <data key="d9">product_information</data>
