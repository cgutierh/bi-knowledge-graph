<node id="urn:kg:jardiance:section:3d65fc8f-e269-48f3-93d4-3d2c12c8c556">
  <data key="d0">brand</data>
  <data key="d20">The symbol may serve multiple purposes:</data>
  <data key="d19">heading</data>
  <data key="d8">25</data>
  <data key="d9">brand_book</data>
  <data key="d10">3d65fc8f-e269-48f3-93d4-3d2c12c8c556</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">- As part of the logo cluster
-   As a separate element that can be used promotionally to strengthen the brand's presence (this must be permitted by local legal and regulatory authorities)
- As a representation of the brand within unbranded materials, where possible (this must be permitted by local legal and regulatory authorities)

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
