<node id="urn:kg:boehringer-ingelheim:chunk:0e4f20f5-d209-4eae-8e92-c521d14fc15c">
  <data key="d0">brand</data>
  <data key="d6">12</data>
  <data key="d7">104</data>
  <data key="d8">3</data>
  <data key="d9">guidance_document</data>
  <data key="d10">db0ef3c0-fd90-4a1a-96cf-c47ca4969ed0</data>
  <data key="d11">docling</data>
  <data key="d12">Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf</data>
  <data key="d13">035a5901c90fbfef748705836bd0bc9ac1fb6b99ba31e801e8245644cf78ff13</data>
  <data key="d14">19fd2b5c-5248-47a5-852e-2b1b1976cae9</data>
  <data key="d15">0e4f20f5-d209-4eae-8e92-c521d14fc15c</data>
  <data key="d16">Send your illustrations to brand@boehringer-ingelheim.com with the subject 'Approval Scene Illustration'. Our team will review and approve them to ensure they are in line with our illustration style. Please note that the inclusion in the library is checked in advance, only illustrations that are relevant for a large part of the organisation and are not duplicated will be included in our library.

&lt;!-- image --&gt;</data>
  <data key="d3">Chunk</data>
  <data key="d4">boehringer-ingelheim</data>
  <data key="d5">Boehringer_Ai-Scene-Illustration-Toolkit-User-Manual.pdf</data>
</node>
