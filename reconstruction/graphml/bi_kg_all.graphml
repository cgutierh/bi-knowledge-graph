  <data key="d20">Branding elements:</data>
  <data key="d19">heading</data>
  <data key="d8">44</data>
  <data key="d9">brand_book</data>
  <data key="d10">d9d2b415-5bb2-48ac-9a28-da7daff1e35c</data>
  <data key="d11">docling</data>
