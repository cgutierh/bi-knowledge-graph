  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">In a subgroup analysis at 24 weeks of patients with baseline ≥8.5%, adjusted mean changes in HbA1c were -0.5% for placebo (n=50), -1.2% for JARDIANCE 10 mg (n=57), and -1.5% for JARDIANCE 25 mg (n=48). Difference from placebo (adjusted mean) was -0.73% for JARDIANCE 10 mg and -1.0% for JARDIANCE 25 mg.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
