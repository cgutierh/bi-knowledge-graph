<node id="urn:kg:jardiance:section:132423af-d1cd-4f96-b49d-83f20ad91df1">
  <data key="d0">brand</data>
  <data key="d20">Branding elements:</data>
  <data key="d19">heading</data>
  <data key="d8">37</data>
  <data key="d9">brand_book</data>
  <data key="d10">132423af-d1cd-4f96-b49d-83f20ad91df1</data>
  <data key="d11">docling</data>
