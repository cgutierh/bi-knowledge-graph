</node>
<node id="urn:kg:ofev:section:16bd04b8-2565-429f-91f0-69fc143864fd">
  <data key="d0">brand</data>
  <data key="d20">Campaign Headline</data>
  <data key="d19">heading</data>
  <data key="d8">65</data>
  <data key="d9">brand_book</data>
  <data key="d10">16bd04b8-2565-429f-91f0-69fc143864fd</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">The campaign headline 'Your patients are walking on unstable ground' reinforces the serious and unpredictable nature of IPF.

The headline should always be set in all caps, italicized, and in either black or white to emphasize the urgency of the communication.</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
