  <data key="d16">The diversity of patients shown emphasises the relevance of JARDIANCE across age groups and conditions.</data>
  <data key="d3">Chunk</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:chunk:ce2935a9-014d-447c-9c21-936a95b7f3b6">
  <data key="d0">brand</data>
  <data key="d6">74</data>
  <data key="d7">52</data>
  <data key="d8">21</data>
  <data key="d9">brand_book</data>
  <data key="d10">9bd45951-5220-4abd-95c5-99f3d296a277</data>
  <data key="d11">docling</data>
