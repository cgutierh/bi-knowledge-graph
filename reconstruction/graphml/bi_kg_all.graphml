  <data key="d13">e44cd116faf8da6d6ce4d27b497b1aa2505988888f8be898a1ef8e52f011b653</data>
  <data key="d14">ab59869e-f86f-48d4-8916-fb89334732d4</data>
  <data key="d15">7eae6b2b-48c4-4226-92a5-950d9cc5ab93</data>
  <data key="d16">Eyes play a central role in our illustrations, vital for showing inclusivity, emotional connections, and expressing feelings.</data>
  <data key="d3">Chunk</data>
  <data key="d4">boehringer-ingelheim</data>
  <data key="d5">BI Illustrations 4.pdf</data>
</node>
<node id="urn:kg:boehringer-ingelheim:chunk:ea7d73b0-3b15-49ee-8510-44122c9524e8">
  <data key="d0">brand</data>
  <data key="d6">53</data>
  <data key="d7">105</data>
  <data key="d8">23</data>
  <data key="d9">guidance_document</data>
  <data key="d10">e55459c3-97c1-4ddf-b5b3-4e9956d11513</data>
  <data key="d11">docling</data>
  <data key="d12">BI Illustrations 4.pdf</data>
  <data key="d13">1c4a225260c117327db5e72f700d4436d00890cc0676ab54641ff0e8be4db4fb</data>
  <data key="d14">ab59869e-f86f-48d4-8916-fb89334732d4</data>
  <data key="d15">ea7d73b0-3b15-49ee-8510-44122c9524e8</data>
  <data key="d16">Human eyes are illustrated with an emphasis on unique upper eyelid shapes and iris variations to represent different individuals. We complement this with eyebrows to enhance overall facial expressions, evoking relatability and emotional resonance.

Shape canforgea deeperconnectionwiththecharactersorsubjects. Expression elongated,rounded,or otherwise,this approach allows us to create diverse and inclusiveillustrations.</data>
  <data key="d3">Chunk</data>
  <data key="d4">boehringer-ingelheim</data>
  <data key="d5">BI Illustrations 4.pdf</data>
</node>
