<node id="urn:kg:jardiance:section:ad239ddc-98c7-4143-bbf3-52e3b7cf6024">
  <data key="d0">brand</data>
  <data key="d20">FULL PRESCRIBING INFORMATION</data>
  <data key="d19">heading</data>
  <data key="d8">3</data>
  <data key="d9">prescribing_information</data>
