<node id="urn:kg:ofev:chunk:e0fbfba0-d5ef-4011-9a2b-9c6448269052">
  <data key="d0">brand</data>
  <data key="d6">157</data>
  <data key="d7">60</data>
  <data key="d8">30</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">2b0570b6-9d18-4dfe-b178-6179cb6ba1b0</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_PI.pdf</data>
  <data key="d13">68b290b61318c725b440a7106dbbf3de00ece53086b3ca5270600f03403b31c7</data>
  <data key="d14">c0db5dd8-583e-47bb-9b75-58402a32791c</data>
