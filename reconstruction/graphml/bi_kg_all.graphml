<node id="urn:kg:jardiance:chunk:203eb7f6-6c13-44c9-b2cb-a531dee726a4">
  <data key="d0">brand</data>
  <data key="d6">189</data>
  <data key="d7">4</data>
  <data key="d8">56</data>
  <data key="d9">brand_book</data>
  <data key="d10">54fa65d8-171e-4a41-9c1d-5f3d753ca666</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d13">e5dc819883d3c4b39a4a3f3054652d05bbceb23ae07f1d5f396b3cb309cce5fb</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
