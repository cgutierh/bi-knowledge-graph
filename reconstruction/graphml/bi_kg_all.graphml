<node id="urn:kg:ofev:section:564892e7-16a6-4e83-99f7-309913fdae70">
  <data key="d0">brand</data>
  <data key="d20">references 9.0</data>
  <data key="d19">heading</data>
  <data key="d8">93</data>
  <data key="d9">brand_book</data>
  <data key="d10">564892e7-16a6-4e83-99f7-309913fdae70</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">Knowing how to access and use the OFEV ® brand assets is critical for ease in applying them. This section explains the file nomenclature and provides assets for download, contact information, and a quick reference guide.</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
<node id="urn:kg:ofev:section:460da3db-8322-4c80-9e44-61d109c861c5">
