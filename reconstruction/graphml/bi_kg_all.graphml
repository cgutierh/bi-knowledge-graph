<node id="urn:kg:ofev:chunk:8f29c178-c75d-4841-bf0d-1415c9e3947d">
  <data key="d0">brand</data>
  <data key="d6">0</data>
  <data key="d7">12</data>
  <data key="d8">1</data>
  <data key="d9">product_information</data>
  <data key="d10">7acb7805-523b-488f-8421-149f8d133751</data>
  <data key="d11">docling</data>
  <data key="d12">ofev-epar-medicines-overview_en.pdf</data>
  <data key="d13">0351ee17e913b0389b93bccb11694b27241509a7ab408c5312ab3d39ff80fc5e</data>
  <data key="d14">dcf1cfdd-57dc-4936-b9b2-0839e9684cb2</data>
