</node>
<node id="urn:kg:ofev:section:5a8ba6f3-cc81-411f-a127-d9ec2f3e648f">
  <data key="d0">brand</data>
  <data key="d20">Holding Shape</data>
  <data key="d19">heading</data>
  <data key="d8">23</data>
  <data key="d9">brand_book</data>
  <data key="d10">5a8ba6f3-cc81-411f-a127-d9ec2f3e648f</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">The OFEV ®  holding shape provides yet another distinctive element to the brand's marketing materials. Available in horizontal and vertical formats, the holding shape can be easily scaled to fit any piece. It is designed to be consistent yet flexible for various types of content. When adjusting the size of the holding shape, be sure to scale all the pieces proportionally.

&lt;!-- image --&gt;

BAcKGround: 20% PMS 5425

45

°</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
