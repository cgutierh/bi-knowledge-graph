<node id="urn:kg:ofev:section:38b8e81a-af41-4c3a-9e9d-3ca01edcf351">
  <data key="d0">brand</data>
  <data key="d20">VARGATEF ®  Logo</data>
  <data key="d19">heading</data>
  <data key="d8">12</data>
  <data key="d9">brand_book</data>
  <data key="d10">38b8e81a-af41-4c3a-9e9d-3ca01edcf351</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">The VARGATEF ®  logo is provided for countries that will launch nintedanib under the brand name VARGATEF ®  for both the IPF and lung cancer indications. These countries are required to use the same brand name for both indications; therefore, use of the brand name OFEV ® is not permitted.

GLoBAL LoGo

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
