  <data key="d7">38</data>
  <data key="d8">6</data>
  <data key="d9">disease_brochure</data>
  <data key="d10">60712e8c-29fb-4365-90e4-c87edc014b2d</data>
  <data key="d11">docling</data>
  <data key="d12">CKD_Brochure.pdf</data>
  <data key="d13">0658eb7b7e742562816c18d3336681997a2f31799438ae1fb9af1deddad9e418</data>
  <data key="d14">c66d5608-a1a9-4ea5-8044-6599b515b904</data>
  <data key="d15">48f6c32c-f106-4644-a08b-1adc9fb3d872</data>
  <data key="d16">ave recently received certain types of immunosuppressive therapy to treat kidney disease. JARDIANCE is not expected to work if you have these conditions.</data>
