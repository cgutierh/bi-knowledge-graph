<node id="urn:kg:jardiance:section:fbeec6a1-735a-49eb-be27-b5d249b77024">
  <data key="d0">brand</data>
  <data key="d20">Patient imagery</data>
  <data key="d19">heading</data>
  <data key="d8">21</data>
  <data key="d9">brand_book</data>
  <data key="d10">fbeec6a1-735a-49eb-be27-b5d249b77024</data>
