<node id="urn:kg:jardiance:section:26c55f7b-565d-4f2a-bc03-a295e890b773">
  <data key="d0">brand</data>
  <data key="d20">MEDICATION GUIDE JARDIANCE ®  (jar DEE ans) (empagliflozin tablets)</data>
  <data key="d19">heading</data>
  <data key="d8">47</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">26c55f7b-565d-4f2a-bc03-a295e890b773</data>
  <data key="d11">docling</data>
  <data key="d12">Jardiance_PI.pdf</data>
