<node id="urn:kg:jardiance:section:8e9a9262-5416-446a-a490-1abaf0a16684">
  <data key="d0">brand</data>
  <data key="d20">Video/motion elements</data>
  <data key="d19">heading</data>
  <data key="d8">19</data>
  <data key="d9">brand_book</data>
  <data key="d10">8e9a9262-5416-446a-a490-1abaf0a16684</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">Short video sequences and cinemagraphs have been developed to expand the campaign's presence across platforms and mediums, adding versatility and visual interest beyond static visuals.

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:93d3695c-2e94-499f-8d64-14902811c6b1">
  <data key="d0">brand</data>
  <data key="d20">The JARDIANCE way</data>
  <data key="d19">heading</data>
  <data key="d8">19</data>
  <data key="d9">brand_book</data>
  <data key="d10">93d3695c-2e94-499f-8d64-14902811c6b1</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">-   Follow applicable guidance from static visuals (ie, use only provided assets, do not introduce new doctors with the campaign pose)
-   Layer graphic elements (paint, textures, swashes) into animations where they add emphasis or enhance storytelling

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:ecb93aca-368b-4e2e-a151-cc15ed6f9924">
  <data key="d0">brand</data>
  <data key="d20">The WRONG way</data>
  <data key="d19">heading</data>
  <data key="d8">19</data>
  <data key="d9">brand_book</data>
