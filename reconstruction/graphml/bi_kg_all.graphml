  <data key="d0">brand</data>
  <data key="d20">Secondary Graphics: Holding Shape</data>
  <data key="d19">heading</data>
  <data key="d8">52</data>
  <data key="d9">brand_book</data>
  <data key="d10">8f9fab1a-35e6-43b3-843e-5b3a34ea2d29</data>
