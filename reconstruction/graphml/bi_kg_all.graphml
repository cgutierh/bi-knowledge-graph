  <data key="d27">Your patients with CKD are more likely to die from CVD than to progress to kidney failure. Nearly 1 in 2 patients with CKD will die from CVD before reaching end-stage kidney disease and requiring dialysis.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">189</data>
  <data key="d34">Chronic kidney disease; Cardiovascular risk / established CVD</data>
  <data key="d12">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
  <data key="d14">13ae0354-6211-4820-b97a-7634167e0ed0</data>
  <data key="d32">Confirmed complete</data>
  <data key="d3">Claim</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
