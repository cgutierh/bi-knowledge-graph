  <data key="d20">9.1</data>
  <data key="d19">heading</data>
  <data key="d8">94</data>
  <data key="d9">brand_book</data>
  <data key="d10">460da3db-8322-4c80-9e44-61d109c861c5</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16"></data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
<node id="urn:kg:ofev:section:85a8ee51-9331-49ce-9d98-b4ae48e70509">
  <data key="d0">brand</data>
  <data key="d20">Marketing Materials</data>
  <data key="d19">heading</data>
  <data key="d8">94</data>
  <data key="d9">brand_book</data>
  <data key="d10">85a8ee51-9331-49ce-9d98-b4ae48e70509</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">Please refer to the document entitled Overview of IPF Materials (ID number in BI Vault: 000). It lists all of the branded and unbranded campaign tactics prepared by the corporate marketing team. These tactics are meant to be translated and adapted for use in your local market. Use the identification numbers in this document to locate and download the tactics. A PDF of each tactic is accompanied by a literature pack as well as a ZIP file containing the art files; your agency can use these materials to customize the tactic and prepare for regulatory review.

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
<node id="urn:kg:ofev:section:29f4a2ae-c22a-424d-a02a-706e1975fe9b">
  <data key="d0">brand</data>
  <data key="d19">body</data>
  <data key="d8">95</data>
  <data key="d9">brand_book</data>
  <data key="d10">29f4a2ae-c22a-424d-a02a-706e1975fe9b</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">9.2</data>
  <data key="d3">Section</data>
