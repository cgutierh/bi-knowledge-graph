<node id="urn:kg:boehringer-ingelheim:section:ca268adb-2135-4bf5-a0e0-5214419a7f60">
  <data key="d0">brand</data>
  <data key="d20">Nature and urbanmix</data>
  <data key="d19">heading</data>
  <data key="d8">4</data>
  <data key="d9">guidance_document</data>
