<node id="urn:kg:jardiance:claim:bdbcac76-9e19-4e55-8ae3-ad3e318ca123:2">
  <data key="d0">brand</data>
  <data key="d24">approved</data>
  <data key="d25">approved</data>
  <data key="d26">Efficacy</data>
  <data key="d27">In patients with CKD, JARDIANCE reduced the relative risk of CV death or kidney disease progression by 28%</data>
  <data key="d28">bdbcac76-9e19-4e55-8ae3-ad3e318ca123</data>
  <data key="d29">Corporate</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">2</data>
  <data key="d12">Jardiance_Claims_updated &amp; Content Modules 1.xlsx</data>
  <data key="d31">JARDIANCE</data>
  <data key="d14">e77ccb64-a3a2-41c2-9027-fb5e54716ebc</data>
  <data key="d32">Approved for Use</data>
