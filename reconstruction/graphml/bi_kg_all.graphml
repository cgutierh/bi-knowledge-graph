  <data key="d44">{"sheet_name": "Final Corrected Claims", "columns": ["#", "Final Corrected Claim", "Status", "Indication", "Key Message Type", "End Audience", "Contextual Information", "Footnotes", "Reference", "Note"], "rows": [{"row_number": 2, "cells": {"#": "1", "Final Corrected Claim": "*Primary outcome was reduction in CV events defined as composite endpoint of CV death, nonfatal MI, or nonfatal stroke. JARDIANCE reduced the relative risk of such CV events by 14%", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 14% | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.144 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA p.144", "Note": null}}, {"row_number": 3, "cells": {"#": "2", "Final Corrected Claim": "*Positively reinforcing continued use of JARDIANCE may significantly reduce the risk of CV death.1", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.117 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.117", "Note": null}}, {"row_number": 4, "cells": {"#": "3", "Final Corrected Claim": "Initiate JARDIANCE first line to reduce your patients’ risk of CV death", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.50 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.50", "Note": null}}, {"row_number": 5, "cells": {"#": "4", "Final Corrected Claim": "†JARDIANCE helps protect patients by reducing the risk of CV death.1", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.116; 2026 Card iVA p.119 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.116; 2026 Card iVA p.119", "Note": null}}, {"row_number": 6, "cells": {"#": "5", "Final Corrected Claim": "#JARDIANCE helps protect patients by reducing CV risk.5", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.107 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "2026 Card iVA | 2026 Card iVA p.107", "Note": null}}, {"row_number": 7, "cells": {"#": "6", "Final Corrected Claim": "*Change from baseline in clinical summary score (HF symptoms and physical limitations domains) of the KCCQ at week 52 was a prespecified secondary endpoint in the EMPEROR- Reduced and EMPEROR-Preserved trials. KCCQ change from baseline to 52 weeks. EMPEROR-Reduced: JARDIANCE 5.8 ± 0.4; placebo 4.1 ± 0.4. EMPEROR-Preserved: JARDIANCE  4.51, placebo 3.18. Patient-reported outcomes measured changes in KCCQ summary scores.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPEROR-Reduced | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.136 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA p.136", "Note": null}}, {"row_number": 8, "cells": {"#": "7", "Final Corrected Claim": "Initiate JARDIANCE to reduce your patients’ risk of CV death and protect them right from the start", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.53 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.53", "Note": null}}, {"row_number": 9, "cells": {"#": "8", "Final Corrected Claim": "Initiate JARDIANCE today to start your patients with sustained CV protection#5", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.106 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "2026 Card iVA | 2026 Card iVA p.106", "Note": null}}, {"row_number": 10, "cells": {"#": "9", "Final Corrected Claim": "JARDIANCE acts fast in the first line to deliver long-term cardioprotection* for a wide range of patients6,7", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.24; 2026 Card iVA p.66; 2026 Card iVA p.102 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "6,7", "Reference": "2026 Card iVA | 2026 Card iVA p.24; 2026 Card iVA p.66; 2026 Card iVA p.102", "Note": null}}, {"row_number": 11, "cells": {"#": "10", "Final Corrected Claim": "JARDIANCE demonstrated consistent efficacy across subgroups1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.140 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.140", "Note": null}}, {"row_number": 12, "cells": {"#": "11", "Final Corrected Claim": "JARDIANCE helped reduce the risk of incident or worsening nephropathy†1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.95 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "†1", "Reference": "2026 PCP iVA | 2026 PCP iVA p.95", "Note": null}}, {"row_number": 13, "cells": {"#": "12", "Final Corrected Claim": "JARDIANCE helps protect patients by giving more time ​out of hospital1,2​", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.183 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.183", "Note": null}}, {"row_number": 14, "cells": {"#": "13", "Final Corrected Claim": "JARDIANCE helps protect the kidneys by slowing the decline in kidney \nfunction across the LVEF spectrum", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.162 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.162", "Note": null}}, {"row_number": 15, "cells": {"#": "14", "Final Corrected Claim": "JARDIANCE led to significant improvements in mean KCCQ-CSS, -TSS, and -OSS, which were apparent as early as 3 months and were sustained at 8 and 12 months.", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.136 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA p.136", "Note": null}}, {"row_number": 16, "cells": {"#": "15", "Final Corrected Claim": "JARDIANCE provides powerful CV and kidney protection* as demonstrated in multiple clinical trials spanning a decade", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.20; 2026 PCP iVA p.28 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.20; 2026 PCP iVA p.28", "Note": null}}, {"row_number": 17, "cells": {"#": "16", "Final Corrected Claim": "JARDIANCE reduced the need for insulin initiation||||8", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.28 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "8", "Reference": "2026 Endo iVA | 2026 Endo iVA p.28", "Note": null}}, {"row_number": 18, "cells": {"#": "17", "Final Corrected Claim": "JARDIANCE reduces the risk of first and recurrent hospitalisation in HF1,2", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.93; 2026 PCP iVA p.113 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.93; 2026 PCP iVA p.113", "Note": null}}, {"row_number": 19, "cells": {"#": "18", "Final Corrected Claim": "JARDIANCE reduces the risk of incident or worsening nephropathy†1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.149 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "†1", "Reference": "2026 Card iVA | 2026 Card iVA p.149", "Note": null}}, {"row_number": 20, "cells": {"#": "19", "Final Corrected Claim": "JARDIANCE: The once-daily tablet for CV protection†", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.44; 2026 Card iVA p.87; 2026 Card iVA p.116 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.44; 2026 Card iVA p.87; 2026 Card iVA p.116", "Note": null}}, {"row_number": 21, "cells": {"#": "20", "Final Corrected Claim": "Patients treated with JARDIANCE experienced a 21% RRR in this endpoint (HR=0.79; 95% CI: 0.69, 0.90; p&lt;0.001)", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 21% | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.24; 2026 PCP iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 Endo iVA p.24; 2026 PCP iVA p.29", "Note": null}}, {"row_number": 22, "cells": {"#": "21", "Final Corrected Claim": "Patients treated with JARDIANCE experienced a 25% RRR in this endpoint (HR=0.75; 95% CI: 0.65, 0.86; p&lt;0.001)", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 25% | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29", "Note": null}}, {"row_number": 23, "cells": {"#": "22", "Final Corrected Claim": "Patients treated with JARDIANCE experienced a 28% RRR in this endpoint (HR=0.72; 95% CI: 0.64, 0.82; p&lt;0.001).1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 28%; 95%; HR=0.72; 95% CI: 0; p&lt;0.001 | Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.78; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.181; 2026 PCP iVA p.41 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.78; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.181; 2026 PCP iVA p.41", "Note": null}}, {"row_number": 24, "cells": {"#": "23", "Final Corrected Claim": "Patients treated with JARDIANCE were more likely to show clinically meaningful improvements (≥5, ≥10, and ≥15 points) and less likely to experience clinically meaningful deterioration in health status when compared to placebo.1,2,4,5", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.136 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2,4,5", "Reference": "2026 Card iVA p.136", "Note": null}}, {"row_number": 25, "cells": {"#": "24", "Final Corrected Claim": "You can initiate JARDIANCE early for the greatest kidney benefit,", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.40 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.40", "Note": null}}, {"row_number": 26, "cells": {"#": "25", "Final Corrected Claim": "Offer your patients across the LVEF spectrum significant  benefits as early as 2 weeks with JARDIANCE", "Status": "Corrected", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.110 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3,4", "Reference": "2026 PCP iVA | 2026 PCP iVA p.110", "Note": null}}, {"row_number": 27, "cells": {"#": "26", "Final Corrected Claim": "§JARDIANCE helps protect by reducing CV and kidney risk.1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.12; 2026 Endo iVA p.46; 2026 Endo iVA p.53 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA | 2026 Endo iVA p.12; 2026 Endo iVA p.46; 2026 Endo iVA p.53", "Note": null}}, {"row_number": 28, "cells": {"#": "27", "Final Corrected Claim": "§JARDIANCE helps protect patients by reducing CV and kidney risk.1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.43; 2026 PCP iVA p.50 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 PCP iVA | 2026 PCP iVA p.43; 2026 PCP iVA p.50", "Note": null}}, {"row_number": 29, "cells": {"#": "28", "Final Corrected Claim": "JARDIANCE significantly improved quality of life regardless of LVEF4,5", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.134 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "4,5", "Reference": "2026 Card iVA | 2026 Card iVA p.134", "Note": null}}, {"row_number": 30, "cells": {"#": "29", "Final Corrected Claim": "Reduce the risk of hospitalisation for HF by adding JARDIANCE", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Primary Care | Source asset(s): 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Card iVA p.109; 2026 PCP iVA p.92 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 PCP iVA; 2026 Card iVA p.109; 2026 PCP iVA p.92", "Note": null}}, {"row_number": 31, "cells": {"#": "30", "Final Corrected Claim": "The effect of empagliflozin to reduce the combined risk of death, hospitalisation for heart failure, or an emergent or urgent heart failure visit was statistically significant at 12 days after randomisation and statistical significance was sustained from day 12 onward (HR=0.70; 95% CI: 0.63, 0.78; p&lt;0.0001).3", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 95%; HR=0.70; 95% CI: 0; p&lt;0.0001 | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.91; 2026 PCP iVA p.111 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 Endo iVA; 2026 Endo iVA p.91; 2026 PCP iVA p.111", "Note": null}}, {"row_number": 32, "cells": {"#": "31", "Final Corrected Claim": "*Positively reinforcing continued use of JARDIANCE may significantly reduce the risk of CV death or HHF.1", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.45; 2026 Card iVA p.88 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.45; 2026 Card iVA p.88", "Note": null}}, {"row_number": 33, "cells": {"#": "32", "Final Corrected Claim": "JARDIANCE protects your patients by reducing the risk of CV death or HHF†1", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.69 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "†1", "Reference": "2026 Card iVA | 2026 Card iVA p.69", "Note": null}}, {"row_number": 34, "cells": {"#": "33", "Final Corrected Claim": "JARDIANCE reduced CV death or HHF across a broad age spectrum1", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.37; 2026 Card iVA p.79 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.37; 2026 Card iVA p.79", "Note": null}}, {"row_number": 35, "cells": {"#": "34", "Final Corrected Claim": "JARDIANCE reduced CV death or HHF regardless of baseline frailty status", "Status": "Corrected", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.80 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.80", "Note": null}}, {"row_number": 36, "cells": {"#": "35", "Final Corrected Claim": "JARDIANCE: the 1st medicine‡ to protect patients across the LVEF spectrum by reducing the risk of CV death and hospitalisation for HF1,2", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.54 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2", "Reference": "2026 PCP iVA | 2026 PCP iVA p.54", "Note": null}}, {"row_number": 37, "cells": {"#": "36", "Final Corrected Claim": "†JARDIANCE helps protect patients by reducing the risk of CV death or HHF.1", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.44; 2026 Card iVA p.47; 2026 Card iVA p.87; 2026 Card iVA p.90 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.44; 2026 Card iVA p.47; 2026 Card iVA p.87; 2026 Card iVA p.90", "Note": null}}, {"row_number": 38, "cells": {"#": "37", "Final Corrected Claim": "JARDIANCE helped protect patients by giving more time out of hospital1,2 In the treatment of patients with CKD with or without T2D*", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.79 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.79", "Note": null}}, {"row_number": 39, "cells": {"#": "38", "Final Corrected Claim": "JARDIANCE reduced risk of CV death regardless of patients’ HbA1c or BMI#5,7", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.27 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5,7", "Reference": "2026 Endo iVA | 2026 Endo iVA p.27", "Note": null}}, {"row_number": 40, "cells": {"#": "39", "Final Corrected Claim": "Prescribe JARDIANCE to reduce the risk of CV death for your patients with eCVD + T2D", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.103 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.103", "Note": null}}, {"row_number": 41, "cells": {"#": "40", "Final Corrected Claim": "JARDIANCE protects a wide range of patients regardless of T2D or CKD status, by reducing the risk of CV death or HHF1", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.165; 2026 Card iVA p.168 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.165; 2026 Card iVA p.168", "Note": null}}, {"row_number": 42, "cells": {"#": "41", "Final Corrected Claim": "JARDIANCE is indicated in adults for the treatment of chronic kidney disease.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Indication / Use", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3", "Note": null}}, {"row_number": 43, "cells": {"#": "42", "Final Corrected Claim": "JARDIANCE is contraindicated in patients with hypersensitivity to the active substance or to any of the excipients of JARDIANCE. JARDIANCE should not be used in patients with type 1 diabetes or for the treatment of DKA.\"\n\nHowever, the first sentence alone also we can consider as a claim", "Status": "Corrected", "Indication": "General", "Key Message Type": "Indication / Use", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.54; 2026 Card iVA p.48; 2026 Card iVA p.91; 2026 Card iVA p.120; 2026 PCP iVA p.51 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.54; 2026 Card iVA p.48; 2026 Card iVA p.91; 2026 Card iVA p.120; 2026 PCP iVA p.51", "Note": null}}, {"row_number": 44, "cells": {"#": "43", "Final Corrected Claim": "JARDIANCE is indicated in adults for the treatment of symptomatic chronic heart failure.", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Indication / Use", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3", "Note": null}}, {"row_number": 45, "cells": {"#": "44", "Final Corrected Claim": "JARDIANCE is indicated in adults and children aged 10 years and above for the treatment of insufficiently controlled type 2 diabetes mellitus as an adjunct to diet and exercise", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Indication / Use", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.3; 2026 Card iVA p.3; 2026 PCP iVA p.3", "Note": null}}, {"row_number": 46, "cells": {"#": "45", "Final Corrected Claim": "In the treatment of patients with T2D and eCVD Early intervention is key to reducing the risk of cardio-renal complications", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.8 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1-3", "Reference": "2026 Endo iVA | 2026 Endo iVA p.8", "Note": null}}, {"row_number": 47, "cells": {"#": "46", "Final Corrected Claim": "Treat your patients with CKD urgently to manage their rising CVD mortality risk1", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.7 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 PCP iVA | 2026 PCP iVA p.7", "Note": null}}, {"row_number": 48, "cells": {"#": "47", "Final Corrected Claim": "EMPA-KIDNEY trial: Reduction in the risk of kidney disease progression or CV death", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-KIDNEY | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.77; 2026 PCP iVA p.38 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPA-KIDNEY | 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.77; 2026 PCP iVA p.38", "Note": null}}, {"row_number": 49, "cells": {"#": "48", "Final Corrected Claim": "EMPA-KIDNEY trial: Reduction in the risk of kidney disease progression or CV death1,3", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-KIDNEY | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.180 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,3", "Reference": "EMPA-KIDNEY | 2026 Card iVA | 2026 Card iVA p.180", "Note": null}}, {"row_number": 50, "cells": {"#": "49", "Final Corrected Claim": "Reduced eGFR is associated with increased risk of all-cause mortality, CV death, and hospitalisation in patients with HF", "Status": "Corrected", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.57 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "4", "Reference": "2026 PCP iVA | 2026 PCP iVA p.57", "Note": null}}, {"row_number": 51, "cells": {"#": "50", "Final Corrected Claim": "EMPA-REG OUTCOME® trial: Early and sustained reductions in the risk of CV death5", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-REG OUTCOME | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.106 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "EMPA-REG OUTCOME | 2026 Card iVA | 2026 Card iVA p.106", "Note": null}}, {"row_number": 52, "cells": {"#": "51", "Final Corrected Claim": "EMPA-REG OUTCOME® trial: Early and sustained reductions in the risk of CV death5 Reducing the risk of CV death can help your patients get more time with their loved ones5", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-REG OUTCOME | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.26; 2026 PCP iVA p.31 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "EMPA-REG OUTCOME | 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.26; 2026 PCP iVA p.31", "Note": null}}, {"row_number": 53, "cells": {"#": "52", "Final Corrected Claim": "The 14% RRR in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p&lt;0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77); there was no change in risk of nonfatal MI (HR=0.87; 95% CI: 0.70, 1.09) or nonfatal stroke (HR=1.24; 95% CI: 0.92, 1.67).1", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 14%; 95%; HR=0.86; HR=0.62; HR=0.87; HR=1.24; 95% CI: 0; p&lt;0.001; p=0.04 | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA | Page(s): 2026 Endo iVA p.24; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 Endo iVA p.24; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104", "Note": null}}, {"row_number": 54, "cells": {"#": "53", "Final Corrected Claim": "JARDIANCE is a guideline-recommended option that can help your patients by reducing their risk of CV death", "Status": "Corrected", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.41 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.41", "Note": null}}, {"row_number": 55, "cells": {"#": "54", "Final Corrected Claim": "Contraindications and precautions \n• JARDIANCE should not be used for the treatment of patients with: \n– Type 1 diabetes \n– Severe hepatic impairment \n– Hypersensitivity to the active substance or to any of the excipients \n• In patients 75 years and older, an increased risk of volume depletion should be taken into account \n• Due to limited experience, it is not recommended to initiate treatment with empagliflozin in patients with an eGFR &lt;20 mL/min/1.73 m2", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.37; 2026 PCP iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.37; 2026 PCP iVA p.47", "Note": null}}, {"row_number": 56, "cells": {"#": "55", "Final Corrected Claim": "EMPA-KIDNEY: the largest SGLT2i kidney trial to date evaluated JARDIANCE across the broadest spectrum of patients with declining kidney function", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.74; 2026 Card iVA p.177; 2026 PCP iVA p.76 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.74; 2026 Card iVA p.177; 2026 PCP iVA p.76", "Note": null}}, {"row_number": 57, "cells": {"#": "56", "Final Corrected Claim": "JARDIANCE significantly: Reduced the risk of hospitalisation, so patients can spend more time out of the hospital", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.133 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.133", "Note": null}}, {"row_number": 58, "cells": {"#": "57", "Final Corrected Claim": "Your patients with HF require urgent and appropriate intervention with foundational treatments, like SGLT2is", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.60 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.60", "Note": null}}, {"row_number": 59, "cells": {"#": "58", "Final Corrected Claim": "The reductions in risk of CV death or HHF, respectively were consistent in patients with or without HF at baseline", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.110 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 Card iVA | 2026 Card iVA p.110", "Note": null}}, {"row_number": 60, "cells": {"#": "59", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are Class I recommended for first-line use in patients with CVD + T2D to reduce the risk of CV events, independent of glucose control", "Status": "Corrected", "Indication": "General", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.99 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.99", "Note": null}}, {"row_number": 61, "cells": {"#": "60", "Final Corrected Claim": "GDMT is typically not optimised for patients with HFrEF2,3", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.126 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2,3", "Reference": "2026 Card iVA | 2026 Card iVA p.126", "Note": null}}, {"row_number": 62, "cells": {"#": "61", "Final Corrected Claim": "Your patients with HFpEF require urgent and appropriate intervention with foundational treatments like SGLT2is2", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.63 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.63", "Note": null}}, {"row_number": 63, "cells": {"#": "62", "Final Corrected Claim": "As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFmrEF and HFpEF to reduce the risk of heart failure hospitalisation or cardiovascular death", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.43; 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.43; 2026 PCP iVA p.25", "Note": null}}, {"row_number": 64, "cells": {"#": "63", "Final Corrected Claim": "SGLT2is are a Class I, Level A-recommended therapy for patients with HFrEF to reduce the risk of heart failure hospitalisation or cardiovascular death, making JARDIANCE 1 of 4 foundational treatments for HFrEF.", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.43; 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.43; 2026 PCP iVA p.25", "Note": null}}, {"row_number": 65, "cells": {"#": "64", "Final Corrected Claim": "In patients with HFrEF JARDIANCE helps keep your patients out of the hospital by reducing the risk of first and recurrent HHF", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.30 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.30", "Note": null}}, {"row_number": 66, "cells": {"#": "65", "Final Corrected Claim": "‡In addition to the RRR of all HHF, including first and recurrent events, the risk of total hospitalisations for any reason was also significantly reduced (HR=0.85; 95% CI: 0.75, 0.95).1", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 95%; HR=0.85; 95% CI: 0 | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.94; 2026 PCP iVA p.114 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.94; 2026 PCP iVA p.114", "Note": null}}, {"row_number": 67, "cells": {"#": "66", "Final Corrected Claim": "The primary endpoint in the EMPEROR- Preserved trial was a composite of CV death or hospitalisation for HF, analysed as time to the first event.", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29", "Note": null}}, {"row_number": 68, "cells": {"#": "67", "Final Corrected Claim": "The primary endpoint in the EMPEROR- Reduced trial was a composite of CV death or hospitalisation for HF, analysed as time to the first event.", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29", "Note": null}}, {"row_number": 69, "cells": {"#": "68", "Final Corrected Claim": "SGLT2is are a Class I, Level A-recommended therapy for patients with HFrEF to reduce the risk of heart failure hospitalisation or cardiovascular death, making JARDIANCE 1 of 4 foundational treatments for HFrEF. (Alternatively: As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFmrEF and HFpEF to reduce the risk of heart failure hospitalisation or cardiovascular death)", "Status": "Corrected", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.17; 2026 Card iVA p.62 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.17; 2026 Card iVA p.62", "Note": "Source lists two related claims on this topic; both variants shown - confirm which applies to this specific asset context"}}, {"row_number": 70, "cells": {"#": "69", "Final Corrected Claim": "CVD is the #1 cause of death in patients with T2D1", "Status": "Confirmed complete", "Indication": "Type 2 diabetes", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.93 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.93", "Note": null}}, {"row_number": 71, "cells": {"#": "70", "Final Corrected Claim": "Optimised treatment should go beyond HbA1c reduction and help protect your patients with T2D and CVD", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.8 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 Endo iVA | 2026 Endo iVA p.8", "Note": null}}, {"row_number": 72, "cells": {"#": "71", "Final Corrected Claim": "Rates of hypoglycaemia‡ were similar between JARDIANCE and placebo in patients with or without T2D", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.96; 2026 Card iVA p.171; 2026 PCP iVA p.116 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.96; 2026 Card iVA p.171; 2026 PCP iVA p.116", "Note": null}}, {"row_number": 73, "cells": {"#": "72", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are Class I recommended for first-line use in patients with CVD + T2D to reduce the risk of CV events", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.17; 2026 Card iVA p.62 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.17; 2026 Card iVA p.62", "Note": null}}, {"row_number": 74, "cells": {"#": "73", "Final Corrected Claim": "In the treatment of patients with CKD with or without T2D Serious adverse events seen in the EMPA-KIDNEY trial", "Status": "Corrected", "Indication": "Type 2 diabetes; Chronic kidney disease", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.81; 2026 PCP iVA p.82 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.81; 2026 PCP iVA p.82", "Note": null}}, {"row_number": 75, "cells": {"#": "74", "Final Corrected Claim": "Patients with hypertension or T2D are at risk for CKD2,3", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Chronic kidney disease", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.8 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2,3", "Reference": "2026 PCP iVA | 2026 PCP iVA p.8", "Note": null}}, {"row_number": 76, "cells": {"#": "75", "Final Corrected Claim": "EMPA-REG OUTCOME® focused on patients with eCVD + T2D2,8", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-REG OUTCOME | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.103 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2,8", "Reference": "EMPA-REG OUTCOME | 2026 Card iVA | 2026 Card iVA p.103", "Note": null}}, {"row_number": 77, "cells": {"#": "76", "Final Corrected Claim": "In insulin-treated patients with T2D and eCVD JARDIANCE reduced the need for large increases in insulin dose", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.29", "Note": null}}, {"row_number": 78, "cells": {"#": "77", "Final Corrected Claim": "In the treatment of patients with T2D and eCVD\nEarly intervention is key to reducing the risk of cardio-renal complications'", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.8; 2026 PCP iVA p.98 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.8; 2026 PCP iVA p.98", "Note": null}}, {"row_number": 79, "cells": {"#": "78", "Final Corrected Claim": "Patients saw consistent reduction in risk of CV death regardless of HbA1c or BMI \nat baseline, and independent of change in HbA1c", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.27 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.27", "Note": null}}, {"row_number": 80, "cells": {"#": "79", "Final Corrected Claim": "Subgroup analyses highlighted below: reduction in risk of CV death across HbA1c and BMI subgroups", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.27 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.27", "Note": null}}, {"row_number": 81, "cells": {"#": "80", "Final Corrected Claim": "JARDIANCE is the first and only SGLT2i proven to reduce the risk \nof CV death in patients with T2D + eCVD", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.26; 2026 PCP iVA p.31 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "‡1-4", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.26; 2026 PCP iVA p.31", "Note": null}}, {"row_number": 82, "cells": {"#": "81", "Final Corrected Claim": "patients with T2D are at increased risk of CV death1-3", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.5 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1-3", "Reference": "2026 Endo iVA | 2026 Endo iVA p.5", "Note": null}}, {"row_number": 83, "cells": {"#": "82", "Final Corrected Claim": "†Key inclusion criteria: adult patients with type 2 diabetes and eCVD (CAD, PAD, or a history of MI or stroke), HbA1c 7%-10%, BMI ≤45 kg/m2. Key exclusion criteria:", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 7%; 10% | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.144 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.144", "Note": null}}, {"row_number": 84, "cells": {"#": "83", "Final Corrected Claim": "Due to limited experience, it is not recommended to initiate treatment with empagliflozin in patients with an eGFR &lt;20 mL/min/1.73 m2", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.37; 2026 PCP iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 Endo iVA; 2026 Endo iVA p.37; 2026 PCP iVA p.47", "Note": null}}, {"row_number": 85, "cells": {"#": "84", "Final Corrected Claim": "It is not recommended to initiate JARDIANCE at eGFR level &lt;20mL/min/1.73 m2", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.47; 2026 PCP iVA p.44 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.47; 2026 PCP iVA p.44", "Note": null}}, {"row_number": 86, "cells": {"#": "85", "Final Corrected Claim": "KDIGO guidelines recommend 2 tests (uACR and eGFR) annually in at-risk individuals to adequately assess for kidney damage", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.8 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.8", "Note": null}}, {"row_number": 87, "cells": {"#": "86", "Final Corrected Claim": "§NNT: 28 (95% CI: 19, 53) per 2 years at risk.2 IIStandard of care: All patients received a RAASi unless an investigator judged that a RAASi was not indicated or tolerated.1 ¶The rate of annual eGFR decline was a prespecified tertiary endpoint of the EMPA-KIDNEY trial.1 #Estimated from each baseline eGFR value by applying the chronic eGFR slopes corresponding to participants on placebo vs JARDIANCE within the prespecified eGFR subgroups (eGFR", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 95%; 95% CI: 19 | Study/programme: EMPA-KIDNEY | Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.41 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPA-KIDNEY | 2026 PCP iVA | 2026 PCP iVA p.41", "Note": null}}, {"row_number": 88, "cells": {"#": "87", "Final Corrected Claim": "*Standard of care included CV medications and glucose-lowering agents given at the discretion of healthcare providers and according to recommendations of local guidelines.1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.63; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.111; 2026 Card iVA p.147; 2026 Card iVA p.151; 2026 PCP iVA p.90 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.63; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.111; 2026 Card iVA p.147; 2026 Card iVA p.151; 2026 PCP iVA p.90", "Note": null}}, {"row_number": 89, "cells": {"#": "88", "Final Corrected Claim": "A-recommended therapy for patients with HFmrEF", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.43; 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.43; 2026 PCP iVA p.25", "Note": null}}, {"row_number": 90, "cells": {"#": "89", "Final Corrected Claim": "ESC Guidelines recommend JARDIANCE for patients with HF,", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.25", "Note": null}}, {"row_number": 91, "cells": {"#": "90", "Final Corrected Claim": "JARDIANCE is 1A recommended for patients with3:", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.24 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.24", "Note": null}}, {"row_number": 92, "cells": {"#": "91", "Final Corrected Claim": "JARDIANCE is 1A recommended for patients with:", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.42 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.42", "Note": null}}, {"row_number": 93, "cells": {"#": "92", "Final Corrected Claim": "JARDIANCE is a guideline-recommended option that can help", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.41; 2026 PCP iVA p.23 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.41; 2026 PCP iVA p.23", "Note": null}}, {"row_number": 94, "cells": {"#": "93", "Final Corrected Claim": "JARDIANCE is a guideline-recommended treatment for patients with HF", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology | Source asset(s): 2026 Endo iVA; 2026 Card iVA | Page(s): 2026 Endo iVA p.43; 2026 Card iVA p.17 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA | 2026 Endo iVA p.43; 2026 Card iVA p.17", "Note": null}}, {"row_number": 95, "cells": {"#": "94", "Final Corrected Claim": "More than 100 endocrinology, nephrology, and cardiology guidelines", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.40 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.40", "Note": null}}, {"row_number": 96, "cells": {"#": "95", "Final Corrected Claim": "More than 100 nephrology, endocrinology, and cardiology guidelines", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.22 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA; 2026 PCP iVA p.22", "Note": null}}, {"row_number": 97, "cells": {"#": "96", "Final Corrected Claim": "Rapid sequencing is a guideline-recommended approach2,3", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.21 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2,3", "Reference": "2026 Card iVA | 2026 Card iVA p.21", "Note": null}}, {"row_number": 98, "cells": {"#": "97", "Final Corrected Claim": "Standard of care: All patients received appropriate treatments for HF, including diuretics, inhibitors of the renin-angiotensin system and neprilysin, beta blockers, mineralocorticoid receptor antagonists and, when indicated, cardiac devices.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.88; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.160; 2026 PCP iVA p.108 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.88; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.160; 2026 PCP iVA p.108", "Note": null}}, {"row_number": 99, "cells": {"#": "98", "Final Corrected Claim": "††Standard of care: All patients received a RAASi unless an investigator judged that a RAASi was not indicated or tolerated.5", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Cardiology, Primary Care | Source asset(s): 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.184; 2026 PCP iVA p.41; 2026 PCP iVA p.80 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "2026 Card iVA; 2026 PCP iVA; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.184; 2026 PCP iVA p.41; 2026 PCP iVA p.80", "Note": null}}, {"row_number": 100, "cells": {"#": "99", "Final Corrected Claim": "Based on a systematic review and network meta-analysis of randomised clinical trials investigating the effects of the recommended drug groups for HFrEF, or those that have recently been shown to improve clinical outcomes in adult patients with HFrEF.", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.127 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.127", "Note": null}}, {"row_number": 101, "cells": {"#": "100", "Final Corrected Claim": "*EMPEROR-Preserved included adult patients with chronic HF (NYHA class II, III, or IV) and preserved ejection fraction (LVEF &gt;40%).1", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Study/programme: EMPEROR-Preserved | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.97; 2026 Card iVA p.34; 2026 Card iVA p.57; 2026 Card iVA p.70; 2026 Card iVA p.73; 2026 Card iVA p.76; 2026 Card iVA p.85; 2026 Card iVA p.141; 2026 Card iVA p.169; 2026 Card iVA p.172; 2026 PCP iVA p.117 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "EMPEROR-Preserved | 2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.97; 2026 Card iVA p.34; 2026 Card iVA p.57; 2026 Card iVA p.70; 2026 Card iVA p.73; 2026 Card iVA p.76; 2026 Card iVA p.85; 2026 Card iVA p.141; 2026 Card iVA p.169; 2026 Card iVA p.172; 2026 PCP iVA p.117", "Note": null}}, {"row_number": 102, "cells": {"#": "101", "Final Corrected Claim": "*EMPEROR-Reduced included adult patients with chronic HF (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤40%).1", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Study/programme: EMPEROR-Reduced | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.97; 2026 Card iVA p.12; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 Card iVA p.34; 2026 Card iVA p.42; 2026 Card iVA p.76; 2026 Card iVA p.141; 2026 Card iVA p.166; 2026 Card iVA p.172; 2026 PCP iVA p.117 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "EMPEROR-Reduced | 2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.97; 2026 Card iVA p.12; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 Card iVA p.34; 2026 Card iVA p.42; 2026 Card iVA p.76; 2026 Card iVA p.141; 2026 Card iVA p.166; 2026 Card iVA p.172; 2026 PCP iVA p.117", "Note": null}}, {"row_number": 103, "cells": {"#": "102", "Final Corrected Claim": "*EMPEROR-Reduced included adult patients with chronic HF (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤40%).", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.55 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 PCP iVA; 2026 PCP iVA p.55", "Note": null}}, {"row_number": 104, "cells": {"#": "103", "Final Corrected Claim": "Despite being a guideline-recommended treatment across LVEF, \nSGLT2is remain underutilised to treat HF.", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.60 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.60", "Note": null}}, {"row_number": 105, "cells": {"#": "104", "Final Corrected Claim": "In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety of JARDIANCE 10 mg (n=1863) were evaluated vs placebo (n=1867). Patients were adults with chronic HF (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤40%). The primary endpoint in the EMPEROR- Reduced trial was a composite of CV death or hospitalisation for HF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint \n(HR=0.75; 95% CI: 0.65, 0.86; p&lt;0.001).", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29; 2026 PCP iVA p.111 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29; 2026 PCP iVA p.111", "Note": null}}, {"row_number": 106, "cells": {"#": "105", "Final Corrected Claim": "In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety of JARDIANCE 10 mg (n=2997) were evaluated vs placebo (n=2991). Patients were adults with chronic heart failure (NYHA class II, III, or IV) and preserved ejection fraction (LVEF &gt;40%). The primary endpoint in the EMPEROR-Preserved trial was a composite of CV death or HHF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 21% RRR in this endpoint \n(HR=0.79; 95% CI: 0.69, 0.90; p&lt;0.001).", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA | Page(s): 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.70; 2026 Card iVA p.73; 2026 Card iVA p.104 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.70; 2026 Card iVA p.73; 2026 Card iVA p.104", "Note": null}}, {"row_number": 107, "cells": {"#": "106", "Final Corrected Claim": "Patients were adults with chronic heart failure (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤40%).", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA | Page(s): 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 Card iVA p.67; 2026 Card iVA p.104 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 Card iVA p.67; 2026 Card iVA p.104", "Note": null}}, {"row_number": 108, "cells": {"#": "107", "Final Corrected Claim": "In addition to the RRR of all HHF, including first and recurrent events, the risk of total hospitalisations for any reason was also significantly reduced (HR=0.85; 95% CI: 0.75, 0.95).1 \n\nII Standard of care: All patients received appropriate treatments for heart failure, including diuretics, inhibitors of the renin-angiotensin system and neprilysin, beta blockers, mineralocorticoid receptor antagonists and, when indicated, cardiac devices.1", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 95%; HR=0.85; 95% CI: 0 | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.31 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.31", "Note": null}}, {"row_number": 109, "cells": {"#": "108", "Final Corrected Claim": "†Adult patients with chronic HF (NYHA class II, III, or IV) and preserved ejection fraction (LVEF &gt;40%).2", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 40% | Specialty context: Cardiology, Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.55 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 PCP iVA; 2026 PCP iVA p.55", "Note": null}}, {"row_number": 110, "cells": {"#": "109", "Final Corrected Claim": "Key inclusion criteria included a chronic HF (NYHA class II-IV) diagnosis, an elevated NT-proBNP level, and structural heart changes or documented hospitalisation for HF within 12 months. Elevated NT-proBNP is defined as a level of &gt;300 pg/mL or, for patients with atrial fibrillation at baseline, a level of &gt;900 pg/mL.2", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.85; 2026 Card iVA p.157; 2026 PCP iVA p.105 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "12", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.85; 2026 Card iVA p.157; 2026 PCP iVA p.105", "Note": null}}, {"row_number": 111, "cells": {"#": "110", "Final Corrected Claim": "‡Standard of care: All patients received appropriate treatments for heart failure, including diuretics, inhibitors of the renin-angiotensin system and neprilysin, beta blockers,", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.91; 2026 Endo iVA p.94; 2026 Card iVA p.163; 2026 PCP iVA p.111; 2026 PCP iVA p.114 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.91; 2026 Endo iVA p.94; 2026 Card iVA p.163; 2026 PCP iVA p.111; 2026 PCP iVA p.114", "Note": null}}, {"row_number": 112, "cells": {"#": "111", "Final Corrected Claim": "International T2D guidelines recommend the use of an", "Status": "Confirmed complete", "Indication": "Type 2 diabetes", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.40 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.40", "Note": null}}, {"row_number": 113, "cells": {"#": "112", "Final Corrected Claim": "JARDIANCE is 1A recommended for first-line treatment of CKD, with or without T2D", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.24 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 PCP iVA | 2026 PCP iVA p.24", "Note": "Observation text appears mismatched/unrelated to this row; claim itself is complete and matches duplicate entry (p.42) marked complete and substantiated"}}, {"row_number": 114, "cells": {"#": "113", "Final Corrected Claim": "JARDIANCE is 1A recommended for first-line treatment of CKD, with or without T2D9", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.42 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "9", "Reference": "2026 Endo iVA | 2026 Endo iVA p.42", "Note": null}}, {"row_number": 115, "cells": {"#": "114", "Final Corrected Claim": "In addition to reducing the risk of CV death when added to the standard of care, JARDIANCE lowered HbA1c,  weight and blood pressure. JARDIANCE is not indicated for weight loss or reduction of blood pressure.", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.31; 2026 Card iVA p.107; 2026 PCP iVA p.33 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 Endo iVA p.31; 2026 Card iVA p.107; 2026 PCP iVA p.33", "Note": null}}, {"row_number": 116, "cells": {"#": "115", "Final Corrected Claim": "In the EMPA-KIDNEY trial, a randomised, parallel-group, double-blind, placebo-controlled study of 6609 patients with CKD, the efficacy and safety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305).", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPA-KIDNEY | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.78; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.181; 2026 PCP iVA p.41 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPA-KIDNEY | 2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.78; 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104; 2026 Card iVA p.181; 2026 PCP iVA p.41", "Note": null}}, {"row_number": 117, "cells": {"#": "116", "Final Corrected Claim": "§In the EMPA-KIDNEY trial, a randomised, parallel-group, double-blind, placebo-controlled study of 6609 patients with CKD, the efficacy and safety of JARDIANCE 10 mg (n=3304) were evaluated vs placebo (n=3305).", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPA-KIDNEY | Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.24; 2026 PCP iVA p.29", "Note": null}}, {"row_number": 118, "cells": {"#": "117", "Final Corrected Claim": "¶¶Sustained insulin dose increase was defined as time to first increase in total daily insulin dose by &gt;20% from baseline total daily insulin dose, sustained for at least 2 consecutive visits at a minimum of 13 weeks apart, analysed in patients treated with insulin at baseline.8 ##Incident or worsening nephropathy is defined as progression to macroalbuminuria, doubling of serum creatinine, eGFR of ≤45 mL/min/1.73 m2; initiation of renal replacement therapy; death from renal disease.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 20% | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.32 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.32", "Note": null}}, {"row_number": 119, "cells": {"#": "118", "Final Corrected Claim": "There were no significant differences between the placebo and JARDIANCE groups of nonfatal MI (HR=0.87; 95% CI: 0.70, 1.09; p=0.22) or nonfatal stroke (HR=1.24; 95% CI: 0.92, 1.67; p=0.16).5 ||Pooled data from 10-mg and 25-mg doses of JARDIANCE; both doses showed a comparable reduction in the risk of CV death.5 ¶Standard of care included CV medications and glucose-lowering agents given at the discretion of healthcare providers and according to recommendations of local guidelines.5", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 95%; HR=0.87; HR=1.24; 95% CI: 0; p=0.22; p=0.16 | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.107 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5", "Reference": "2026 Card iVA | 2026 Card iVA p.107", "Note": null}}, {"row_number": 120, "cells": {"#": "119", "Final Corrected Claim": "#In a double-blind extension trial, adjusted mean changes in weight for patients with baseline BMI ≥35 at Week 76 were 0.23 kg for placebo (n=29), -3.74 kg for JARDIANCE 10 mg (n=33), and -4.77 kg for JARDIANCE 25 mg (n=41).", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 121, "cells": {"#": "120", "Final Corrected Claim": "*Key inclusion criteria included a chronic HF (NYHA class II-IV) diagnosis, an elevated NT-proBNP level, and therapy with the appropriate doses of HF medication. Elevated NT-proBNP is defined as a level of ≥1000 pg/mL in those with an ejection fraction of 31% to 35% or a level of ≥2500 pg/mL in those with an ejection fraction of 36% to 40%, as compared with a level of ≥600 pg/mL in those with an ejection fraction of ≤30%.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.85; 2026 Card iVA p.157; 2026 PCP iVA p.105 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.85; 2026 Card iVA p.157; 2026 PCP iVA p.105", "Note": null}}, {"row_number": 122, "cells": {"#": "121", "Final Corrected Claim": "In a subgroup analysis at 24 weeks of patients with baseline BMI ≥35, adjusted mean changes in weight were -0.34 kg for placebo (n=29), -2.63 kg for JARDIANCE 10 mg (n=33), and -3.35 kg for JARDIANCE 25 mg (n=41). Difference from placebo (adjusted mean) was -2.28 for JARDIANCE 10 mg and -3.01 for JARDIANCE 25 mg.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 25 mg; 10 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 123, "cells": {"#": "122", "Final Corrected Claim": "A convenient, easy-to-use option with once-daily, oral dosing1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.47; 2026 Card iVA p.90; 2026 Card iVA p.119 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.47; 2026 Card iVA p.90; 2026 Card iVA p.119", "Note": null}}, {"row_number": 124, "cells": {"#": "123", "Final Corrected Claim": "Initiate with JARDIANCE 10 mg. Continue with 10 mg in patients already taking JARDIANCE.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.47; 2026 PCP iVA p.44 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.47; 2026 PCP iVA p.44", "Note": null}}, {"row_number": 125, "cells": {"#": "124", "Final Corrected Claim": "In a double-blind extension trial, adjusted mean changes in weight for patients with baseline BMI ≥35 at Week 76 were 0.23 kg for placebo (n=29), -3.74 kg for JARDIANCE 10 mg (n=33), and -4.77 kg for JARDIANCE 25 mg (n=41). Difference from placebo (adjusted mean) was -3.96 kg for JARDIANCE 10 mg and -4.99 kg for JARDIANCE 25 mg. Missing data were imputed using the LOCF approach.3", "Status": "Corrected", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 126, "cells": {"#": "125", "Final Corrected Claim": "Initiate with JARDIANCE 10 mg. \nIn patients tolerating 10 mg and requiring additional glycaemic control, the dose can be increased to 25 mg.", "Status": "Corrected", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.47", "Note": null}}, {"row_number": 127, "cells": {"#": "126", "Final Corrected Claim": "JARDIANCE 25 mg (n=48). Difference from placebo (adjusted mean) was -0.73% for JARDIANCE 10 mg and -1.0% for JARDIANCE 25 mg. Missing data were imputed using the LOCF", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 0.73%; 1.0%; 25 mg; 10 mg | Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.36", "Note": null}}, {"row_number": 128, "cells": {"#": "127", "Final Corrected Claim": "JARDIANCE reduced the need for large increases in insulin dose¶¶8", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.29 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "8", "Reference": "2026 Endo iVA | 2026 Endo iVA p.29", "Note": null}}, {"row_number": 129, "cells": {"#": "128", "Final Corrected Claim": "for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p&lt;0.001 vs placebo for both doses.2", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 0.6%; p&lt;0.001; 25 mg; 10 mg | Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 PCP iVA | 2026 PCP iVA p.36", "Note": null}}, {"row_number": 130, "cells": {"#": "129", "Final Corrected Claim": "for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p&lt;0.001 vs placebo for both doses.2​", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 0.6%; p&lt;0.001; 25 mg; 10 mg | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.57 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.57", "Note": null}}, {"row_number": 131, "cells": {"#": "130", "Final Corrected Claim": "for JARDIANCE 25 mg (n=48). Difference from placebo (adjusted mean) was -0.73% for JARDIANCE 10 mg and -1.0% for JARDIANCE 25 mg. Missing data were imputed using the last", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 0.73%; 1.0%; 25 mg; 10 mg | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.57 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.57", "Note": null}}, {"row_number": 132, "cells": {"#": "131", "Final Corrected Claim": "§Adjusted mean change in systolic blood pressure from baseline at 24 weeks: JARDIANCE 10 mg -4.5 mm Hg (n=217), JARDIANCE 25 mg -5.2 mm Hg (n=213), vs placebo -0.4 mm Hg", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 133, "cells": {"#": "132", "Final Corrected Claim": "†Insulin and insulin secretagogues, such as sulphonylureas, may increase the risk of hypoglycaemia. Therefore, a lower dose of insulin or an insulin secretagogue may be required to reduce", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.48; 2026 PCP iVA p.45 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.48; 2026 PCP iVA p.45", "Note": null}}, {"row_number": 134, "cells": {"#": "133", "Final Corrected Claim": "||In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety of JARDIANCE 10 mg (n=2997) were evaluated vs placebo (n=2991).", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPEROR-Preserved | Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.21; 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.67 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.21; 2026 Endo iVA p.91; 2026 Card iVA p.25; 2026 Card iVA p.67", "Note": null}}, {"row_number": 135, "cells": {"#": "134", "Final Corrected Claim": "§In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety of JARDIANCE 10 mg (n=1863) were evaluated vs placebo (n=1867).", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPEROR-Reduced | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPEROR-Reduced | 2026 Card iVA | 2026 Card iVA p.25; 2026 Card iVA p.67; 2026 Card iVA p.104", "Note": null}}, {"row_number": 136, "cells": {"#": "135", "Final Corrected Claim": "The EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety of JARDIANCE 10 mg (n=1863) were evaluated vs placebo (n=1867).", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPEROR-Reduced | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.24; 2026 Endo iVA p.91; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 PCP iVA p.111 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPEROR-Reduced | 2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.24; 2026 Endo iVA p.91; 2026 Card iVA p.28; 2026 Card iVA p.31; 2026 PCP iVA p.111", "Note": null}}, {"row_number": 137, "cells": {"#": "136", "Final Corrected Claim": "In the EMPEROR-Preserved trial, a randomised, double-blind, parallel-group, placebo-controlled study of 5988 patients with HFpEF, the efficacy and safety of JARDIANCE 10 mg (n=2997) were evaluated vs placebo (n=2991).", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Study/programme: EMPEROR-Preserved | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA | Page(s): 2026 Endo iVA p.24; 2026 Card iVA p.70; 2026 Card iVA p.73 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 Endo iVA p.24; 2026 Card iVA p.70; 2026 Card iVA p.73", "Note": null}}, {"row_number": 138, "cells": {"#": "137", "Final Corrected Claim": "In a 24-week, double-blind, placebo-controlled study of 637 patients with T2D, the efficacy and safety of JARDIANCE 10 mg (n=217) and JARDIANCE 25 mg (n=213) as add-on therapy to metformin ≥1500 mg were evaluated vs placebo added to metformin (n=207).", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 139, "cells": {"#": "138", "Final Corrected Claim": "*Increase to 25 mg once daily in patients with T2D who tolerate 10 mg and need additional glycaemic control.1", "Status": "Confirmed complete", "Indication": "Type 2 diabetes", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 25 mg; 10 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.46; 2026 PCP iVA p.43 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.46; 2026 PCP iVA p.43", "Note": null}}, {"row_number": 140, "cells": {"#": "139", "Final Corrected Claim": "In patients with T2D tolerating 10 mg and requiring additional glycaemic control, the dose can be increased to 25 mg.", "Status": "Confirmed complete", "Indication": "Type 2 diabetes", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg; 25 mg | Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.44 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.44", "Note": null}}, {"row_number": 141, "cells": {"#": "140", "Final Corrected Claim": "Adjusted mean changes of -0.1% from baseline HbA1c 7.9% for placebo (n=207), -0.7% from baseline HbA1c 7.9% for JARDIANCE 10 mg (n=217), and -0.8% from baseline HbA1c 7.9% for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p&lt;0.001 vs placebo for both doses.", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 0.1%; 7.9%; 0.7%; 0.8%; 10 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.57; 2026 PCP iVA p.36 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.57; 2026 PCP iVA p.36", "Note": null}}, {"row_number": 142, "cells": {"#": "141", "Final Corrected Claim": "In a subgroup analysis at 24 weeks of patients with baseline ≥8.5%, adjusted mean changes in HbA1c were -0.5% for placebo (n=50), -1.2% for JARDIANCE 10 mg (n=57), and -1.5% for JARDIANCE 25 mg (n=48). Difference from placebo (adjusted mean) was -0.73% for JARDIANCE 10 mg and -1.0% for JARDIANCE 25 mg.", "Status": "Corrected", "Indication": "Type 2 diabetes", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 8.5%; 0.5%; 1.2%; 1.5%; 10 mg | Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.57 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 Endo iVA p.57", "Note": null}}, {"row_number": 143, "cells": {"#": "142", "Final Corrected Claim": "Continue with 10 mg in patients with T2D + eCVD already taking JARDIANCE.", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.47", "Note": null}}, {"row_number": 144, "cells": {"#": "143", "Final Corrected Claim": "Initiate with JARDIANCE 10 mg for treatment of T2D + eCVD.", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 10 mg | Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.47", "Note": null}}, {"row_number": 145, "cells": {"#": "144", "Final Corrected Claim": "Pooled data from the 10 mg and 25 mg doses of JARDIANCE showed a comparable reduction in the risk of hospitalisation for heart failure.", "Status": "Corrected", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.93 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.93", "Note": null}}, {"row_number": 146, "cells": {"#": "145", "Final Corrected Claim": "Pooled data from 10-mg and 25-mg doses of JARDIANCE; both doses showed a comparable reduction in the risk of CV death.", "Status": "Corrected", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Dosing / Administration", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.96 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.96", "Note": null}}, {"row_number": 147, "cells": {"#": "146", "Final Corrected Claim": "2024 KDIGO guidelines on CKD management recommend SGLT2is, such as JARDIANCE, for first-line treatment.", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.42; 2026 PCP iVA p.24 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.42; 2026 PCP iVA p.24", "Note": null}}, {"row_number": 148, "cells": {"#": "147", "Final Corrected Claim": "JARDIANCE, an SGLT2i, is recommended to reduce cardio-renal risk in high-risk patients with: \n• T2D + ASCVD\n• T2D + indicators of high risk\n• T2D + HF\n• T2D + CKD", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.41 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA | 2026 Endo iVA p.41", "Note": null}}, {"row_number": 149, "cells": {"#": "148", "Final Corrected Claim": "SGLT2is consistently improved cardio-renal outcomes across a wide \nrange of patients", "Status": "Corrected", "Indication": "Chronic kidney disease", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.129 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.129", "Note": null}}, {"row_number": 150, "cells": {"#": "149", "Final Corrected Claim": "EMPA-KIDNEY is the largest dedicated SGLT2i trial, evaluating JARDIANCE across a broad population with CKD", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Study/programme: EMPA-KIDNEY | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.180 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "EMPA-KIDNEY | 2026 Card iVA | 2026 Card iVA p.180", "Note": null}}, {"row_number": 151, "cells": {"#": "150", "Final Corrected Claim": "JARDIANCE is the first and only SGLT2i to show positive outcomes when initiated in the hospital within 1-5 days after stabilisation", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.33; 2026 Card iVA p.75; 2026 Card iVA p.138 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.33; 2026 Card iVA p.75; 2026 Card iVA p.138", "Note": null}}, {"row_number": 152, "cells": {"#": "151", "Final Corrected Claim": "International T2D guidelines recommend the use of an SGLT2i such as JARDIANCE as early as first line2-5", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.40 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2-5", "Reference": "2026 Endo iVA | 2026 Endo iVA p.40", "Note": null}}, {"row_number": 153, "cells": {"#": "152", "Final Corrected Claim": "SGLT2is are a Class I, Level A-recommended therapy for patients with HFrEF to reduce the risk of heart failure hospitalisation or cardiovascular death, making JARDIANCE 1 of 4 foundational treatments \nfor HFrEF6", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.43; 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.43; 2026 PCP iVA p.25", "Note": null}}, {"row_number": 154, "cells": {"#": "153", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are 1A recommended for first-line use4,5", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.25 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "4,5", "Reference": "2026 PCP iVA | 2026 PCP iVA p.25", "Note": null}}, {"row_number": 155, "cells": {"#": "154", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are Class I recommended \nfor first-line use in patients with CVD + T2D to reduce \nthe risk of CV events*3", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.17; 2026 Card iVA p.62 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.17; 2026 Card iVA p.62", "Note": null}}, {"row_number": 156, "cells": {"#": "155", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are Class I recommended for first-line use in patients with CVD + T2D to reduce the risk of CV events, independent of glucose control1", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.99 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.99", "Note": null}}, {"row_number": 157, "cells": {"#": "156", "Final Corrected Claim": "Your patients with HF require urgent and appropriate \nintervention with foundational treatments, like SGLT2is1", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.60 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2", "Reference": "2026 PCP iVA | 2026 PCP iVA p.60", "Note": null}}, {"row_number": 158, "cells": {"#": "157", "Final Corrected Claim": "International T2D, CKD, and HF guidelines recommend the use of an SGLT2i such as JARDIANCE as early as first line2-9", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.22 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2-9", "Reference": "2026 PCP iVA | 2026 PCP iVA p.22", "Note": null}}, {"row_number": 159, "cells": {"#": "158", "Final Corrected Claim": "More than 100 nephrology, endocrinology, and cardiology guidelines \nworldwide endorse the foundational use of SGLT2is, such as JARDIANCE1", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.40; 2026 PCP iVA p.22 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.40; 2026 PCP iVA p.22", "Note": null}}, {"row_number": 160, "cells": {"#": "159", "Final Corrected Claim": "Used alone” is defined as giving JARDIANCE without insulin or sulphonylureas.2 \n\n|| The mechanism of action of JARDIANCE is dependent on blood glucose levels, meaning it only removes glucose when levels are elevated. The risk of hypoglycaemia only increases when it’s combined with other medications that can cause low blood sugar, such as insulin or sulphonylureas.2,3", "Status": "Corrected", "Indication": "General", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.114 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.114", "Note": null}}, {"row_number": 161, "cells": {"#": "160", "Final Corrected Claim": "Based on claims data sources of adult patients with HFrEF in Japan (Medical Data Vision claims registry), Sweden (nationwide administrative registries), and the United States (C212Optum de-identified Market Clarity Data). At study onset, dapagliflozin was the available SGLT2i approved for use in patients with HFrEF in the United States.2", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.127 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 Card iVA | 2026 Card iVA p.127", "Note": null}}, {"row_number": 162, "cells": {"#": "161", "Final Corrected Claim": "As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFmrEF and HFpEF to reduce the risk of heart failure hospitalisation or cardiovascular death2", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.17; 2026 Card iVA p.62 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.17; 2026 Card iVA p.62", "Note": null}}, {"row_number": 163, "cells": {"#": "162", "Final Corrected Claim": "In the 2022 AHA/ACC/HFSA Guideline for the Management of HF JARDIANCE, as an SGLT2i, is recommended for adult patients with HFrEF1", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.14 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.14", "Note": null}}, {"row_number": 164, "cells": {"#": "163", "Final Corrected Claim": "JARDIANCE, as an SGLT2i, is recommended for adult patients with HFpEF1 In the 2022 AHA/ACC/HFSA Guideline for the Management of HF", "Status": "Confirmed complete", "Indication": "Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.59 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.59", "Note": null}}, {"row_number": 165, "cells": {"#": "164", "Final Corrected Claim": "Rapid sequencing rationale: Drugs should be prioritised based on efficacy, safety, and ease of use, initiating an additional GDMT class likely yields a greater benefit than titrating a class in use, and background therapy can facilitate the use of other drugs by enhancing safety.1", "Status": "Corrected", "Indication": "Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.22 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.22", "Note": null}}, {"row_number": 166, "cells": {"#": "165", "Final Corrected Claim": "ESC Guidelines: As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFpEF to reduce the risk of CV death or HHF.2", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.63 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 Card iVA | 2026 Card iVA p.63", "Note": null}}, {"row_number": 167, "cells": {"#": "166", "Final Corrected Claim": "ESC Guidelines: As an SGLT2i, JARDIANCE is a Class I, Level A-recommended therapy for patients with HFrEF to reduce the risk of CV death or HHF.1", "Status": "Confirmed complete", "Indication": "Heart failure; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.18 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.18", "Note": null}}, {"row_number": 168, "cells": {"#": "167", "Final Corrected Claim": "ARR was estimated as the absolute difference in the proportion of events by treatment arm. NNT=1/ARR. NNT is per 2 years at risk.\n\n‖ Standard of care: All patients received a RAASi unless an investigator judged that a RAASi was not indicated or tolerated.", "Status": "Corrected", "Indication": "Type 2 diabetes; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.181 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.181", "Note": null}}, {"row_number": 169, "cells": {"#": "168", "Final Corrected Claim": "*Based on a consortium that was tasked with compiling and meta-analysing the best available data to provide a more comprehensive assessment of the independent and combined associations of eGFR and albuminuria with mortality and kidney outcomes. Results are from the findings from a collaborative meta-analysis of the 21 general population cohorts for all-cause and cardiovascular mortality, which included &gt;100,000 individuals with uACR measurements and 1.1 million participants with dipstick measurements", "Status": "Corrected", "Indication": "Type 2 diabetes; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.9 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.9", "Note": null}}, {"row_number": 170, "cells": {"#": "169", "Final Corrected Claim": "Primary care guidelines recommend including SGLT2is, such as JARDIANCE, as part of initial therapy for patients with T2D at high or very high cardiovascular risk7 ESC guidelines include SGLT2is, such as JARDIANCE, as Class I, Level A-recommended therapy for patients with eCVD and T2D to reduce cardiovascular events, independent of baseline or target HbA1c6", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.23 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "6", "Reference": "2026 PCP iVA | 2026 PCP iVA p.23", "Note": null}}, {"row_number": 171, "cells": {"#": "170", "Final Corrected Claim": "SGLT2is, such as JARDIANCE, are Class I recommended for first-line use in patients with eCVD + T2D to reduce the risk of CV events8", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.43 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "8", "Reference": "2026 Endo iVA | 2026 Endo iVA p.43", "Note": null}}, {"row_number": 172, "cells": {"#": "171", "Final Corrected Claim": "SGLT2is reduced the risk of composite HHF or CV mortality by 22% In a meta-analysis examining 15 studies with SGLT2is in CVD, T2D, and CKD", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease", "Key Message Type": "Mechanism of action", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 22% | Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.130 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.130", "Note": null}}, {"row_number": 173, "cells": {"#": "172", "Final Corrected Claim": "Very common AEs: hypoglycaemia (when used with sulphonylurea or insulin). JARDIANCE has a placebo-like incidence of hypoglycaemia when added to metformin; volume \ndepletion. Selected uncommon AE: diabetic ketoacidosis. Rare AE: necrotising fasciitis of the perineum (Fournier’s gangrene).", "Status": "Corrected", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA | Page(s): 2026 Endo iVA p.37 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Endo iVA; 2026 Endo iVA p.37", "Note": null}}, {"row_number": 174, "cells": {"#": "173", "Final Corrected Claim": "JARDIANCE is contraindicated in patients with hypersensitivity to the active substance or to any of the excipients of JARDIANCE. JARDIANCE should not be used in patients with type 1 diabetes or for the treatment of DKA. JARDIANCE should be used with caution in patients who may be at a higher risk of ketoacidosis while taking JARDIANCE. In patients where DKA is suspected or diagnosed, treatment with JARDIANCE should be discontinued immediately. For use in patients with renal impairment, please refer to the dosing page of this document and the SmPC.1", "Status": "Corrected", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.54; 2026 Card iVA p.48; 2026 Card iVA p.91; 2026 Card iVA p.120; 2026 PCP iVA p.51 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.54; 2026 Card iVA p.48; 2026 Card iVA p.91; 2026 Card iVA p.120; 2026 PCP iVA p.51", "Note": null}}, {"row_number": 175, "cells": {"#": "174", "Final Corrected Claim": "Rates of hypoglycaemia were similar between JARDIANCE and placebo1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.65; 2026 PCP iVA p.98 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.65; 2026 PCP iVA p.98", "Note": null}}, {"row_number": 176, "cells": {"#": "175", "Final Corrected Claim": "Rates of hypoglycaemia‡ were similar between JARDIANCE \nand placebo in patients with or without T2D1", "Status": "Corrected", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.96; 2026 Card iVA p.41; 2026 Card iVA p.84; 2026 Card iVA p.171; 2026 PCP iVA p.116 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.96; 2026 Card iVA p.41; 2026 Card iVA p.84; 2026 Card iVA p.171; 2026 PCP iVA p.116", "Note": null}}, {"row_number": 177, "cells": {"#": "176", "Final Corrected Claim": "Very common AEs: hypoglycaemia (when used with sulphonylurea or insulin). JARDIANCE has a placebo-like incidence of hypoglycaemia when added to metformin; volume depletion. Selected uncommon AE: diabetic ketoacidosis. Rare AE: necrotising fasciitis of the perineum (Fournier’s gangrene", "Status": "Corrected", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.47 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 PCP iVA | 2026 PCP iVA p.47", "Note": null}}, {"row_number": 178, "cells": {"#": "177", "Final Corrected Claim": "When used alone,§ JARDIANCE does not inherently cause hypoglycaemia||2​", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.113 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA p.113", "Note": null}}, {"row_number": 179, "cells": {"#": "178", "Final Corrected Claim": "the risk of hypoglycaemia when used in combination with JARDIANCE.1", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.48; 2026 PCP iVA p.45 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.48; 2026 PCP iVA p.45", "Note": null}}, {"row_number": 180, "cells": {"#": "179", "Final Corrected Claim": "†Ketoacidosis occurred in one patient (in the JARDIANCE group) without diabetes at baseline.2", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.81; 2026 PCP iVA p.83 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "2", "Reference": "2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.81; 2026 PCP iVA p.83", "Note": null}}, {"row_number": 181, "cells": {"#": "180", "Final Corrected Claim": "‡Hypoglycaemic AEs with a plasma glucose value of ≤70 mg/dL (3.9 mmol/L) or that required assistance.1,2", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Quantitative detail: 70 mg | Specialty context: Cardiology, Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 Card iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.66; 2026 Endo iVA p.97; 2026 Card iVA p.42 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1,2", "Reference": "2026 Card iVA; 2026 Endo iVA; 2026 PCP iVA; 2026 Endo iVA p.66; 2026 Endo iVA p.97; 2026 Card iVA p.42", "Note": null}}, {"row_number": 182, "cells": {"#": "181", "Final Corrected Claim": "‡Ketoacidosis occurred in 1 patient (in the JARDIANCE group) without diabetes at baseline.", "Status": "Confirmed complete", "Indication": "General", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardio-Renal, Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.187 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA; 2026 Card iVA p.187", "Note": null}}, {"row_number": 183, "cells": {"#": "182", "Final Corrected Claim": "The mechanism of action of JARDIANCE is dependent on blood glucose levels, meaning it only removes glucose when levels are elevated. The risk of hypoglycaemia only increases when it’s combined with other medications that can cause low blood sugar, such as insulin or sulphonylureas.2", "Status": "Corrected", "Indication": "Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.114 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "See source asset footnotes and local label.", "Reference": "2026 Card iVA | 2026 Card iVA p.114", "Note": null}}, {"row_number": 184, "cells": {"#": "183", "Final Corrected Claim": "Treat early to reduce the risk of hospitalisation or CV death in your patients3", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Campaign / Messaging", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.5; 2026 Card iVA p.50 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "3", "Reference": "2026 Card iVA | 2026 Card iVA p.5; 2026 Card iVA p.50", "Note": null}}, {"row_number": 185, "cells": {"#": "184", "Final Corrected Claim": "reduce their risk of hospitalisation or CV death5,6", "Status": "Confirmed complete", "Indication": "Cardiovascular risk / established CVD", "Key Message Type": "Campaign / Messaging", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Primary Care | Source asset(s): 2026 PCP iVA | Page(s): 2026 PCP iVA p.57 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "5,6", "Reference": "2026 PCP iVA | 2026 PCP iVA p.57", "Note": null}}, {"row_number": 186, "cells": {"#": "185", "Final Corrected Claim": "JARDIANCE can help you stay committed by: offering protection by reducing the risk of CV death for adult patients with T2D + eCVD; reducing the risk of CV death and HHF for adult patients with HF; reducing the risk of kidney disease progression or CV death in adult patients with CKD; and lowering HbA1c in adult patients with T2D.1", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Campaign / Messaging", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Endocrinology, Primary Care | Source asset(s): 2026 Endo iVA; 2026 PCP iVA | Page(s): 2026 Endo iVA p.1; 2026 PCP iVA p.1 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Endo iVA; 2026 PCP iVA | 2026 Endo iVA p.1; 2026 PCP iVA p.1", "Note": null}}, {"row_number": 187, "cells": {"#": "186", "Final Corrected Claim": "JARDIANCE can help you stay committed by: offering protection by reducing the risk of CV death for adult patients with eCVD + T2D; reducing the risk of CV death and HHF for adult patients with HF; reducing the risk of kidney disease progression or CV death in adult patients with CKD; and lowering HbA1c in adult patients with T2D.1", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Campaign / Messaging", "End Audience": "HCP/Internal", "Contextual Information": "Specialty context: Cardiology | Source asset(s): 2026 Card iVA | Page(s): 2026 Card iVA p.1 | Extracted only from the included 2026 iVAs; local medical, legal and regulatory validation is required.", "Footnotes": "1", "Reference": "2026 Card iVA | 2026 Card iVA p.1", "Note": null}}, {"row_number": 188, "cells": {"#": "187", "Final Corrected Claim": "JARDIANCE can help you stay committed by: offering protection by reducing the risk of CV death for adult patients with T2D + eCVD; reducing the risk of CV death and HHF for adult patients with HF; reducing the risk of kidney disease progression or CV death in adult patients with CKD; and lowering HbA1c in adult patients with T2D.", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "2026 Nephrology iVA overarching benefit statement. Local label and mandatory qualifiers must be checked before reuse. Source: PC-CRP-105591, page 1.", "Footnotes": "1", "Reference": "JARDIANCE Summary of Product Characteristics, June 2025 | PC-CRP-105591 Nephrology iVA 2026, p.1", "Note": null}}, {"row_number": 189, "cells": {"#": "188", "Final Corrected Claim": "Your patients with CKD are more likely to die from CVD than to progress to kidney failure. Nearly 1 in 2 patients with CKD will die from CVD before reaching end-stage kidney disease and requiring dialysis.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP / Internal", "Contextual Information": "Disease-burden statement; not a product efficacy claim. Source: PC-CRP-105591 Nephrology iVA 2026, page 5.", "Footnotes": "1,2", "Reference": "PC-CRP-105591 Nephrology iVA 2026, p.5", "Note": null}}, {"row_number": 190, "cells": {"#": "189", "Final Corrected Claim": "CV mortality risk is elevated even at low albuminuria levels.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Disease education / Unmet need", "End Audience": "HCP / Internal", "Contextual Information": "CKD disease-risk statement based on albuminuria and kidney function risk stratification. Source: PC-CRP-105591, page 8.", "Footnotes": "1", "Reference": "PC-CRP-105591 Nephrology iVA 2026, p.8", "Note": null}}, {"row_number": 191, "cells": {"#": "190", "Final Corrected Claim": "JARDIANCE provides kidney and CV protection as demonstrated in multiple clinical trials spanning a decade.", "Status": "Confirmed complete", "Indication": "Type 2 diabetes; Heart failure; Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Umbrella statement linked to EMPA-REG OUTCOME, EMPEROR-Reduced, EMPEROR-Preserved and EMPA-KIDNEY. Must be used with indication-specific outcomes and footnotes. Source: PC-CRP-105591, pages 14–17.", "Footnotes": "1-5", "Reference": "EMPA-REG OUTCOME | EMPEROR-Reduced | EMPEROR-Preserved | EMPA-KIDNEY | PC-CRP-105591, pp.14-17", "Note": null}}, {"row_number": 192, "cells": {"#": "191", "Final Corrected Claim": "In EMPA-KIDNEY, JARDIANCE reduced the risk of kidney disease progression or cardiovascular death by 28% versus placebo.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "EMPA-KIDNEY primary composite endpoint: HR=0.72; 95% CI: 0.64, 0.82; p&lt;0.001. Use with complete trial population and standard-of-care qualifiers. Source: PC-CRP-105591, page 18.", "Footnotes": "1,3", "Reference": "Herrington WG et al. N Engl J Med. 2023; 388:117-127 | EMPA-KIDNEY | PC-CRP-105591, pp.18-20", "Note": null}}, {"row_number": 193, "cells": {"#": "192", "Final Corrected Claim": "EMPA-KIDNEY studied JARDIANCE across a broad spectrum of patients with CKD, including understudied patient populations.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Clinical evidence / Study population", "End Audience": "HCP / Internal", "Contextual Information": "Includes patients across a wide uACR and eGFR range, with and without T2D or CVD, and with or without RAAS inhibitor use. Source: PC-CRP-105591, pages 21–23.", "Footnotes": "1-3", "Reference": "EMPA-KIDNEY | PC-CRP-105591, pp.21-23", "Note": null}}, {"row_number": 194, "cells": {"#": "193", "Final Corrected Claim": "JARDIANCE slowed eGFR decline over time in patients with CKD with or without type 2 diabetes.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Long-term eGFR slope outcome from EMPA-KIDNEY. Annual decline presented in the asset: -1.37 with JARDIANCE versus -2.75 mL/min/1.73 m²/year with placebo. Use the complete outcome qualification. Source: PC-CRP-105591, pages 27–29.", "Footnotes": "1", "Reference": "EMPA-KIDNEY | PC-CRP-105591, pp.27-29", "Note": null}}, {"row_number": 195, "cells": {"#": "194", "Final Corrected Claim": "JARDIANCE can help protect kidney function in patients with CKD who have low albuminuria.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Linked to slowed eGFR decline across the uACR spectrum. The primary composite subgroup result was not statistically significant in the uACR &lt;30 mg/g subgroup; retain the eGFR-slope qualification. Source: PC-CRP-105591, pages 33–36.", "Footnotes": "1", "Reference": "EMPA-KIDNEY | PC-CRP-105591, pp.33-36", "Note": null}}, {"row_number": 196, "cells": {"#": "195", "Final Corrected Claim": "JARDIANCE reduced kidney disease progression regardless of diabetes status.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Based on a subsidiary EMPA-KIDNEY analysis across causes of CKD. The analysis type and outcome definition must remain linked. Source: PC-CRP-105591, pages 37–39.", "Footnotes": "1", "Reference": "EMPA-KIDNEY subsidiary analysis | PC-CRP-105591, pp.37-39", "Note": null}}, {"row_number": 197, "cells": {"#": "196", "Final Corrected Claim": "JARDIANCE may slow the onset of dialysis by more than 20 years in selected patients with CKD.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Modelled extrapolation based on EMPA-KIDNEY eGFR slope, not an observed clinical-trial endpoint. Must always be described as extrapolated and not as a guaranteed individual outcome. Source: PC-CRP-105591, pages 40–46.", "Footnotes": "1", "Reference": "Extrapolated EMPA-KIDNEY eGFR-slope analysis | PC-CRP-105591, pp.40-46", "Note": null}}, {"row_number": 198, "cells": {"#": "197", "Final Corrected Claim": "In the EMPOWER meta-analysis, JARDIANCE reduced the risk of acute kidney injury by 27% and the risk of a 50% or greater increase in serum creatinine by 20%.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Heart failure; Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Meta-analysis across CKD, HF and T2D + eCVD populations. AKI HR=0.73; 95% CI: 0.63, 0.85. Creatinine increase HR=0.80; 95% CI: 0.72, 0.88. Source: PC-CRP-105591, pages 60–62.", "Footnotes": "1", "Reference": "EMPOWER meta-analysis | PC-CRP-105591, pp.60-62", "Note": null}}, {"row_number": 199, "cells": {"#": "198", "Final Corrected Claim": "In the EMPOWER meta-analysis, JARDIANCE reduced the risk of kidney failure by 34% and kidney disease progression by 30%.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Heart failure; Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Meta-analysis across CKD, HF and T2D + eCVD populations. Kidney failure HR=0.66; 95% CI: 0.55, 0.79. Kidney disease progression HR=0.70; 95% CI: 0.63, 0.78. Source: PC-CRP-105591, pages 63–65.", "Footnotes": "1", "Reference": "EMPOWER meta-analysis | PC-CRP-105591, pp.63-65", "Note": null}}, {"row_number": 200, "cells": {"#": "199", "Final Corrected Claim": "The risk of selected serious adverse events with JARDIANCE remained low and comparable with placebo in more than 20,000 patients.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease; Heart failure; Type 2 diabetes; Cardiovascular risk / established CVD", "Key Message Type": "Safety / Tolerability", "End Audience": "HCP / Internal", "Contextual Information": "Meta-analysis statement covering selected serious adverse events. It does not replace the complete locally approved safety information. Source: PC-CRP-105591, pages 66–68.", "Footnotes": "1", "Reference": "Safety outcomes meta-analysis | PC-CRP-105591, pp.66-68", "Note": null}}, {"row_number": 201, "cells": {"#": "200", "Final Corrected Claim": "The 2024 KDIGO guideline reinforces SGLT2 inhibitors as an early and foundational therapy for the management of CKD.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Guideline / Standard of care", "End Audience": "HCP / Internal", "Contextual Information": "Class-level recommendation applying to defined patient groups by eGFR, albuminuria, T2D and HF status. Avoid implying an exclusive recommendation for JARDIANCE. Source: PC-CRP-105591, pages 72–75.", "Footnotes": "1", "Reference": "KDIGO 2024 Clinical Practice Guideline for CKD | PC-CRP-105591, pp.72-75", "Note": null}}, {"row_number": 202, "cells": {"#": "201", "Final Corrected Claim": "JARDIANCE is a once-daily oral treatment with no titration, can be taken at any time of day with or without food, and can be initiated down to an eGFR of 20 mL/min/1.73 m².", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Dosing / Administration", "End Audience": "HCP / Internal", "Contextual Information": "The asset presents 10 mg once daily as the starting and recommended dose. Initiation and continuation thresholds must be checked against the current local label. Source: PC-CRP-105591, pages 76–78.", "Footnotes": "1,2", "Reference": "JARDIANCE Summary of Product Characteristics, June 2025 | PC-CRP-105591, pp.76-78", "Note": null}}, {"row_number": 203, "cells": {"#": "202", "Final Corrected Claim": "JARDIANCE works by inhibiting SGLT2\" which is the title of the slide and next point is \"JARDIANCE reduces glucose and sodium reabsorption and increases delivery of sodium to the distal tubule", "Status": "Corrected", "Indication": "Type 2 diabetes; Chronic kidney disease; Heart failure", "Key Message Type": "Mechanism of action", "End Audience": "HCP / Internal", "Contextual Information": "Linked in the asset to increased urinary glucose excretion, tubuloglomerular feedback and reduced intraglomerular pressure. Proposed cardiovascular mechanisms should not be presented as proven clinical mediators. Source: PC-CRP-105591, pages 79–81.", "Footnotes": "1", "Reference": "JARDIANCE Summary of Product Characteristics | PC-CRP-105591, pp.79-81", "Note": null}}, {"row_number": 204, "cells": {"#": "203", "Final Corrected Claim": "In EMPA-KIDNEY, JARDIANCE reduced first and recurrent all-cause hospitalisation by 14% versus placebo.", "Status": "Confirmed complete", "Indication": "Chronic kidney disease", "Key Message Type": "Efficacy / Clinical benefit", "End Audience": "HCP / Internal", "Contextual Information": "Key secondary outcome including first and all subsequent all-cause hospitalisations. HR=0.86; 95% CI: 0.78, 0.95; p=0.003. Source: PC-CRP-105591, pages 121–123.", "Footnotes": "1,2", "Reference": "Herrington WG et al. N Engl J Med. 2023; 388:117-127 | Data on file | PC-CRP-105591, pp.121-123", "Note": null}}]}</data>
  <data key="d3">Table</data>
  <data key="d4">jardiance</data>
  <data key="d5">Final Corrected Claims</data>
</node>
