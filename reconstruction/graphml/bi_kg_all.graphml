<node id="urn:kg:jardiance:section:114a1fc0-9233-45ea-9645-ccd2dc027ac7">
  <data key="d0">brand</data>
  <data key="d20">Prioritise heart health in patients with CRM conditions</data>
  <data key="d19">heading</data>
  <data key="d8">12</data>
  <data key="d9">brand_book</data>
  <data key="d10">114a1fc0-9233-45ea-9645-ccd2dc027ac7</data>
  <data key="d11">docling</data>
