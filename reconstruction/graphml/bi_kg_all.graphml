<node id="urn:kg:jardiance:section:25ad1cc1-11e6-4b22-9551-82f85a0684f1">
  <data key="d0">brand</data>
  <data key="d19">body</data>
  <data key="d8">23</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">25ad1cc1-11e6-4b22-9551-82f85a0684f1</data>
  <data key="d11">docling</data>
