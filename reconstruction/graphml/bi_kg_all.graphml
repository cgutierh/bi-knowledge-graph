<node id="urn:kg:jardiance:section:5ce6e48d-445d-4112-ba0d-7047a75d4283">
  <data key="d0">brand</data>
  <data key="d20">Branding elements:</data>
  <data key="d19">heading</data>
  <data key="d8">36</data>
  <data key="d9">brand_book</data>
