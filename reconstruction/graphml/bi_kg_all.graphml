<node id="urn:kg:jardiance:section:740a999c-76ab-44be-92cd-b14e42ae2a07">
  <data key="d0">brand</data>
  <data key="d20">Rare</data>
  <data key="d19">heading</data>
  <data key="d8">54</data>
  <data key="d9">product_information</data>
  <data key="d10">740a999c-76ab-44be-92cd-b14e42ae2a07</data>
