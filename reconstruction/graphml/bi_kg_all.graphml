  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Disease education / Unmet need</data>
  <data key="d27">The 14% RRR in 3-point MACE (HR=0.86; 95% CI: 0.74, 0.99; p&lt;0.001 for noninferiority; p=0.04 for superiority) was driven by a reduction in the risk of CV death (HR=0.62; 95% CI: 0.49, 0.77); there was no change in risk of nonfatal MI (HR=0.87; 95% CI: 0.70, 1.09) or nonfatal stroke (HR=1.24; 95% CI: 0.92, 1.67).1</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">53</data>
  <data key="d34">Cardiovascular risk / established CVD</data>
  <data key="d12">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
