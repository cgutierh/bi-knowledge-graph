<node id="urn:kg:boehringer-ingelheim:section:1dd69269-a01f-4a12-8b0d-709ce00e7959">
  <data key="d0">brand</data>
  <data key="d20">Introduction: Imagery</data>
  <data key="d19">heading</data>
  <data key="d8">1</data>
  <data key="d9">guidance_document</data>
  <data key="d10">1dd69269-a01f-4a12-8b0d-709ce00e7959</data>
  <data key="d11">docling</data>
  <data key="d12">Introduction - Imagery.pdf</data>
  <data key="d14">ded4ae29-e5c0-417b-8c08-00855d252370</data>
  <data key="d16">Our imagery is a key part of how we visualize the Unwavering Optimism of our brand story. By focusing on the resilience and energy of everyday living, we also zoom in on the profound and significant details that capture connections between people, animals and society.

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">boehringer-ingelheim</data>
  <data key="d5">Introduction - Imagery.pdf</data>
</node>
