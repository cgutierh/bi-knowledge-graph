<node id="urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:202">
  <data key="d0">brand</data>
  <data key="d33">HCP / Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">JARDIANCE is a once-daily oral treatment with no titration, can be taken at any time of day with or without food, and can be initiated down to an eGFR of 20 mL/min/1.73 m².</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
