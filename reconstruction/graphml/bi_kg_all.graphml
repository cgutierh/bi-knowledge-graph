<node id="urn:kg:ofev:section:c32f82a0-7397-487b-b65d-1cbb6df7becd">
  <data key="d0">brand</data>
  <data key="d20">hcP Branded Identity System 3.0</data>
  <data key="d19">heading</data>
  <data key="d8">28</data>
  <data key="d9">brand_book</data>
  <data key="d10">c32f82a0-7397-487b-b65d-1cbb6df7becd</data>
