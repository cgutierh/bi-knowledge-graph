</node>
<node id="urn:kg:jardiance:section:fe085a7b-a98a-4459-8eaa-b79d7c8a820b">
  <data key="d0">brand</data>
  <data key="d20">Print layers</data>
  <data key="d19">heading</data>
  <data key="d8">39</data>
  <data key="d9">brand_book</data>
  <data key="d10">fe085a7b-a98a-4459-8eaa-b79d7c8a820b</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">&lt;!-- image --&gt;

&lt;!-- image --&gt;

-   All 3 layers must be shown
-   All 3 layers must be full saturation of yellow, teal, and grey
-   JARDIANCE data/key messages need to be a primary focus
-   Include lifestyle imagery inside the frame when space allows
-   Images can be scaled back to 1/4 or 1/3 of the page depending on the print schematic

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
