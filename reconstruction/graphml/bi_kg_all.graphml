<node id="urn:kg:ofev:chunk:b97af278-7722-400a-a960-f3e25a4d9250">
  <data key="d0">brand</data>
  <data key="d6">151</data>
  <data key="d7">87</data>
  <data key="d8">59</data>
  <data key="d9">brand_book</data>
  <data key="d10">d8624806-6eb4-4b24-a32f-1fa592abb4ac</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d13">ca47d898cc8072b7283a1c196a4da8aa4cbe61a6ae7fb2b2412c6a25952cace2</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d15">b97af278-7722-400a-a960-f3e25a4d9250</data>
  <data key="d16">The HCP unbranded identity system comprises key assets that are designed, managed, and used in a recognizable way across all of our disease state communication materials.

Our identity system unifies our unbranded materials in a consistent, flexible, and ownable way across all channels, allowing us to communicate consistently to the HCP community.</data>
  <data key="d3">Chunk</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
<node id="urn:kg:ofev:chunk:5a04ec6a-35ab-44bf-b2d9-29eb1988ea4f">
  <data key="d0">brand</data>
  <data key="d6">152</data>
  <data key="d7">1</data>
  <data key="d8">60</data>
  <data key="d9">brand_book</data>
  <data key="d10">24f0c4b5-9c1f-4034-af17-2e27ec66c546</data>
