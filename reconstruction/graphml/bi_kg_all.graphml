  <data key="d0">brand</data>
  <data key="d20">Avoid forced and staged scenes.</data>
  <data key="d19">heading</data>
  <data key="d8">2</data>
  <data key="d9">guidance_document</data>
  <data key="d10">1f50455e-dd19-46cb-8a01-e3a70eb62630</data>
  <data key="d11">docling</data>
  <data key="d12">Imagery Production.pdf</data>
  <data key="d14">0f55abc8-b39d-49f3-a7b4-22747fd324cd</data>
  <data key="d16">Explore emotions that feel authentic.

- Check out the Imagery. chapter to read more about the proximity and intensity scales.</data>
  <data key="d3">Section</data>
  <data key="d4">boehringer-ingelheim</data>
  <data key="d5">Imagery Production.pdf</data>
</node>
<node id="urn:kg:boehringer-ingelheim:section:d9c712f7-9012-4e42-99fe-e8d47eb0656c">
  <data key="d0">brand</data>
  <data key="d20">How to use</data>
  <data key="d19">heading</data>
  <data key="d8">2</data>
  <data key="d9">guidance_document</data>
  <data key="d10">d9c712f7-9012-4e42-99fe-e8d47eb0656c</data>
  <data key="d11">docling</data>
