<node id="urn:kg:jardiance:section:9a455c12-0a2f-490c-976b-807141f7ac6c">
  <data key="d0">brand</data>
  <data key="d20">Creates urgency:</data>
  <data key="d19">heading</data>
  <data key="d8">14</data>
  <data key="d9">brand_book</data>
  <data key="d10">9a455c12-0a2f-490c-976b-807141f7ac6c</data>
  <data key="d11">docling</data>
