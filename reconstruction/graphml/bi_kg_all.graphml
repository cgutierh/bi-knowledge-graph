<node id="urn:kg:ofev:chunk:9215c1b0-e31f-4d23-af1e-51fd5b82d44e">
  <data key="d0">brand</data>
  <data key="d6">123</data>
  <data key="d7">115</data>
  <data key="d8">22</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">ce5bae28-2e04-4264-918e-5980b4dd50a7</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_PI.pdf</data>
  <data key="d13">7429d60078294f297b09e67da648195ed6497deb318e04bd503b5d94198e7d96</data>
