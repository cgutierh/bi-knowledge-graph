  <data key="d32">Corrected</data>
  <data key="d3">Claim</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx</data>
</node>
<node id="urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:122">
  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">In a subgroup analysis at 24 weeks of patients with baseline BMI ≥35, adjusted mean changes in weight were -0.34 kg for placebo (n=29), -2.63 kg for JARDIANCE 10 mg (n=33), and -3.35 kg for JARDIANCE 25 mg (n=41). Difference from placebo (adjusted mean) was -2.28 for JARDIANCE 10 mg and -3.01 for JARDIANCE 25 mg.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">122</data>
