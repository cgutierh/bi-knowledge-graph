</node>
<node id="urn:kg:ofev:section:a92bc9ec-5a1e-4db5-ac8c-cf0c815f43a7">
  <data key="d0">brand</data>
  <data key="d20">SUBHEADS SHOULD BE CO TEXT BOLD ALL CAPS</data>
  <data key="d19">heading</data>
  <data key="d8">18</data>
  <data key="d9">brand_book</data>
  <data key="d10">a92bc9ec-5a1e-4db5-ac8c-cf0c815f43a7</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">Body copy should be Gotham Book sentence case in 80%K. Body call-outs should be in Gotham Bold.</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
