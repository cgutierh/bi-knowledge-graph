  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
<node id="urn:kg:ofev:section:04476e36-8a43-4bb4-aada-998924622c29">
  <data key="d0">brand</data>
  <data key="d20">Line Pattern</data>
  <data key="d19">heading</data>
  <data key="d8">22</data>
  <data key="d9">brand_book</data>
  <data key="d10">04476e36-8a43-4bb4-aada-998924622c29</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">A line pattern inspired by the core campaign has been incorporated into the Guardian Blue shape in our secondary graphic. The change of the angle in the line pattern reinforces the idea that OFEV ®  is changing the path of IPF.

This line pattern should only appear within the Guardian Blue shape in our secondary graphic.

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
