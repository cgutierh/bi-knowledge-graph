</node>
<node id="urn:kg:jardiance:chunk:97cc29d2-be61-4d5d-b724-5f212f6b5af4">
  <data key="d0">brand</data>
  <data key="d6">186</data>
  <data key="d7">34</data>
  <data key="d8">34</data>
  <data key="d9">product_information</data>
  <data key="d10">a13d3b4a-4fa5-486f-92ca-8e399085cf68</data>
  <data key="d11">docling</data>
