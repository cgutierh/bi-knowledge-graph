  <data key="d0">brand</data>
  <data key="d33">HCP / Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Efficacy / Clinical benefit</data>
  <data key="d27">JARDIANCE provides kidney and CV protection as demonstrated in multiple clinical trials spanning a decade.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
