  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:9bd45951-5220-4abd-95c5-99f3d296a277">
  <data key="d0">brand</data>
  <data key="d20">Headline</data>
  <data key="d19">heading</data>
  <data key="d8">21</data>
  <data key="d9">brand_book</data>
  <data key="d10">9bd45951-5220-4abd-95c5-99f3d296a277</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">The headline encourages HCPs to think not only about the functional benefits that JARDIANCE offers (reducing CV risk), but to also consider the emotional benefits for patients (having more moments that matter).</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
