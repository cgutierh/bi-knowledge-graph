<node id="urn:kg:jardiance:chunk:331a7ffa-01b4-45c3-b339-4be57f270c01">
  <data key="d0">brand</data>
  <data key="d6">144</data>
  <data key="d7">90</data>
  <data key="d8">43</data>
  <data key="d9">brand_book</data>
  <data key="d10">bcd6bb80-24a2-4ce4-a137-30829a6e6519</data>
