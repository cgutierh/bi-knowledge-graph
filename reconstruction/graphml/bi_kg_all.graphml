<node id="urn:kg:jardiance:section:d1167e88-1a95-45b7-a3a8-e1cdddc99012">
  <data key="d0">brand</data>
  <data key="d20">proactive</data>
  <data key="d19">heading</data>
  <data key="d8">64</data>
  <data key="d9">brand_book</data>
  <data key="d10">d1167e88-1a95-45b7-a3a8-e1cdddc99012</data>
