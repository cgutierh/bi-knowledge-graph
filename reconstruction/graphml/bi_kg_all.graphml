  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">In a 24-week, double-blind, placebo-controlled study of 637 patients with T2D, the efficacy and safety of JARDIANCE 10 mg (n=217) and JARDIANCE 25 mg (n=213) as add-on therapy to metformin ≥1500 mg were evaluated vs placebo added to metformin (n=207).</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
