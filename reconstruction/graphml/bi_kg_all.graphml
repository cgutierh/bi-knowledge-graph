<node id="urn:kg:jardiance:section:3fcb7149-391a-4fa3-86c4-55be69d59756">
  <data key="d0">brand</data>
  <data key="d20">Icons</data>
  <data key="d19">heading</data>
  <data key="d8">50</data>
  <data key="d9">brand_book</data>
  <data key="d10">3fcb7149-391a-4fa3-86c4-55be69d59756</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">Icons provide a simplified approach that can call attention to key points of information. They can be used to make information more legible when a large amount of text is required. They can be used to showcase the key information or subject of the text.

&lt;!-- image --&gt;

&lt;!-- image --&gt;

&lt;!-- image --&gt;

&lt;!-- image --&gt;

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:28d9ff37-be73-4be8-aa07-7e5e0a8ca384">
  <data key="d0">brand</data>
  <data key="d20">The JARDIANCE way</data>
  <data key="d19">heading</data>
  <data key="d8">50</data>
  <data key="d9">brand_book</data>
  <data key="d10">28d9ff37-be73-4be8-aa07-7e5e0a8ca384</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">-   The icons should be 3 points, grey, and scaled accordingly
-   Each icon should have a teal dashed line following a curve
-   Icons should be easy to interpret with limited lines inside
- Icons can be filled or lined based on the needs of the design

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
