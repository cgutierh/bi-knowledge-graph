<node id="urn:kg:jardiance:chunk:6bbc3af1-1e40-4fd5-a1a4-d56c71a0524d">
  <data key="d0">brand</data>
  <data key="d6">67</data>
  <data key="d7">160</data>
  <data key="d8">20</data>
  <data key="d9">brand_book</data>
  <data key="d10">0ed2ed37-a104-44f6-bd64-3c7927606a5d</data>
  <data key="d11">docling</data>
