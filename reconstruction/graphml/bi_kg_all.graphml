<node id="urn:kg:ofev:section:0a8d2cd2-13e6-45ad-97f3-b4d22a555491">
  <data key="d0">brand</data>
  <data key="d20">Modified Rodnan Skin Score</data>
  <data key="d19">heading</data>
  <data key="d8">28</data>
  <data key="d9">prescribing_information</data>
