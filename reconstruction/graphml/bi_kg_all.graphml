<node id="urn:kg:jardiance:chunk:0e103c94-df9b-445d-9823-c7d9b650017b">
  <data key="d0">brand</data>
  <data key="d6">66</data>
  <data key="d7">115</data>
  <data key="d8">10</data>
  <data key="d9">product_information</data>
  <data key="d10">10a7c9c3-041a-4930-8c48-78dcb2a4d4e5</data>
  <data key="d11">docling</data>
