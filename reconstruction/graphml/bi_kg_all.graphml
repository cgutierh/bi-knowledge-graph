<node id="urn:kg:jardiance:chunk:b686e729-d673-45c5-8000-baa31cc3ccf1">
  <data key="d0">brand</data>
  <data key="d6">54</data>
  <data key="d7">32</data>
  <data key="d8">17</data>
  <data key="d9">brand_book</data>
  <data key="d10">3678d2b8-3f2f-49ff-a233-42fe67b633f4</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d13">603110fddcc11d99c5eb40aab7c51abbb5167d84e5561f091300d678ff49aa98</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d15">b686e729-d673-45c5-8000-baa31cc3ccf1</data>
  <data key="d16">Four different doctors are available for use. Choose the one who most closely aligns with your market's needs.

