  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">JARDIANCE is focused on achieving the best possible future .

It is not: Aggressive, short-sighted, focused on instant wins, inconsiderate.</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:102aa704-d839-4b37-80b8-ab59cc73e9b6">
  <data key="d0">brand</data>
  <data key="d20">brave</data>
  <data key="d19">heading</data>
  <data key="d8">64</data>
  <data key="d9">brand_book</data>
  <data key="d10">102aa704-d839-4b37-80b8-ab59cc73e9b6</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">JARDIANCE takes a stand for a noble cause .

It is not: Impulsive, daring, a risk-taker that does not consider the consequences, audacious.</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:840284b0-f18b-44f8-9ad2-24fe8f6392b5">
  <data key="d0">brand</data>
  <data key="d20">energising</data>
  <data key="d19">heading</data>
  <data key="d8">64</data>
  <data key="d9">brand_book</data>
  <data key="d10">840284b0-f18b-44f8-9ad2-24fe8f6392b5</data>
