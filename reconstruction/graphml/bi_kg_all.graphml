<node id="urn:kg:jardiance:section:c9e34bbd-aa38-4d5f-b759-dd19be79d886">
  <data key="d0">brand</data>
  <data key="d20">Graphic elements and background</data>
  <data key="d19">heading</data>
  <data key="d8">18</data>
  <data key="d9">brand_book</data>
  <data key="d10">c9e34bbd-aa38-4d5f-b759-dd19be79d886</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">The paint, textural, and colour swash elements provide visual impact, vibrancy, and a distinctive layer of brand expression that enhances recognition and engagement across campaign materials.

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:b70a4da7-b789-436c-8282-9cc641eda358">
  <data key="d0">brand</data>
  <data key="d20">The JARDIANCE way</data>
  <data key="d19">heading</data>
  <data key="d8">18</data>
  <data key="d9">brand_book</data>
  <data key="d10">b70a4da7-b789-436c-8282-9cc641eda358</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">-   Use the supplied background images only
-   Use textures and graphics from the hero visual in isolation for both print and digital applications where appropriate
-   Ensure any usage outside the hero visual complements and does not interfere with established page layouts and brand architecture

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
<node id="urn:kg:jardiance:section:4dea457f-4a27-4e53-8e03-1eec755da8d5">
  <data key="d0">brand</data>
  <data key="d20">The WRONG way</data>
  <data key="d19">heading</data>
  <data key="d8">18</data>
  <data key="d9">brand_book</data>
  <data key="d10">4dea457f-4a27-4e53-8e03-1eec755da8d5</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">- DON'T use any other background images
- DON'T alter the colours, colour ratios, or proportions of graphic treatment in the hero visual
- DON'T apply graphic treatments to visuals that are unrelated to the campaign story

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
  <data key="d4">jardiance</data>
  <data key="d5">JARDIANCE Brand Book 2025.pdf</data>
</node>
