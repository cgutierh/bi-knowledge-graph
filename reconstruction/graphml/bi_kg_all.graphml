  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Efficacy / Clinical benefit</data>
  <data key="d27">In the EMPOWER meta-analysis, JARDIANCE reduced the risk of acute kidney injury by 27% and the risk of a 50% or greater increase in serum creatinine by 20%.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
