<node id="urn:kg:jardiance:pisection:26c55f7b-565d-4f2a-bc03-a295e890b773">
  <data key="d0">brand</data>
  <data key="d20">MEDICATION GUIDE JARDIANCE ®  (jar DEE ans) (empagliflozin tablets)</data>
  <data key="d8">47</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">26c55f7b-565d-4f2a-bc03-a295e890b773</data>
  <data key="d12">Jardiance_PI.pdf</data>
  <data key="d14">b2560bb2-851a-4e06-8246-07641712e8b0</data>
  <data key="d16">for oral use</data>
  <data key="d3">PISection</data>
  <data key="d4">jardiance</data>
