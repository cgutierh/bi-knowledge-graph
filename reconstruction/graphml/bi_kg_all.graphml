</node>
<node id="urn:kg:ofev:section:1e45624e-d809-4909-a45f-11c6fffa514e">
  <data key="d0">brand</data>
  <data key="d20">How Our Brand Identity Assets Work Together</data>
  <data key="d19">heading</data>
  <data key="d8">88</data>
  <data key="d9">brand_book</data>
  <data key="d10">1e45624e-d809-4909-a45f-11c6fffa514e</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_Brand-Book_Nov-2015.pdf</data>
  <data key="d14">7c99d579-1450-4667-9bc5-7d13421ddab2</data>
  <data key="d16">The key elements of the clinical trial materials are the secondary graphics (the dominant blue color and the golden supergraphic), the clinical trial logo, and the written content. These elements complement one another and work synergistically to communicate in a clear and compelling way.

&lt;!-- image --&gt;

.

Y</data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
  <data key="d5">OFEV_Brand-Book_Nov-2015.pdf</data>
</node>
