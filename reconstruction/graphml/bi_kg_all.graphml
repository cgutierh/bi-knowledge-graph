<node id="urn:kg:ofev:section:ef644a7a-b2cb-4872-96fa-c27c9364854d">
  <data key="d0">brand</data>
  <data key="d20">Survival</data>
  <data key="d19">heading</data>
  <data key="d8">28</data>
  <data key="d9">prescribing_information</data>
  <data key="d10">ef644a7a-b2cb-4872-96fa-c27c9364854d</data>
  <data key="d11">docling</data>
  <data key="d12">OFEV_PI.pdf</data>
  <data key="d14">c0db5dd8-583e-47bb-9b75-58402a32791c</data>
  <data key="d16">No difference in survival was observed in an exploratory analysis of mortality over the whole trial (OFEV: n=10 (3.5%) vs. placebo: n=9 (3.1%)). The analysis of time to death over the whole trial resulted in a HR of 1.16 (95% CI: 0.47, 2.84).</data>
  <data key="d3">Section</data>
