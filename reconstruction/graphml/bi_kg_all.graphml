<node id="urn:kg:ofev:section:b8b10953-95c7-413d-a909-6022cf02797a">
  <data key="d0">brand</data>
  <data key="d20">Ofev ( nintedanib )</data>
  <data key="d19">heading</data>
  <data key="d8">1</data>
  <data key="d9">product_information</data>
  <data key="d10">b8b10953-95c7-413d-a909-6022cf02797a</data>
  <data key="d11">docling</data>
  <data key="d12">ofev-epar-medicines-overview_en.pdf</data>
  <data key="d14">dcf1cfdd-57dc-4936-b9b2-0839e9684cb2</data>
  <data key="d16"></data>
  <data key="d3">Section</data>
  <data key="d4">ofev</data>
