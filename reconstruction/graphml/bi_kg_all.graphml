<node id="urn:kg:jardiance:section:669f4412-d504-47f9-a293-fab549447481">
  <data key="d0">brand</data>
  <data key="d20">The JARDIANCE way</data>
  <data key="d19">heading</data>
  <data key="d8">45</data>
  <data key="d9">brand_book</data>
  <data key="d10">669f4412-d504-47f9-a293-fab549447481</data>
  <data key="d11">docling</data>
  <data key="d12">JARDIANCE Brand Book 2025.pdf</data>
  <data key="d14">b5acf5ff-42d8-4d92-bba4-931955176f5b</data>
  <data key="d16">-   Use full saturation of teal in lines depicting JARDIANCE
-   Use grey in lines depicting placebo
-   Fill the space between the two lines with a teal gradient
-   Use teal arrow to highlight key data points
-   Use teal for X and Y axis numbers
-   Use brown for axis labels

&lt;!-- image --&gt;</data>
  <data key="d3">Section</data>
