  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Efficacy / Clinical benefit</data>
  <data key="d27">In EMPA-KIDNEY, JARDIANCE reduced the risk of kidney disease progression or cardiovascular death by 28% versus placebo.</data>
