<node id="urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:141">
  <data key="d0">brand</data>
  <data key="d33">HCP/Internal</data>
  <data key="d24">candidate</data>
  <data key="d25">candidate</data>
  <data key="d26">Dosing / Administration</data>
  <data key="d27">Adjusted mean changes of -0.1% from baseline HbA1c 7.9% for placebo (n=207), -0.7% from baseline HbA1c 7.9% for JARDIANCE 10 mg (n=217), and -0.8% from baseline HbA1c 7.9% for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p&lt;0.001 vs placebo for both doses.</data>
  <data key="d28">5812fcb9-1028-4304-99d1-d1da70d2fc48</data>
  <data key="d9">claims_content_modules</data>
  <data key="d30">141</data>
  <data key="d34">Type 2 diabetes</data>
