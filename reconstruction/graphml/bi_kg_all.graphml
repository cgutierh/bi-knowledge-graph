<node id="urn:kg:ofev:section:456e0f85-2637-47da-9144-582b50c2628b">
  <data key="d0">brand</data>
  <data key="d20">Brand Insights</data>
  <data key="d19">heading</data>
  <data key="d8">6</data>
  <data key="d9">brand_book</data>
