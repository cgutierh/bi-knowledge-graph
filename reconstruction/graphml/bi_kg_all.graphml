<node id="urn:kg:jardiance:pisection:b08e53e7-dabc-4810-879a-17b83aa13a58">
  <data key="d0">brand</data>
  <data key="d20">Deutschland</data>
  <data key="d8">56</data>
  <data key="d9">product_information</data>
  <data key="d10">b08e53e7-dabc-4810-879a-17b83aa13a58</data>
