    kg:section_id "108c30f8-6696-4415-bf60-6aa2f8d3f7f5" ;
    kg:section_title "Brightness and contrast" ;
    kg:section_type "heading" ;
    kg:source_document_id "ded4ae29-e5c0-417b-8c08-00855d252370" ;
    kg:source_document_type "guidance_document" ;
    kg:source_file_name "Introduction - Imagery.pdf" ;
    kg:text """We want to capture Optimism through our lighting.

- ·Use divergent lighting for clarity, but avoid 'perfectly lit' scenes
- ·Try slightly higher contrast images for greater expression
- Consider using specific moments of light, such as sunrises or sunsets.

<!-- image -->""" .

<urn:kg:boehringer-ingelheim:section:10f03feb-cc23-43de-a7fd-292e6e04442c> a kg:Section ;
