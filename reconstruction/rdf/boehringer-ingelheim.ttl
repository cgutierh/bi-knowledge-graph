<urn:kg:boehringer-ingelheim:section:55c34674-98ef-4deb-bb37-a5281e0b6300> a kg:Section ;
    rdfs:label "BI Design Style Guide 1.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:boehringer-ingelheim:chunk:c3eea999-3575-4b8f-b7f4-f7a2a56e5aed> ;
    kg:extraction_method "docling" ;
