<urn:kg:boehringer-ingelheim:section:1bbcb16e-9a4e-4370-a7f7-f94de04722f7> a kg:Section ;
    rdfs:label "Introduction - Imagery.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:boehringer-ingelheim:chunk:f7949d91-2de9-4788-bba9-49036dbe46a0> ;
    kg:extraction_method "docling" ;
