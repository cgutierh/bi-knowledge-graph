    kg:section_title "Combining Ouri images" ;
    kg:section_type "heading" ;
    kg:source_document_id "ded4ae29-e5c0-417b-8c08-00855d252370" ;
    kg:source_document_type "guidance_document" ;
    kg:source_file_name "Introduction - Imagery.pdf" ;
    kg:text """Inourlayoutsystem,we aimtocreatecontrastbyintentionallycombiningimagesfromthesamescene,with different proximity scales.Forinstance,we may pair a Close up with an Environment shot,or an In the moment narrative.

To learn more about how we combine the different brand elements and images, visit our Layout section.""" .

<urn:kg:boehringer-ingelheim:section:1dd69269-a01f-4a12-8b0d-709ce00e7959> a kg:Section ;
    rdfs:label "Introduction - Imagery.pdf" ;
