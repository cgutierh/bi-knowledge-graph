    kg:source_document_type "guidance_document" ;
    kg:source_file_name "Imagery Production.pdf" ;
    kg:text "Clothes shouldn't look like they're brand new, they should be comfortably worn. Try clothesfrom the models' ownwardrobesorfrom fashion archives." .

<urn:kg:boehringer-ingelheim:section:1287b0e6-7f16-4cb0-a77f-daca0aed484f> a kg:Section ;
