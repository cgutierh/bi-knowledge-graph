    kg:source_file_name "BI Design Style Guide 1.pdf" ;
    kg:text """Ourillustrationstyleadds swarmth,simplicityand emotiontoour design. Itallowsustovisualizeawide range of subjects-i includingcomplex technicalormedicaltopics-while eexpressingour brandidentity.

<!-- image -->""" .

<urn:kg:boehringer-ingelheim:section:cedc958f-32ef-42f2-b597-4cabeb0b2126> a kg:Section ;
    rdfs:label "BI Design Style Guide 1.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:boehringer-ingelheim:chunk:f0a64d78-894a-4bb5-b3cd-c4fbb7a58cb8> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 6 ;
    kg:section_id "cedc958f-32ef-42f2-b597-4cabeb0b2126" ;
    kg:section_title "Ourillustration style" ;
    kg:section_type "heading" ;
    kg:source_document_id "3a3871a8-b21d-44c3-883b-299017d57793" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "BI Design Style Guide 1.pdf" ;
    kg:text """Ourillustrationstyleisguided by ourbrand core:Unwaveringoptimism'Through simplelines and shapes, weconvey themeslikecollaboration,resilience,andinnovation.Italsohelpsusshowtheexpressionof love andaffectionbetweenhumansandanimals.

Weillustratewithasenseofpositivityacrossawiderangeofsubjects,frommedical toinnovation to lifestyle.Oneway wedo thisisbyusingwarmcolorpalettesand ahandmadelookand feel.""" .

