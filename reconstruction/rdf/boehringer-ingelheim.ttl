    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 1 ;
    kg:section_id "1dd69269-a01f-4a12-8b0d-709ce00e7959" ;
    kg:section_title "Introduction: Imagery" ;
    kg:section_type "heading" ;
    kg:source_document_id "ded4ae29-e5c0-417b-8c08-00855d252370" ;
    kg:source_document_type "guidance_document" ;
    kg:source_file_name "Introduction - Imagery.pdf" ;
    kg:text """Our imagery is a key part of how we visualize the Unwavering Optimism of our brand story. By focusing on the resilience and energy of everyday living, we also zoom in on the profound and significant details that capture connections between people, animals and society.

<!-- image -->""" .

