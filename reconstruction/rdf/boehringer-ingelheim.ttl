<urn:kg:boehringer-ingelheim:section:108c30f8-6696-4415-bf60-6aa2f8d3f7f5> a kg:Section ;
    rdfs:label "Introduction - Imagery.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:boehringer-ingelheim:chunk:be750616-d252-4907-8664-9f3207fca6ac> ;
    kg:extraction_method "docling" ;
