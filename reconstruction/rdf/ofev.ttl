<urn:kg:ofev:chunk:e6a7b8d0-68e9-4af2-82d2-5efcf95e99b0> a kg:Chunk ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:chunk_id "e6a7b8d0-68e9-4af2-82d2-5efcf95e99b0" ;
    kg:chunk_index 79 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 19 ;
    kg:section_id "5d73ab60-4648-4da2-9902-581f07f9629f" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "73e5713cc2c77bf351100ff40dbf8951b308ef537bbb4c787d7332836abd5e75" ;
    kg:text """The OFEV ®  colors were selected to reinforce our brand identity and to differentiate our brand from competitors. They should be used to help maintain brand recognition and impact. The OFEV ®  core brand color is Guardian Blue, and it should be the most prominent color in the palette. In addition, Guardian Blue is the only color that should be used with the line pattern.

The three secondary colors, Inspiring Yellow, Brilliant Gold, and Premium Orange, reflect the colors used in the OFEV ®  gradient. Premium Orange may be used for highlights in applications as well as in typographical call-outs and subheads.

Comfort Gray is included as a neutral tertiary color that helps balance the palette. Comfort Gray can be used in clinical and scientific situations, such as in charts or to represent placebo.

<!-- image -->""" ;
    kg:token_count 206 .

