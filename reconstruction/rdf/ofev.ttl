<urn:kg:ofev:section:3573d564-f0aa-4e08-9b68-71a8dd228a88> a kg:Section ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:c732fc4c-475e-472f-b21d-e786dd8089e2> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 30 ;
    kg:section_id "3573d564-f0aa-4e08-9b68-71a8dd228a88" ;
    kg:section_title "Smokers" ;
    kg:section_type "heading" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Encourage patients to stop smoking prior to treatment with OFEV and to avoid smoking when using OFEV [see Clinical Pharmacology (12.3)] ." .

