    kg:chunk_index 36 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 4 ;
    kg:section_id "016180eb-524e-4868-8480-7c5079d8c5b2" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
