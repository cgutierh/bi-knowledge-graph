<urn:kg:ofev:chunk:110d7b54-4801-484e-917f-2e61fe1db01f> a kg:Chunk ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:chunk_id "110d7b54-4801-484e-917f-2e61fe1db01f" ;
    kg:chunk_index 112 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 39 ;
    kg:section_id "32bd715c-cf39-431e-9310-aaf5b8a5ece9" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "50105f036086896501abe3996525a03c0b717f73bdbcc5f256c5649861d98d09" ;
    kg:text """The campaign visual works to clearly communicate the slowing of disease progression with OFEV ® . The campaign shows a declining path, which represents the continuous and irreversible deterioration of lung function in patients with IPF. The path is changed by the intervention of the hand, which lifts and supports the patient as he enjoys time with his grandson, an activity that is common, but not always possible for many patients with IPF. The hand that is changing the path can be interpreted as the HCP, OFEV ® , or Boehringer Ingelheim.

Together, the downward angle of the path, in contrast with the angle of the inset image of the patient, represents the reduction in lung function decline and the slowing of disease progression with OFEV ® .

<!-- image -->

<!-- image -->

<!-- image -->""" ;
    kg:token_count 200 .

