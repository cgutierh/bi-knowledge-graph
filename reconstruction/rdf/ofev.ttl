<urn:kg:ofev:chunk:6b26567b-195d-48e9-9d00-2b8648c2e843> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "6b26567b-195d-48e9-9d00-2b8648c2e843" ;
    kg:chunk_index 84 ;
    kg:extraction_method "docling" ;
