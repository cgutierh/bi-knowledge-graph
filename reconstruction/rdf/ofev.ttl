    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "e098ce5d6158b296803fa2c9897e069b54018b76fd44722079fb78b47c200bbc" ;
    kg:text """Nintedanib is a tyrosine kinase inhibitor that targets pathways involved in fibrosis.

OFEV ® slows IPF disease progression so that the physician's role is restored and patients can live tomorrow like they did yesterday.""" ;
    kg:token_count 55 .

