<urn:kg:ofev:chunk:bc86f02d-e23f-423b-82d3-232b3a58f759> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "bc86f02d-e23f-423b-82d3-232b3a58f759" ;
