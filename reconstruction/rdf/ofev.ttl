    kg:text "Figure 6 presents the percent change from baseline in FVC in mL at Week 52 for Study 5. For the majority of patients, the decline in lung function was less on OFEV than on placebo." ;
    kg:token_count 45 .

<urn:kg:ofev:chunk:e0cf4742-4821-4ae0-9872-8c33c1206da4> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "e0cf4742-4821-4ae0-9872-8c33c1206da4" ;
    kg:chunk_index 1 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
