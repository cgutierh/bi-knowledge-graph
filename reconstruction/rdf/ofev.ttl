    kg:text "Knowing how to access and use the OFEV ® brand assets is critical for ease in applying them. This section explains the file nomenclature and provides assets for download, contact information, and a quick reference guide." ;
    kg:token_count 55 .

<urn:kg:ofev:chunk:8be15576-14fd-40ea-a499-a3e27e31eb87> a kg:Chunk ;
