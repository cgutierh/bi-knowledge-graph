    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "c567836099ee529efd4bc9e996d363432e6bf76a09219e39467736d075fa3d9e" ;
    kg:text """Clear space is the specified area of empty space surrounding our brandmark. Its use allows us to maintain our brandmark's visual integrity and impact. The 'O' height in 'OFEV ® ' scaled down to 75% of its original size represents 1x. A minimum clear space of 1x should be maintained around the entire mark at all times.

The minimum size of the OFEV ® brandmark is 7/8' (22 mm, 125 pixels) in width. To maintain legibility, the brandmark should never be smaller than this.

<!-- image -->

cLEAr SPAcE

<!-- image -->

MiniMuM SizE

<!-- image -->

Print: 7/8' (22 mm) diGitAL: 125 PixELS""" ;
    kg:token_count 147 .

