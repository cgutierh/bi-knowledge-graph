    kg:page_number 30 ;
    kg:section_id "dff60917-e4b1-4acc-b573-acf13137cbf2" ;
    kg:section_title "Lactation" ;
    kg:section_type "heading" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Advise patients that breastfeeding is not recommended while taking OFEV [see Use in Specific Populations (8.2)]." .

