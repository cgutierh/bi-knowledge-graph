    kg:text "1.5 Color Palette" .

<urn:kg:ofev:section:2534378c-d573-4f8e-823f-646211314283> a kg:Section ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:d557ec5b-85fa-479b-a27d-162076a364b3> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 30 ;
    kg:section_id "2534378c-d573-4f8e-823f-646211314283" ;
    kg:section_title "Administration" ;
    kg:section_type "heading" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Instruct patients to take OFEV with food, to swallow OFEV capsules whole with liquid, and not to chew the capsules due to the bitter taste . Advise patients or caregivers not to open or crush OFEV capsules and to wash hands immediately and thoroughly if contact with the content of the capsule occurs. Advise patients to not make up for a missed dose [see Dosage and Administration (2.2)] ." .

<urn:kg:ofev:section:257ef4a8-88af-4578-b3b6-8f1e17f07614> a kg:Section ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:dab4af6e-b563-4ce6-b21d-6a521676854f> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 29 ;
    kg:section_id "257ef4a8-88af-4578-b3b6-8f1e17f07614" ;
    kg:section_title "Storage" ;
    kg:section_type "heading" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Store at 20°C to 25°C (68°F to 77°F); excursions permitted to 15°C to 30°C (59°F to 86°F) [see USP Controlled Room Temperature]. Protect from exposure to high humidity and avoid excessive heat. If repackaged, use USP tight container." .

<urn:kg:ofev:section:280ae365-b37a-47f3-a039-1b441d0ab689> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:5829d303-a218-4ef2-803d-81c4e0aabdcd> ;
