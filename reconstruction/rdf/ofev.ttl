<urn:kg:ofev:chunk:82d6befb-dc02-465d-886d-ee6fd6472f29> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "82d6befb-dc02-465d-886d-ee6fd6472f29" ;
