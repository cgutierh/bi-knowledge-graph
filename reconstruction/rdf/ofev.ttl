<urn:kg:ofev:chunk:376debe6-4661-442f-b50b-49c1366aaa3c> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "376debe6-4661-442f-b50b-49c1366aaa3c" ;
    kg:chunk_index 117 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 20 ;
    kg:section_id "7f693733-17b1-494e-8e31-762835700832" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:source_hash "69f078da3acc623b8d896ab5e200366cb13c278c4e17d6b341d8c474c0425ab2" ;
    kg:text "Acute IPF exacerbation was defined as unexplained worsening or development of dyspnea within 30 days, new diffuse pulmonary infiltrates on chest x-ray, and/or new high-resolution CT parenchymal abnormalities with no pneumothorax or pleural effusion, and exclusion of alternative causes. Acute IPF exacerbation was adjudicated in Study 2 and Study 3. In Study 1 (investigator-reported) and Study 3 (adjudicated), the risk of first acute IPF exacerbation over 52 weeks was significantly reduced in patients receiving OFEV compared to placebo (hazard ratio [HR]: 0.16, 95% CI: 0.04, 0.71) and (HR: 0.20, 95% CI: 0.07, 0.56), respectively. In Study 2 (adjudicated), there was no difference between the treatment groups (HR: 0.55, 95% CI: 0.20, 1.54)." ;
    kg:token_count 186 .

<urn:kg:ofev:chunk:38a31a23-e2b7-45c8-93c2-e99a2dfc6c98> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "38a31a23-e2b7-45c8-93c2-e99a2dfc6c98" ;
    kg:chunk_index 82 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 12 ;
    kg:section_id "3eef6067-5ce7-4439-b6f5-b9e4766aea08" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:source_hash "4fb8c3066fac9b6ebdb358224eb98a9b5323405659e7c663dd0eee75f7620ef2" ;
    kg:text "The safety and effectiveness of OFEV have not been established in pediatric patients for the treatment of fibrosing interstitial lung diseases. Effectiveness was not demonstrated in a randomized, double-blind, placebocontrolled study conducted in 26 OFEV-treated pediatric patients aged 6 to 17 years with fibrosing interstitial lung diseases, who were treated with OFEV based on weight." ;
    kg:token_count 97 .

