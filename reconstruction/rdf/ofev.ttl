<urn:kg:ofev:chunk:3099738b-7fd7-4e84-9826-4177c8bff178> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "3099738b-7fd7-4e84-9826-4177c8bff178" ;
    kg:chunk_index 5 ;
    kg:extraction_method "docling" ;
