<urn:kg:ofev:section:bda01afe-dea7-4e12-833e-f18770366c7f> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:668cfa0b-445d-4344-9127-cedba23e079b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 44 ;
    kg:section_id "bda01afe-dea7-4e12-833e-f18770366c7f" ;
    kg:section_title "Campaign Examples" ;
    kg:section_type "heading" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:text """The campaign should be applied to all types of tactics and communications in a cohesive and consistent manner. Here are some examples of the campaign integrated into approved tactics.

<!-- image -->

cAMPAiGn BAnnEr

oFEV ®  LEAVE-BEHind BrocHurE

