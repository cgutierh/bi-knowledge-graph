    kg:source_document_type "product_information" ;
    kg:source_file_name "ofev-epar-medicines-overview_en.pdf" ;
    kg:source_hash "81a0623b7b03f1eb87aa2f6d186349aee4a547ab3938870ad2ced36b194847fd" ;
    kg:text """Recommendations and precautions to be followed by healthcare professionals and patients for the safe and effective use of Ofev have been included in the summary of product characteristics and the package leaflet.

As for all medicines, data on the use of Ofev are continuously monitored. Side effects reported with Ofev are carefully evaluated and any necessary action taken to protect patients.""" ;
    kg:token_count 99 .

<urn:kg:ofev:chunk:b8aa29a2-79d9-4794-8233-0253c26cd619> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "b8aa29a2-79d9-4794-8233-0253c26cd619" ;
