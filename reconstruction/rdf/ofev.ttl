<urn:kg:ofev:chunk:67c947b2-5110-4cee-a7e2-5372443aa9ef> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "67c947b2-5110-4cee-a7e2-5372443aa9ef" ;
    kg:chunk_index 115 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 19 ;
    kg:section_id "5c96615a-f77b-4894-b50e-67747b31d772" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:source_hash "82e6a87fb1cf52ca2304bf852e3a18821a2c8ce877d8b6ad358b7d4f3182ab06" ;
    kg:text "Figure 2 presents the cumulative distribution for all cut-offs for the change from baseline in FVC percent predicted at Week 52 for Study 2. For all categorical declines in lung function, the proportion of patients declining was lower on OFEV than on placebo. Study 3 showed similar results." ;
    kg:token_count 73 .

<urn:kg:ofev:chunk:68483cde-281e-476f-8367-d2fa88d6d461> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "68483cde-281e-476f-8367-d2fa88d6d461" ;
