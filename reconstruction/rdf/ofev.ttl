<urn:kg:ofev:chunk:32a50cc3-f02b-4b7f-9734-60f6a70030de> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "32a50cc3-f02b-4b7f-9734-60f6a70030de" ;
    kg:chunk_index 132 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 25 ;
    kg:section_id "d98137e4-1182-40a9-a960-56289cab694d" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:source_hash "860580a9d93c7f2f4910d8c65ad4f2628591d4cb39c6fe15c403756f8d22e090" ;
    kg:text "Survival was evaluated for OFEV compared to placebo in Study 5 to support the primary endpoint (FVC). Allcause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (52 week treatment period: HR 0.94 (95% CI: 0.47, 1.86); whole trial: HR 0.78 (95% CI: 0.50, 1.21))." ;
    kg:token_count 109 .

<urn:kg:ofev:chunk:32df6210-8b14-49e7-8b15-257e4f917871> a kg:Chunk ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
