    kg:source_file_name "OFEV_PI.pdf" ;
    kg:source_hash "d7173c051dd60376eee5af1fb4ecf8e94ea2a5fa75ee43fea1d4b6316de2fc71" ;
    kg:text "Instruct patients to take OFEV with food, to swallow OFEV capsules whole with liquid, and not to chew the capsules due to the bitter taste . Advise patients or caregivers not to open or crush OFEV capsules and to wash hands immediately and thoroughly if contact with the content of the capsule occurs. Advise patients to not make up for a missed dose [see Dosage and Administration (2.2)] ." ;
    kg:token_count 98 .

