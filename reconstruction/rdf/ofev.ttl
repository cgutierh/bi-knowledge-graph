<urn:kg:ofev:section:8ef37cfd-36e8-4299-b27a-c20c73cbb5b9> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:92a5d3fd-9710-4116-bade-2f5854c2a3c4> ;
    kg:extraction_method "docling" ;
