<urn:kg:ofev:chunk:843021b2-839a-453e-8e3e-cff396d2fbdf> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "843021b2-839a-453e-8e3e-cff396d2fbdf" ;
    kg:chunk_index 160 ;
    kg:extraction_method "docling" ;
