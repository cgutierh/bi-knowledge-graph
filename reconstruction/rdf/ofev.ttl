<urn:kg:ofev:section:38252ec6-7815-4802-b76b-a5669c4f5de3> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:b39c0e0b-0a12-414f-8d77-4efbdd5d8798> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 54 ;
    kg:section_id "38252ec6-7815-4802-b76b-a5669c4f5de3" ;
    kg:section_title "How Our Brand Identity Assets Work T ogether" ;
    kg:section_type "heading" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:text """Assets such as typeface, color, and graphics together form our brand identity system, through which we achieve our unique look and feel. All of these elements were created to work together harmoniously and reffect the oFEV ®  brand personality.

PAtiEnt BrocHurE coVEr ExAMPLE

<!-- image -->""" .

<urn:kg:ofev:section:38b8e81a-af41-4c3a-9e9d-3ca01edcf351> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:7dbf2957-c600-41fa-b0d3-1718a868a054> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 12 ;
    kg:section_id "38b8e81a-af41-4c3a-9e9d-3ca01edcf351" ;
    kg:section_title "VARGATEF ®  Logo" ;
    kg:section_type "heading" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:text """The VARGATEF ®  logo is provided for countries that will launch nintedanib under the brand name VARGATEF ®  for both the IPF and lung cancer indications. These countries are required to use the same brand name for both indications; therefore, use of the brand name OFEV ® is not permitted.

GLoBAL LoGo

