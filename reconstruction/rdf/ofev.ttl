<urn:kg:ofev:section:d4446dc7-f9ad-430a-b635-6f0399220be6> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:22dede4a-74b0-47f6-a8b2-d43a570a9c0d> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 49 ;
    kg:section_id "d4446dc7-f9ad-430a-b635-6f0399220be6" ;
