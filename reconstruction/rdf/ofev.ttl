<urn:kg:ofev:chunk:21fc65a7-238b-4ef0-97b6-88625174ec1b> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "21fc65a7-238b-4ef0-97b6-88625174ec1b" ;
