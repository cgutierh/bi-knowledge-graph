<urn:kg:ofev:section:1b4cad53-af36-425a-a0ac-a1e91f52fc34> a kg:Section ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:9a82d2d3-9772-426f-9ffa-1920136cc82e>,
        <urn:kg:ofev:chunk:ecaf57c2-a9b5-4d5e-a054-501546d7e687> ;
    kg:extraction_method "docling" ;
