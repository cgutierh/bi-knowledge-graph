    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:statement_text "The most frequent serious adverse reactions reported in patients treated with OFEV, more than placebo, were bronchitis (1.2% vs. 0.8%) and myocardial infarction (1.5% vs. 0.4%). The most common adverse events leading to death in patients treated with OFEV, more than placebo, were" .

<urn:kg:ofev:safety:bb4bf01d-0141-4b83-8161-67022dd9966b> a kg:SafetyStatement ;
    rdfs:label "OFEV_PI.pdf" ;
