<urn:kg:ofev:chunk:9a4b4e71-f6cd-4cb3-aa62-3873350f2406> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "9a4b4e71-f6cd-4cb3-aa62-3873350f2406" ;
    kg:chunk_index 32 ;
    kg:extraction_method "docling" ;
