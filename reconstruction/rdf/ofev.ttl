<urn:kg:ofev:chunk:552ecab1-8b3b-4e35-a7c1-822898c4ac7a> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "552ecab1-8b3b-4e35-a7c1-822898c4ac7a" ;
    kg:chunk_index 76 ;
