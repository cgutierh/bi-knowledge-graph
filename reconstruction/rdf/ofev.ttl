<urn:kg:ofev:section:85a8ee51-9331-49ce-9d98-b4ae48e70509> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:d4d5fbfa-6b11-45af-a23c-39af0fef430d> ;
    kg:extraction_method "docling" ;
