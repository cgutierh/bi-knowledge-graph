    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "43f630b1d4adb0876f2ef8064edb86b9f602e8fdd588bf10671a226057c27d72" ;
    kg:text """The patient branded identity system comprises key assets that are designed, managed, and used in a recognizable way across all of our branded materials that are patient facing.

Our identity system unifies our patient branded materials in a consistent, flexible, and ownable way across all channels, allowing us to communicate consistently with patients with IPF and their caregivers.""" ;
    kg:token_count 96 .

