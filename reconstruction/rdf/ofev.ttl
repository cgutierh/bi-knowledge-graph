<urn:kg:ofev:chunk:72edc69b-77b9-4331-b0fb-00d9fd220d99> a kg:Chunk ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:chunk_id "72edc69b-77b9-4331-b0fb-00d9fd220d99" ;
    kg:chunk_index 83 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 23 ;
    kg:section_id "5a8ba6f3-cc81-411f-a127-d9ec2f3e648f" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "dcbfbe26622217fa2a70376fd843ed1c353de75f5a510ec117ffc169e8540c98" ;
    kg:text """The OFEV ®  holding shape provides yet another distinctive element to the brand's marketing materials. Available in horizontal and vertical formats, the holding shape can be easily scaled to fit any piece. It is designed to be consistent yet flexible for various types of content. When adjusting the size of the holding shape, be sure to scale all the pieces proportionally.

<!-- image -->

