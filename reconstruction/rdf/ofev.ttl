<urn:kg:ofev:chunk:5a9cb6bb-7ffa-4db0-a6b6-4d102da0a52c> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "5a9cb6bb-7ffa-4db0-a6b6-4d102da0a52c" ;
    kg:chunk_index 83 ;
