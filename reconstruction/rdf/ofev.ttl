<urn:kg:ofev:section:e3f4c465-5528-4fc3-b8f6-39435ba74bce> a kg:Section ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:d9c7ad31-7c80-42c2-a1f2-6479152cbe29> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 21 ;
    kg:section_id "e3f4c465-5528-4fc3-b8f6-39435ba74bce" ;
    kg:section_title "Secondary Graphics Flexibility" ;
    kg:section_type "heading" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:text """Our secondary graphic has been designed to accommodate a variety of layouts and content. The shapes can be scaled up and down, adding flexibility to the system and allowing for different configurations of the shapes to provide a variety of layout options with a consistent look.

The Guardian Blue shape should always be dominant and the golden gradient shape should be used as an accent. The golden gradient shape should not take up more than 15% of the page.

<!-- image -->

oFEV\\_HorizontAL\\_cMYK.Ai""" .

<urn:kg:ofev:section:e49931ec-9215-444f-963d-2f82d6261e86> a kg:Section ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:ofev:chunk:77bd2805-c8ad-4602-a654-e5c4aff54e27> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 20 ;
    kg:section_id "e49931ec-9215-444f-963d-2f82d6261e86" ;
    kg:section_title "Survival" ;
    kg:section_type "heading" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Survival was evaluated for OFEV compared to placebo in Study 2 and Study 3 as an exploratory analysis to support the primary endpoint (FVC). All-cause mortality was assessed over the study duration and available follow-up period, irrespective of cause of death and whether patients continued treatment. All-cause mortality did not show a statistically significant difference (See Figure 3)." .

