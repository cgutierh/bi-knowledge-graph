<urn:kg:ofev:chunk:a198018d-d669-420f-9587-881a74664b8d> a kg:Chunk ;
    rdfs:label "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:chunk_id "a198018d-d669-420f-9587-881a74664b8d" ;
    kg:chunk_index 205 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 96 ;
    kg:section_id "968357fa-6ef8-422f-9dba-15bf92f4b8cb" ;
    kg:source_document_id "7c99d579-1450-4667-9bc5-7d13421ddab2" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "OFEV_Brand-Book_Nov-2015.pdf" ;
    kg:source_hash "cefb0794c7da6cae8bcdecb0409586557115d838047c755089bbec4f223bb293" ;
    kg:text """The following nomenclature system has been developed to help identify and easily locate the various graphic files. Please always use the downloadable electronic reproducible art we have provided.

The various file formats available are: AI (Adobe Illustrator) files are used for all high-quality printing. These files are in a vector format and can be scaled up or down without loss of quality.

JPG (Joint Photographic Experts Group) files are in a compressed format best used on the Internet because they are in RGB. They cannot be scaled up without loss of quality.

PNG (Portable Network Graphics) files are used for importing artwork into PowerPoint for on-screen presentations. These files can also be used on the Internet. This is a compressed format; files are best created at full size and not scaled up or down. PNG files are created with a transparent background.""" ;
    kg:token_count 218 .

