    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "" .

<urn:kg:ofev:pisection:460d3160-c99a-49cc-bbe0-1f26dcfbee8c> a kg:PISection ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c> ;
    kg:DERIVED_FROM_SECTION <urn:kg:ofev:section:460d3160-c99a-49cc-bbe0-1f26dcfbee8c> ;
    kg:graphScope "brand" ;
    kg:page_number 12 ;
    kg:section_id "460d3160-c99a-49cc-bbe0-1f26dcfbee8c" ;
    kg:section_title "Infertility" ;
    kg:source_document_id "c0db5dd8-583e-47bb-9b75-58402a32791c" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "Based on animal data, OFEV may reduce fertility in females of reproductive potential [see Nonclinical Toxicology (13.1)]." .

<urn:kg:ofev:pisection:4710c794-ec31-42e5-aabe-d350fb6966de> a kg:PISection ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:ofev:document:c0db5dd8-583e-47bb-9b75-58402a32791c> ;
