    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "OFEV_PI.pdf" ;
    kg:text "In patients with mild hepatic impairment (Child Pugh A), the recommended dosage of OFEV is 100 mg orally twice daily approximately 12 hours apart taken with food [see Use in Specific Populations (8.6)] ." .

