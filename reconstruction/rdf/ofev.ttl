<urn:kg:ofev:chunk:ecaf57c2-a9b5-4d5e-a054-501546d7e687> a kg:Chunk ;
    rdfs:label "OFEV_PI.pdf" ;
    kg:chunk_id "ecaf57c2-a9b5-4d5e-a054-501546d7e687" ;
