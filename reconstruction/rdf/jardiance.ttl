<urn:kg:jardiance:section:b8f88a87-25cb-428a-846e-a9bed8221b0c> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:bfb4eb0f-4428-418e-8a06-b6d68066c962> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "b8f88a87-25cb-428a-846e-a9bed8221b0c" ;
    kg:section_title "6 ADVERSE REACTIONS" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """The following important adverse reactions are described below and elsewhere in the labeling:

- x Diabetic Ketoacidosis in Patients with Type 1 Diabetes Mellitus and Other Ketoacidosis [see Warnings and Precautions (5.1)]
- x Volume Depletion [see Warnings and Precautions (5.2)]
- x Genitourinary Infections, including Urosepsis, Pyelonephritis, Necrotizing Fasciitis of the Perineum (Fournier's Gangrene), and Genital Mycotic Infections [see Warnings and Precautions (5.3)]
- x Hypoglycemia [see Warnings and Precautions (5.4)]
- x Hypersensitivity Reactions [see Warnings and Precautions (5.6)]""" .

