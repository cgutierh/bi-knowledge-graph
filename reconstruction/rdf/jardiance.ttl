<urn:kg:jardiance:pisection:0045af39-13a4-4ff2-8ad9-9208cd3dadab> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:0045af39-13a4-4ff2-8ad9-9208cd3dadab> ;
    kg:graphScope "brand" ;
    kg:page_number 24 ;
    kg:section_id "0045af39-13a4-4ff2-8ad9-9208cd3dadab" ;
    kg:section_title "Nephropathy" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """In the EMPA-REG OUTCOME study, for time to first nephropathy event, the HR was 0.61 (95% CI 0.53, 0.70) for empagliflozin (12.7%) vs placebo (18.8%).

In addition, empagliflozin showed a higher (HR 1.82, 95% CI 1.40, 2.37) occurrence of sustained normo- or micro-albuminuria (49.7%) in patients with baseline macro-albuminuria compared with placebo (28.8%).""" .

