<urn:kg:jardiance:pisection:c37b5864-2d1a-4473-9a4b-60505cdcb9de> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c37b5864-2d1a-4473-9a4b-60505cdcb9de> ;
    kg:graphScope "brand" ;
    kg:page_number 8 ;
    kg:section_id "c37b5864-2d1a-4473-9a4b-60505cdcb9de" ;
    kg:section_title "Breast-feeding" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "No data in humans are available on excretion of empagliflozin into milk. Available toxicological data in animals have shown excretion of empagliflozin in milk. A risk to the newborns/infants cannot be excluded. Jardiance should not be used during breast-feeding." .

<urn:kg:jardiance:pisection:c38a08f3-236b-484a-8e6f-895335e62a8a> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c38a08f3-236b-484a-8e6f-895335e62a8a> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:c38a08f3-236b-484a-8e6f-895335e62a8a> ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "c38a08f3-236b-484a-8e6f-895335e62a8a" ;
    kg:section_title "6.1  Clinical Trials Experience" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """Because clinical trials are conducted under widely varying conditions, adverse reaction rates observed in the clinical trials of a drug cannot be directly compared to rates in the clinical trials of another drug and may not reflect the rates observed in practice.

JARDIANCE has been evaluated in clinical trials in adult and pediatric patients aged 10 to 17 years with type 2 diabetes mellitus, in adults with heart failure, and in adults with chronic kidney disease. The overall safety profile of JARDIANCE was generally consistent across the studied indications.""" .

<urn:kg:jardiance:pisection:c393d8de-b447-4a59-8c9f-42939da54f45> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c393d8de-b447-4a59-8c9f-42939da54f45> ;
    kg:graphScope "brand" ;
    kg:page_number 54 ;
    kg:section_id "c393d8de-b447-4a59-8c9f-42939da54f45" ;
    kg:section_title "What Jardiance contains" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """- -The active substance is empagliflozin.
- -Each tablet contains 10 mg or 25 mg empagliflozin.
- -The other ingredients are:
- -tablet core: lactose monohydrate (see end of section 2 under 'Jardiance contains lactose'), microcrystalline cellulose, hydroxypropylcellulose, croscarmellose sodium (see end of section 2 under 'Jardiance contains sodium'), colloidal anhydrous silica, magnesium stearate""" .

<urn:kg:jardiance:pisection:c507029e-23db-46d2-91d9-9e218508fa6f> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c507029e-23db-46d2-91d9-9e218508fa6f> ;
    kg:graphScope "brand" ;
    kg:page_number 51 ;
    kg:section_id "c507029e-23db-46d2-91d9-9e218508fa6f" ;
    kg:section_title "Children and adolescents" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Jardiance can be used in children aged 10 years and older for the treatment of type 2 diabetes. No data are available in children below 10 years of age.

Jardiance is not recommended for children and adolescents under 18 years of age for the treatment of heart failure or for the treatment of chronic kidney disease, because it has not been studied in these patients.""" .

<urn:kg:jardiance:pisection:c55430de-1e20-44cf-9ccf-8d0da12e8f81> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c55430de-1e20-44cf-9ccf-8d0da12e8f81> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:c55430de-1e20-44cf-9ccf-8d0da12e8f81> ;
    kg:graphScope "brand" ;
    kg:page_number 18 ;
    kg:section_id "c55430de-1e20-44cf-9ccf-8d0da12e8f81" ;
    kg:section_title "Empagliflozin 24 months data, as add-on to metformin in comparison to glimepiride" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """In a study comparing the efficacy and safety of empagliflozin 25 mg versus glimepiride (up to 4 mg per day) in patients with inadequate glycaemic control on metformin alone, treatment with empagliflozin daily resulted in superior reduction in HbA1c (Table 6), and a clinically meaningful reduction in FPG, compared to glimepiride. Empagliflozin daily resulted in a statistically significant reduction in body weight, systolic and diastolic blood pressure and a statistically significantly lower proportion of patients with hypoglycaemic events compared to glimepiride (2.5% for empagliflozin, 24.2% for glimepiride, p &lt; 0.0001).

Table 6: Efficacy results at 104 week in an active controlled study comparing empagliflozin to glimepiride as add-on to metformin a

|                 |   Empagliflozin 25 mg |   Glimepiride b |
|-----------------|-----------------------|-----------------|
| N               |                   765 |             780 |
| HbA1c (%)       |                       |                 |
| Baseline (mean) |                  7.92 |            7.92 |""" .

<urn:kg:jardiance:pisection:c58179a7-4d47-46ae-8cd4-466012acceff> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:c58179a7-4d47-46ae-8cd4-466012acceff> ;
    kg:graphScope "brand" ;
    kg:page_number 35 ;
    kg:section_id "c58179a7-4d47-46ae-8cd4-466012acceff" ;
    kg:section_title "6. PHARMACEUTICAL PARTICULARS" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
