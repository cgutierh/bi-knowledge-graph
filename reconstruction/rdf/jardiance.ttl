<urn:kg:jardiance:chunk:dab13f70-7dc7-4668-82a9-66fdd36cf37f> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "dab13f70-7dc7-4668-82a9-66fdd36cf37f" ;
    kg:chunk_index 152 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
