<urn:kg:jardiance:section:950fa678-14a1-40e2-8375-206d1804f896> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:f597ab25-1a07-424d-86a0-0643ab7c2905> ;
    kg:extraction_method "docling" ;
