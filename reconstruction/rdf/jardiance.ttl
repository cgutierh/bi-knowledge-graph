    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 4 ;
    kg:section_id "2c3ae1b7-9edb-4706-a9ff-6b789a40c9b6" ;
    kg:section_title "UACR" ;
    kg:section_type "heading" ;
    kg:source_document_id "c66d5608-a1a9-4ea5-8044-6599b515b904" ;
    kg:source_document_type "disease_brochure" ;
    kg:source_file_name "CKD_Brochure.pdf" ;
    kg:text "A UACR (urine albumin-to-creatinine ratio) is a urine test that checks for how much small protein, called albumin, is in your urine, which is a sign of kidney damage." .

