    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "1f7e90acd06d74c4d66c59be32df9ff88efb37535fab967845f29dba3f69df1a" ;
    kg:text """In the EMPA-REG OUTCOME study, for time to first nephropathy event, the HR was 0.61 (95% CI 0.53, 0.70) for empagliflozin (12.7%) vs placebo (18.8%).

In addition, empagliflozin showed a higher (HR 1.82, 95% CI 1.40, 2.37) occurrence of sustained normo- or micro-albuminuria (49.7%) in patients with baseline macro-albuminuria compared with placebo (28.8%).""" ;
    kg:token_count 89 .

<urn:kg:jardiance:chunk:7ed238fd-08c6-4f77-889f-e8e16cac5f09> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "7ed238fd-08c6-4f77-889f-e8e16cac5f09" ;
    kg:chunk_index 72 ;
    kg:extraction_method "docling" ;
