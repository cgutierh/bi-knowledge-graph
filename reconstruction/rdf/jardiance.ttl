<urn:kg:jardiance:section:e493fe94-1f99-469f-8493-2c4e22b1bc2c> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:66f573da-a75f-4eab-bb95-e2e07fbeda4b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 36 ;
    kg:section_id "e493fe94-1f99-469f-8493-2c4e22b1bc2c" ;
    kg:section_title "Colour palette" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """The power of colour is often underestimated in branding. Different colours and different combinations of colours cause different emotional and psychologic reactions.

The JARDIANCE brand colour palette is a strong reflection of the proactive, brave, and energising personality of the brand. It uses a combination of high-contrasting colours: teal, yellow, and brown.

Codes for each colour and/or gradient range are provided within each colour swatch.""" .

<urn:kg:jardiance:section:e4c9d7e4-676c-4ba6-bd7a-a90f0344acc1> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
