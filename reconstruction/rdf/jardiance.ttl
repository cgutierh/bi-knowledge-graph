<urn:kg:jardiance:section:dff5d609-8387-412f-adb6-6b2ee91fbe2f> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:724bb5c2-64f5-4c48-b8a1-a102e4eff432> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 4 ;
    kg:section_id "dff5d609-8387-412f-adb6-6b2ee91fbe2f" ;
    kg:section_title "General" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Empagliflozin should not be used in patients with type 1 diabetes mellitus (see 'Ketoacidosis' in section 4.4)." .

<urn:kg:jardiance:section:e0799d46-0074-47d9-b4db-2580f1a1d3ff> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:acbf3404-2548-4e71-806a-1b73f6a7cef3> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "e0799d46-0074-47d9-b4db-2580f1a1d3ff" ;
    kg:section_title "Insulin and insulin secretagogues" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Insulin and insulin secretagogues, such as sulphonylureas, may increase the risk of hypoglycaemia. Therefore, a lower dose of insulin or an insulin secretagogue may be required to reduce the risk of hypoglycaemia when used in combination with empagliflozin (see sections 4.2 and 4.8)." .

<urn:kg:jardiance:section:e156c391-41bc-4900-8f1d-243f070d56e1> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:6244bb07-3a2b-4173-9fdf-e228f651bf4e> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 24 ;
    kg:section_id "e156c391-41bc-4900-8f1d-243f070d56e1" ;
    kg:section_title "Fasting plasma glucose" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "In four placebo-controlled studies, treatment with empagliflozin as monotherapy or add-on therapy to metformin, pioglitazone, or metformin plus a sulphonylurea resulted in mean changes from baseline in FPG of -20.5 mg/dL [-1.14 mmol/L] for empagliflozin 10 mg and -23.2 mg/dL [-1.29 mmol/L] for empagliflozin 25 mg compared to placebo (7.4 mg/dL [0.41 mmol/L]). This effect was observed after 24 weeks and maintained for 76 weeks." .

<urn:kg:jardiance:section:e1a203ff-ede7-48ea-ba5a-531e9255e43a> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
