<urn:kg:jardiance:pisection:55565e14-66ad-4c40-98a8-5d571ad91ec5> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:55565e14-66ad-4c40-98a8-5d571ad91ec5> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:55565e14-66ad-4c40-98a8-5d571ad91ec5> ;
    kg:graphScope "brand" ;
    kg:page_number 45 ;
    kg:section_id "55565e14-66ad-4c40-98a8-5d571ad91ec5" ;
    kg:section_title "Hypoglycemia" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Inform patients that hypoglycemia has been reported when JARDIANCE is used with insulin secretagogues or insulin. Hypoglycemia may occur in pediatric patients regardless of concomitant antidiabetic treatment. Educate patients or caregivers on the signs and symptoms of hypoglycemia [see Warnings and Precautions (5.4)] ." .

<urn:kg:jardiance:pisection:5556d121-5d2f-42f5-b6cb-3847d4b3223a> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:5556d121-5d2f-42f5-b6cb-3847d4b3223a> ;
    kg:graphScope "brand" ;
    kg:page_number 6 ;
    kg:section_id "5556d121-5d2f-42f5-b6cb-3847d4b3223a" ;
    kg:section_title "Lower limb amputations" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "An increase in cases of lower limb amputation (primarily of the toe) has been observed in long-term clinical studies with another SGLT2 inhibitor. It is unknown whether this constitutes a class effect. Like for all diabetic patients it is important to counsel patients on routine preventative foot-care." .

<urn:kg:jardiance:pisection:55880ba3-c4f4-41d4-8672-c6cb88ab9d74> a kg:PISection ;
