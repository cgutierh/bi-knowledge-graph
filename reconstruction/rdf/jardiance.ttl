    kg:section_title "Lactation" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Advise patients that breastfeeding is not recommended during treatment with JARDIANCE [see Use in Specific Populations (8.2)]." .

