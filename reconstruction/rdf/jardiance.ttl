    kg:page_number 20 ;
    kg:section_id "950fa678-14a1-40e2-8375-206d1804f896" ;
    kg:section_title "Impairment of Fertility" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Empagliflozin had no effects on mating, fertility or early embryonic development in treated male or female rats up to the high dose of 700 mg/kg/day (approximately 155 times the 25 mg clinical dose in males and females, respectively)." .

<urn:kg:jardiance:section:960dacf9-11e2-42e9-b8da-6bded3aff8b3> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
