    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Age, body mass index (BMI), gender and race (Asians versus primarily Whites) do not have a clinically meaningful effect on pharmacokinetics of empagliflozin." .

