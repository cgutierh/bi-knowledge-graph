<urn:kg:jardiance:chunk:17e819b0-a9cc-4d83-9937-b69457566f64> a kg:Chunk ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:chunk_id "17e819b0-a9cc-4d83-9937-b69457566f64" ;
