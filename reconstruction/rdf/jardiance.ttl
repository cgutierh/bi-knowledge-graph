<urn:kg:jardiance:chunk:3b442f96-0ad8-4836-9e4f-29b3cad0ea44> a kg:Chunk ;
    rdfs:label "CKD_Brochure.pdf" ;
    kg:chunk_id "3b442f96-0ad8-4836-9e4f-29b3cad0ea44" ;
    kg:chunk_index 5 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 2 ;
    kg:section_id "be2ef901-f86d-4028-80b1-982e816c84f8" ;
    kg:source_document_id "c66d5608-a1a9-4ea5-8044-6599b515b904" ;
    kg:source_document_type "disease_brochure" ;
    kg:source_file_name "CKD_Brochure.pdf" ;
    kg:source_hash "7ca77928207c14d70736b56217b75c1ed7aec27b51e2910ef4af9230b794df16" ;
    kg:text """<!-- image -->

Slow the progression of chronic kidney disease

Reduce the risk of kidney failure, which can lead to dialysis

<!-- image -->

Lower the risk of cardiovascular death

<!-- image -->

JARDIANCE is not for use to lower blood sugar in people with type 1 diabetes. It may increase their risk of diabetic ketoacidosis (increased ketones in the blood or urine).

JARDIANCE is not for use to lower blood sugar in people with type 2 diabetes who have severe kidney problems, because it may not work.

JARDIANCE is not for people with polycystic kidney disease, or who are taking or have recently received certain types of immunosuppressive therapy to treat kidney disease. JARDIANCE is not expected to work if you have these conditions.""" ;
    kg:token_count 186 .

