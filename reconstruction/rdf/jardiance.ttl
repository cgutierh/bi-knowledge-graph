<urn:kg:jardiance:chunk:6ff6eaad-6860-48f1-b249-b966dbc390eb> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "6ff6eaad-6860-48f1-b249-b966dbc390eb" ;
