    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "21214b6b18eca314ab35f08c0b7c395f83bea8fbf8f8f66f5ec8432f506af883" ;
    kg:text "Body mass index had no clinically relevant effect on the pharmacokinetics of empagliflozin based on the population pharmacokinetic analysis. In this analysis, AUC was estimated to be 5.82%, 10.4%, and 17.3% lower in subjects with BMI of 30, 35, and 45 kg/m 2 , respectively, compared to subjects with a body mass index of 25 kg/m 2 ." ;
    kg:token_count 83 .

