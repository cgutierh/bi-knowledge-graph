<urn:kg:jardiance:chunk:a8263b31-469b-4ca9-a627-48e96a796d58> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "a8263b31-469b-4ca9-a627-48e96a796d58" ;
    kg:chunk_index 74 ;
