<urn:kg:jardiance:section:e8158717-c350-4032-bda0-9a654038afcd> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:36cbd42c-7441-468d-a347-1b517bd565e6> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 54 ;
    kg:section_id "e8158717-c350-4032-bda0-9a654038afcd" ;
    kg:section_title "Common" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """- genital yeast infection (thrush)
- passing more urine than usual or needing to pass urine more often
- itching
- rash or red skin - this may be itchy and include raised bumps, oozing fluid or blisters
- thirst
- blood tests may show an increase in blood fat (cholesterol) levels in your blood
- constipation""" .

<urn:kg:jardiance:section:e8f35e26-cca8-418c-ba00-d2b1847beab8> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:cd6d5b3f-bf8a-4619-bccd-a5efeefec956> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 32 ;
    kg:section_id "e8f35e26-cca8-418c-ba00-d2b1847beab8" ;
    kg:section_title "The Boehringer Ingelheim/ Lilly Alliance: logo use" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """When the Boehringer Ingelheim logo and Lilly logo appear on the same surface, for non-product branded purposes, place the former in the bottom left corner and the latter in the bottom right corner. Try to preserve as much horizontal distance as possible between them.

<!-- image -->

Preserve a clear space around both logos, equal in space, with dimensions equal to the diameter of the Boehringer Ingelheim logogram.

<!-- image -->

<!-- image -->""" .

