    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text "The styling for JARDIANCE charts and graphs is characterised by clean, simple data and infographics. Refer to the examples provided when visualising data for promotional communications." .

