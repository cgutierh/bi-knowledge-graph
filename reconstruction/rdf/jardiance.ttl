<urn:kg:jardiance:section:c1e1e362-b99d-461d-8082-b89d2f65f27d> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:e3cf4de1-10da-443f-b8f7-3e0d94c031cb> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 39 ;
    kg:section_id "c1e1e362-b99d-461d-8082-b89d2f65f27d" ;
    kg:section_title "Follow these examples:" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text "You may apply the 3 layers as a frame to house a lifestyle image or as a block of the JARDIANCE teal to highlight key data points (see examples on previous page). The 3 layers are meant to be used in conjunction with the page architecture for print pieces; however, in the iVA these elements may compete. If space is limited, the page architecture should be used instead of the 3 layers." .

<urn:kg:jardiance:section:c2574437-58c0-4360-a8f9-99e493ad1651> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:67b52d93-ac7c-46c0-9a9b-cde18a7db5f0> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 40 ;
    kg:section_id "c2574437-58c0-4360-a8f9-99e493ad1651" ;
    kg:section_title "Use a 3-layered graphic once (in any corner), preferably the top right." ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """This page architecture is approved for use across all print and digital materials.

The JARDIANCE page architecture uses a layered sequence. Use a full saturation of the 3 colours: yellow, teal, and grey. The 3 colours, when grouped together, become a layer. Without this graphic trio, the page architecture is incomplete.

<!-- image -->""" .

<urn:kg:jardiance:section:c37b5864-2d1a-4473-9a4b-60505cdcb9de> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:0d446b35-c4ef-4b47-89c0-9364003dec2b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 8 ;
    kg:section_id "c37b5864-2d1a-4473-9a4b-60505cdcb9de" ;
    kg:section_title "Breast-feeding" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "No data in humans are available on excretion of empagliflozin into milk. Available toxicological data in animals have shown excretion of empagliflozin in milk. A risk to the newborns/infants cannot be excluded. Jardiance should not be used during breast-feeding." .

<urn:kg:jardiance:section:c393d8de-b447-4a59-8c9f-42939da54f45> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:95651fe2-39e4-4dfd-8465-a5e5139bf900> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 54 ;
    kg:section_id "c393d8de-b447-4a59-8c9f-42939da54f45" ;
    kg:section_title "What Jardiance contains" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """- -The active substance is empagliflozin.
- -Each tablet contains 10 mg or 25 mg empagliflozin.
- -The other ingredients are:
- -tablet core: lactose monohydrate (see end of section 2 under 'Jardiance contains lactose'), microcrystalline cellulose, hydroxypropylcellulose, croscarmellose sodium (see end of section 2 under 'Jardiance contains sodium'), colloidal anhydrous silica, magnesium stearate""" .

<urn:kg:jardiance:section:c507029e-23db-46d2-91d9-9e218508fa6f> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:d30e4fce-4909-4f93-a17e-679f6d8fd2d9> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 51 ;
    kg:section_id "c507029e-23db-46d2-91d9-9e218508fa6f" ;
    kg:section_title "Children and adolescents" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Jardiance can be used in children aged 10 years and older for the treatment of type 2 diabetes. No data are available in children below 10 years of age.

Jardiance is not recommended for children and adolescents under 18 years of age for the treatment of heart failure or for the treatment of chronic kidney disease, because it has not been studied in these patients.""" .

