<urn:kg:jardiance:section:7de08fb3-1a74-4e7d-92a5-c3a3e10adbef> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:379d0541-bf82-4bfd-a876-be12f506c33d> ;
    kg:extraction_method "docling" ;
