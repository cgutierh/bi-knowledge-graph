<urn:kg:jardiance:section:e5e1003e-f1ba-47e7-9743-0582ab6b81b9> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:3ddedeb2-6807-4c97-9147-db90828aeba8> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 28 ;
    kg:section_id "e5e1003e-f1ba-47e7-9743-0582ab6b81b9" ;
    kg:section_title "Generic name" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """If the generic name (empagliflozin) is required by regulatory authorities to appear with the brand name, then the generic name must always appear with the largest display of the JARDIANCE logo on any surface or screen and should be at least one-third the size of the logotype.

Always use brown for the generic name unless local regulations or technical requirements state otherwise. Please follow individual country guidelines regarding use of the generic name.""" .

