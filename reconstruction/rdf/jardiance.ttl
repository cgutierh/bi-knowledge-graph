    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:statement_text "The primary endpoint in EMPA-REG OUTCOME was the time to first occurrence of a Major Adverse Cardiac Event (MACE).  A major adverse cardiac event was defined as occurrence of either a CV death or a non-fatal myocardial infarction (MI) or a non-fatal stroke.  The statistical analy" .

