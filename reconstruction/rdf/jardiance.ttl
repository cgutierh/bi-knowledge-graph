<urn:kg:jardiance:chunk:bcb3b421-23d6-41d1-9101-20b3db01d55e> a kg:Chunk ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:chunk_id "bcb3b421-23d6-41d1-9101-20b3db01d55e" ;
    kg:chunk_index 221 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 65 ;
    kg:section_id "c0ef518e-9d29-4fc5-bc8a-dc151bdb3e8a" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:source_hash "11773d844220ddad1aa0d5b958a35ec5c987781daa6c97f810fede20869e729f" ;
    kg:text """Consider the following when developing content:

-   Convey a sense of empathy with the challenges that HCPs and patients face when treating/managing the disease
-   Infuse headlines, callouts, and lead-ins with energy; use upbeat and positive language
- Speak with confidence and assuredness
-   When possible, use present and future tenses. (Note, in the EU, use past tense for all CV claims ['JARDIANCE demonstrated' vs 'JARDIANCE demonstrates']. Similarly, for safety statements in either the EU or Mexico, only past tense is acceptable.)
-   Speak directly to the reader (when appropriate), as in 'you' and 'your'
-   Start sentences or paragraphs with verbs (eg, 'Give,' 'Choose,' 'Ask') to encourage the reader to take action""" ;
    kg:token_count 183 .

<urn:kg:jardiance:chunk:bcf04b45-9439-4c9e-bcf8-8b856cbacddc> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "bcf04b45-9439-4c9e-bcf8-8b856cbacddc" ;
    kg:chunk_index 48 ;
