<urn:kg:jardiance:chunk:9236a975-a3ac-43d8-b441-e02e21b5b96c> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "9236a975-a3ac-43d8-b441-e02e21b5b96c" ;
    kg:chunk_index 220 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 48 ;
    kg:section_id "edc92f27-a46a-41a8-896b-3ac34f080a55" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:source_hash "931d057e7687398032b76e619942071aa6f267c2ccfd123b810172279338e9f2" ;
    kg:text """- x have type 1 diabetes or have had diabetic ketoacidosis.
- x have a serious infection.
- x have a decrease in your insulin dose.
- x have a history of infection of the vagina or penis.
- x have kidney problems.
- x have a history of amputation.
- x have liver problems.
- x are on a low sodium (salt) diet. Your healthcare provider may change your diet or your dose.
- x have a history of urinary tract infections or problems with urination.
- x are going to have surgery. Your healthcare provider may stop your JARDIANCE before you have surgery. Talk to your healthcare provider if you are having surgery about when to stop taking JARDIANCE and when to start it again.
- x are eating less, or there is a change in your diet.
- x have or have had problems with your pancreas, including pancreatitis or surgery on your pancreas.
- x are dehydrated.
- x drink alcohol very often or drink a lot of alcohol in the short term ('binge' drinking).
- x are pregnant or plan to become pregnant. JARDIANCE may harm your unborn baby. If you become pregnant while taking JARDIANCE, tell your healthcare provider as soon as possible. Talk with your healthcare provider about the best way to control your blood""" ;
    kg:token_count 300 .

