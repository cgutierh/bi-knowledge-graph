<urn:kg:jardiance:pisection:19829346-10c0-4e65-a3e2-d5e9a3651c59> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:19829346-10c0-4e65-a3e2-d5e9a3651c59> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:19829346-10c0-4e65-a3e2-d5e9a3651c59> ;
    kg:graphScope "brand" ;
    kg:page_number 1 ;
    kg:section_id "19829346-10c0-4e65-a3e2-d5e9a3651c59" ;
    kg:section_title "-----------------------USE IN SPECIFIC POPULATIONS------------------------" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """- x Pregnancy: Advise females of the potential risk to a fetus especially during the second and third trimesters. (8.1)
- x Lactation: Not recommended when breastfeeding. (8.2)
- x Geriatric Patients: Higher incidence of adverse reactions related to volume depletion and reduced renal function. (8.5)
- x Renal Impairment: Higher incidence of adverse reactions related to reduced renal function. (8.6)

See 17 for PATIENT COUNSELING INFORMATION and Medication Guide.

Revised: 10/2025

