    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 8 ;
    kg:section_id "689d954c-5fa0-4db4-a085-143676834c2e" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "2243b070af48330f5e986ab82e1002b4b36f105cdc37a13160c3c03a88dff0dc" ;
    kg:text "There are no data from the use of empagliflozin in pregnant women. Animal studies show that empagliflozin crosses the placenta during late gestation to a very limited extent but do not indicate direct or indirect harmful effects with respect to early embryonic development. However, animal studies have shown adverse effects on postnatal development (see section 5.3). As a precautionary measure, it is preferable to avoid the use of Jardiance during pregnancy." ;
    kg:token_count 115 .

