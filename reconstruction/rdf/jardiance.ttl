    kg:claim_status "candidate" ;
    kg:claim_text "Adjusted mean changes of -0.1% from baseline HbA1c 7.9% for placebo (n=207), -0.7% from baseline HbA1c 7.9% for JARDIANCE 10 mg (n=217), and -0.8% from baseline HbA1c 7.9% for JARDIANCE 25 mg (n=213), respectively. Difference from placebo (adjusted mean) was -0.6% for both JARDIANCE 10 mg and 25 mg; p<0.001 vs placebo for both doses." ;
    kg:graphScope "brand" ;
    kg:indication "Type 2 diabetes" ;
    kg:key_message_type "Dosing / Administration" ;
