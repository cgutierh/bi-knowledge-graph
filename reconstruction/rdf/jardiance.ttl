<urn:kg:jardiance:section:c605dd04-eea9-4d75-84ac-2089ef8e7cb5> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:6756e47d-8341-461c-9954-16ffc1b25015>,
        <urn:kg:jardiance:chunk:6ad965ef-4fdb-4d2c-843d-4253114db198>,
        <urn:kg:jardiance:chunk:d23d6391-796b-4874-b675-65ddfaac61b9> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 17 ;
    kg:section_id "c605dd04-eea9-4d75-84ac-2089ef8e7cb5" ;
    kg:section_title "individual components a" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """|                                 | Empagliflozin 10 mg b   | Empagliflozin 10 mg b   | Empagliflozin 10 mg b   | Empagliflozin 25 mg b   | Empagliflozin 25 mg b   | Empagliflozin 25 mg b   | Metformin c   | Metformin c   |
|---------------------------------|-------------------------|-------------------------|-------------------------|-------------------------|-------------------------|-------------------------|---------------|---------------|
|                                 | + Met 1 000 mg c        | + Met 2 000 mg c        | No Met                  | + Met 1 000 mg c        | + Met 2 000 mg c        | No Met                  | 1 000 m g     | 2 000 m g     |
| N                               | 161                     | 167                     | 169                     | 165                     | 169                     | 163                     | 167           | 162           |
| HbA1c (%)                       |                         |                         |                         |                         |                         |                         |               |               |
| Baseline (mean)                 | 8.68                    | 8.65                    | 8.62                    | 8.84                    | 8.66                    | 8.86                    | 8.69          | 8.55          |
| Change from baseline 1          | -1.98                   | -2.07                   | -1.3 5                  | -1.93                   | -2.08                   | -1.3 6                  | -1.18         | -1.75         |
| Compariso n vs. empa (95% CI) 1 | -0.63* (-0.86, -0.40)   | -0.72* (-0.96, -0.49)   |                         | -0.57* (-0.81, -0.34)   | -0.72* (-0.95, -0.48)   |                         |               |               |
| Compariso n vs. met (95% CI) 1  | -0.79* (-1.03, -0.56)   | -0.33* (-0.56, -0.09)   |                         | -0.75* (-0.98 -0.51)    | -0.33* (-0.56, -0.10)   |                         |               |               |

Met = metformin; empa = empagliflozin

- 1 mean adjusted for baseline value
- a Analyses were performed on the full analysis set (FAS) using an observed cases (OC) approach
- b Given in two equally divided doses per day when given together with metformin
- c Given in two equally divided doses per day
* p ≤ 0.0062 for HbA1c""" .

<urn:kg:jardiance:section:c772b334-5918-4ce4-89a8-51b6ced1f797> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:67183249-a0c1-403e-b9e9-67450d820b39> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 33 ;
    kg:section_id "c772b334-5918-4ce4-89a8-51b6ced1f797" ;
    kg:section_title "Hepatic impairment" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "In subjects with mild, moderate, and severe hepatic impairment according to the Child-Pugh classification, AUC of empagliflozin increased approximately by 23%, 47%, and 75% and Cmax by approximately 4%, 23%, and 48%, respectively, compared to subjects with normal hepatic function." .

<urn:kg:jardiance:section:c9e34bbd-aa38-4d5f-b759-dd19be79d886> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:85386c65-ad22-4ba3-9bc0-9658c8ef2210> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 18 ;
    kg:section_id "c9e34bbd-aa38-4d5f-b759-dd19be79d886" ;
    kg:section_title "Graphic elements and background" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """The paint, textural, and colour swash elements provide visual impact, vibrancy, and a distinctive layer of brand expression that enhances recognition and engagement across campaign materials.

<!-- image -->""" .

