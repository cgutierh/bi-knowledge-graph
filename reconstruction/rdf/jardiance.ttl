<urn:kg:jardiance:chunk:f1a17838-39cc-4301-a0ec-5e0a44fc0fe3> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "f1a17838-39cc-4301-a0ec-5e0a44fc0fe3" ;
    kg:chunk_index 29 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 5 ;
    kg:section_id "85d76290-0f19-41ac-bfe5-6cabbd83b70a" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:source_hash "453946ff5f7db9ade3315b259105afc39bce8c07db407662ec6ba8debcbafd0b" ;
    kg:text "JARDIANCE can cause intravascular volume depletion which may sometimes manifest as symptomatic hypotension or acute transient changes in creatinine [see Adverse Reactions (6.1)] . There have been postmarketing reports of acute kidney injury, some requiring hospitalization and dialysis, in patients with type 2 diabetes mellitus receiving SGLT2 inhibitors, including JARDIANCE. Patients with impaired renal function (eGFR less than 60 mL/min/1.73 m 2 ), elderly patients, or patients on loop diuretics may be at increased risk for volume depletion or hypotension. Before initiating JARDIANCE in patients with one or more of these characteristics, assess volume status and renal function. In patients with volume depletion, correct this condition before initiating JARDIANCE. Monitor for signs and symptoms of volume depletion, and renal function after initiating therapy." ;
    kg:token_count 218 .

