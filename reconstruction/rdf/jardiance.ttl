    kg:graphScope "brand" ;
    kg:page_number 52 ;
    kg:section_id "51f6265a-6eb7-4cab-b0b1-b752bf487c18" ;
    kg:section_title "Jardiance contains lactose" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Jardiance contains lactose (milk sugar). If you have been told by your doctor that you have an intolerance to some sugars, contact your doctor before taking this medicine." .

<urn:kg:jardiance:pisection:52e4f9fc-25ee-4e4f-ac2a-e79d8366954b> a kg:PISection ;
