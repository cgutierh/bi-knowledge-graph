<urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:105> a kg:Claim ;
    rdfs:label "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx" ;
    kg:CLAIM_DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0> ;
    kg:CLAIM_SUPPORTED_BY_REFERENCE <urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:105> ;
    kg:DERIVED_FROM_TABLE <urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48> ;
    kg:approval_status "candidate" ;
    kg:audience "HCP/Internal" ;
    kg:claim_status "candidate" ;
    kg:claim_text """In the EMPEROR-Reduced trial, a randomised, double-blind, parallel-group, placebo-controlled study of 3730 patients with HFrEF, the efficacy and safety of JARDIANCE 10 mg (n=1863) were evaluated vs placebo (n=1867). Patients were adults with chronic HF (NYHA class II, III, or IV) and reduced ejection fraction (LVEF ≤40%). The primary endpoint in the EMPEROR- Reduced trial was a composite of CV death or hospitalisation for HF, analysed as time to the first event. Patients treated with JARDIANCE experienced a 25% RRR in this endpoint 
(HR=0.75; 95% CI: 0.65, 0.86; p<0.001).""" ;
    kg:graphScope "brand" ;
    kg:indication "Heart failure" ;
    kg:key_message_type "Guideline / Standard of care" ;
    kg:row_number 105 ;
    kg:source_document_id "13ae0354-6211-4820-b97a-7634167e0ed0" ;
    kg:source_document_type "claims_content_modules" ;
    kg:source_file_name "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx" ;
    kg:source_status "Corrected" ;
    kg:table_id "5812fcb9-1028-4304-99d1-d1da70d2fc48" .

<urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:106> a kg:Claim ;
    rdfs:label "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx" ;
    kg:CLAIM_DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0> ;
    kg:CLAIM_SUPPORTED_BY_REFERENCE <urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:106> ;
