    kg:page_number 53 ;
    kg:section_id "7de08fb3-1a74-4e7d-92a5-c3a3e10adbef" ;
    kg:section_title "4. Possible side effects" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Like all medicines, this medicine can cause side effects, although not everybody gets them." .

<urn:kg:jardiance:section:7e20fc68-1213-476f-b61f-bdcd7057e1d2> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:1117bd18-288c-4f1e-9dbb-10cb65211614> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 5 ;
    kg:section_id "7e20fc68-1213-476f-b61f-bdcd7057e1d2" ;
    kg:section_title "Complicated urinary tract infections" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Cases of complicated urinary tract infections including pyelonephritis and urosepsis have been reported in patients treated with empagliflozin (see section 4.8). Temporary interruption of empagliflozin should be considered in patients with complicated urinary tract infections." .

<urn:kg:jardiance:section:7f4bc599-9777-4a56-b4a2-0107e3fafb23> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:b085cd39-f30f-43be-8bb7-2247ef5ba9a9> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 50 ;
    kg:section_id "7f4bc599-9777-4a56-b4a2-0107e3fafb23" ;
    kg:section_title "What is heart failure?" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Heart failure occurs when the heart is too weak or stiff and cannot work properly. This can lead to serious medical problems and need for hospital care. The most common symptoms of heart failure are feeling breathless, feeling tired or very tired all the time, and ankle swelling.

Jardiance helps protect your heart from getting weaker and improves your symptoms.""" .

<urn:kg:jardiance:section:7f835f2f-3003-4cfa-b1b8-1505cbd7c6d3> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
