<urn:kg:jardiance:chunk:c07d0ae4-bb57-4eed-a56d-390dba02ba58> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "c07d0ae4-bb57-4eed-a56d-390dba02ba58" ;
    kg:chunk_index 82 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 13 ;
    kg:section_id "deecb14f-6525-4bb3-819d-fd6e87487433" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "84dc15f377226abbb6a8656a0003165be0d6804fabe81a753641e63bf49e98a7" ;
    kg:text "liflozin also reduces sodium reabsorption and increases the delivery of sodium to the distal tubule. This may influence several physiological functions including, but not restricted to: increasing tubuloglomerular feedback and reducing intraglomerular pressure, lowering both pre- and afterload of the heart, downregulating of sympathetic activity and reducing left ventricular wall stress as evidenced by lower NT-proBNP values which may have beneficial effects on cardiac remodeling, filling pressures and diastolic function as well as preserving kidney structure and function. Other effects such as an increase in haematocrit, a reduction in body weight and blood pressure may further contribute to the beneficial cardiac and renal effects." ;
    kg:token_count 186 .

