    kg:graphScope "brand" ;
    kg:page_number 54 ;
    kg:section_id "b8af523b-64a3-40ad-8964-e67d2a2bfde8" ;
    kg:section_title "Uncommon" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """- hives
- straining or pain when emptying the bladder
- blood tests may show a decrease in kidney function (creatinine or urea)
- blood tests may show increases in the amount of red blood cells in your blood (haematocrit)""" .

<urn:kg:jardiance:section:b8c312fb-18d3-4b42-9a88-06355658f720> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:extraction_method "docling" ;
