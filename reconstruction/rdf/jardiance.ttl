    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """It is important to use the brand palette whenever possible. Best practice is to apply colours at 100% strength for maximum brand recognition; however, tints and shades may be used to enhance visual impact where necessary in both print and digital applications.

<!-- image -->""" .

<urn:kg:jardiance:section:ad239ddc-98c7-4143-bbf3-52e3b7cf6024> a kg:Section ;
