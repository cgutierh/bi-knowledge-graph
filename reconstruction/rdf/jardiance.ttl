<urn:kg:jardiance:section:bc93c8a3-3eb1-4c6d-bf5b-9db9c5014c62> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:7661a4a7-33eb-49b0-9db8-0a22712b3866> ;
    kg:extraction_method "docling" ;
