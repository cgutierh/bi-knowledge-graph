<urn:kg:jardiance:chunk:6a514e4e-cef7-4e68-b357-2438d5aad197> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "6a514e4e-cef7-4e68-b357-2438d5aad197" ;
