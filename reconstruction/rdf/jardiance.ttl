<urn:kg:jardiance:chunk:1db06abc-047e-4407-bbe7-7070445e7530> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "1db06abc-047e-4407-bbe7-7070445e7530" ;
    kg:chunk_index 253 ;
