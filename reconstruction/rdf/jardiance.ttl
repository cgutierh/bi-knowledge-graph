    kg:page_number 53 ;
    kg:section_id "e6ed863c-6fbf-4594-be86-ee0292a3d5a6" ;
    kg:section_title "The WRONG way" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """- DON'T remove any of the organs-all 3 must be present
- DON'T make any organ larger or smaller than the others
- DON'T remove the circles connecting the organs""" .

<urn:kg:jardiance:section:e6f53908-a57e-4c29-9795-d193bce41745> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
