<urn:kg:jardiance:section:29d81d7e-8e15-48bc-aa7a-1050d980ebe7> a kg:Section ;
    rdfs:label "Medication Guidance.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:4cbe7ab2-5693-4a42-abb6-4142ba3dbad3> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 4 ;
    kg:section_id "29d81d7e-8e15-48bc-aa7a-1050d980ebe7" ;
    kg:section_title "General information about the safe and effective use of JARDIANCE." ;
    kg:section_type "heading" ;
    kg:source_document_id "dd225975-2d03-4997-adf6-8e9d59ecfa0e" ;
    kg:source_document_type "medication_guide" ;
    kg:source_file_name "Medication Guidance.pdf" ;
    kg:text """Medicines are sometimes prescribed for purposes other than those listed in a Medication Guide. Do not use JARDIANCE for a condition for which it is not prescribed.  Do not give JARDIANCE to other people, even if they have the same symptoms you have.  It may harm them.

You can ask your pharmacist or healthcare provider for information about JARDIANCE that is written for health professionals.""" .

<urn:kg:jardiance:section:29e9009a-a8d2-4b7d-90cc-fbeac38d3c25> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:2b7e835a-0d3c-4b7d-a169-e6019cdbc46b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 11 ;
    kg:section_id "29e9009a-a8d2-4b7d-90cc-fbeac38d3c25" ;
