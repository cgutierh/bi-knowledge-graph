    kg:graphScope "brand" ;
    kg:page_number 8 ;
    kg:section_id "c37b5864-2d1a-4473-9a4b-60505cdcb9de" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "7ffdc510b843b7a4b5a87568b94577b5578f6697eff134000a7752980d39f634" ;
    kg:text "No data in humans are available on excretion of empagliflozin into milk. Available toxicological data in animals have shown excretion of empagliflozin in milk. A risk to the newborns/infants cannot be excluded. Jardiance should not be used during breast-feeding." ;
    kg:token_count 66 .

<urn:kg:jardiance:chunk:0dafd8af-b710-4138-a3b8-0a88f9b81768> a kg:Chunk ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
