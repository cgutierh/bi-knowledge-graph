<urn:kg:jardiance:section:bbc27328-2672-4863-9c7d-127cc97fec4b> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:4a1fe6a1-a005-4f87-b6cb-9fa37b051eec> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 45 ;
    kg:section_id "bbc27328-2672-4863-9c7d-127cc97fec4b" ;
    kg:section_title "1. NAME OF THE MEDICINAL PRODUCT" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Jardiance 25 mg film-coated tablets empagliflozin" .

<urn:kg:jardiance:section:bc0e6856-6e6c-414d-9cc3-cfc13f3edf91> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:0db8125f-b7b1-45b0-a54b-6cc037f534f8> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 50 ;
    kg:section_id "bc0e6856-6e6c-414d-9cc3-cfc13f3edf91" ;
    kg:section_title "What is chronic kidney disease?" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Chronic kidney disease is a long-term condition. It might be caused by other diseases such as diabetes and high blood pressure or even by your own immune system attacking the kidneys. When you have chronic kidney disease, your kidneys may gradually lose their ability to clean and filter the blood properly. This can lead to serious medical problems such as swollen legs, heart failure or need for hospital care.

Jardiance helps protect your kidneys from losing their function.""" .

<urn:kg:jardiance:section:be3206bc-d5e2-4dfe-ad3d-e45c20e9c589> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:429c334a-7b29-4093-962b-ccf50ae23e5d> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 4 ;
    kg:section_id "be3206bc-d5e2-4dfe-ad3d-e45c20e9c589" ;
    kg:section_title "3 DOSAGE FORMS AND STRENGTHS" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """JARDIANCE tablets available as:

- x 10 mg pale yellow, round, biconvex and bevel-edged, film-coated tablets debossed with 'S 10' on one side and the Boehringer Ingelheim company symbol on the other side.
- x 25 mg pale yellow, oval, biconvex, film-coated tablets debossed with 'S 25' on one side and the Boehringer Ingelheim company symbol on the other side.""" .

