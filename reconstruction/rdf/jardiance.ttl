    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:038c2086-a3a9-4cb4-9161-1dcad61dbffd> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 49 ;
    kg:section_id "838f85ec-c0f0-4676-aec7-17a3ae0762d3" ;
    kg:section_title "Read all of this leaflet carefully before you start taking this medicine because it contains important information for you." ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """- -Keep this leaflet. You may need to read it again.
- -If you have any further questions, ask your doctor, pharmacist or nurse.
- -This medicine has been prescribed for you only. Do not pass it on to others. It may harm them, even if their signs of illness are the same as yours.
- -If you get any side effects, talk to your doctor, pharmacist or nurse. This includes any possible side effects not listed in this leaflet. See section 4.""" .

