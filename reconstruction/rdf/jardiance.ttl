<urn:kg:jardiance:section:55037364-6034-4112-8191-e20419b48e5c> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:d4e3717f-c95e-4c9d-8e7a-ef2ab99c94b3> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 55 ;
    kg:section_id "55037364-6034-4112-8191-e20419b48e5c" ;
    kg:section_title "JARDIANCE brand positioning" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """In the case of JARDIANCE, with its robust scientific platform, positioning guides how the new data and new brand indications will be embraced by the community in the future. By establishing a strong and aspirational positioning, we can create a distinct need for JARDIANCE in the minds of customers that, regardless of new indications or clinical data, will remain true over the long term.

The JARDIANCE positioning statement must drive everything we do and say in representing our brand.""" .

