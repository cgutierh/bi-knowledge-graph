    kg:page_number 14 ;
    kg:section_id "691c0d49-486d-4575-8859-432aa3d2c8b7" ;
    kg:section_title "Combination therapy" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
