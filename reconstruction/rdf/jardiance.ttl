<urn:kg:jardiance:section:ecdc03de-9687-47a8-b907-f6c414c8a6b3> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:993c5983-f0a1-4eb4-af7c-d521103ecb3b> ;
