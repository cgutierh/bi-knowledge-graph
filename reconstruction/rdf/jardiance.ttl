<urn:kg:jardiance:section:3c6aec85-7961-4278-9f61-4fb239513690> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:648b1f0c-9e3c-4a94-addc-9dc0c2d14e4e> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
