    rdfs:label "CKD_Brochure.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:49d1c548-0c92-47ac-8e2d-474cbd8a4973> ;
    kg:extraction_method "docling" ;
