<urn:kg:jardiance:chunk:a4030064-8a20-411f-8d36-670649164426> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "a4030064-8a20-411f-8d36-670649164426" ;
    kg:chunk_index 255 ;
    kg:extraction_method "docling" ;
