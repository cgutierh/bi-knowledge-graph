    kg:section_id "3391912a-4b4c-4df4-91d5-478b776dc9a7" ;
    kg:section_title "Pregnancy" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Advise pregnant patients, and patients of reproductive potential, of the potential risk to a fetus with treatment with JARDIANCE [see Use in Specific Populations (8.1)] .  Instruct patients to report pregnancies to their healthcare provider as soon as possible." .

<urn:kg:jardiance:section:33a8d98a-f8d6-460e-a0a4-7434bf8256cc> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:a984bf56-c24e-418f-bff6-d06fcdaa6632> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 50 ;
    kg:section_id "33a8d98a-f8d6-460e-a0a4-7434bf8256cc" ;
    kg:section_title "What is type 2 diabetes?" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Type 2 diabetes is a disease that comes from both your genes and your lifestyle. If you have type 2 diabetes, your pancreas does not make enough insulin to control the level of glucose in your blood, and your body is unable to use its own insulin effectively. This results in high levels of glucose in your blood which can lead to medical problems like heart disease, kidney disease, blindness, and poor circulation in your limbs." .

