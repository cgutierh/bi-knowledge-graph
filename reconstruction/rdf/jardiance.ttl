    kg:graphScope "brand" ;
    kg:page_number 6 ;
    kg:section_id "9fbfe13b-d7e9-47c8-b364-22200e5553b5" ;
    kg:section_title "Chronic kidney disease" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Patients with albuminuria may benefit more from treatment with empagliflozin." .

<urn:kg:jardiance:pisection:a0c9e45c-c33f-45a7-a82c-45f9f2aa159e> a kg:PISection ;
