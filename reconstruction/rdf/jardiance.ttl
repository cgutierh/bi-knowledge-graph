    kg:text "" .

<urn:kg:jardiance:section:d7dfdd26-4552-4293-8258-e2072ec11206> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:65ea8ce3-5446-446a-8242-c2dda6e5718a> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 45 ;
    kg:section_id "d7dfdd26-4552-4293-8258-e2072ec11206" ;
    kg:section_title "Lower Limb Amputation" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "Counsel patients about the importance of routine preventative foot care. Instruct patients to monitor for new pain or tenderness, sores or ulcers, or infections involving the leg or foot and to seek medical advice immediately if such signs or symptoms develop [see Warnings and Precautions (5.5)] ." .

<urn:kg:jardiance:section:d983b26b-1391-4ac9-b2f9-8a9d3e371541> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
