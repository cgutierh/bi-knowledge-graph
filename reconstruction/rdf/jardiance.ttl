<urn:kg:jardiance:section:8e575eb3-68c5-4fe2-9786-5cb2480351e3> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:06aa42bd-639c-42cd-8439-babaf800b011> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 65 ;
