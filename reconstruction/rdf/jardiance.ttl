    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "No new adverse reactions were identified in EMPEROR-Reduced or EMPEROR-Preserved heart failure trials." .

<urn:kg:jardiance:section:e9e280b4-7d10-4662-aa4f-cd53e6d91934> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:07bc97f0-8b8a-4cfb-9cc7-b22d0b881d9b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 9 ;
    kg:section_id "e9e280b4-7d10-4662-aa4f-cd53e6d91934" ;
    kg:section_title "Heart failure" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The EMPEROR studies included patients with heart failure and either reduced ejection fraction (N = 3 726) or preserved ejection fraction (N = 5 985) treated with empagliflozin 10 mg or placebo. Approximately half of the patients had type 2 diabetes mellitus. The most frequent adverse reaction of the pooled EMPEROR-Reduced and EMPEROR-Preserved studies was volume depletion (empagliflozin 10 mg: 11.4%. placebo: 9.7%)." .

<urn:kg:jardiance:section:ecb93aca-368b-4e2e-a151-cc15ed6f9924> a kg:Section ;
