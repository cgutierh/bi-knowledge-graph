<urn:kg:jardiance:claim:5812fcb9-1028-4304-99d1-d1da70d2fc48:174> a kg:Claim ;
    rdfs:label "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx" ;
    kg:CLAIM_DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:13ae0354-6211-4820-b97a-7634167e0ed0> ;
    kg:CLAIM_SUPPORTED_BY_REFERENCE <urn:kg:jardiance:reference:5812fcb9-1028-4304-99d1-d1da70d2fc48:174> ;
    kg:DERIVED_FROM_TABLE <urn:kg:jardiance:table:5812fcb9-1028-4304-99d1-d1da70d2fc48> ;
    kg:approval_status "candidate" ;
    kg:audience "HCP/Internal" ;
    kg:claim_status "candidate" ;
    kg:claim_text "JARDIANCE is contraindicated in patients with hypersensitivity to the active substance or to any of the excipients of JARDIANCE. JARDIANCE should not be used in patients with type 1 diabetes or for the treatment of DKA. JARDIANCE should be used with caution in patients who may be at a higher risk of ketoacidosis while taking JARDIANCE. In patients where DKA is suspected or diagnosed, treatment with JARDIANCE should be discontinued immediately. For use in patients with renal impairment, please refer to the dosing page of this document and the SmPC.1" ;
    kg:graphScope "brand" ;
    kg:indication "General" ;
    kg:key_message_type "Safety / Tolerability" ;
    kg:row_number 174 ;
    kg:source_document_id "13ae0354-6211-4820-b97a-7634167e0ed0" ;
    kg:source_document_type "claims_content_modules" ;
    kg:source_file_name "JARDIANCE_Claims_Corrected_Final-1 (1) 2.xlsx" ;
    kg:source_status "Corrected" ;
    kg:table_id "5812fcb9-1028-4304-99d1-d1da70d2fc48" .

