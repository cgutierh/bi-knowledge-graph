        <urn:kg:jardiance:chunk:9f056a35-cf55-4a7a-bc8c-d3a3e51b574c>,
        <urn:kg:jardiance:chunk:b7d6df2b-2b4d-4ef0-9336-68ecc827b29d>,
        <urn:kg:jardiance:chunk:d5a0cfec-4329-4e03-96ab-df7565ce28ee>,
        <urn:kg:jardiance:chunk:f32b5149-a2a3-4a72-a920-6b372e9e616f>,
        <urn:kg:jardiance:chunk:fc34c543-9ca5-472f-8c40-72c0de4973cd>,
        <urn:kg:jardiance:chunk:fd3fcd1f-918a-4ae8-a9de-07f014eb5ac4> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 15 ;
