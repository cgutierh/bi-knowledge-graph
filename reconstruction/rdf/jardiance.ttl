<urn:kg:jardiance:section:0f89706e-afab-4596-ab5b-0d16761cfd6c> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:8e1f3450-049e-4901-ab1f-15afb4f27418> ;
    kg:extraction_method "docling" ;
