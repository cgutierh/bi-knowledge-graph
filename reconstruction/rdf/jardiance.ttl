<urn:kg:jardiance:section:e1f75249-dc3c-4c04-9ddd-37d58d923549> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:d26f8f7a-132f-4da9-a00b-c25acdea3a37> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 11 ;
    kg:section_id "e1f75249-dc3c-4c04-9ddd-37d58d923549" ;
    kg:section_title "6.2  Postmarketing Experience" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """Additional adverse reactions have been identified during postapproval use of JARDIANCE. Because these reactions are reported voluntarily from a population of uncertain size, it is generally not possible to reliably estimate their frequency or establish a causal relationship to drug exposure.

Gastrointestinal Disorders:

Constipation

Infections:

Necrotizing fasciitis of the perineum (Fournier's gangrene), urosepsis and pyelonephritis

Metabolism and Nutrition Disorders:

Ketoacidosis

Renal and Urinary Disorders:

Acute kidney injury

Skin and Subcutaneous Tissue Disorders: Angioedema, skin reactions (e.g., rash, urticaria)""" .

<urn:kg:jardiance:section:e56f7b44-18b6-4db2-afa3-8b69ed0c09bf> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
