    kg:graphScope "brand" ;
    kg:page_number 32 ;
    kg:section_id "7076ad58-2837-4a04-94c0-4aea1af45b39" ;
    kg:section_title "Heart failure and chronic kidney disease" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The European Medicines Agency has waived the obligation to submit the results of studies with Jardiance in all subsets of the paediatric population in heart failure and in the treatment of chronic kidney disease (see section 4.2 for information on paediatric use)." .

<urn:kg:jardiance:pisection:72043664-d5b7-4ed9-8e8a-39ffb1cf44e7> a kg:PISection ;
