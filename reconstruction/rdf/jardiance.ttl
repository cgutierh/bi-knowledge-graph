    kg:text "Patients with albuminuria may benefit more from treatment with empagliflozin." ;
    kg:token_count 19 .

<urn:kg:jardiance:chunk:5dc70c67-bf4c-4418-9f1c-d09ec724b15b> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
