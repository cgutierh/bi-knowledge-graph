    kg:claim_status "candidate" ;
    kg:claim_text "*Key inclusion criteria included a chronic HF (NYHA class II-IV) diagnosis, an elevated NT-proBNP level, and therapy with the appropriate doses of HF medication. Elevated NT-proBNP is defined as a level of ≥1000 pg/mL in those with an ejection fraction of 31% to 35% or a level of ≥2500 pg/mL in those with an ejection fraction of 36% to 40%, as compared with a level of ≥600 pg/mL in those with an ejection fraction of ≤30%." ;
    kg:graphScope "brand" ;
    kg:indication "General" ;
    kg:key_message_type "Dosing / Administration" ;
    kg:row_number 121 ;
    kg:source_document_id "13ae0354-6211-4820-b97a-7634167e0ed0" ;
