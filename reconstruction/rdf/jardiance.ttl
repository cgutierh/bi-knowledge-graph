    kg:graphScope "brand" ;
    kg:page_number 34 ;
    kg:section_id "a13d3b4a-4fa5-486f-92ca-8e399085cf68" ;
    kg:section_title "Elderly" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Age did not have a clinically meaningful impact on the pharmacokinetics of empagliflozin based on the population pharmacokinetic analysis." .

