<urn:kg:jardiance:pisection:2beaba5a-54f8-4e07-82f8-61f70852fe79> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:2beaba5a-54f8-4e07-82f8-61f70852fe79> ;
    kg:graphScope "brand" ;
    kg:page_number 49 ;
    kg:section_id "2beaba5a-54f8-4e07-82f8-61f70852fe79" ;
    kg:section_title "What Jardiance is" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Jardiance contains the active substance empagliflozin.

Jardiance is a member of a group of medicines called sodium glucose co-transporter-2 (SGLT2) inhibitors.""" .

<urn:kg:jardiance:pisection:2dd90f41-cf84-43aa-83c1-268af0ba8aa9> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:2dd90f41-cf84-43aa-83c1-268af0ba8aa9> ;
    kg:graphScope "brand" ;
    kg:page_number 3 ;
    kg:section_id "2dd90f41-cf84-43aa-83c1-268af0ba8aa9" ;
    kg:section_title "Heart failure" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
