<urn:kg:jardiance:chunk:9ea7c767-69a4-4303-90ae-18042a0c7ecd> a kg:Chunk ;
    rdfs:label "Jardiance_Claims_updated & Content Modules 1.xlsx" ;
    kg:chunk_id "9ea7c767-69a4-4303-90ae-18042a0c7ecd" ;
