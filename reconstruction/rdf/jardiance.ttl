<urn:kg:jardiance:section:a4c15f9f-a518-4034-8328-017f9e14749c> a kg:Section ;
    rdfs:label "CKD_Brochure.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:69e5c7e3-1a36-4bc5-8b44-4b9464671626> ;
