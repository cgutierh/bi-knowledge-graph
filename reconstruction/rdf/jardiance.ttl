<urn:kg:jardiance:section:ad7eaca9-7cd2-4fa9-b9c1-052b1adb8aad> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:3d4d4ba7-5408-46a5-b8d0-7288c4678397> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 1 ;
    kg:section_id "ad7eaca9-7cd2-4fa9-b9c1-052b1adb8aad" ;
    kg:section_title "Limitations of Use:" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """- x Not recommended for use to improve glycemic control in patients with type 1 diabetes mellitus. It may increase the risk of diabetic ketoacidosis in these patients. (1)
- x Not recommended for use to improve glycemic control in patients with type 2 diabetes mellitus with an eGFR less than 30 mL/min/1.73 m 2 . (1)
- x Not recommended for the treatment of chronic kidney disease in patients with polycystic kidney disease or patients requiring or with a recent history of intravenous immunosuppressive therapy or greater than 45 mg of prednisone or equivalent for kidney disease. JARDIANCE is not expected to be effective in these populations. (1)""" .

<urn:kg:jardiance:section:ada0dd92-bf58-4831-810e-5e5d12bc2798> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:c589f855-8b67-4fbe-92a7-7cbf19111817> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 16 ;
    kg:section_id "ada0dd92-bf58-4831-810e-5e5d12bc2798" ;
    kg:section_title "Urinary Volume" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "In a 5-day study, mean 24-hour urine volume increase from baseline was 341 mL on Day 1 and 135 mL on Day 5 of empagliflozin 25 mg once daily treatment." .

<urn:kg:jardiance:section:adc0cd5f-3623-4d8d-8dde-95430221d837> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:567003f3-c169-4647-9a04-96b426094766> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 37 ;
    kg:section_id "adc0cd5f-3623-4d8d-8dde-95430221d837" ;
    kg:section_title "JARDIANCE." ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text "The JARDIANCE colour environment is inspired by the colours and proportions of the JARDIANCE symbol and creates visual continuity across all executions. The multiple layers are designed to draw the viewer into the JARDIANCE world. Generous usage of the primary colour, teal, brings instant brand recognition." .

<urn:kg:jardiance:section:aeb9cd16-33e4-4535-8437-8dacf916936f> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:a9a09ef3-4f86-46b8-9a28-ddc63e544475> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 42 ;
    kg:section_id "aeb9cd16-33e4-4535-8437-8dacf916936f" ;
    kg:section_title "3. LIST OF EXCIPIENTS" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Contains lactose, see leaflet for further information." .

<urn:kg:jardiance:section:aff7b731-329d-4ae8-a471-c0c44168e3d3> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:0faa8c45-ba83-4ef9-99be-7c46f661d23b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 17 ;
    kg:section_id "aff7b731-329d-4ae8-a471-c0c44168e3d3" ;
    kg:section_title "Patients with Hepatic Impairment" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "In adult patients with mild, moderate, and severe hepatic impairment according to the Child-Pugh classification, AUC of empagliflozin increased by approximately 23%, 47%, and 75%, and Cmax increased by approximately 4%, 23%, and 48%, respectively, compared to subjects with normal hepatic function." .

<urn:kg:jardiance:section:b08e53e7-dabc-4810-879a-17b83aa13a58> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:19e7596d-c4bb-44ed-956c-72826a0653a6> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 56 ;
    kg:section_id "b08e53e7-dabc-4810-879a-17b83aa13a58" ;
    kg:section_title "Deutschland" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Boehringer Ingelheim Pharma GmbH &amp; Co. KG Tel: +49 (0) 800 77 90 900" .

<urn:kg:jardiance:section:b0a2edfb-2315-4618-b86d-09b5ed86d2c6> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:706eaa4c-937b-42c6-afa5-a13737a69019> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 5 ;
    kg:section_id "b0a2edfb-2315-4618-b86d-09b5ed86d2c6" ;
    kg:section_title "Monitoring of renal function" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Assessment of renal function is recommended as follows:

- -Prior to empagliflozin initiation and periodically during treatment, i.e. at least yearly (see sections 4.2, 4.8, 5.1 and 5.2).
- -Prior to initiation of any concomitant medicinal product that may have a negative impact on renal function.""" .

<urn:kg:jardiance:section:b0c0a9ca-1f49-4fb1-ba69-09b754e34493> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:84552a19-30f2-4233-9dff-d5b3744ce135> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 3 ;
    kg:section_id "b0c0a9ca-1f49-4fb1-ba69-09b754e34493" ;
    kg:section_title "Paediatric population" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The recommended starting dose is 10 mg empagliflozin once daily. In patients tolerating empagliflozin 10 mg once daily and requiring additional glycaemic control, the dose can be increased to 25 mg once daily (see sections 5.1 and 5.2). No data are available for children with eGFR &lt; 60 mL/min/1.73 m 2  and children below 10 years of age." .

<urn:kg:jardiance:section:b0c46249-a646-4284-b06e-b5736ef77747> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:13958bd4-6dd8-419e-bde0-842ce3600ddf> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 14 ;
    kg:section_id "b0c46249-a646-4284-b06e-b5736ef77747" ;
    kg:section_title "8.7  Hepatic Impairment" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "JARDIANCE may be used in patients with hepatic impairment [see Clinical Pharmacology (12.3)] ." .

