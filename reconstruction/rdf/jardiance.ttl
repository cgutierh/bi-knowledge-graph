<urn:kg:jardiance:pisection:7de08fb3-1a74-4e7d-92a5-c3a3e10adbef> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:7de08fb3-1a74-4e7d-92a5-c3a3e10adbef> ;
    kg:graphScope "brand" ;
    kg:page_number 53 ;
    kg:section_id "7de08fb3-1a74-4e7d-92a5-c3a3e10adbef" ;
    kg:section_title "4. Possible side effects" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Like all medicines, this medicine can cause side effects, although not everybody gets them." .

<urn:kg:jardiance:pisection:7e20fc68-1213-476f-b61f-bdcd7057e1d2> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:7e20fc68-1213-476f-b61f-bdcd7057e1d2> ;
    kg:graphScope "brand" ;
    kg:page_number 5 ;
    kg:section_id "7e20fc68-1213-476f-b61f-bdcd7057e1d2" ;
    kg:section_title "Complicated urinary tract infections" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Cases of complicated urinary tract infections including pyelonephritis and urosepsis have been reported in patients treated with empagliflozin (see section 4.8). Temporary interruption of empagliflozin should be considered in patients with complicated urinary tract infections." .

<urn:kg:jardiance:pisection:7ef3b9c8-c592-4dc7-a32e-65dcbc6668fc> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:7ef3b9c8-c592-4dc7-a32e-65dcbc6668fc> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:7ef3b9c8-c592-4dc7-a32e-65dcbc6668fc> ;
    kg:graphScope "brand" ;
    kg:page_number 10 ;
    kg:section_id "7ef3b9c8-c592-4dc7-a32e-65dcbc6668fc" ;
    kg:section_title "Clinical Trial in Adults with Chronic Kidney Disease" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "The safety profile in patients with chronic kidney disease was generally consistent with that observed across the studied indications. In a long-term cardio-renal outcome trial [see Clinical Studies 14.5] , in patients with chronic kidney disease, the occurrence of lower limb amputations was reported with event rates of 2.9, and 4.3 events per 1,000 patient-years in the placebo, and JARDIANCE 10 mg treatment arms, respectively [see Warnings and Precautions (5.5)]." .

