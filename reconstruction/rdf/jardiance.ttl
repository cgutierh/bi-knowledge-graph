<urn:kg:jardiance:section:f49aaa9f-a235-41d0-a04a-6c166164036b> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:5eefcda2-bd7a-4626-99ac-363be01f822c> ;
    kg:extraction_method "docling" ;
