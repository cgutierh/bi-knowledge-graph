<urn:kg:jardiance:section:89a7d627-f636-45c9-aced-13601362840a> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:f0b04188-0076-4ec4-b4ed-5b567af7afe8> ;
