<urn:kg:jardiance:chunk:cc0ddc2f-855d-41b5-8365-4c2958cf6ee8> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "cc0ddc2f-855d-41b5-8365-4c2958cf6ee8" ;
    kg:chunk_index 254 ;
    kg:extraction_method "docling" ;
