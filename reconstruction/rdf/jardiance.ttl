    kg:page_number 2 ;
    kg:section_id "b8c312fb-18d3-4b42-9a88-06355658f720" ;
    kg:section_title "4.1 Therapeutic indications" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "" .

<urn:kg:jardiance:section:b9908a1a-c9e1-4cfc-ad05-9bd4f2b282f3> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:106da502-2fb9-4c91-8a1b-7bfbe5bef5ea> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "b9908a1a-c9e1-4cfc-ad05-9bd4f2b282f3" ;
    kg:section_title "Diuretics" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Empagliflozin may add to the diuretic effect of thiazide and loop diuretics and may increase the risk of dehydration and hypotension (see section 4.4)." .

<urn:kg:jardiance:section:b9f3eb9a-be8b-4f96-8f20-210ffeeee15a> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:64c92c0a-eed1-44ae-932f-a6610959ddcc> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 3 ;
    kg:section_id "b9f3eb9a-be8b-4f96-8f20-210ffeeee15a" ;
    kg:section_title "Chronic kidney disease" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The recommended dose is 10 mg empagliflozin once daily." .

<urn:kg:jardiance:section:ba43c7dd-2b90-4f0c-8540-202777228484> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
