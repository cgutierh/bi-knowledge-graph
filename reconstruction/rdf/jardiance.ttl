    kg:section_title "Severe allergic reaction, seen uncommonly (may affect up to 1 in 100 people)" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """Possible signs of severe allergic reaction may include:

- swelling of the face, lips, mouth, tongue, or throat that may lead to difficulty breathing or swallowing)""" .

