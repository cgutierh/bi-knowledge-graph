<urn:kg:jardiance:pisection:b8f88a87-25cb-428a-846e-a9bed8221b0c> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:b8f88a87-25cb-428a-846e-a9bed8221b0c> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:b8f88a87-25cb-428a-846e-a9bed8221b0c> ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "b8f88a87-25cb-428a-846e-a9bed8221b0c" ;
    kg:section_title "6 ADVERSE REACTIONS" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text """The following important adverse reactions are described below and elsewhere in the labeling:

- x Diabetic Ketoacidosis in Patients with Type 1 Diabetes Mellitus and Other Ketoacidosis [see Warnings and Precautions (5.1)]
- x Volume Depletion [see Warnings and Precautions (5.2)]
- x Genitourinary Infections, including Urosepsis, Pyelonephritis, Necrotizing Fasciitis of the Perineum (Fournier's Gangrene), and Genital Mycotic Infections [see Warnings and Precautions (5.3)]
- x Hypoglycemia [see Warnings and Precautions (5.4)]
- x Hypersensitivity Reactions [see Warnings and Precautions (5.6)]""" .

<urn:kg:jardiance:pisection:b9908a1a-c9e1-4cfc-ad05-9bd4f2b282f3> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:b9908a1a-c9e1-4cfc-ad05-9bd4f2b282f3> ;
    kg:graphScope "brand" ;
    kg:page_number 7 ;
    kg:section_id "b9908a1a-c9e1-4cfc-ad05-9bd4f2b282f3" ;
    kg:section_title "Diuretics" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Empagliflozin may add to the diuretic effect of thiazide and loop diuretics and may increase the risk of dehydration and hypotension (see section 4.4)." .

<urn:kg:jardiance:pisection:b9b6bedd-2c81-45d4-aec9-4e0963368e04> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:b9b6bedd-2c81-45d4-aec9-4e0963368e04> ;
    kg:PI_SECTION_CONTAINS_SAFETY <urn:kg:jardiance:safety:b9b6bedd-2c81-45d4-aec9-4e0963368e04> ;
    kg:graphScope "brand" ;
    kg:page_number 8 ;
    kg:section_id "b9b6bedd-2c81-45d4-aec9-4e0963368e04" ;
    kg:section_title "4.7 Effects on ability to drive and use machines" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Jardiance has minor influence on the ability to drive and use machines. Patients should be advised to take precautions to avoid hypoglycaemia while driving and using machines, in particular when Jardiance is used in combination with a sulphonylurea and/or insulin." .

<urn:kg:jardiance:pisection:b9f3eb9a-be8b-4f96-8f20-210ffeeee15a> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
