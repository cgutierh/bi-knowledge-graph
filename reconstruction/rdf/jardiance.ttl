<urn:kg:jardiance:chunk:4485cb6c-c8c2-430c-83f8-da19d886c04c> a kg:Chunk ;
    rdfs:label "Jardiance_Claims_updated & Content Modules 1.xlsx" ;
    kg:chunk_id "4485cb6c-c8c2-430c-83f8-da19d886c04c" ;
    kg:chunk_index 19 ;
    kg:extraction_method "openpyxl" ;
    kg:graphScope "brand" ;
