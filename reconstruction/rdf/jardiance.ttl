<urn:kg:jardiance:pisection:61a7d8e6-605a-4699-9ef9-5b16b6a47781> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:61a7d8e6-605a-4699-9ef9-5b16b6a47781> ;
