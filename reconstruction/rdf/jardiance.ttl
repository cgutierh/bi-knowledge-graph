    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:source_hash "7f3d509ee22d08b0a73c51dab96b4a0258ef30b3b3a5dfe4328004fb75e9072e" ;
    kg:text """The JARDIANCE logo has a registration mark that appears at the end of the brand name, showing that the brand is a registered trademark. In some countries, the registration mark is required whenever the JARDIANCE brand name appears, while in other countries it may be required only on first appearance within a document or first appearance on each new page, spread, or screen.

For internal pieces, the registration mark and generic name are not required after the first mention. For your country-specific regulations, please contact the Corporate Department, Trademarks &amp; Unfair Competition for guidance prior to use.

<!-- image -->

This symbol forms an important part of the logo, must appear in the size and position shown, and must be scaled up or down in proportion to the size of the logo.""" ;
    kg:token_count 200 .

<urn:kg:jardiance:chunk:0db8125f-b7b1-45b0-a54b-6cc037f534f8> a kg:Chunk ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:chunk_id "0db8125f-b7b1-45b0-a54b-6cc037f534f8" ;
    kg:chunk_index 251 ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 50 ;
    kg:section_id "bc0e6856-6e6c-414d-9cc3-cfc13f3edf91" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:source_hash "7ec5463ffc0c1b6164b61d22dcc42586ab7d1f2e8fa803e94703f3f86674c0b6" ;
    kg:text """Chronic kidney disease is a long-term condition. It might be caused by other diseases such as diabetes and high blood pressure or even by your own immune system attacking the kidneys. When you have chronic kidney disease, your kidneys may gradually lose their ability to clean and filter the blood properly. This can lead to serious medical problems such as swollen legs, heart failure or need for hospital care.

Jardiance helps protect your kidneys from losing their function.""" ;
    kg:token_count 120 .

