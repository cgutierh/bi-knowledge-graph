<urn:kg:jardiance:pisection:9447f588-b6bf-46de-a6a1-ed998dd71e44> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:9447f588-b6bf-46de-a6a1-ed998dd71e44> ;
