    kg:section_title "Stopping power:" ;
    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text "The unique, impactful visual of Anthem stands out and gives JARDIANCE a platform for driving change. Even as it polarises, it creates meaningful brand recall and stopping power" .

<urn:kg:jardiance:section:5cfc38ce-789a-4a9e-bf9e-59f27c3011b9> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:b2e5c1ff-b9c9-4e05-b4a3-2577e85b7a2b> ;
    kg:extraction_method "docling" ;
