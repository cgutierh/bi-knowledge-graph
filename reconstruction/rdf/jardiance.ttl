<urn:kg:jardiance:chunk:90f997f2-5ae8-402f-ae78-4caf09415537> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "90f997f2-5ae8-402f-ae78-4caf09415537" ;
    kg:chunk_index 150 ;
