    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:source_hash "a23ac6dae8b0881b08b4cc50df5eb707ad66934af37237f12577b4f32d7192cf" ;
    kg:text """JARDIANCE is contraindicated in patients:

- x with a hypersensitivity to empagliflozin or any of the excipients in JARDIANCE, reactions such as angioedema have occurred [see Warnings and Precautions (5.6)] .""" ;
    kg:token_count 52 .

<urn:kg:jardiance:chunk:3fe89c76-121f-4099-8f4e-a7500f649e5e> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
