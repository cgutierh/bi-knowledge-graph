<urn:kg:jardiance:section:2d3eff54-7709-413a-898b-cc0ff7bcb0e0> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:52a4351f-3db7-4eaf-ba07-4203face17f1> ;
