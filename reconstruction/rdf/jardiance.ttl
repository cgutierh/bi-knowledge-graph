<urn:kg:jardiance:section:74ddfc00-f218-4899-bfc5-81fa0c1e64da> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:f361aba0-8837-4c34-8557-f711b93faeb6> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 6 ;
    kg:section_id "74ddfc00-f218-4899-bfc5-81fa0c1e64da" ;
    kg:section_title "Lactose" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The tablets contain lactose. Patients with rare hereditary problems of galactose intolerance, total lactase deficiency, or glucose-galactose malabsorption should not take this medicinal product." .

<urn:kg:jardiance:section:7561f639-7882-454b-b411-23c90ede7334> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:efb7f3d5-ac39-4ba2-b3ce-8148499c7a9b> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 2 ;
    kg:section_id "7561f639-7882-454b-b411-23c90ede7334" ;
    kg:section_title "Jardiance 10 mg film-coated tablets" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Round, pale yellow, biconvex, bevel-edged film-coated tablet debossed with 'S10' on one side and the Boehringer Ingelheim logo on the other (tablet diameter: 9.1 mm)." .

<urn:kg:jardiance:section:75e24a75-eeca-44c9-8778-473889172003> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:065825db-e0fd-4a32-8d16-481a25485cb3> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 16 ;
    kg:section_id "75e24a75-eeca-44c9-8778-473889172003" ;
    kg:section_title "12.3  Pharmacokinetics" ;
    kg:section_type "heading" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "The pharmacokinetics of empagliflozin has been characterized in healthy volunteers and patients with type 2 diabetes mellitus and no clinically relevant differences were noted between the two populations.  The steadystate mean plasma AUC and Cmax were 1,870 nmol ā h/L and 259 nmol/L, respectively, with 10 mg empagliflozin once daily treatment, and 4,740 nmol ā h/L and 687 nmol/L, respectively, with 25 mg empagliflozin once daily treatment.  Systemic exposure of empagliflozin increased in a dose-proportional manner in the therapeutic dose range. Empagliflozin does not appear to have time-dependent pharmacokinetic characteristics. Following oncedaily dosing, up to 22% accumulation, with respect to plasma AUC, was observed at steady-state." .

