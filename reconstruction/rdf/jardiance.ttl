<urn:kg:jardiance:section:b4aae777-ca81-42d2-af78-09316ff61110> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:364e2ec5-9166-4c25-8e64-31495586280c> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 2 ;
    kg:section_id "b4aae777-ca81-42d2-af78-09316ff61110" ;
    kg:section_type "body" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text "All content in the global branding guidelines is strictly confidential and not to be distributed externally. It is neither the intention of the authors of the global branding guidelines nor of the Boehringer Ingelheim/ Lilly Alliance to discuss, strategise, or implement marketing communications that fall beyond the approved indications for this product. Any promotional activities must be consistent with the approved label and carried out in compliance with all company policies, applicable laws, and regulations. Any promotional materials must be reviewed and approved locally for compliance with all company policies, applicable laws, and regulations." .

