<urn:kg:jardiance:section:16e8cdd0-4601-48dc-846d-fe1921cdc8d4> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:b57b20d1-ce33-43d6-88ef-8c10df7c346e> ;
