<urn:kg:jardiance:section:8cc6c1c4-80dc-49ed-b160-634d92f0d22e> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:09805519-5f1e-4f42-b05e-23e264152436> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 3 ;
    kg:section_id "8cc6c1c4-80dc-49ed-b160-634d92f0d22e" ;
    kg:section_title "All indications" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text """When empagliflozin is used in combination with a sulphonylurea or with insulin, a lower dose of the sulphonylurea or insulin may be considered to reduce the risk of hypoglycaemia (see sections 4.5 and 4.8).

If a dose is missed, it should be taken as soon as the patient remembers; however, a double dose should not be taken on the same day.""" .

<urn:kg:jardiance:section:8d5b8aa6-3e6a-4322-9090-a3afe8d4122a> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:88d74940-6f28-41a1-bd62-6d4265d2fc7d> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 6 ;
    kg:section_id "8d5b8aa6-3e6a-4322-9090-a3afe8d4122a" ;
    kg:section_title "Elevated haematocrit" ;
    kg:section_type "heading" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "Haematocrit increase was observed with empagliflozin treatment (see section 4.8). Patients with pronounced elevations in haematocrit should be monitored and investigated for underlying haematological disease." .

