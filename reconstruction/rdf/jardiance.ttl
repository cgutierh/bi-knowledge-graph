<urn:kg:jardiance:chunk:c95da2ba-09f9-48b5-b7d0-e94bb76c6b13> a kg:Chunk ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:chunk_id "c95da2ba-09f9-48b5-b7d0-e94bb76c6b13" ;
