<urn:kg:jardiance:chunk:5d28ea1a-778b-4a87-8f18-025b7d3ef96d> a kg:Chunk ;
    rdfs:label "Jardiance_Claims_updated & Content Modules 1.xlsx" ;
    kg:chunk_id "5d28ea1a-778b-4a87-8f18-025b7d3ef96d" ;
    kg:chunk_index 25 ;
    kg:extraction_method "openpyxl" ;
