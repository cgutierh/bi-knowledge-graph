<urn:kg:jardiance:chunk:25bd08d8-8406-4bc3-b89e-0d28f248f2fe> a kg:Chunk ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:chunk_id "25bd08d8-8406-4bc3-b89e-0d28f248f2fe" ;
    kg:chunk_index 176 ;
