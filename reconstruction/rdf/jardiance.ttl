<urn:kg:jardiance:section:8c928918-d099-4553-9210-1125577645c1> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:1f8a142b-0651-4a18-bd1b-f00d771921ef> ;
