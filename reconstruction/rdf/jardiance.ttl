<urn:kg:jardiance:section:28f0f5a0-5174-4204-86d8-ec6b4e529e97> a kg:Section ;
    rdfs:label "JARDIANCE Brand Book 2025.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:1ff1da85-6891-49a0-a263-de23e1046e06>,
        <urn:kg:jardiance:chunk:e2e649db-4f8e-4601-b097-d304bdd3e764> ;
    kg:extraction_method "docling" ;
