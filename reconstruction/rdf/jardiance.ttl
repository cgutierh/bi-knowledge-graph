<urn:kg:jardiance:pisection:0e91383f-891f-429a-ab40-686f5e3ffd27> a kg:PISection ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:b2560bb2-851a-4e06-8246-07641712e8b0> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:0e91383f-891f-429a-ab40-686f5e3ffd27> ;
