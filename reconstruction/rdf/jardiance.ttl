<urn:kg:jardiance:pisection:6255a9e3-f098-4b96-9800-27a1d1f3afb3> a kg:PISection ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
    kg:DERIVED_FROM_DOCUMENT <urn:kg:jardiance:document:98de1eab-c096-475d-9a30-ff5319cefc40> ;
    kg:DERIVED_FROM_SECTION <urn:kg:jardiance:section:6255a9e3-f098-4b96-9800-27a1d1f3afb3> ;
    kg:graphScope "brand" ;
    kg:page_number 3 ;
    kg:section_id "6255a9e3-f098-4b96-9800-27a1d1f3afb3" ;
    kg:section_title "Type 2 diabetes mellitus" ;
    kg:source_document_id "98de1eab-c096-475d-9a30-ff5319cefc40" ;
    kg:source_document_type "product_information" ;
    kg:source_file_name "jardiance-epar-product-information_en.pdf" ;
    kg:text "The recommended starting dose is 10 mg empagliflozin once daily for monotherapy and add-on combination therapy with other medicinal products for the treatment of diabetes. In patients tolerating empagliflozin 10 mg once daily who have an eGFR ≥ 60 mL/min/1.73 m 2  and need tighter glycaemic control, the dose can be increased to 25 mg once daily. The maximum daily dose is 25 mg (see below and section 4.4)." .

