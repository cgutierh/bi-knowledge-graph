    kg:section_type "heading" ;
    kg:source_document_id "b5acf5ff-42d8-4d92-bba4-931955176f5b" ;
    kg:source_document_type "brand_book" ;
    kg:source_file_name "JARDIANCE Brand Book 2025.pdf" ;
    kg:text """-   Use the supplied background images only
-   Use textures and graphics from the hero visual in isolation for both print and digital applications where appropriate
-   Ensure any usage outside the hero visual complements and does not interfere with established page layouts and brand architecture

<!-- image -->""" .

<urn:kg:jardiance:section:b74d2511-2d96-4d12-bbed-f2fccf06f712> a kg:Section ;
    rdfs:label "Jardiance_PI.pdf" ;
    kg:SECTION_HAS_CHUNK <urn:kg:jardiance:chunk:c29d0ffd-3fb5-4212-9321-26f31d8d49ae> ;
    kg:extraction_method "docling" ;
    kg:graphScope "brand" ;
    kg:page_number 13 ;
    kg:section_id "b74d2511-2d96-4d12-bbed-f2fccf06f712" ;
    kg:section_type "body" ;
    kg:source_document_id "b2560bb2-851a-4e06-8246-07641712e8b0" ;
    kg:source_document_type "prescribing_information" ;
    kg:source_file_name "Jardiance_PI.pdf" ;
    kg:text "In pre- and postnatal development studies in pregnant rats, empagliflozin was administered from gestation day 6 through to lactation day 20 (weaning) at up to 100 mg/kg/day (approximately 16-times the 25 mg maximum clinical dose) without maternal toxicity.  Reduced body weight was observed in the offspring at greater than or equal to 30 mg/kg/day (approximately 4-times the 25 mg maximum clinical dose)." .

<urn:kg:jardiance:section:b8af523b-64a3-40ad-8964-e67d2a2bfde8> a kg:Section ;
    rdfs:label "jardiance-epar-product-information_en.pdf" ;
